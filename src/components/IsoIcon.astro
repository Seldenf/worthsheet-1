---
import { LUCIDE } from '../lib/lucide-glyphs';
type Icon = 'house' | 'scale' | 'percent' | 'key' | 'gauge' | 'bank' | 'document' | 'sheet' | 'pin';
type Tone = 'green' | 'blue' | 'yellow' | 'pink' | 'white';

interface Props {
  icon: Icon;
  tone: Tone;
  /** Rendered width in px; height follows the 52×44 viewBox. */
  size?: number;
  /** Breathing animation delay in seconds (desynchronises instances). */
  delay?: number;
  class?: string;
}

const { icon, tone, size = 56, delay = 0, class: className } = Astro.props;

// Palette: tile fill, darker side slab, edge stroke, glyph ink.
const TONES: Record<Tone, { fill: string; side: string; edge: string; edgeWidth: number; ink: string }> = {
  green: { fill: '#40aa4a', side: '#2f8a39', edge: '#fff', edgeWidth: 2, ink: '#fff' },
  blue: { fill: '#6cbee4', side: '#4a9fc8', edge: '#fff', edgeWidth: 2, ink: '#fff' },
  yellow: { fill: '#fac344', side: '#d9a02a', edge: '#fff', edgeWidth: 2, ink: '#fff' },
  pink: { fill: '#f3a6d2', side: '#e07fb8', edge: '#fff', edgeWidth: 2, ink: '#fff' },
  white: { fill: '#ffffff', side: '#d9d6d3', edge: '#e3e0dd', edgeWidth: 1, ink: '#0c2635' },
};

// Lucide glyphs (24×24 grid, ISC; see src/lib/lucide-glyphs.ts), stroked upright on the tile top.
const ICONS: Record<Icon, string> = {
  house: LUCIDE.house,
  scale: LUCIDE.scale,
  percent: LUCIDE.percent,
  key: LUCIDE.key,
  gauge: LUCIDE.gauge,
  bank: LUCIDE.bank,
  document: LUCIDE.document,
  sheet: LUCIDE.sheet,
  pin: LUCIDE.pin,
};

const t = TONES[tone];
// Artwork: iso square of side S (top diamond 2S wide, S tall), slab drops by SLAB.
// ViewBox 52×44 = artwork bounds + 2 margin, plus 4 headroom above for the idle rise.
const S = 24;
const SLAB = 5;
const CX = 26;
const CY = 18;
const iso = (cy: number) => `matrix(1 -0.5 1 0.5 ${CX - S} ${cy})`;
// Glyph lies flat on the top face: 24-grid glyph centred on the face square, side G·S.
const G = 0.78;
const glyphTransform = `translate(${S / 2} ${S / 2}) scale(${G}) translate(-12 -12)`;
// ~1.15 viewBox units after the iso projection (its linear map has mean scale ≈1): fine lines at small sizes.
const glyphStroke = (1.15 / G).toFixed(2);
const delayStyle = `--iso-delay:${delay}s`;
---

<svg
  class:list={['iso-ico', className]}
  width={size}
  height={(size * 44) / 52}
  viewBox="0 0 52 44"
  xmlns="http://www.w3.org/2000/svg"
  focusable="false"
  aria-hidden="true"
>
  <g class="iso-ico-shadow">
    <ellipse cx={CX} cy="39" rx="21" ry="3.4" fill="#2e2926" fill-opacity=".08"></ellipse>
    <ellipse cx={CX} cy="39" rx="15" ry="2.4" fill="#2e2926" fill-opacity=".07"></ellipse>
  </g>

  <g class="iso-ico-tile" style={delayStyle}>
    <g class="iso-ico-slab">
      <g class="iso-ico-slab-bob">
        <g transform={iso(CY + SLAB)}>
          <rect width={S} height={S} rx={S * 0.17} fill={t.side}></rect>
        </g>
      </g>
    </g>
    <g class="iso-ico-top">
      <g class="iso-ico-top-bob">
        <g transform={iso(CY)}>
          <rect width={S} height={S} rx={S * 0.17} fill={t.fill} stroke={t.edge} stroke-width={t.edgeWidth}></rect>
          <g
            class="iso-ico-glyph"
            transform={glyphTransform}
            color={t.ink}
            stroke="currentColor"
            stroke-width={glyphStroke}
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
            set:html={ICONS[icon]}
          ></g>
        </g>
      </g>
    </g>
  </g>
</svg>

<style is:global>
  .iso-ico {
    display: block;
    overflow: visible;
    flex: none;
  }

  @keyframes iso-ico-breathe-top {
    0%, 100% { translate: 0 -1.5px; }
    50% { translate: 0 1.5px; }
  }

  @keyframes iso-ico-breathe-slab {
    0%, 100% { translate: 0 -0.5px; }
    50% { translate: 0 0.5px; }
  }

  /* Rest: shadow hidden (fades in on hover/focus of an ancestor). */
  .iso-ico-shadow {
    opacity: 0;
    transform: scale(0.8);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 320ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 320ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  :is(a, .card, .mega-item, .mega-feature, .iso-hover):is(:hover, :focus-visible) .iso-ico .iso-ico-shadow {
    opacity: 0.6;
    transform: scale(1);
  }

  /* Layers: wrapper lifts (plain <g>), inner bob loops; glyph sits inside the top bob. */
  .iso-ico-slab,
  .iso-ico-top {
    translate: 0 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .iso-ico-slab,
    .iso-ico-top {
      transition: translate 320ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    :is(a, .card, .mega-item, .mega-feature, .iso-hover):is(:hover, :focus-visible) .iso-ico .iso-ico-top {
      translate: 0 -3px;
    }

    :is(a, .card, .mega-item, .mega-feature, .iso-hover):is(:hover, :focus-visible) .iso-ico .iso-ico-slab {
      translate: 0 -1px;
    }

    :is(a, .card, .mega-item, .mega-feature, .iso-hover):is(:hover, :focus-visible) .iso-ico .iso-ico-top-bob {
      animation: iso-ico-breathe-top 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      animation-delay: var(--iso-delay, 0s);
    }

    :is(a, .card, .mega-item, .mega-feature, .iso-hover):is(:hover, :focus-visible) .iso-ico .iso-ico-slab-bob {
      animation: iso-ico-breathe-slab 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      animation-delay: calc(var(--iso-delay, 0s) + 1.6s);
    }
  }
</style>
