---
type Icon = 'house' | 'scale' | 'percent' | 'key' | 'gauge' | 'bank' | 'document' | 'sheet' | 'pin';
type Tone = 'green' | 'blue' | 'yellow' | 'pink' | 'white';

interface Props {
  icon: Icon;
  tone: Tone;
  /** Rendered width in px; height follows the 52×44 viewBox. */
  size?: number;
  /** Breathing animation delay in seconds (desynchronises instances). */
  delay?: number;
  class?: string;
}

const { icon, tone, size = 56, delay = 0, class: className } = Astro.props;

// Palette: tile fill, darker side slab, edge stroke, glyph ink.
const TONES: Record<Tone, { fill: string; side: string; edge: string; edgeWidth: number; ink: string }> = {
  green: { fill: '#40aa4a', side: '#2f8a39', edge: '#fff', edgeWidth: 2, ink: '#fff' },
  blue: { fill: '#6cbee4', side: '#4a9fc8', edge: '#fff', edgeWidth: 2, ink: '#fff' },
  yellow: { fill: '#fac344', side: '#d9a02a', edge: '#fff', edgeWidth: 2, ink: '#2e2926' },
  pink: { fill: '#f3a6d2', side: '#e07fb8', edge: '#fff', edgeWidth: 2, ink: '#2e2926' },
  white: { fill: '#ffffff', side: '#d9d6d3', edge: '#e3e0dd', edgeWidth: 1, ink: '#2e2926' },
};

// Glyphs drawn on a 24×24 grid, stroked upright on the tile top.
const ICONS: Record<Icon, string> = {
  house: '<path d="M3.5 11.5 12 4l8.5 7.5M6 10v10h12V10M10 20v-5.5h4V20"/>',
  scale: '<path d="M12 4v16M8 20h8M4 7h16M4 7 1.5 13.5a2.5 2.5 0 0 0 5 0zM20 7l-2.5 6.5a2.5 2.5 0 0 0 5 0z"/>',
  percent: '<path d="M18 6 6 18"/><circle cx="7.5" cy="7.5" r="2.3"/><circle cx="16.5" cy="16.5" r="2.3"/>',
  key: '<circle cx="7.5" cy="12" r="3.5"/><path d="M11 12h9.5M17.5 12v3M20.5 12v2.5"/>',
  gauge: '<path d="M4 16a8 8 0 1 1 16 0"/><path d="M12 16l3.5-4"/><circle cx="12" cy="16" r="1" fill="currentColor" stroke="none"/>',
  bank: '<path d="M3 9.5 12 4l9 5.5zM5.5 12v6M10 12v6M14 12v6M18.5 12v6M3 20.5h18"/>',
  document: '<path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6"/>',
  sheet: '<rect x="3.5" y="4.5" width="17" height="15" rx="1.5"/><path d="M3.5 9.5h17M3.5 14.5h17M9.5 4.5v15M14.5 4.5v15"/>',
  pin: '<path d="M12 21s-6-5.5-6-10.5a6 6 0 0 1 12 0C18 15.5 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.2"/>',
};

const t = TONES[tone];
// Artwork: iso square of side S (top diamond 2S wide, S tall), slab drops by SLAB.
// ViewBox 52×44 = artwork bounds + 2 margin, plus 4 headroom above for the hover lift.
const S = 24;
const SLAB = 5;
const CX = 26;
const CY = 18;
const iso = (cy: number) => `matrix(1 -0.5 1 0.5 ${CX - S} ${cy})`;
// Glyph lies flat on the top face: 24-grid glyph centred on the face square, side G·S.
const G = 0.7;
const glyphTransform = `translate(${S / 2} ${S / 2}) scale(${G}) translate(-12 -12)`;
// ~1.8 viewBox units after the iso projection (its linear map has mean scale ≈1).
const glyphStroke = (1.8 / G).toFixed(2);
const delayStyle = `animation-delay:${delay}s`;
---

<svg
  class:list={['iso-ico', className]}
  width={size}
  height={(size * 44) / 52}
  viewBox="0 0 52 44"
  xmlns="http://www.w3.org/2000/svg"
  focusable="false"
  aria-hidden="true"
>
  <g class="iso-ico-shadow">
    <ellipse cx={CX} cy="39" rx="21" ry="3.4" fill="#2e2926" fill-opacity=".08"></ellipse>
    <ellipse cx={CX} cy="39" rx="15" ry="2.4" fill="#2e2926" fill-opacity=".07"></ellipse>
  </g>

  <g class="iso-ico-tile" style={delayStyle}>
    <g transform={iso(CY + SLAB)}>
      <rect width={S} height={S} rx={S * 0.17} fill={t.side}></rect>
    </g>
    <g transform={iso(CY)}>
      <rect width={S} height={S} rx={S * 0.17} fill={t.fill} stroke={t.edge} stroke-width={t.edgeWidth}></rect>
      <g
        class="iso-ico-glyph"
        transform={glyphTransform}
        color={t.ink}
        stroke="currentColor"
        stroke-width={glyphStroke}
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
        set:html={ICONS[icon]}
      ></g>
    </g>
  </g>
</svg>

<style is:global>
  .iso-ico {
    display: block;
    overflow: visible;
    flex: none;
  }

  .iso-ico-shadow {
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes iso-ico-breathe {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -1.5px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .iso-ico-tile {
      transform-box: fill-box;
      transform-origin: center;
      will-change: transform, translate;
      animation: iso-ico-breathe 6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      transition: transform 280ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .iso-ico-shadow {
      will-change: transform, opacity;
      transition: transform 280ms cubic-bezier(0.23, 1, 0.32, 1), opacity 280ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* Keyboard focus lifts too. */
    .iso-hover:focus-visible .iso-ico-tile {
      transform: translate(0, -4px);
    }

    .iso-hover:focus-visible .iso-ico-shadow {
      transform: scale(0.85);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .iso-hover:hover .iso-ico-tile {
      transform: translate(0, -4px);
    }

    .iso-hover:hover .iso-ico-shadow {
      transform: scale(0.85);
      opacity: 0.6;
    }
  }
</style>
