---
/**
 * ZIP-code bank finder. Progressive enhancement: the only network call is made from the browser
 * to the public FDIC BankFind API after the visitor submits a ZIP code.
 * Optional `stateCode`/`stateName` pre-scope the search to one state (state pages).
 */
interface Props {
  /** Unique prefix for element ids when more than one finder is on a page. */
  id?: string;
  stateCode?: string;
  stateName?: string;
  class?: string;
}

const { id = 'bank-finder', stateCode, stateName, class: className } = Astro.props;
---

<div class:list={['bank-finder', className]} data-bank-finder data-state={stateCode} data-state-name={stateName}>
  <form class="bf-form" novalidate>
    <div class="field">
      <label for={`${id}-zip`}>{stateName ? `ZIP code in ${stateName}` : 'ZIP code'}</label>
      <div class="bf-row">
        <input
          id={`${id}-zip`}
          name="zip"
          type="text"
          inputmode="numeric"
          autocomplete="postal-code"
          maxlength="5"
          pattern="[0-9]{5}"
          placeholder="e.g. 37203"
          aria-describedby={`${id}-hint ${id}-error`}
          required
        />
        <button type="submit" class="btn btn-primary">Find banks</button>
      </div>
      <p class="field-hint" id={`${id}-hint`}>
        {
          stateName
            ? `Lists full-service FDIC-insured bank offices for a ZIP code in ${stateName}.`
            : 'Lists full-service FDIC-insured bank offices (branches) in a 5-digit ZIP code.'
        } Your ZIP code is sent to the FDIC's public API (api.fdic.gov) to run the search; WorthSheet does not store it.
      </p>
      <p class="field-error" id={`${id}-error`} data-bf-error hidden></p>
    </div>
  </form>
  <div class="bf-results" data-bf-results aria-live="polite"></div>
  <noscript>
    <p class="muted">
      The ZIP search needs JavaScript. You can also use the FDIC's own
      <a href="https://banks.data.fdic.gov/bankfind-suite/bankfind" rel="noopener">BankFind Suite</a>.
    </p>
  </noscript>
</div>

<style>
  .bank-finder {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bf-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bf-row input {
    flex: 1 1 180px;
    max-width: 280px;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
  }

  .bf-row .btn {
    min-height: 48px;
    padding-inline: 1.5em;
    font-size: 0.9375rem;
  }

  .bf-results:empty {
    display: none;
  }

  .bf-results :global(.bf-summary) {
    font-weight: 560;
    margin-bottom: 12px;
  }

  .bf-results :global(.bf-note),
  .bf-results :global(.bf-empty) {
    color: var(--muted);
    max-width: 44em;
  }

  .bf-results :global(.bf-list) {
    list-style: none;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  .bf-results :global(.bf-bank) {
    padding: 16px 18px;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-border);
  }

  .bf-results :global(.bf-bank strong) {
    display: block;
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }

  .bf-results :global(.bf-addr) {
    list-style: none;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .bf-results :global(.bf-addr li + li) {
    margin-top: 4px;
  }
</style>

<script>
  const API = 'https://api.fdic.gov/banks/locations';
  const LIMIT = 100;
  const TIMEOUT_MS = 15000;
  const BANKFIND = 'https://banks.data.fdic.gov/bankfind-suite/bankfind';

  interface Loc {
    NAME: string;
    ADDRESS?: string;
    CITY?: string;
    STALP?: string;
    ZIP?: string;
    CERT?: string | number;
  }
  interface ApiResponse {
    meta: { total: number };
    data: { data: Loc }[];
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function init(root: HTMLElement) {
    const form = root.querySelector('form') as HTMLFormElement;
    const input = form.querySelector('input') as HTMLInputElement;
    const button = form.querySelector('button') as HTMLButtonElement;
    const error = root.querySelector('[data-bf-error]') as HTMLElement;
    const results = root.querySelector('[data-bf-results]') as HTMLElement;
    const state = root.dataset.state || '';
    const scope = state ? ` in ${root.dataset.stateName || state}` : '';
    let inflight: AbortController | null = null;

    const showError = (msg: string) => {
      error.textContent = msg;
      error.hidden = false;
      input.setAttribute('aria-invalid', 'true');
    };
    const clearError = () => {
      error.hidden = true;
      error.textContent = '';
      input.removeAttribute('aria-invalid');
    };
    const render = (...nodes: Node[]) => results.replaceChildren(...nodes);
    const message = (text: string, cls = 'bf-empty') => render(el('p', cls, text));

    const fallbackLink = () => {
      const p = el('p', 'bf-note', 'You can also look up any bank directly in ');
      const a = el('a', undefined, 'FDIC BankFind Suite');
      a.href = BANKFIND;
      a.rel = 'noopener';
      p.append(a, '.');
      return p;
    };

    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '').slice(0, 5);
      if (!error.hidden) clearError();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const zip = input.value.trim();
      if (!/^\d{5}$/.test(zip)) {
        showError('Enter a 5-digit ZIP code, for example 37203.');
        results.replaceChildren();
        input.focus();
        return;
      }
      clearError();

      // Newest search wins.
      inflight?.abort();
      const controller = new AbortController();
      inflight = controller;
      const timer = setTimeout(() => controller.abort('timeout'), TIMEOUT_MS);
      button.disabled = true;
      message(`Searching the FDIC database for ZIP ${zip}…`, 'bf-note');

      const filters =
        `ZIP:"${zip}" AND (SERVTYPE:11 OR SERVTYPE:12)` + (state ? ` AND STALP:"${state}"` : '');
      const query = new URLSearchParams({
        filters,
        fields: 'NAME,ADDRESS,CITY,STALP,ZIP,SERVTYPE,CERT',
        limit: String(LIMIT),
        sort_by: 'NAME',
      });

      try {
        const res = await fetch(`${API}?${query}`, { signal: controller.signal });
        if (res.status === 429) throw new Error('rate');
        if (!res.ok) throw new Error(`http ${res.status}`);
        const json = (await res.json()) as ApiResponse;
        if (controller !== inflight) return;

        const rows = json.data.map((d) => d.data);
        if (rows.length === 0) {
          render(
            el(
              'p',
              'bf-empty',
              `No full-service FDIC-insured bank offices found for ZIP ${zip}${scope}. Check the ZIP code or try a neighboring one; some ZIP codes have no branches.`,
            ),
            fallbackLink(),
          );
          return;
        }

        const banks = new Map<string, { name: string; offices: Loc[] }>();
        for (const loc of rows) {
          const key = String(loc.CERT ?? loc.NAME);
          const entry = banks.get(key) ?? { name: loc.NAME, offices: [] };
          entry.offices.push(loc);
          banks.set(key, entry);
        }

        const total = json.meta.total;
        const summary = el(
          'p',
          'bf-summary',
          `${total.toLocaleString('en-US')} full-service ${total === 1 ? 'office' : 'offices'} in ZIP ${zip}${scope}` +
            (rows.length < total ? ` (showing the first ${rows.length})` : `, from ${banks.size} ${banks.size === 1 ? 'bank' : 'banks'}`),
        );

        const list = el('ul', 'bf-list');
        for (const { name, offices } of banks.values()) {
          const li = el('li', 'bf-bank');
          li.append(el('strong', undefined, name));
          const addrs = el('ul', 'bf-addr');
          for (const o of offices) {
            const parts = [o.ADDRESS ?? '', [o.CITY, o.STALP].filter(Boolean).join(', ')].filter(Boolean);
            addrs.append(el('li', undefined, `${parts.join(', ')} ${o.ZIP ?? ''}`.trim()));
          }
          li.append(addrs);
          list.append(li);
        }

        const note = el(
          'p',
          'bf-note',
          'Source: FDIC BankFind Suite (updated by the FDIC, so recent openings and closings may be missing). Listing is not an endorsement. ',
        );
        const link = el('a', undefined, 'Verify a bank in FDIC BankFind');
        link.href = BANKFIND;
        link.rel = 'noopener';
        note.append(link, '.');

        render(summary, list, note);
      } catch (err) {
        if (controller !== inflight && controller.signal.reason !== 'timeout') return;
        const reason = (err as Error).message;
        const text =
          controller.signal.reason === 'timeout'
            ? 'The FDIC service did not answer in time. Please try again in a moment.'
            : reason === 'rate'
              ? 'The FDIC service is busy right now. Please wait a minute and try again.'
              : 'We could not reach the FDIC service. Check your connection and try again.';
        render(el('p', 'field-error', text), fallbackLink());
      } finally {
        clearTimeout(timer);
        if (controller === inflight) {
          inflight = null;
          button.disabled = false;
        }
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-bank-finder]').forEach(init);
</script>
