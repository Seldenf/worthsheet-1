---
import type { CollectionEntry } from 'astro:content';
import BankMap from './illustrations/BankMap.astro';
import CalculatorTile from './illustrations/CalculatorTile.astro';
import CategoriesStack from './illustrations/CategoriesStack.astro';
import CtaTiles from './illustrations/CtaTiles.astro';
import DocumentStack from './illustrations/DocumentStack.astro';
import GlossaryBook from './illustrations/GlossaryBook.astro';
import HeroSheet from './illustrations/HeroSheet.astro';
import IsoTiles from './illustrations/IsoTiles.astro';
import ReadinessGauge from './illustrations/ReadinessGauge.astro';
import ShieldSecure from './illustrations/ShieldSecure.astro';
import StepsFlow from './illustrations/StepsFlow.astro';

type Cover = NonNullable<CollectionEntry<'blog'>['data']['cover']>;

// Illustration per cover key. Keys double as the tint rotation order below.
const ART: Record<Cover, typeof DocumentStack> = {
  HeroSheet,
  IsoTiles,
  CategoriesStack,
  StepsFlow,
  ShieldSecure,
  CalculatorTile,
  BankMap,
  GlossaryBook,
  DocumentStack,
  ReadinessGauge,
  CtaTiles,
};
const KEYS = Object.keys(ART) as Cover[];
const TINTS = ['--tint-blue', '--tint-green', '--tint-cream', '--tint-pink'];
const DEFAULT: Cover = 'DocumentStack';

interface Props {
  /** Blog frontmatter `cover`; falls back to DocumentStack. */
  cover?: Cover;
  class?: string;
  /** Wide hero panel above an article (max-height 320px) instead of the 16:10 card media. */
  wide?: boolean;
}

const { cover, class: className, wide = false } = Astro.props;
const key = cover ?? DEFAULT;
const Art = ART[key];
const tint = TINTS[KEYS.indexOf(key) % TINTS.length];
---

<div
  class:list={['post-cover', wide && 'post-cover-wide', className]}
  style={`--cover-tint: var(${tint})`}
  aria-hidden="true"
>
  <Art class="post-cover-art" />
</div>

<style>
  .post-cover {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--cover-tint);
    transition: background-color 400ms cubic-bezier(0.23, 1, 0.32, 1);
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
  }

  .post-cover :global(svg) {
    display: block;
    width: 85%;
    height: auto;
    max-height: 100%;
  }

  .post-cover-wide {
    max-width: 960px;
    max-height: 320px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
  }

  /* Card covers rest muted; the article hero (wide) stays full tint. */
  .post-cover:not(.post-cover-wide) {
    background-color: color-mix(in srgb, var(--cover-tint) 55%, #f5f3f2);
  }

  /* Looping animations stay paused at rest. :where keeps specificity at zero
     so the hover rule below can override it. */
  .post-cover:not(.post-cover-wide)
    :global(:where(svg.wsi *:not(.wsi-in):not(.wsi-draw):not(.wsi-cats-card):not(.wsi-docs-enter))) {
    animation-play-state: paused;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(:is(a, .card, .post-card):is(:hover, :focus-visible)) .post-cover {
      background-color: var(--cover-tint);
    }

    :global(:is(a, .card, .post-card):is(:hover, :focus-visible)) .post-cover :global(svg.wsi *) {
      animation-play-state: running;
    }

    /* Card covers rest bare: extras (.wsi-extra) and strokes (.wsi-draw) stay hidden until the card is hovered or focused.
       Touch devices never match this block, so they keep the full illustration. */
    .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-extra),
    .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-draw) {
      opacity: 0;
      transition:
        opacity 420ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i, 0) * 60ms),
        translate 420ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i, 0) * 60ms),
        stroke-dashoffset 600ms cubic-bezier(0.23, 1, 0.32, 1) 200ms;
    }

    /* Stagger index: nth-of-type fallbacks 1-8 (an inline --i still wins). */
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(1)) { --i: 1; }
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(2)) { --i: 2; }
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(3)) { --i: 3; }
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(4)) { --i: 4; }
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(5)) { --i: 5; }
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(6)) { --i: 6; }
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(7)) { --i: 7; }
    .post-cover:not(.post-cover-wide) :global(svg.wsi :is(.wsi-extra, .wsi-draw):nth-of-type(8)) { --i: 8; }

    :global(:is(a, .card, .post-card):is(:hover, :focus-visible)) .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-extra),
    :global(:is(a, .card, .post-card):is(:hover, :focus-visible)) .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-draw) {
      opacity: 1;
      translate: 0 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      /* Cancel the global .wsi-draw intro on card covers so the hover transition owns the stroke. */
      .post-cover:not(.post-cover-wide) :global(svg.wsi.is-in .wsi-draw) {
        animation: none;
      }

      .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-extra),
      .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-draw) {
        translate: 0 6px;
      }

      .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-draw) {
        stroke-dasharray: 100;
        stroke-dashoffset: 100;
      }

      :global(:is(a, .card, .post-card):is(:hover, :focus-visible)) .post-cover:not(.post-cover-wide) :global(svg.wsi .wsi-draw) {
        stroke-dashoffset: 0;
      }
    }
  }
</style>
