---
import type { CollectionEntry } from 'astro:content';
import BankMap from './illustrations/BankMap.astro';
import CalculatorTile from './illustrations/CalculatorTile.astro';
import CategoriesStack from './illustrations/CategoriesStack.astro';
import CtaTiles from './illustrations/CtaTiles.astro';
import DocumentStack from './illustrations/DocumentStack.astro';
import GlossaryBook from './illustrations/GlossaryBook.astro';
import HeroSheet from './illustrations/HeroSheet.astro';
import IsoTiles from './illustrations/IsoTiles.astro';
import ReadinessGauge from './illustrations/ReadinessGauge.astro';
import ShieldSecure from './illustrations/ShieldSecure.astro';
import StepsFlow from './illustrations/StepsFlow.astro';

type Cover = NonNullable<CollectionEntry<'blog'>['data']['cover']>;

// Illustration per cover key. Keys double as the tint rotation order below.
const ART: Record<Cover, typeof DocumentStack> = {
  HeroSheet,
  IsoTiles,
  CategoriesStack,
  StepsFlow,
  ShieldSecure,
  CalculatorTile,
  BankMap,
  GlossaryBook,
  DocumentStack,
  ReadinessGauge,
  CtaTiles,
};
const KEYS = Object.keys(ART) as Cover[];
const TINTS = ['--tint-blue', '--tint-green', '--tint-cream', '--tint-pink'];
const DEFAULT: Cover = 'DocumentStack';

interface Props {
  /** Blog frontmatter `cover`; falls back to DocumentStack. */
  cover?: Cover;
  class?: string;
  /** Wide hero panel above an article (max-height 320px) instead of the 16:10 card media. */
  wide?: boolean;
}

const { cover, class: className, wide = false } = Astro.props;
const key = cover ?? DEFAULT;
const Art = ART[key];
const tint = TINTS[KEYS.indexOf(key) % TINTS.length];
---

<div
  class:list={['post-cover', wide && 'post-cover-wide', className]}
  style={`--cover-tint: var(${tint})`}
  aria-hidden="true"
>
  <Art class="post-cover-art" />
</div>

<style>
  .post-cover {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--cover-tint);
    transition: background-color 400ms cubic-bezier(0.23, 1, 0.32, 1);
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
  }

  .post-cover :global(svg) {
    display: block;
    width: 85%;
    height: auto;
    max-height: 100%;
  }

  .post-cover-wide {
    max-width: 960px;
    max-height: 320px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
  }

  /* Card covers rest muted; the article hero (wide) stays full tint. */
  .post-cover:not(.post-cover-wide) {
    background-color: color-mix(in srgb, var(--cover-tint) 55%, #f5f3f2);
  }

  /* Looping animations stay paused at rest. :where keeps specificity at zero
     so the hover rule below can override it. */
  .post-cover:not(.post-cover-wide)
    :global(:where(svg.wsi *:not(.wsi-in):not(.wsi-draw):not(.wsi-cats-card):not(.wsi-docs-enter))) {
    animation-play-state: paused;
  }

  @media (hover: hover) and (pointer: fine) {
    :is(a, .card, .post-card):is(:hover, :focus-visible) .post-cover {
      background-color: var(--cover-tint);
    }

    :is(a, .card, .post-card):is(:hover, :focus-visible) .post-cover :global(svg.wsi *) {
      animation-play-state: running;
    }
  }
</style>
