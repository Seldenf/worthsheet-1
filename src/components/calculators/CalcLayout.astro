---
/**
 * Hero + two-column tool shell shared by all calculators. Render it inside `<Base>`; follow it with your own
 * `<Section>`s (explanation, FAQ, related links) and a `<CtaBand>`.
 *
 * Props
 * - eyebrow      small label above the h1 (rendered as `<p class="eyebrow">`).
 * - title        (required) the page's single `<h1>`.
 * - lead         intro paragraph under the h1.
 * - formId       (required) id of the `<form novalidate>` that wraps the default slot (pass to `bindCalculator`).
 * - inputsTitle  heading above the inputs (default "Your numbers"); resultsTitle (default "Your results").
 * - resultsTone  background of the results panel: 'surface' | 'blue' | 'green' | 'yellow' | 'cream' (default 'surface').
 *
 * Slots
 * - art       hero illustration, e.g. `<CalculatorTile slot="art" />`.
 * - default   form fields (`MoneyInput`s, radios, …).
 * - results   result content. Put the valid-state markup inside `<div data-results>…</div>`; the layout supplies
 *             a `<p data-empty hidden>` placeholder that `showResults(false, msg)` reveals when inputs are invalid.
 *             Everything sits in an `aria-live="polite"` region.
 * - below     optional full-width content under the tool card (e.g. an amortization table).
 *
 * The standard disclaimer is rendered under the tool.
 */
interface Props {
	eyebrow?: string;
	title: string;
	lead?: string;
	formId: string;
	inputsTitle?: string;
	resultsTitle?: string;
	resultsTone?: 'surface' | 'blue' | 'green' | 'yellow' | 'cream';
}

const {
	eyebrow,
	title,
	lead,
	formId,
	inputsTitle = 'Your numbers',
	resultsTitle = 'Your results',
	resultsTone = 'surface',
} = Astro.props;
---

<section class="calc-hero tone-paper">
	<div class="container calc-hero-grid">
		<div class="calc-hero-copy">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h1>{title}</h1>
			{lead && <p class="lead">{lead}</p>}
		</div>
		<div class="calc-hero-art"><slot name="art" /></div>
	</div>
</section>

<section class="calc-tool" aria-label="Calculator">
	<div class="container">
		<div class="calc-grid">
			<div class="calc-panel card">
				<h2 class="calc-panel-title">{inputsTitle}</h2>
				<form id={formId} class="calc-form" novalidate autocomplete="off">
					<noscript><p class="field-error">This calculator needs JavaScript. The example results below use the prefilled values.</p></noscript>
					<slot />
				</form>
			</div>

			<div class:list={['calc-panel', 'calc-results', `calc-tone-${resultsTone}`]}>
				<h2 class="calc-panel-title">{resultsTitle}</h2>
				<div class="calc-live" aria-live="polite" aria-atomic="false">
					<p class="calc-empty" data-empty hidden>Fix the highlighted fields to see your results.</p>
					<slot name="results" />
				</div>
			</div>
		</div>

		<slot name="below" />

		<p class="calc-disclaimer muted small">
			Estimates for educational purposes only. Not a loan offer or financial advice.
		</p>
	</div>
</section>

<style>
	.calc-hero {
		padding-block: clamp(32px, 6vw, 72px) clamp(16px, 3vw, 32px);
	}

	.calc-hero-grid {
		display: grid;
		gap: 32px;
		align-items: center;
	}

	.calc-hero-copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.calc-hero-art {
		max-width: 420px;
		width: 100%;
		margin-inline: auto;
	}

	.calc-hero-art:empty {
		display: none;
	}

	.calc-tool {
		padding-block: clamp(16px, 3vw, 32px) clamp(48px, 8vw, 96px);
	}

	.calc-grid {
		display: grid;
		gap: clamp(16px, 2.4vw, 28px);
		align-items: start;
	}

	.calc-panel {
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-width: 0;
	}

	.calc-panel-title {
		font-size: 1.125rem;
		letter-spacing: -0.015em;
		line-height: 1.3;
	}

	.calc-form {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.calc-results {
		padding: clamp(20px, 3vw, 32px);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.calc-tone-surface {
		background: var(--surface);
	}
	.calc-tone-blue {
		background: var(--tint-blue);
	}
	.calc-tone-green {
		background: var(--tint-green);
	}
	.calc-tone-yellow {
		background: var(--tint-yellow);
	}
	.calc-tone-cream {
		background: var(--tint-cream);
	}

	.calc-live {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.calc-empty {
		padding: 14px 16px;
		border-radius: var(--radius-sm);
		background: var(--white);
		border: 1px solid var(--danger);
		color: var(--danger);
		font-weight: 500;
	}

	.calc-disclaimer {
		margin-top: 24px;
	}

	@media (min-width: 900px) {
		.calc-hero-grid {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		}

		.calc-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.calc-results {
			position: sticky;
			top: calc(var(--header-h) + 16px);
		}
	}
</style>
