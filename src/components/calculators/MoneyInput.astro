---
/**
 * Labelled numeric text input for calculators (money, percent, years, …). Generic; no calculator logic.
 *
 * Props
 * - id        (required) input id; also used as `name` unless `name` is given. The error element is `#<id>-error`
 *             (hidden until `showError(id, msg)` from `./calc` fills it) and `aria-describedby` is wired for you.
 * - label     (required) visible label text.
 * - value     initial value (number or string), rendered into the `value` attribute.
 * - prefix    visible leading affix, default `'$'`; pass `''` for none.
 * - suffix    visible trailing affix, e.g. `'%'`, `'years'`.
 * - hint      helper text under the input.
 * - placeholder
 * - inputmode default `'decimal'` (money/percent); use `'numeric'` for whole numbers.
 * - required  sets `aria-required` (validation itself is done in JS; the form has `novalidate`).
 * - class     extra class on the wrapping `.field`.
 */
interface Props {
	id: string;
	label: string;
	value?: number | string;
	prefix?: string;
	suffix?: string;
	hint?: string;
	placeholder?: string;
	inputmode?: 'decimal' | 'numeric';
	name?: string;
	required?: boolean;
	class?: string;
}

const {
	id,
	label,
	value,
	prefix = '$',
	suffix,
	hint,
	placeholder,
	inputmode = 'decimal',
	name,
	required = false,
	class: className,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
// Reserve room for a trailing affix (≈9px per character + padding).
const padRight = suffix ? `${18 + suffix.length * 9}px` : undefined;
---

<div class:list={['field', className]}>
	<label for={id}>{label}</label>
	<div class="input-group">
		{prefix && <span class="input-affix" aria-hidden="true">{prefix}</span>}
		<input
			type="text"
			id={id}
			name={name ?? id}
			inputmode={inputmode}
			autocomplete="off"
			value={value === undefined ? undefined : String(value)}
			placeholder={placeholder}
			aria-required={required ? 'true' : undefined}
			aria-describedby={describedBy}
			style={padRight ? `padding-right:${padRight}` : undefined}
		/>
		{suffix && <span class="input-affix input-affix-end" aria-hidden="true">{suffix}</span>}
	</div>
	{hint && <p class="field-hint" id={hintId}>{hint}</p>}
	<p class="field-error" id={errorId} hidden></p>
</div>
