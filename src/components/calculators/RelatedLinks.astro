---
/**
 * Grid of internal link cards ("Related tools and guides"). Generic.
 *
 * Props
 * - items  `{ href, title, text }[]`; `href` is a root-relative route path (`/glossary/amortization/`) —
 *          the component applies `url()` itself.
 */
import { url } from '../../lib/url';

interface Props {
	items: { href: string; title: string; text: string }[];
}

const { items } = Astro.props;
const EDGES = ['edge-blue', 'edge-green', 'edge-yellow', 'edge-pink'];
---

<ul class="related grid grid-3" role="list">
	{
		items.map((item, i) => (
			<li>
				<a class={`card related-card ${EDGES[i % EDGES.length]}`} href={url(item.href)}>
					<span class="related-title">{item.title}</span>
					<span class="related-text muted">{item.text}</span>
					<span class="related-arrow" aria-hidden="true">↗</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.related {
		list-style: none;
		gap: 20px;
	}

	.related-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		padding: clamp(22px, 2.6vw, 30px);
	}

	.related-title {
		padding-right: 24px;
		font-size: 1.1875rem;
		font-weight: 560;
		letter-spacing: -0.015em;
		line-height: 1.25;
	}

	.related-text {
		font-size: 0.9688rem;
		line-height: 1.55;
	}

	/* Diagonal arrow in the top-right corner: only on hover or keyboard focus. */
	.related-arrow {
		position: absolute;
		top: 14px;
		right: 16px;
		font-size: 1.25rem;
		line-height: 1;
		color: var(--ink);
		opacity: 0;
		pointer-events: none;
	}

	.related-card:focus-visible .related-arrow {
		opacity: 1;
	}

	@media (hover: hover) and (pointer: fine) {
		.related-card:hover .related-arrow {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.related-arrow {
			translate: -2px 2px;
			transition:
				opacity 200ms var(--ease-out),
				translate 200ms var(--ease-out);
		}

		.related-card:focus-visible .related-arrow {
			translate: 0 0;
		}

		@media (hover: hover) and (pointer: fine) {
			.related-card:hover .related-arrow {
				translate: 0 0;
			}
		}
	}
</style>
