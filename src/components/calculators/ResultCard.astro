---
/**
 * One labelled result value. Generic; update the value from JS with `setOut(out, text)` from `./calc`
 * (it sets the text of every `[data-out="<out>"]` element).
 *
 * Props
 * - label    (required) what the number is, e.g. "Monthly principal & interest".
 * - out      (required) key for `data-out` on the value element.
 * - value    server-rendered initial text (default "—"). Pass a prerendered string so the page is useful without JS.
 * - hint     optional small text under the value.
 * - hintOut  optional `data-out` key for the hint (when its text is also updated from JS).
 * - primary  larger, highlighted card (use for the headline number).
 * - class    extra class.
 */
interface Props {
	label: string;
	out: string;
	value?: string;
	hint?: string;
	hintOut?: string;
	primary?: boolean;
	class?: string;
}

const { label, out, value = '—', hint, hintOut, primary = false, class: className } = Astro.props;
---

<div class:list={['card', 'result', { 'result-primary': primary }, className]}>
	<p class="result-label">{label}</p>
	<p class="result-value num" data-out={out}>{value}</p>
	{(hint || hintOut) && <p class="result-hint" data-out={hintOut}>{hint}</p>}
</div>

<style>
	.result {
		--chip-bg: var(--tint-blue);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		padding: 16px 18px;
		min-width: 0;
	}

	/* Calm tint rotation: the label chip takes the next logo colour (green first for the headline number). */
	.result-primary,
	:global(.out-grid) > .result:nth-child(4n + 2) {
		--chip-bg: var(--tint-green);
	}

	:global(.out-grid) > .result:nth-child(4n + 3) {
		--chip-bg: var(--tint-yellow);
	}

	:global(.out-grid) > .result:nth-child(4n + 4) {
		--chip-bg: var(--tint-pink);
	}

	.result-label {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--chip-bg);
		font-size: 0.8125rem;
		font-weight: 560;
		color: var(--ink);
		line-height: 1.3;
	}

	.result-value {
		font-size: clamp(1.5rem, 2.8vw, 1.875rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.result-hint {
		font-size: 0.8125rem;
		color: var(--muted);
		line-height: 1.4;
	}

	.result-primary {
		--edge: rgba(64, 170, 74, 0.85);
		gap: 10px;
		padding: 22px 24px;
	}

	.result-primary .result-value {
		font-size: clamp(2.25rem, 5.4vw, 3.25rem);
		letter-spacing: -0.04em;
	}
</style>
