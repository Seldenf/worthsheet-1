---
/**
 * A home page section in the hero's style (Figma 1:1277): a rounded card as wide as the hero card.
 * With `grid`, the card also sits on spreadsheet cells (100 x 26) with a few highlighted cells
 * around it (soft fading gradients + grain), like the hero. Use the grid sparingly: the hero and
 * the closing CTA only. Gridded sheets are snapped to whole rows by the script below.
 */
type Tone = 'green' | 'blue' | 'yellow' | 'pink';
export type GlowCell = [col: number, row: number, tone: Tone, strength: number, end: 'l' | 'r'];

interface Props {
  id?: string;
  'aria-labelledby'?: string;
  /** Card surface: white, or a soft tinted wash with grain. */
  tone?: 'white' | 'green' | 'blue' | 'cream' | 'cta';
  /** Put the card on spreadsheet cells with highlighted cells around it. */
  grid?: boolean;
  /** Highlighted grid cells (with `grid`). Generated from `seed` when omitted. */
  glow?: GlowCell[];
  seed?: number;
  /** Grid rows above the sheet (default 2) and below it (default 2 with `grid`, else 0). */
  rowsAbove?: number;
  rowsBelow?: number;
  /** Tighter inner padding for short content such as the logo strip. */
  compact?: boolean;
  class?: string;
}

const {
  id,
  'aria-labelledby': labelledby,
  tone = 'white',
  grid = false,
  glow,
  seed = 1,
  rowsAbove = 2,
  rowsBelow = grid ? 2 : 0,
  compact = false,
  class: className,
} = Astro.props;

// Small deterministic PRNG so every build places the same cells.
function rng(seedValue: number) {
  let a = seedValue | 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function generate(seedValue: number): GlowCell[] {
  const r = rng(seedValue * 7919);
  const tones: Tone[] = ['green', 'blue', 'yellow', 'pink'];
  const pick = <T,>(xs: T[]): T => xs[Math.floor(r() * xs.length)];
  const cells: GlowCell[] = [];

  // Five stacks per side (alternating the near and far columns), each fading row by row away from its strongest cell.
  // Right-side columns (>= 12) are rendered from the frame's right edge (.right), so they hug any card width.
  for (const side of ['l', 'r'] as const) {
    let row = Math.floor(r() * 3);
    for (let k = 0; k < 5; k++) {
      const col = side === 'l' ? pick(k % 2 ? [-2, -3] : [-1, -1, -2]) : pick(k % 2 ? [13, 14] : [12, 12, 13]);
      const tone = pick(tones);
      const len = 2 + Math.floor(r() * 3);
      const start = 34 + Math.floor(r() * 14);
      for (let i = 0; i < len; i++) cells.push([col, row + i, tone, Math.max(8, start - i * 11), side]);
      row += len + 1 + Math.floor(r() * 3);
    }
  }

  // Highlighted pairs in the rows above and below the sheet.
  const pair = (row: number) => {
    const col = Math.floor(r() * 11);
    const tone = pick(tones);
    const start = 22 + Math.floor(r() * 12);
    const end = r() < 0.5 ? 'l' : 'r';
    cells.push([col, row, tone, start, end], [col + 1, row, tone, Math.round(start * 0.5), end]);
  };
  for (let k = 0; k < Math.min(rowsAbove, 3); k++) pair(-1 - Math.floor(r() * rowsAbove));
  // Rows <= -100 encode cells in the rows below the sheet (rendered with .below, counted up from the bottom edge).
  if (rowsBelow > 0) pair(-101 - Math.floor(r() * rowsBelow));
  return cells;
}

const cells = grid ? (glow ?? generate(seed)) : [];
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={['sheet-section', { 'has-grid': grid }, className]}
  style={`--rows-above:${rowsAbove};--rows-below:${rowsBelow}`}
>
  <div class="sheet-frame">
    {
      grid && (
        <div class="sheet-glow" aria-hidden="true">
          {cells.map(([c, row, t, a, end]) => (
            <i
              class:list={[`tone-${t}`, { below: row <= -100, right: c >= 12 }]}
              style={`--c:${c >= 12 ? c - 12 : c};--r:${row <= -100 ? -(row + 101) : row};--a:${a}%;--dir:${end === 'l' ? '90deg' : '270deg'}`}
            />
          ))}
        </div>
      )
    }
    <div class="sheet" data-sheet>
      <div class:list={['sheet-card', `sheet-card--${tone}`]}>
        <div class:list={['sheet-body', { 'sheet-body--compact': compact }]} data-sheet-body>
          <slot />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Snap gridded sheets (the hand-built hero and any <Sheet grid>) to whole 26px rows so their
  // cell lines stay aligned below the sheet. Without JS they simply keep their natural height.
  const CELL = 26;

  const measure = (body: HTMLElement) => {
    const card = body.parentElement;
    const sheet = card?.parentElement;
    if (!card || !sheet) return;
    const s = getComputedStyle(sheet);
    const c = getComputedStyle(card);
    const extra =
      parseFloat(s.paddingTop) +
      parseFloat(s.paddingBottom) +
      parseFloat(c.borderTopWidth) +
      parseFloat(c.borderBottomWidth);
    sheet.style.setProperty('--rows', String(Math.ceil((body.offsetHeight + extra) / CELL)));
  };

  const bodies = document.querySelectorAll<HTMLElement>('.has-grid [data-sheet-body]');
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) measure(entry.target as HTMLElement);
  });
  bodies.forEach((body) => {
    measure(body);
    observer.observe(body);
  });
</script>
