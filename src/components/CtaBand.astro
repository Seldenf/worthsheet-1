---
/**
 * Closing CTA band: a navy card with grain and soft glows, centred copy, a light button and three
 * trust ticks below it. A passed `art` slot is ignored.
 */
import Button from './Button.astro';
import Sheet from './Sheet.astro';
import { STATS } from '../config';

interface Props {
  title?: string;
  text?: string;
  class?: string;
}

const {
  title = 'Get the free PFS template',
  text = `Build a bank-ready personal financial statement in Google Sheets or Excel. Free, with ${STATS.assetCategories} asset and ${STATS.liabilityCategories} liability categories built in.`,
  class: className,
} = Astro.props;

const ticks = ['Free forever', 'Google Sheets & Excel', '9,000+ downloads'];

// The word "template" renders as the hero H1's pill (spreadsheet mark + word).
const match = title.match(/^(.*?)\btemplate\b(.*)$/s);
const [before, after] = match ? [match[1], match[2]] : [title, ''];
---

<Sheet
  class={['cta-band-wrap', className].filter(Boolean).join(' ')}
  tone="cta"
  grid
  rowsAbove={3}
  rowsBelow={3}
  seed={11}
  aria-labelledby="cta-band-title"
>
  <div class="cta-band">
    <h2 id="cta-band-title">
      {before}
      {
        match && (
          <span class="title-pill">
            <span class="title-icons" aria-hidden="true">
              <svg class="title-icon title-icon-excel" viewBox="0 0 48 48">
                <rect x="15" y="6" width="29" height="36" rx="5" fill="#21a366" />
                <path d="M30 6v36M15 18h29M15 30h29" stroke="#fff" stroke-opacity=".35" stroke-width="1.5" />
                <rect x="4" y="12" width="24" height="24" rx="5" fill="#107c41" />
                <path d="M9.6 17.5h4.1l2.3 4 2.3-4h4.1l-4.3 6.5 4.4 6.5h-4.1l-2.4-4.1-2.4 4.1H9.5l4.4-6.5z" fill="#fff" />
              </svg>
              <svg class="title-icon title-icon-sheets" viewBox="0 0 48 48">
                <path d="M12 3h18l10 10v28a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z" fill="#0f9d58" />
                <path d="M30 3v6a4 4 0 0 0 4 4h6z" fill="#87ceac" />
                <path d="M15 22h18v16H15zM15 27.3h18M15 32.7h18M24 22v16" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round" />
              </svg>
            </span>
            template
          </span>
        )
      }
      {after}
    </h2>
    <p class="cta-band-text">{text}</p>
    <div class="cta-band-actions">
      <Button href="/download/" variant="secondary" size="lg" class="cta-band-btn">Get the free template</Button>
    </div>
    <ul class="cta-band-ticks">
      {
        ticks.map((t) => (
          <li>{t}</li>
        ))
      }
    </ul>
  </div>
</Sheet>

<style is:global>
  /* Card surface: navy base with grain. The coloured glows live on two oversized pseudo layers
     (below) so they can drift on the compositor without repainting the grain. */
  .cta-band-wrap .sheet-card {
    border-color: rgba(255, 255, 255, 0.08);
    background-color: #0c2635;
    background-image: var(--grain), linear-gradient(160deg, #123447 0%, #0a1f2b 100%);
  }

  /* The layers extend 12% past the card (clipped by its overflow), so the gradient centres below
     are given relative to the larger box: card corner = 10% / 90%. */
  .cta-band-wrap .sheet-card::before,
  .cta-band-wrap .sheet-card::after {
    content: '';
    position: absolute;
    inset: -12%;
    z-index: 0;
    pointer-events: none;
  }

  /* A green wash bottom-left. */
  .cta-band-wrap .sheet-card::before {
    background-image: radial-gradient(56% 86% at 10% 90%, rgba(64, 170, 74, 0.16), transparent 70%);
  }

  /* A cool glow in the middle and a faint yellow wash top-right. */
  .cta-band-wrap .sheet-card::after {
    background-image:
      radial-gradient(50% 74% at 90% 10%, rgba(250, 195, 68, 0.08), transparent 70%),
      radial-gradient(66% 90% at 50% 50%, rgba(108, 190, 228, 0.2), transparent 72%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta-band-wrap .sheet-card::before {
      animation: cta-glow-a 22s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }

    .cta-band-wrap .sheet-card::after {
      animation: cta-glow-b 26s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }
  }

  @keyframes cta-glow-a {
    from {
      transform: translate3d(-4%, 3%, 0);
    }
    to {
      transform: translate3d(9%, -8%, 0);
    }
  }

  @keyframes cta-glow-b {
    from {
      transform: translate3d(5%, -3%, 0);
    }
    to {
      transform: translate3d(-8%, 6%, 0);
    }
  }

  /* No plate inset or white fill: the navy card itself is the sheet. Its outer box runs from grid
     line to grid line inclusive: 1px up/left onto the row line above, 1px wider so the right border
     lands on the next column line, and 1px taller so the bottom border lands on a row line. Whole
     rows are measured by the Sheet snap script from the card's own height. */
  .cta-band-wrap.has-grid .sheet {
    padding: 0;
    top: -1px;
    margin-bottom: -1px;
    width: calc(100% + 1px);
    min-height: calc(var(--rows, 0) * var(--cell-h) + 1px);
    background: transparent;
    box-shadow: none;
  }

  /* The closing card runs half a grid column wider on each side than the other sheets. Its section's grid
     is shifted by half a column to match, so both edges still land on column lines. */
  @media (min-width: 1332px) {
    .cta-band-wrap .sheet-frame {
      width: 1300px;
    }

    .cta-band-wrap.has-grid::before {
      background-position: 50% -1px;
    }
  }

  .cta-band-wrap .sheet-body {
    padding: 0;
  }
</style>

<style>
  .cta-band {
    --pad: clamp(24px, 4.6vw, 64px);
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: clamp(40px, 5.4vw, 72px) var(--pad);
  }

  .cta-band h2 {
    max-width: 17ch;
    color: #fff;
  }

  /* "template" pill, as in the home H1, with a translucent fill for the navy card. */
  .title-pill {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.105em;
    padding: 0 0.185em 0 0.123em;
    border: 1px solid transparent;
    border-radius: 0.37em;
    color: var(--green);
  }

  .title-pill::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  /* Excel and Google Sheets marks stacked in one box, swapping slowly. Static Excel mark without motion. */
  .title-icons {
    position: relative;
    flex: none;
    width: 0.74em;
    height: 0.74em;
    perspective: 3em;
  }

  .title-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .title-icon-sheets {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .title-icon-excel {
      animation: cta-icon-excel 8s cubic-bezier(0.23, 1, 0.32, 1) 1s infinite backwards;
    }

    .title-icon-sheets {
      animation: cta-icon-sheets 8s cubic-bezier(0.23, 1, 0.32, 1) 1s infinite backwards;
    }
  }

  @keyframes cta-icon-excel {
    0%,
    40% {
      opacity: 1;
      transform: rotateY(0deg) scale(1);
    }
    48%,
    90% {
      opacity: 0;
      transform: rotateY(-80deg) scale(0.85);
    }
    100% {
      opacity: 1;
      transform: rotateY(0deg) scale(1);
    }
  }

  @keyframes cta-icon-sheets {
    0%,
    42% {
      opacity: 0;
      transform: rotateY(80deg) scale(0.85);
    }
    50%,
    90% {
      opacity: 1;
      transform: rotateY(0deg) scale(1);
    }
    98%,
    100% {
      opacity: 0;
      transform: rotateY(80deg) scale(0.85);
    }
  }

  .cta-band-text {
    max-width: 32rem;
    margin: 0;
    font-size: clamp(1rem, 1.45vw, 1.125rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  .cta-band-actions {
    margin-top: 8px;
  }

  /* Light button on navy: white fill, navy label, no hairline. */
  .cta-band-actions :global(.cta-band-btn) {
    --btn-bg: #fff;
    --btn-fg: var(--navy);
    --btn-border: #fff;
    background-image: linear-gradient(rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.05));
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-band-actions :global(.cta-band-btn:hover) {
      --btn-bg: var(--tint-blue);
      --btn-border: var(--tint-blue);
    }
  }

  .cta-band-ticks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .cta-band-ticks li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.84);
  }

  /* Square rounded checkboxes like .list-check: green, blue, yellow, white check. */
  .cta-band-ticks li::before {
    content: '';
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: var(--icon-check) center / 12px no-repeat, var(--sheen);
    background-color: var(--green);
  }

  .cta-band-ticks li:nth-child(3n + 2)::before {
    background-color: var(--blue);
  }

  .cta-band-ticks li:nth-child(3n + 3)::before {
    background-color: var(--yellow);
  }

  @media (max-width: 479px) {
    .cta-band-actions,
    .cta-band-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
