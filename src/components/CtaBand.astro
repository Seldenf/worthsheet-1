---
/**
 * Closing CTA band: a navy card with grain and soft glows, centred copy, a light button and three
 * trust ticks below it. A passed `art` slot is ignored.
 */
import Button from './Button.astro';
import Sheet from './Sheet.astro';
import { STATS } from '../config';

interface Props {
  title?: string;
  text?: string;
  class?: string;
}

const {
  title = 'Get the free PFS template',
  text = `Build a bank-ready personal financial statement in Google Sheets or Excel. Free, with ${STATS.assetCategories} asset and ${STATS.liabilityCategories} liability categories built in.`,
  class: className,
} = Astro.props;

const ticks = ['Free forever', 'Google Sheets & Excel', '9,000+ downloads'];
---

<Sheet
  class={['cta-band-wrap', className].filter(Boolean).join(' ')}
  tone="cta"
  grid
  rowsBelow={2}
  seed={11}
  aria-labelledby="cta-band-title"
>
  <div class="cta-band">
    <h2 id="cta-band-title">{title}</h2>
    <p class="cta-band-text">{text}</p>
    <div class="cta-band-actions">
      <Button href="/download/" variant="secondary" size="lg" class="cta-band-btn">Get the free template</Button>
    </div>
    <ul class="cta-band-ticks">
      {
        ticks.map((t) => (
          <li>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <circle cx="8" cy="8" r="8" fill="#40aa4a"></circle>
              <path
                d="M4.6 8.3l2.2 2.2 4.6-4.9"
                fill="none"
                stroke="#fff"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>{t}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Sheet>

<style is:global>
  /* Card surface: navy, a cool glow, a green wash bottom-left, a faint yellow wash top-right, grain. */
  .cta-band-wrap .sheet-card {
    border-color: rgba(255, 255, 255, 0.08);
    background-color: #0c2635;
    background-image:
      var(--grain),
      radial-gradient(55% 80% at 50% 50%, rgba(108, 190, 228, 0.2), transparent 72%),
      radial-gradient(45% 70% at 0% 100%, rgba(64, 170, 74, 0.16), transparent 70%),
      radial-gradient(40% 60% at 100% 0%, rgba(250, 195, 68, 0.08), transparent 70%),
      linear-gradient(160deg, #123447 0%, #0a1f2b 100%);
  }

  /* No plate inset: the navy card itself is the sheet, so its edges sit on the page grid lines. */
  .cta-band-wrap .sheet {
    padding: 0;
  }

  .cta-band-wrap .sheet-body {
    padding: 0;
  }
</style>

<style>
  .cta-band {
    --pad: clamp(24px, 4.6vw, 64px);
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: clamp(40px, 5.4vw, 72px) var(--pad);
  }

  .cta-band h2 {
    max-width: 17ch;
    color: #fff;
  }

  .cta-band-text {
    max-width: 32rem;
    margin: 0;
    font-size: clamp(1rem, 1.45vw, 1.125rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  .cta-band-actions {
    margin-top: 8px;
  }

  /* Light button on navy: white fill, navy label, no hairline. */
  .cta-band-actions :global(.cta-band-btn) {
    --btn-bg: #fff;
    --btn-fg: var(--navy);
    --btn-border: #fff;
    background-image: linear-gradient(rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.05));
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-band-actions :global(.cta-band-btn:hover) {
      --btn-bg: var(--tint-blue);
      --btn-border: var(--tint-blue);
    }
  }

  .cta-band-ticks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .cta-band-ticks li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.84);
  }

  .cta-band-ticks svg {
    flex: none;
  }

  @media (max-width: 479px) {
    .cta-band-actions,
    .cta-band-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
