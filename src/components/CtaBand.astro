---
import Button from './Button.astro';
import { STATS } from '../config';

interface Props {
  title?: string;
  text?: string;
  class?: string;
}

const {
  title = 'Get the free PFS template',
  text = `Build a bank-ready personal financial statement in Google Sheets or Excel. Free, with ${STATS.assetCategories} asset and ${STATS.liabilityCategories} liability categories built in.`,
  class: className,
} = Astro.props;
---

<section class:list={['cta-band-wrap', className]} aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-band">
      <div class="cta-copy">
        <h2 id="cta-band-title">{title}</h2>
        <p class="lead">{text}</p>
        <div class="cta-actions">
          <Button href="/download/" variant="primary" size="lg">Get the free template</Button>
        </div>
      </div>
      <div class="cta-art"><slot name="art" /></div>
    </div>
  </div>
</section>

<style>
  .cta-band-wrap {
    padding-block: clamp(48px, 8vw, 96px);
  }

  .cta-band {
    display: grid;
    gap: 32px;
    align-items: center;
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--radius-lg);
    background: var(--tint-blue);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .cta-band:has(.cta-art:empty) {
    grid-template-columns: 1fr;
  }

  .cta-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .cta-actions {
    margin-top: 8px;
  }

  .cta-art:empty {
    display: none;
  }

  @media (min-width: 860px) {
    .cta-band:has(.cta-art:not(:empty)) {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
