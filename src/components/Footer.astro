---
import { SITE_NAME } from '../config';
import { url } from '../lib/url';

const columns = [
  {
    title: 'Template',
    links: [
      { name: 'Free PFS template', path: '/download/' },
      { name: 'SBA Form 413', path: '/sba-form-413/' },
      { name: 'PFS Example', path: '/personal-financial-statement-example/' },
      { name: 'What is a PFS?', path: '/what-is-a-personal-financial-statement/' },
    ],
  },
  {
    title: 'Calculators',
    links: [
      { name: 'Mortgage Calculator', path: '/mortgage-calculator/' },
      { name: 'Net Worth Calculator', path: '/net-worth-calculator/' },
      { name: 'Debt-to-Income Calculator', path: '/debt-to-income-ratio-calculator/' },
      { name: 'Home Affordability', path: '/how-much-house-can-i-afford/' },
      { name: 'Mortgage Readiness', path: '/mortgage-readiness-assessment/' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { name: 'Banks by State', path: '/banks/' },
      { name: 'Glossary', path: '/glossary/' },
      { name: 'Blog', path: '/blog/' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href={url('/')} aria-label={`${SITE_NAME} home`}>
          <svg class="logo-mark" viewBox="14 14 36 36" width="22" height="22" aria-hidden="true">
            <rect class="sq sq-tl" x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a"></rect>
            <rect class="sq sq-tr" x="34" y="14" width="16" height="16" rx="4" fill="#fac344"></rect>
            <rect class="sq sq-br" x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4"></rect>
            <rect class="sq sq-bl" x="14" y="34" width="16" height="16" rx="4" fill="#0c2635"></rect>
          </svg>
          <span class="logo-text">{SITE_NAME}</span>
        </a>
        <p class="muted">
          A free personal financial statement template for Google Sheets and Excel.
        </p>
      </div>
      {
        columns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <p class="footer-title">{col.title}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={url(l.path)}>{l.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <nav class="footer-col" aria-label="Legal">
        <p class="footer-title">Legal</p>
        <ul>
          <li><a href={url('/privacy-policy/')}>Privacy Policy</a></li>
          <li><button type="button" class="link-button" data-consent-open>Cookie settings</button></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© {year} {SITE_NAME}</p>
      <p>{SITE_NAME} provides educational tools, not financial, legal or tax advice.</p>
    </div>
  </div>
</footer>

<style>
  /* Same paper background as the page, aligned to the sheet width and body padding (see Sheet.astro). */
  .site-footer {
    padding: clamp(24px, 4vw, 48px) 0 16px;
    border-top: 1px solid var(--line);
    background: var(--paper);
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .footer-inner {
    width: min(1200px, 100% - 32px);
    margin-inline: auto;
    padding: 0 clamp(24px, 4.6vw, 64px);
  }

  .footer-grid {
    display: grid;
    gap: 32px 24px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer-brand {
    grid-column: 1 / -1;
    max-width: 22em;
  }

  .footer-brand p {
    margin-top: 12px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-mark {
      transition: scale 150ms var(--ease-out);
    }

    .logo:active .logo-mark {
      scale: 0.96;
    }

    .logo-mark .sq {
      transition: translate 300ms var(--ease-in-out);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .logo:hover .sq-tl {
      translate: 20px 0;
    }

    .logo:hover .sq-tr {
      translate: 0 20px;
    }

    .logo:hover .sq-br {
      translate: -20px 0;
    }

    .logo:hover .sq-bl {
      translate: 0 -20px;
    }
  }

  .footer-title {
    margin-bottom: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .footer-col a,
  .link-button {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    text-decoration: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 150ms var(--ease-out);
  }

  @media (pointer: coarse) {
    .footer-col a,
    .link-button {
      min-height: 44px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-col a:hover,
    .link-button:hover {
      color: var(--ink);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .footer-col a:focus-visible,
  .link-button:focus-visible,
  .logo:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(32px, 5vw, 56px);
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>
