---
interface Props {
  id?: string;
  tone?: 'white' | 'paper' | 'surface' | 'blue' | 'green' | 'yellow' | 'cream';
  /** Wrap content in `.container` (default). Set false for full-bleed content. */
  container?: boolean;
  /** Reduced vertical padding. */
  tight?: boolean;
  class?: string;
  'aria-labelledby'?: string;
}

const {
  id,
  tone = 'paper',
  container = true,
  tight = false,
  class: className,
  'aria-labelledby': labelledby,
} = Astro.props;
---

<section id={id} aria-labelledby={labelledby} class:list={['section', `tone-${tone}`, { 'section-tight': tight }, className]}>
  {
    container ? (
      <div class="container">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
