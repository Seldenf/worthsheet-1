---
import { SITE_NAME } from '../config';
import { url } from '../lib/url';
import Button from './Button.astro';

const calculators = [
  {
    name: 'Mortgage Calculator',
    path: '/mortgage-calculator/',
    desc: 'Monthly payment & amortization',
    tint: 'blue',
    icon: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  },
  {
    name: 'Net Worth Calculator',
    path: '/net-worth-calculator/',
    desc: 'Assets minus liabilities',
    tint: 'green',
    icon: '<path d="M12 4v16"/><path d="M6 20h12"/><path d="M5 7h14"/><path d="M5 7l-3 7a3 3 0 0 0 6 0z"/><path d="M19 7l-3 7a3 3 0 0 0 6 0z"/>',
  },
  {
    name: 'Debt-to-Income Calculator',
    path: '/debt-to-income-ratio-calculator/',
    desc: 'Front-end & back-end DTI',
    tint: 'cream',
    icon: '<path d="M19 5L5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>',
  },
  {
    name: 'Home Affordability Calculator',
    path: '/how-much-house-can-i-afford/',
    desc: 'How much house you can afford',
    tint: 'pink',
    icon: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9"/><path d="M17 6l3 3"/><path d="M14 9l2 2"/>',
  },
  {
    name: 'Mortgage Readiness Assessment',
    path: '/mortgage-readiness-assessment/',
    desc: 'Score 5 criteria lenders check',
    tint: 'green',
    featured: true,
    icon: '<path d="M4 16a8 8 0 1 1 16 0"/><path d="M12 16l4-4"/>',
  },
];

const links = [
  { name: 'Banks', path: '/banks/' },
  { name: 'Glossary', path: '/glossary/' },
  { name: 'Blog', path: '/blog/' },
];

const current = Astro.url.pathname;
const isCurrent = (path: string) => current === url(path);
const calculatorsActive = calculators.some((c) => current.startsWith(url(c.path)));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="logo" href={url('/')} aria-label={`${SITE_NAME} home`}>
      <svg class="logo-mark" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
        <rect width="64" height="64" rx="16" fill="#2e2926"></rect>
        <rect class="sq sq-tl" x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a"></rect>
        <rect class="sq sq-tr" x="34" y="14" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
        <rect class="sq sq-br" x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4"></rect>
        <rect class="sq sq-bl" x="14" y="34" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
      </svg>
      <span class="logo-text">{SITE_NAME}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <svg class="menu-icon" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
        <path class="bar-a" d="M2 6h14"></path>
        <path class="bar-b" d="M2 12h14"></path>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main" data-nav>
      <ul class="nav-list">
        <li>
          <a href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Template</a>
        </li>
        <li class="has-dropdown">
          <button
            class:list={['dropdown-toggle', { active: calculatorsActive }]}
            type="button"
            aria-expanded="false"
            aria-controls="nav-calculators"
            data-dropdown-toggle
          >
            Calculators
            <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
              <path
                d="M1 1.5l5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul id="nav-calculators" class="dropdown" hidden>
            {
              calculators.map((c) => (
                <li class:list={[{ featured: c.featured }]}>
                  <a
                    class:list={['dd-item', { 'is-featured': c.featured }]}
                    href={url(c.path)}
                    aria-current={isCurrent(c.path) ? 'page' : undefined}
                  >
                    <span class:list={['dd-icon', `dd-icon--${c.tint}`]} aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={c.icon}
                      />
                    </span>
                    <span class="dd-text">
                      <span class="dd-title">{c.name}</span>
                      <span class="dd-desc">{c.desc}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          links.map((l) => (
            <li>
              <a href={url(l.path)} aria-current={current.startsWith(url(l.path)) ? 'page' : undefined}>
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/download/" variant="primary" size="sm" class="nav-cta">
        Get the free template
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 252, 250, 0.88);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .logo-mark {
    transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .logo:active .logo-mark {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Four squares travel clockwise around the 2x2 grid as one rigid ring. Cells are 20 user units apart.
       Each 3.2s cycle: hold at a corner 0–18%, move to the next corner 18–25%, repeat. */
    .logo-mark .sq {
      animation-duration: 3.2s;
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
      animation-iteration-count: infinite;
      animation-play-state: paused;
    }

    .logo-mark .sq-tl {
      animation-name: logo-fly-tl;
    }

    .logo-mark .sq-tr {
      animation-name: logo-fly-tr;
    }

    .logo-mark .sq-br {
      animation-name: logo-fly-br;
    }

    .logo-mark .sq-bl {
      animation-name: logo-fly-bl;
    }

    @media (hover: hover) and (pointer: fine) {
      .logo:hover .logo-mark .sq {
        animation-play-state: running;
      }
    }

    .logo:focus-visible .logo-mark .sq {
      animation-play-state: running;
    }
  }

  /* Paths: TL(0,0) → TR(20,0) → BR(20,20) → BL(0,20) → TL, expressed relative to each square's start corner. */
  @keyframes logo-fly-tl {
    0%, 18% { translate: 0 0; }
    25%, 43% { translate: 20px 0; }
    50%, 68% { translate: 20px 20px; }
    75%, 93% { translate: 0 20px; }
    100% { translate: 0 0; }
  }

  @keyframes logo-fly-tr {
    0%, 18% { translate: 0 0; }
    25%, 43% { translate: 0 20px; }
    50%, 68% { translate: -20px 20px; }
    75%, 93% { translate: -20px 0; }
    100% { translate: 0 0; }
  }

  @keyframes logo-fly-br {
    0%, 18% { translate: 0 0; }
    25%, 43% { translate: -20px 0; }
    50%, 68% { translate: -20px -20px; }
    75%, 93% { translate: 0 -20px; }
    100% { translate: 0 0; }
  }

  @keyframes logo-fly-bl {
    0%, 18% { translate: 0 0; }
    25%, 43% { translate: 0 -20px; }
    50%, 68% { translate: 20px -20px; }
    75%, 93% { translate: 20px 0; }
    100% { translate: 0 0; }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-list > li {
    position: relative;
  }

  .nav-list a,
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-list a:hover,
  .dropdown-toggle:hover,
  .dropdown-toggle[aria-expanded='true'] {
    background: var(--beige-soft);
  }

  .nav-list a[aria-current='page'],
  .dropdown-toggle.active {
    background: var(--beige-soft);
  }

  .dropdown-toggle svg {
    transition: transform 0.15s ease;
  }

  .dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    translate: -50% 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    width: 560px;
    max-width: calc(100vw - 2 * var(--gutter));
    margin: 0;
    padding: 10px;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 1px 0 var(--line), 0 24px 48px -20px rgba(46, 41, 38, 0.28);
    transform-origin: top;
  }

  .dropdown[hidden] {
    display: none;
  }

  .dropdown:not([hidden]) {
    animation: dropdown-in 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .dropdown li.featured {
    grid-column: 1 / -1;
  }

  .dropdown .dd-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    text-decoration: none;
  }

  .dropdown .dd-item.is-featured {
    background: var(--tint-green);
  }

  .dropdown .dd-item[aria-current='page'] {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .dd-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }

  .dd-icon--blue {
    background: var(--tint-blue);
    color: #6cbee4;
  }

  .dd-icon--green {
    background: var(--tint-green);
    color: #40aa4a;
  }

  .dd-icon--cream {
    background: var(--tint-cream);
    color: var(--ink);
  }

  .dd-icon--pink {
    background: var(--tint-pink);
    color: var(--ink);
  }

  .dropdown .dd-item.is-featured .dd-icon {
    background: var(--white);
  }

  .dd-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .dd-title {
    font-size: 0.9375rem;
    font-weight: 560;
    line-height: 1.3;
  }

  .dd-desc {
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .dropdown .dd-item:hover {
      background: var(--surface);
    }
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--white);
  }

  .menu-icon path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform 0.2s ease;
  }

  .bar-a {
    transform-origin: 9px 6px;
  }

  .bar-b {
    transform-origin: 9px 12px;
  }

  .menu-toggle[aria-expanded='true'] .bar-a {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bar-b {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 899px) {
    :global(html.js) .menu-toggle {
      display: inline-flex;
    }

    :global(html.js) .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 16px var(--gutter) 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }

    :global(html.js) .site-nav.open {
      display: flex;
    }

    .site-nav {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px 16px;
    }

    .header-inner {
      flex-wrap: wrap;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .nav-list a,
    .dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: 12px 14px;
    }

    .dropdown {
      position: static;
      left: auto;
      translate: none;
      width: auto;
      max-width: none;
      grid-template-columns: 1fr;
      gap: 2px;
      margin: 4px 0 4px 12px;
      padding: 0 0 0 12px;
      border: 0;
      border-left: 1px solid var(--line-strong);
      border-radius: 0;
      box-shadow: none;
      background: transparent;
    }

    :global(.nav-cta) {
      width: 100%;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuToggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');
  const dropdownToggle = header?.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
  const dropdown = dropdownToggle
    ? document.getElementById(dropdownToggle.getAttribute('aria-controls') ?? '')
    : null;

  function setDropdown(open: boolean) {
    if (!dropdownToggle || !dropdown) return;
    dropdownToggle.setAttribute('aria-expanded', String(open));
    dropdown.hidden = !open;
  }

  function setMenu(open: boolean) {
    if (!menuToggle || !nav) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    if (!open) setDropdown(false);
  }

  menuToggle?.addEventListener('click', () => {
    setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  dropdownToggle?.addEventListener('click', () => {
    setDropdown(dropdownToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (dropdownToggle && !dropdownToggle.parentElement?.contains(target)) setDropdown(false);
  });

  header?.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const dropdownOpen = dropdownToggle?.getAttribute('aria-expanded') === 'true';
    const menuOpen = menuToggle?.getAttribute('aria-expanded') === 'true';
    if (dropdownOpen) {
      setDropdown(false);
      dropdownToggle?.focus();
    } else if (menuOpen) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
