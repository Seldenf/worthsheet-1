---
import { SITE_NAME } from '../config';
import { url } from '../lib/url';
import Button from './Button.astro';
import IsoIcon from './IsoIcon.astro';

const calculators = [
  { name: 'Mortgage Calculator', short: 'Mortgage', path: '/mortgage-calculator/', desc: 'Monthly payment & amortization', icon: 'house', tone: 'blue' },
  { name: 'Net Worth Calculator', short: 'Net Worth', path: '/net-worth-calculator/', desc: 'Assets minus liabilities', icon: 'scale', tone: 'green' },
  { name: 'Debt-to-Income Calculator', short: 'Debt-to-Income (DTI)', path: '/debt-to-income-ratio-calculator/', desc: 'Front-end & back-end DTI', icon: 'percent', tone: 'yellow' },
  { name: 'Home Affordability Calculator', short: 'Home Affordability', path: '/how-much-house-can-i-afford/', desc: 'How much house you can afford', icon: 'key', tone: 'pink' },
] as const;

const footLinks = [
  { name: 'Find banks by ZIP', path: '/banks/', icon: 'bank', tone: 'blue' },
  { name: 'PFS example', path: '/personal-financial-statement-example/', icon: 'sheet', tone: 'yellow' },
  { name: 'SBA Form 413', path: '/sba-form-413/', icon: 'document', tone: 'green' },
] as const;

const featured = {
  name: 'Mortgage Readiness Assessment',
  path: '/mortgage-readiness-assessment/',
};

const links = [
  { name: 'Banks', path: '/banks/' },
  { name: 'Glossary', path: '/glossary/' },
  { name: 'Blog', path: '/blog/' },
];

const current = Astro.url.pathname;
const isCurrent = (path: string) => current === url(path);
const calculatorsActive = [...calculators, featured].some((c) => current.startsWith(url(c.path)));

---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="logo" href={url('/')} aria-label={`${SITE_NAME} home`}>
      <svg class="logo-mark" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
        <rect width="64" height="64" rx="16" fill="#edecea" fill-opacity="0.25"></rect>
        <rect class="sq sq-tl" x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a"></rect>
        <rect class="sq sq-tr" x="34" y="14" width="16" height="16" rx="4" fill="#fac344"></rect>
        <rect class="sq sq-br" x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4"></rect>
        <rect class="sq sq-bl" x="14" y="34" width="16" height="16" rx="4" fill="#0c2635"></rect>
      </svg>
      <span class="logo-text">{SITE_NAME}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <svg class="menu-icon" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
        <path class="bar-a" d="M2 6h14"></path>
        <path class="bar-b" d="M2 12h14"></path>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main" data-nav>
      <ul class="nav-list">
        <li class="has-dropdown">
          <button
            class:list={['dropdown-toggle', { active: calculatorsActive }]}
            type="button"
            aria-expanded="false"
            aria-controls="nav-calculators"
            data-dropdown-toggle
          >
            Calculators
            <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
              <path
                d="M1 1.5l5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <div id="nav-calculators" class="dropdown" hidden>
            <div class="dropdown-inner">
            <ul class="mega-grid">
              {
                calculators.map((c, i) => (
                  <li>
                    <a
                      class="mega-item"
                      data-tone={c.tone}
                      href={url(c.path)}
                      aria-label={c.name}
                      title={c.name}
                      aria-current={isCurrent(c.path) ? 'page' : undefined}
                      style={`--i:${i}`}
                    >
                      <IsoIcon class="mega-icon" icon={c.icon} tone={c.tone} size={52} />
                      <span class="mega-text">
                        <span class="mega-title">{c.short}</span>
                        <span class="mega-desc">{c.desc}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a
              class="mega-feature"
              href={url(featured.path)}
              aria-current={isCurrent(featured.path) ? 'page' : undefined}
              style="--i:4"
            >
              <IsoIcon class="mega-icon" icon="gauge" tone="white" size={88} />
              <span class="mega-feature-text">
                <span class="mega-feature-title">{featured.name}</span>
                <span class="mega-badge">Featured</span>
                <span class="mega-feature-desc">Score your credit, income, LTV, DTI and PFS on the 5 criteria lenders check.</span>
              </span>
              <span class="mega-feature-cta">Start the assessment →</span>
            </a>
            <div class="mega-foot">
              <ul class="mega-foot-links">
                {
                  footLinks.map((l) => (
                    <li>
                      <a class="mega-foot-link" href={url(l.path)}>
                        <IsoIcon icon={l.icon} tone={l.tone} size={28} />
                        {l.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a class="mega-cta" href={url('/download/')}>Get the free template</a>
            </div>
            </div>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a href={url(l.path)} aria-current={current.startsWith(url(l.path)) ? 'page' : undefined}>
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/download/" variant="primary" size="sm" class="nav-cta">
        Get the free template
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 252, 250, 0.88);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Logo: on hover the four squares step one cell clockwise as a ring, and step back on leave.
     A transition (not a looping keyframe) so it reverses smoothly from wherever it is. */
  .logo {
    -webkit-tap-highlight-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-mark {
      transition: scale 150ms var(--ease-out);
    }

    .logo:active .logo-mark {
      scale: 0.96;
    }

    .logo-mark .sq {
      transition: translate 300ms var(--ease-in-out);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .logo:hover .sq-tl {
      translate: 20px 0;
    }

    .logo:hover .sq-tr {
      translate: 0 20px;
    }

    .logo:hover .sq-br {
      translate: -20px 0;
    }

    .logo:hover .sq-bl {
      translate: 0 -20px;
    }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-list > li {
    position: static;
  }

  .nav-list a,
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      background-color 0.2s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.2s cubic-bezier(0.23, 1, 0.32, 1);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-list > li > a:hover,
  .dropdown-toggle:hover,
  .dropdown-toggle[aria-expanded='true'],
  .nav-list > li > a[aria-current='page'],
  .dropdown-toggle.active {
    background: var(--white);
    box-shadow: inset 0 0 0 1px rgba(12, 38, 53, 0.55);
  }

  .dropdown-toggle svg {
    transition: transform 0.15s ease;
  }

  .dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    translate: -50% 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 8px;
    width: 840px;
    max-width: calc(100vw - 32px);
    margin: 0;
    padding: 12px;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 2px 6px rgba(46, 41, 38, 0.06), 0 32px 64px -24px rgba(46, 41, 38, 0.34);
    transform-origin: top;
  }

  .dropdown[hidden] {
    display: none;
  }

  .dropdown-inner {
    display: contents;
  }

  .dropdown .mega-grid {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dropdown .mega-grid > li {
    min-width: 0;
    display: flex;
  }

  .dropdown .mega-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 16px;
    flex: 1 1 auto;
    height: 100%;
    border-radius: 14px;
    background: transparent;
    color: var(--ink);
    text-decoration: none;
  }

  .dropdown .mega-item[data-tone='blue'] {
    --edge: rgba(108, 190, 228, 0.9);
  }

  .dropdown .mega-item[data-tone='green'] {
    --edge: rgba(64, 170, 74, 0.85);
  }

  .dropdown .mega-item[data-tone='yellow'] {
    --edge: rgba(250, 195, 68, 0.95);
  }

  .dropdown .mega-item[data-tone='pink'] {
    --edge: rgba(224, 127, 184, 0.85);
  }

  .dropdown .mega-item[aria-current='page'] {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .mega-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mega-title {
    font-size: 1rem;
    font-weight: 580;
    line-height: 1.25;
    white-space: nowrap;
  }

  .mega-desc {
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--muted);
  }

  .dropdown .mega-feature {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 10px;
    padding: 20px;
    border-radius: 16px;
    --edge: rgba(64, 170, 74, 0.85);
    color: var(--ink);
    font-size: 1rem;
    text-decoration: none;
  }

  .dropdown .mega-feature,
  .dropdown .mega-feature:hover,
  .dropdown .mega-feature[aria-current='page'] {
    background: var(--tint-green);
  }

  .dropdown .mega-feature .mega-icon {
    align-self: center;
  }

  .mega-feature-title {
    font-size: 1rem;
    font-weight: 580;
    line-height: 1.25;
  }

  .mega-feature-desc {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .mega-feature-cta {
    margin-top: auto;
    padding-top: 4px;
    font-size: 0.875rem;
    font-weight: 560;
  }

  .mega-feature-text {
    display: contents;
  }

  .mega-badge {
    display: none;
  }

  .dropdown .mega-foot {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin: 4px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  .mega-foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dropdown .mega-foot-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .dropdown .mega-cta {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .dropdown .mega-cta:hover {
    background: var(--ink);
  }

  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mega-stagger {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .dropdown .mega-item[data-tone='blue'] {
    --item-tint: rgba(108, 190, 228, 0.14);
  }

  .dropdown .mega-item[data-tone='green'] {
    --item-tint: rgba(64, 170, 74, 0.12);
  }

  .dropdown .mega-item[data-tone='yellow'] {
    --item-tint: rgba(250, 195, 68, 0.16);
  }

  .dropdown .mega-item[data-tone='pink'] {
    --item-tint: rgba(243, 166, 210, 0.18);
  }

  .dropdown .mega-item:focus-visible {
    background: var(--item-tint, var(--surface));
  }

  @media (hover: hover) and (pointer: fine) {
    .dropdown .mega-item:hover {
      background: var(--item-tint, var(--surface));
    }

    .dropdown .mega-foot-link:hover {
      background: transparent;
      text-decoration: underline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dropdown:not([hidden]) {
      animation: dropdown-in 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .dropdown:not([hidden]) .mega-item,
    .dropdown:not([hidden]) .mega-feature {
      animation: mega-stagger 200ms cubic-bezier(0.23, 1, 0.32, 1) both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--white);
  }

  .menu-icon path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform 0.2s ease;
  }

  .bar-a {
    transform-origin: 9px 6px;
  }

  .bar-b {
    transform-origin: 9px 12px;
  }

  .menu-toggle[aria-expanded='true'] .bar-a {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bar-b {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 899px) {
    :global(html.js) .menu-toggle {
      display: inline-flex;
    }

    :global(html.js) .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-h));
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 16px clamp(20px, 5vw, 40px) 32px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    :global(html.js) .site-nav.open {
      display: flex;
    }

    .site-nav {
      flex-wrap: wrap;
      justify-content: flex-start;
      align-content: flex-start;
      gap: 8px 16px;
    }

    .header-inner {
      flex-wrap: wrap;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .nav-list a,
    .dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: 12px 14px;
    }

    .dropdown {
      position: static;
      left: auto;
      translate: none;
      width: 100%;
      min-width: 0;
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin: 0;
      grid-template-rows: 1fr;
      transition:
        grid-template-rows 300ms cubic-bezier(0.23, 1, 0.32, 1),
        visibility 300ms cubic-bezier(0.23, 1, 0.32, 1);
      padding: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: transparent;
    }

    .dropdown[hidden] {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
    }

    .dropdown-inner {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 0;
      overflow: hidden;
    }

    .dropdown:not([hidden]) {
      animation: none;
    }

    .dropdown-toggle svg {
      transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .dropdown-toggle[aria-expanded='true'],
    .dropdown-toggle.active {
      background: rgba(12, 38, 53, 0.04);
      box-shadow: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .dropdown,
      .dropdown-toggle svg {
        transition: none;
      }
    }

    .dropdown .mega-grid {
      grid-column: 1;
      grid-row: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
      width: 100%;
      min-width: 0;
    }

    .dropdown .mega-grid > li,
    .dropdown .mega-item,
    .dropdown .mega-feature,
    .dropdown .mega-foot,
    .dropdown .mega-foot-links,
    .dropdown .mega-foot-link,
    .dropdown .mega-cta {
      min-width: 0;
      width: 100%;
    }

    .dropdown .mega-item :global(svg.iso-ico) {
      width: 40px;
      height: 34px;
    }

    .dropdown .mega-item,
    .dropdown .mega-feature,
    .dropdown .mega-foot-link {
      justify-content: flex-start;
    }

    .dropdown .mega-feature {
      grid-column: 1;
      grid-row: auto;
    }

    .dropdown .mega-foot {
      grid-column: 1;
      grid-row: auto;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      padding: 12px 0 0;
    }

    .mega-foot-links {
      flex-direction: column;
      gap: 0;
    }

    .dropdown .mega-foot-link {
      padding: 8px 0;
      font-size: 0.9375rem;
    }

    .dropdown .mega-cta {
      justify-content: center;
      margin-left: 0;
      padding: 12px 16px;
    }

    :global(.nav-cta) {
      width: 100%;
    }

    .dropdown .mega-feature,
    .dropdown .mega-feature:hover,
    .dropdown .mega-feature[aria-current='page'] {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 12px;
      padding: 15px;
      border: 1px solid rgba(64, 170, 74, 0.45);
      border-radius: 12px;
      background: rgba(64, 170, 74, 0.06);
    }

    .dropdown .mega-feature :global(svg.iso-ico) {
      flex: none;
      width: 40px;
      height: 34px;
      align-self: center;
    }

    .mega-feature-text {
      display: block;
      flex: 1 1 auto;
      min-width: 0;
    }

    .mega-badge {
      display: inline-block;
      margin-left: 8px;
      padding: 1px 8px;
      border-radius: 999px;
      background: rgba(64, 170, 74, 0.14);
      color: #14551d;
      font-size: 0.6875rem;
      font-weight: 600;
      line-height: 1.6;
      letter-spacing: 0.02em;
      vertical-align: 1px;
    }

    .mega-feature-desc {
      display: block;
      margin-top: 2px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .mega-feature-cta {
      display: none;
    }

    :global(html.menu-open) {
      overflow: hidden;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuToggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');
  const dropdownToggle = header?.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
  const dropdown = dropdownToggle
    ? document.getElementById(dropdownToggle.getAttribute('aria-controls') ?? '')
    : null;

  function setDropdown(open: boolean) {
    if (!dropdownToggle || !dropdown) return;
    dropdownToggle.setAttribute('aria-expanded', String(open));
    dropdown.hidden = !open;
  }

  function setMenu(open: boolean) {
    if (!menuToggle || !nav) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    document.documentElement.classList.toggle('menu-open', open);
    if (!open) setDropdown(false);
  }

  menuToggle?.addEventListener('click', () => {
    setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  dropdownToggle?.addEventListener('click', () => {
    setDropdown(dropdownToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (dropdownToggle && !dropdownToggle.parentElement?.contains(target)) setDropdown(false);
  });

  header?.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const dropdownOpen = dropdownToggle?.getAttribute('aria-expanded') === 'true';
    const menuOpen = menuToggle?.getAttribute('aria-expanded') === 'true';
    if (dropdownOpen) {
      setDropdown(false);
      dropdownToggle?.focus();
    } else if (menuOpen) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
