---
import { SITE_NAME } from '../config';
import { url } from '../lib/url';
import Button from './Button.astro';
import IsoIcon from './IsoIcon.astro';

const calculators = [
  { name: 'Mortgage Calculator', short: 'Mortgage', path: '/mortgage-calculator/', desc: 'Monthly payment & amortization', icon: 'house', tone: 'blue' },
  { name: 'Net Worth Calculator', short: 'Net Worth', path: '/net-worth-calculator/', desc: 'Assets minus liabilities', icon: 'scale', tone: 'green' },
  { name: 'Debt-to-Income Calculator', short: 'Debt-to-Income (DTI)', path: '/debt-to-income-ratio-calculator/', desc: 'Front-end & back-end DTI', icon: 'percent', tone: 'yellow' },
  { name: 'Home Affordability Calculator', short: 'Home Affordability', path: '/how-much-house-can-i-afford/', desc: 'How much house you can afford', icon: 'key', tone: 'pink' },
] as const;

const footLinks = [
  { name: 'Find banks by ZIP', path: '/banks/', icon: 'bank', tone: 'blue' },
  { name: 'PFS example', path: '/personal-financial-statement-example/', icon: 'sheet', tone: 'yellow' },
  { name: 'SBA Form 413', path: '/sba-form-413/', icon: 'document', tone: 'green' },
] as const;

const featured = {
  name: 'Mortgage Readiness Assessment',
  path: '/mortgage-readiness-assessment/',
};

const links = [
  { name: 'Banks', path: '/banks/' },
  { name: 'Glossary', path: '/glossary/' },
  { name: 'Blog', path: '/blog/' },
];

const current = Astro.url.pathname;
const isCurrent = (path: string) => current === url(path);
const calculatorsActive = [...calculators, featured].some((c) => current.startsWith(url(c.path)));

---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="logo" href={url('/')} aria-label={`${SITE_NAME} home`}>
      <svg class="logo-mark" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
        <defs>
          <clipPath id="ws-logo-clip">
            <rect width="64" height="64" rx="16"></rect>
          </clipPath>
        </defs>
        <rect width="64" height="64" rx="16" fill="#2e2926"></rect>
        <g clip-path="url(#ws-logo-clip)">
          <g class="logo-squares">
            <g class="logo-sq" data-sq="tl">
              <rect x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a"></rect>
              <rect class="logo-cover" x="14" y="14" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
            </g>
            <g class="logo-sq" data-sq="tr">
              <rect x="34" y="14" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
            </g>
            <g class="logo-sq" data-sq="br">
              <rect x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4"></rect>
              <rect class="logo-cover" x="34" y="34" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
            </g>
            <g class="logo-sq" data-sq="bl">
              <rect x="14" y="34" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
            </g>
          </g>
          <g class="logo-row">
            <rect x="14" y="0" width="36" height="12" rx="3" fill="#fdfcfa"></rect>
            <rect x="31.5" y="0" width="1" height="12" fill="#2e2926" fill-opacity="0.18"></rect>
          </g>
          <g class="logo-row">
            <rect x="14" y="0" width="36" height="12" rx="3" fill="#fdfcfa"></rect>
            <rect x="31.5" y="0" width="1" height="12" fill="#2e2926" fill-opacity="0.18"></rect>
          </g>
          <g class="logo-row">
            <rect x="14" y="0" width="36" height="12" rx="3" fill="#fdfcfa"></rect>
            <rect x="31.5" y="0" width="1" height="12" fill="#2e2926" fill-opacity="0.18"></rect>
          </g>
          <g class="logo-row">
            <rect x="14" y="0" width="36" height="12" rx="3" fill="#fdfcfa"></rect>
            <rect x="31.5" y="0" width="1" height="12" fill="#2e2926" fill-opacity="0.18"></rect>
          </g>
        </g>
      </svg>
      <span class="logo-text">{SITE_NAME}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <svg class="menu-icon" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
        <path class="bar-a" d="M2 6h14"></path>
        <path class="bar-b" d="M2 12h14"></path>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main" data-nav>
      <ul class="nav-list">
        <li class="has-dropdown">
          <button
            class:list={['dropdown-toggle', { active: calculatorsActive }]}
            type="button"
            aria-expanded="false"
            aria-controls="nav-calculators"
            data-dropdown-toggle
          >
            Calculators
            <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
              <path
                d="M1 1.5l5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <div id="nav-calculators" class="dropdown" hidden>
            <ul class="mega-grid">
              {
                calculators.map((c, i) => (
                  <li>
                    <a
                      class="mega-item"
                      data-tone={c.tone}
                      href={url(c.path)}
                      aria-label={c.name}
                      title={c.name}
                      aria-current={isCurrent(c.path) ? 'page' : undefined}
                      style={`--i:${i}`}
                    >
                      <IsoIcon class="mega-icon" icon={c.icon} tone={c.tone} size={52} />
                      <span class="mega-text">
                        <span class="mega-title">{c.short}</span>
                        <span class="mega-desc">{c.desc}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a
              class="mega-feature"
              href={url(featured.path)}
              aria-current={isCurrent(featured.path) ? 'page' : undefined}
              style="--i:4"
            >
              <IsoIcon class="mega-icon" icon="gauge" tone="white" size={88} />
              <span class="mega-feature-title">{featured.name}</span>
              <span class="mega-feature-desc">Score your credit, income, LTV, DTI and PFS on the 5 criteria lenders check.</span>
              <span class="mega-feature-cta">Start the assessment →</span>
            </a>
            <div class="mega-foot">
              <ul class="mega-foot-links">
                {
                  footLinks.map((l) => (
                    <li>
                      <a class="mega-foot-link" href={url(l.path)}>
                        <IsoIcon icon={l.icon} tone={l.tone} size={28} />
                        {l.name}
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a class="mega-cta" href={url('/download/')}>Get the free template</a>
            </div>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a href={url(l.path)} aria-current={current.startsWith(url(l.path)) ? 'page' : undefined}>
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/download/" variant="primary" size="sm" class="nav-cta">
        Get the free template
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 252, 250, 0.88);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .logo-mark {
    transition: transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .logo:active .logo-mark {
    transform: scale(0.96);
  }

  /* Wrappers animated via WAAPI: user-space origin, no transform attribute on these elements. */
  .logo-sq,
  .logo-row {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  .logo-row {
    opacity: 0;
  }

  .logo-cover {
    opacity: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-list > li {
    position: static;
  }

  .nav-list a,
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-list a:hover,
  .dropdown-toggle:hover,
  .dropdown-toggle[aria-expanded='true'] {
    background: var(--beige-soft);
  }

  .nav-list a[aria-current='page'],
  .dropdown-toggle.active {
    background: var(--beige-soft);
  }

  .dropdown-toggle svg {
    transition: transform 0.15s ease;
  }

  .dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    translate: -50% 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 8px;
    width: 840px;
    max-width: calc(100vw - 32px);
    margin: 0;
    padding: 12px;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 2px 6px rgba(46, 41, 38, 0.06), 0 32px 64px -24px rgba(46, 41, 38, 0.34);
    transform-origin: top;
  }

  .dropdown[hidden] {
    display: none;
  }

  .dropdown .mega-grid {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dropdown .mega-grid > li {
    min-width: 0;
    display: flex;
  }

  .dropdown .mega-item {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 16px;
    flex: 1 1 auto;
    height: 100%;
    border-radius: 14px;
    background: transparent;
    color: var(--ink);
    text-decoration: none;
  }

  .dropdown .mega-item[data-tone='blue'] {
    --edge: rgba(108, 190, 228, 0.9);
  }

  .dropdown .mega-item[data-tone='green'] {
    --edge: rgba(64, 170, 74, 0.85);
  }

  .dropdown .mega-item[data-tone='yellow'] {
    --edge: rgba(250, 195, 68, 0.95);
  }

  .dropdown .mega-item[data-tone='pink'] {
    --edge: rgba(224, 127, 184, 0.85);
  }

  .dropdown .mega-item[aria-current='page'] {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .mega-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mega-title {
    font-size: 1rem;
    font-weight: 580;
    line-height: 1.25;
    white-space: nowrap;
  }

  .mega-desc {
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--muted);
  }

  .dropdown .mega-feature {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 10px;
    padding: 20px;
    border-radius: 16px;
    --edge: rgba(64, 170, 74, 0.85);
    color: var(--ink);
    font-size: 1rem;
    text-decoration: none;
  }

  .dropdown .mega-feature,
  .dropdown .mega-feature:hover,
  .dropdown .mega-feature[aria-current='page'] {
    background: var(--tint-green);
  }

  .dropdown .mega-feature .mega-icon {
    align-self: center;
  }

  .mega-feature-title {
    font-size: 1rem;
    font-weight: 580;
    line-height: 1.25;
  }

  .mega-feature-desc {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .mega-feature-cta {
    margin-top: auto;
    padding-top: 4px;
    font-size: 0.875rem;
    font-weight: 560;
  }

  .dropdown .mega-foot {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin: 4px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  .mega-foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dropdown .mega-foot-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .dropdown .mega-cta {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .dropdown .mega-cta:hover {
    background: var(--ink);
  }

  @keyframes dropdown-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mega-stagger {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .dropdown .mega-item[data-tone='blue'] {
    --item-tint: rgba(108, 190, 228, 0.14);
  }

  .dropdown .mega-item[data-tone='green'] {
    --item-tint: rgba(64, 170, 74, 0.12);
  }

  .dropdown .mega-item[data-tone='yellow'] {
    --item-tint: rgba(250, 195, 68, 0.16);
  }

  .dropdown .mega-item[data-tone='pink'] {
    --item-tint: rgba(243, 166, 210, 0.18);
  }

  .dropdown .mega-item:focus-visible {
    background: var(--item-tint, var(--surface));
  }

  @media (hover: hover) and (pointer: fine) {
    .dropdown .mega-item:hover {
      background: var(--item-tint, var(--surface));
    }

    .dropdown .mega-foot-link:hover {
      background: transparent;
      text-decoration: underline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .dropdown:not([hidden]) {
      animation: dropdown-in 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    .dropdown:not([hidden]) .mega-item,
    .dropdown:not([hidden]) .mega-feature {
      animation: mega-stagger 200ms cubic-bezier(0.23, 1, 0.32, 1) both;
      animation-delay: calc(var(--i, 0) * 30ms);
    }
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--white);
  }

  .menu-icon path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform 0.2s ease;
  }

  .bar-a {
    transform-origin: 9px 6px;
  }

  .bar-b {
    transform-origin: 9px 12px;
  }

  .menu-toggle[aria-expanded='true'] .bar-a {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bar-b {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 899px) {
    :global(html.js) .menu-toggle {
      display: inline-flex;
    }

    :global(html.js) .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 16px var(--gutter) 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }

    :global(html.js) .site-nav.open {
      display: flex;
    }

    .site-nav {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px 16px;
    }

    .header-inner {
      flex-wrap: wrap;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .nav-list a,
    .dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: 12px 14px;
    }

    .dropdown {
      position: static;
      left: auto;
      translate: none;
      width: auto;
      max-width: none;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin: 4px 0 4px 12px;
      padding: 0 0 0 12px;
      border: 0;
      border-left: 1px solid var(--line-strong);
      border-radius: 0;
      box-shadow: none;
      background: transparent;
    }

    .dropdown .mega-grid {
      grid-column: 1;
      grid-row: auto;
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .dropdown .mega-item .mega-icon {
      width: 40px;
      height: auto;
    }

    .dropdown .mega-item,
    .dropdown .mega-feature,
    .dropdown .mega-foot-link {
      justify-content: flex-start;
    }

    .dropdown .mega-feature {
      grid-column: 1;
      grid-row: auto;
    }

    .dropdown .mega-foot {
      grid-column: 1;
      grid-row: auto;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      padding: 12px 0 0;
    }

    .mega-foot-links {
      flex-direction: column;
      gap: 0;
    }

    .dropdown .mega-foot-link {
      padding: 8px 0;
      font-size: 0.9375rem;
    }

    .dropdown .mega-cta {
      justify-content: center;
      margin-left: 0;
      padding: 12px 16px;
    }

    :global(.nav-cta) {
      width: 100%;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuToggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');
  const dropdownToggle = header?.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
  const dropdown = dropdownToggle
    ? document.getElementById(dropdownToggle.getAttribute('aria-controls') ?? '')
    : null;

  function setDropdown(open: boolean) {
    if (!dropdownToggle || !dropdown) return;
    dropdownToggle.setAttribute('aria-expanded', String(open));
    dropdown.hidden = !open;
  }

  function setMenu(open: boolean) {
    if (!menuToggle || !nav) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    if (!open) setDropdown(false);
  }

  menuToggle?.addEventListener('click', () => {
    setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  dropdownToggle?.addEventListener('click', () => {
    setDropdown(dropdownToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (dropdownToggle && !dropdownToggle.parentElement?.contains(target)) setDropdown(false);
  });

  header?.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const dropdownOpen = dropdownToggle?.getAttribute('aria-expanded') === 'true';
    const menuOpen = menuToggle?.getAttribute('aria-expanded') === 'true';
    if (dropdownOpen) {
      setDropdown(false);
      dropdownToggle?.focus();
    } else if (menuOpen) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  const logo = header?.querySelector<HTMLAnchorElement>('.logo');
  const logoMark = logo?.querySelector<SVGElement>('.logo-mark');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (logo && logoMark && !reduceMotion) {
    // Rest: four squares. Hover: they merge into two cream rows; while hovered, a new row enters below
    // (sliver → expand → whole stack jumps up one slot), 360ms per step. Leave: the current step completes,
    // then the rows split back into the coloured squares (time-reversed intro).
    const EASE_OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
    const EASE_MIRROR = 'cubic-bezier(0.68, 0, 0.77, 0)'; // time-reversed EASE_OUT, so the outro mirrors the intro
    const EASE_JUMP = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
    const MERGE_MS = 320;
    const FADE_MS = 120;
    const EXPAND_MS = 140;
    const JUMP_MS = 160;
    const HOLD_MS = 60; // 140 + 160 + 60 = 360ms per loop step

    const ROW_X = 14;
    const ROW_W = 36;
    const SLIVER = 4 / ROW_W;
    // Slot 1 = y16 (top visible row), slot 2 = y36, slot 3 = y56 (entry, below row 2), slot 0 = y-4 (exit, above tile).
    const slotY = (n: number) => 16 + (n - 1) * 20;
    // Row element is drawn at y=0 with a 14-anchored horizontal scale; `sx` < 1 is the sliver/expansion.
    const rowT = (sx: number, y: number) => `matrix(${sx},0,0,1,${ROW_X * (1 - sx)},${y})`;
    const IDENT = 'matrix(1,0,0,1,0,0)';

    type Box = { x: number; y: number; w: number; h: number };
    // Matrix mapping rectangle `from` onto rectangle `to` (transform-origin 0 0, user units).
    const fit = (from: Box, to: Box) => {
      const sx = to.w / from.w;
      const sy = to.h / from.h;
      return `matrix(${sx},0,0,${sy},${to.x - sx * from.x},${to.y - sy * from.y})`;
    };
    const CORNERS = ['tl', 'tr', 'br', 'bl'] as const;
    type Corner = (typeof CORNERS)[number];
    const SQUARE: Record<Corner, Box> = {
      tl: { x: 14, y: 14, w: 16, h: 16 },
      tr: { x: 34, y: 14, w: 16, h: 16 },
      br: { x: 34, y: 34, w: 16, h: 16 },
      bl: { x: 14, y: 34, w: 16, h: 16 },
    };
    // Each square's half of a merged row: left half (14–32) and right half (32–50) meet at the seam x=32.
    const HALF: Record<Corner, Box> = {
      tl: { x: 14, y: 16, w: 18, h: 12 },
      tr: { x: 32, y: 16, w: 18, h: 12 },
      br: { x: 32, y: 36, w: 18, h: 12 },
      bl: { x: 14, y: 36, w: 18, h: 12 },
    };
    const SPLIT: Record<Corner, string> = {
      tl: fit(SQUARE.tl, HALF.tl),
      tr: fit(SQUARE.tr, HALF.tr),
      br: fit(SQUARE.br, HALF.br),
      bl: fit(SQUARE.bl, HALF.bl),
    };

    const squares = logoMark.querySelector<SVGGElement>('.logo-squares')!;
    const sq = Object.fromEntries(
      CORNERS.map((c) => [c, logoMark.querySelector<SVGGElement>(`.logo-sq[data-sq="${c}"]`)!]),
    ) as Record<Corner, SVGGElement>;
    const covers = Array.from(logoMark.querySelectorAll<SVGElement>('.logo-cover'));
    const rows = Array.from(logoMark.querySelectorAll<SVGGElement>('.logo-row'));

    type Style = Partial<Record<'transform' | 'opacity', string | number>>;
    // Animates `el` from → to, then commits `to` as inline style so the element rests on the final value.
    function tween(el: SVGElement, from: Style, to: Style, duration: number, easing: string, delay = 0) {
      const anim = el.animate([from, to] as Keyframe[], { duration, delay, easing, fill: 'none' });
      return anim.finished.then(() => {
        Object.assign(el.style, to);
        anim.cancel();
      });
    }

    let stack: SVGGElement[] = []; // [top visible row (slot 1), second visible row (slot 2)]
    let free: SVGGElement[] = [];  // recycled pool
    let phase: 'rest' | 'stack' = 'rest';
    let active = false;
    let busy = false;
    let pointerIn = false;
    let keyFocus = false;

    async function intro() {
      const [top, mid] = rows;
      rows.forEach((r) => (r.style.opacity = '0'));
      top.style.transform = rowT(1, slotY(1));
      mid.style.transform = rowT(1, slotY(2));
      stack = [top, mid];
      free = rows.slice(2);
      await Promise.all([
        ...CORNERS.map((c) => tween(sq[c], { transform: IDENT }, { transform: SPLIT[c] }, MERGE_MS, EASE_OUT)),
        ...covers.map((el) => tween(el, { opacity: 0 }, { opacity: 1 }, MERGE_MS, EASE_OUT)),
        tween(squares, { opacity: 1 }, { opacity: 0 }, FADE_MS, 'linear', MERGE_MS - FADE_MS),
        tween(top, { opacity: 0 }, { opacity: 1 }, FADE_MS, 'linear', MERGE_MS - FADE_MS),
        tween(mid, { opacity: 0 }, { opacity: 1 }, FADE_MS, 'linear', MERGE_MS - FADE_MS),
      ]);
    }

    async function outro() {
      const [top, mid] = stack;
      // Start exactly where the intro ended: squares sit on the row halves, invisible.
      CORNERS.forEach((c) => (sq[c].style.transform = SPLIT[c]));
      covers.forEach((el) => (el.style.opacity = '1'));
      squares.style.opacity = '0';
      await Promise.all([
        ...CORNERS.map((c) => tween(sq[c], { transform: SPLIT[c] }, { transform: IDENT }, MERGE_MS, EASE_MIRROR)),
        ...covers.map((el) => tween(el, { opacity: 1 }, { opacity: 0 }, MERGE_MS, EASE_MIRROR)),
        tween(squares, { opacity: 0 }, { opacity: 1 }, FADE_MS, 'linear'),
        tween(top, { opacity: 1 }, { opacity: 0 }, FADE_MS, 'linear'),
        tween(mid, { opacity: 1 }, { opacity: 0 }, FADE_MS, 'linear'),
      ]);
      stack = [];
    }

    // One ENTER: a sliver appears in slot 3, expands from the left, then the stack jumps up one slot.
    async function step() {
      const row = free.shift()!;
      row.style.transform = rowT(SLIVER, slotY(3));
      row.style.opacity = '1';
      await tween(row, { transform: rowT(SLIVER, slotY(3)) }, { transform: rowT(1, slotY(3)) }, EXPAND_MS, EASE_OUT);

      const [top, mid] = stack;
      await Promise.all([
        tween(top, { transform: rowT(1, slotY(1)) }, { transform: rowT(1, slotY(0)) }, JUMP_MS, EASE_JUMP),
        tween(mid, { transform: rowT(1, slotY(2)) }, { transform: rowT(1, slotY(1)) }, JUMP_MS, EASE_JUMP),
        tween(row, { transform: rowT(1, slotY(3)) }, { transform: rowT(1, slotY(2)) }, JUMP_MS, EASE_JUMP),
      ]);
      top.style.opacity = '0';
      free.push(top);
      stack = [mid, row];
      await new Promise((resolve) => setTimeout(resolve, HOLD_MS));
    }

    // Single driver: intro → steps while active → outro → (re-)intro if active again. Each phase completes
    // before the next, so a step in progress always finishes its expansion and jump.
    async function drive() {
      busy = true;
      try {
        while (active || phase === 'stack') {
          if (!active) {
            await outro();
            phase = 'rest';
          } else if (phase === 'rest') {
            await intro();
            phase = 'stack';
          } else {
            await step();
          }
        }
      } finally {
        busy = false;
      }
    }

    const update = () => {
      active = pointerIn || keyFocus;
      if (!busy) void drive();
    };
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    logo.addEventListener('pointerenter', () => {
      if (!fine.matches) return;
      pointerIn = true;
      update();
    });
    logo.addEventListener('pointerleave', () => {
      pointerIn = false;
      update();
    });
    logo.addEventListener('focus', () => {
      keyFocus = logo.matches(':focus-visible');
      update();
    });
    logo.addEventListener('blur', () => {
      keyFocus = false;
      update();
    });
  }
</script>
