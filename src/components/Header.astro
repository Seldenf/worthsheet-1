---
import { SITE_NAME } from '../config';
import { url } from '../lib/url';
import Button from './Button.astro';

const current = Astro.url.pathname;
const isCurrent = (path: string) => current === url(path);
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="logo" href={url('/')} aria-label={`${SITE_NAME} home`}>
      <svg class="logo-mark" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
        <rect width="64" height="64" rx="16" fill="#edecea" fill-opacity="0.25"></rect>
        <rect class="sq sq-tl" x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a"></rect>
        <rect class="sq sq-tr" x="34" y="14" width="16" height="16" rx="4" fill="#fac344"></rect>
        <rect class="sq sq-br" x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4"></rect>
        <rect class="sq sq-bl" x="14" y="34" width="16" height="16" rx="4" fill="#0c2635"></rect>
      </svg>
      <span class="logo-text">{SITE_NAME}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="nav-list">
        <li>
          <a href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Template</a>
        </li>
      </ul>
      <Button href="/download/" variant="primary" size="sm" class="nav-cta">
        Get the free template
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --ink: var(--navy);
    --ink-hover: var(--navy-hover);
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
    padding-inline: clamp(16px, 2.15vw, 30px);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Logo: on hover the four squares step one cell clockwise as a ring, and step back on leave.
     A transition (not a looping keyframe) so it reverses smoothly from wherever it is. */
  .logo {
    -webkit-tap-highlight-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-mark {
      transition: scale 150ms var(--ease-out);
    }

    .logo:active .logo-mark {
      scale: 0.96;
    }

    .logo-mark .sq {
      transition: translate 300ms var(--ease-in-out);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .logo:hover .sq-tl {
      translate: 20px 0;
    }

    .logo:hover .sq-tr {
      translate: 0 20px;
    }

    .logo:hover .sq-br {
      translate: -20px 0;
    }

    .logo:hover .sq-bl {
      translate: 0 -20px;
    }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-list > li {
    position: relative;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    -webkit-tap-highlight-color: transparent;
    transition: background-color 150ms var(--ease-out);
  }

  .nav-list a[aria-current='page'] {
    background: var(--beige-soft);
  }

  @media (hover: hover) {
    .nav-list a:hover {
      background: var(--beige-soft);
    }
  }

  @media (pointer: coarse) {
    .nav-list a {
      min-height: 44px;
    }
  }

  @media (max-width: 559px) {
    .nav-list {
      display: none;
    }
  }
</style>
