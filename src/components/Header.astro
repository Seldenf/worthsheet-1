---
import { SITE_NAME } from '../config';
import { url } from '../lib/url';
import Button from './Button.astro';

const calculators = [
  { name: 'Mortgage Calculator', path: '/mortgage-calculator/' },
  { name: 'Net Worth Calculator', path: '/net-worth-calculator/' },
  { name: 'Debt-to-Income Calculator', path: '/debt-to-income-ratio-calculator/' },
  { name: 'Home Affordability Calculator', path: '/how-much-house-can-i-afford/' },
  { name: 'Mortgage Readiness Assessment', path: '/mortgage-readiness-assessment/' },
];

const links = [
  { name: 'Banks', path: '/banks/' },
  { name: 'Glossary', path: '/glossary/' },
  { name: 'Blog', path: '/blog/' },
];

const current = Astro.url.pathname;
const isCurrent = (path: string) => current === url(path);
const calculatorsActive = calculators.some((c) => current.startsWith(url(c.path)));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="logo" href={url('/')} aria-label={`${SITE_NAME} home`}>
      <svg class="logo-mark" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
        <rect width="64" height="64" rx="16" fill="#2e2926"></rect>
        <rect x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a"></rect>
        <rect x="34" y="14" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
        <rect x="14" y="34" width="16" height="16" rx="4" fill="#fdfcfa"></rect>
        <rect x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4"></rect>
      </svg>
      <span class="logo-text">{SITE_NAME}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <svg class="menu-icon" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
        <path class="bar-a" d="M2 6h14"></path>
        <path class="bar-b" d="M2 12h14"></path>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main" data-nav>
      <ul class="nav-list">
        <li>
          <a href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Template</a>
        </li>
        <li class="has-dropdown">
          <button
            class:list={['dropdown-toggle', { active: calculatorsActive }]}
            type="button"
            aria-expanded="false"
            aria-controls="nav-calculators"
            data-dropdown-toggle
          >
            Calculators
            <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
              <path
                d="M1 1.5l5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul id="nav-calculators" class="dropdown" hidden>
            {
              calculators.map((c) => (
                <li>
                  <a href={url(c.path)} aria-current={isCurrent(c.path) ? 'page' : undefined}>
                    {c.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          links.map((l) => (
            <li>
              <a href={url(l.path)} aria-current={current.startsWith(url(l.path)) ? 'page' : undefined}>
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/download/" variant="primary" size="sm" class="nav-cta">
        Get the free template
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 252, 250, 0.88);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  .nav-list > li {
    position: relative;
  }

  .nav-list a,
  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-list a:hover,
  .dropdown-toggle:hover,
  .dropdown-toggle[aria-expanded='true'] {
    background: var(--beige-soft);
  }

  .nav-list a[aria-current='page'],
  .dropdown-toggle.active {
    background: var(--beige-soft);
  }

  .dropdown-toggle svg {
    transition: transform 0.15s ease;
  }

  .dropdown-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 280px;
    padding: 8px;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .dropdown a {
    display: flex;
    width: 100%;
    border-radius: var(--radius-sm);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--white);
  }

  .menu-icon path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform 0.2s ease;
  }

  .bar-a {
    transform-origin: 9px 6px;
  }

  .bar-b {
    transform-origin: 9px 12px;
  }

  .menu-toggle[aria-expanded='true'] .bar-a {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bar-b {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 899px) {
    :global(html.js) .menu-toggle {
      display: inline-flex;
    }

    :global(html.js) .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 16px var(--gutter) 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }

    :global(html.js) .site-nav.open {
      display: flex;
    }

    .site-nav {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px 16px;
    }

    .header-inner {
      flex-wrap: wrap;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .nav-list a,
    .dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: 12px 14px;
    }

    .dropdown {
      position: static;
      min-width: 0;
      margin: 4px 0 4px 12px;
      padding: 0;
      border: 0;
      border-left: 1px solid var(--line-strong);
      border-radius: 0;
      box-shadow: none;
      background: transparent;
    }

    :global(.nav-cta) {
      width: 100%;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuToggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');
  const dropdownToggle = header?.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
  const dropdown = dropdownToggle
    ? document.getElementById(dropdownToggle.getAttribute('aria-controls') ?? '')
    : null;

  function setDropdown(open: boolean) {
    if (!dropdownToggle || !dropdown) return;
    dropdownToggle.setAttribute('aria-expanded', String(open));
    dropdown.hidden = !open;
  }

  function setMenu(open: boolean) {
    if (!menuToggle || !nav) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
    if (!open) setDropdown(false);
  }

  menuToggle?.addEventListener('click', () => {
    setMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  dropdownToggle?.addEventListener('click', () => {
    setDropdown(dropdownToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (dropdownToggle && !dropdownToggle.parentElement?.contains(target)) setDropdown(false);
  });

  header?.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const dropdownOpen = dropdownToggle?.getAttribute('aria-expanded') === 'true';
    const menuOpen = menuToggle?.getAttribute('aria-expanded') === 'true';
    if (dropdownOpen) {
      setDropdown(false);
      dropdownToggle?.focus();
    } else if (menuOpen) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
