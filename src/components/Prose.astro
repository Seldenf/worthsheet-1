---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}><slot /></div>

<style is:global>
  .prose {
    max-width: var(--prose);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .prose > * + * {
    margin-top: 1.25em;
  }

  .prose h2 {
    margin-top: 2.2em;
    font-size: clamp(1.6rem, 3vw, 2.125rem);
  }

  .prose h3 {
    margin-top: 1.8em;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .prose h2 + *,
  .prose h3 + * {
    margin-top: 0.7em;
  }

  .prose p,
  .prose li {
    text-wrap: pretty;
  }

  .prose a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(64, 170, 74, 0.55);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1.5px;
    transition: text-decoration-color 150ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .prose a:hover {
      text-decoration-color: var(--ink);
    }
  }

  .prose a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose li + li {
    margin-top: 0.4em;
  }

  .prose li::marker {
    color: var(--muted);
  }

  /* Callout: a tinted rounded card. */
  .prose blockquote {
    margin-inline: 0;
    padding: clamp(16px, 2.4vw, 24px) clamp(18px, 2.6vw, 28px);
    border-radius: var(--radius);
    background-color: var(--tint-blue);
    background-image: var(--grain-soft);
    color: var(--ink);
  }

  .prose blockquote > * + * {
    margin-top: 0.7em;
  }

  .prose blockquote > :first-child {
    margin-top: 0;
  }

  .prose code {
    padding: 0.12em 0.4em;
    border-radius: 6px;
    background: var(--beige-soft);
    font-size: 0.92em;
  }

  .prose pre {
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    background: var(--beige-soft);
    overflow-x: auto;
  }

  .prose pre code {
    padding: 0;
    background: none;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--line-strong);
    margin-block: 2.5em;
  }

  .prose img {
    border-radius: var(--radius);
    height: auto;
  }

  .prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
</style>
