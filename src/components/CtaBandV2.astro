---
/**
 * Closing CTA band, variant 2: the same navy card and copy as CtaBand, but the spreadsheet grid
 * also runs INSIDE the card, inverted (faint light lines, brighter drifting cells on navy). The
 * inner grid is aligned to the card's border box, which sits exactly on the page grid, so its lines
 * continue the page grid's. Its cells reuse the `.sheet-glow > i` markup, so `drift()` in motion.ts
 * animates them with the page cells.
 */
import Button from './Button.astro';
import Sheet from './Sheet.astro';
import type { GlowCell } from './Sheet.astro';
import { STATS } from '../config';

interface Props {
  title?: string;
  text?: string;
  class?: string;
}

const {
  title = 'Get the free PFS template',
  text = `Build a bank-ready personal financial statement in Google Sheets or Excel. Free, with ${STATS.assetCategories} asset and ${STATS.liabilityCategories} liability categories built in.`,
  class: className,
} = Astro.props;

const ticks = ['Free forever', 'Google Sheets & Excel', '9,000+ downloads'];

// Cells inside the card: [column, row, tone, strength %, strong end]. Kept to the sides and the
// top and bottom rows; the mask below dims whatever is left behind the copy.
const cells: GlowCell[] = [
  [0, 1, 'green', 36, 'l'],
  [0, 2, 'green', 24, 'l'],
  [1, 6, 'blue', 34, 'r'],
  [0, 9, 'yellow', 34, 'l'],
  [1, 10, 'yellow', 22, 'l'],
  [3, 0, 'yellow', 32, 'r'],
  [2, 12, 'blue', 34, 'l'],
  [7, 0, 'green', 34, 'l'],
  [6, 12, 'green', 32, 'r'],
  [11, 1, 'blue', 36, 'r'],
  [10, 2, 'blue', 24, 'r'],
  [11, 6, 'yellow', 34, 'r'],
  [9, 9, 'green', 36, 'r'],
  [10, 10, 'green', 24, 'r'],
  [9, 12, 'blue', 32, 'l'],
];
---

<Sheet
  class={['cta-band-v2-wrap', className].filter(Boolean).join(' ')}
  tone="cta"
  grid
  rowsBelow={2}
  seed={11}
  aria-labelledby="cta-band-v2-title"
>
  <div class="cta-band-v2">
    <div class="cta-band-v2-grid" aria-hidden="true">
      <div class="sheet-glow">
        {
          cells.map(([c, row, t, a, end]) => (
            <i
              class={`tone-${t}`}
              style={`--c:${c};--r:${row};--a:${a}%;--dir:${end === 'l' ? '90deg' : '270deg'}`}
            />
          ))
        }
      </div>
    </div>
    <h2 id="cta-band-v2-title">{title}</h2>
    <p class="cta-band-v2-text">{text}</p>
    <div class="cta-band-v2-actions">
      <Button href="/download/" variant="secondary" size="lg" class="cta-band-v2-btn">Get the free template</Button>
    </div>
    <ul class="cta-band-v2-ticks">
      {
        ticks.map((t) => (
          <li>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <circle cx="8" cy="8" r="8" fill="#40aa4a"></circle>
              <path
                d="M4.6 8.3l2.2 2.2 4.6-4.9"
                fill="none"
                stroke="#fff"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>{t}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Sheet>

<style is:global>
  /* Card surface: navy, a cool glow, a green wash bottom-left, a faint yellow wash top-right, grain. */
  .cta-band-v2-wrap .sheet-card {
    border-color: rgba(255, 255, 255, 0.08);
    background-color: #0c2635;
    background-image:
      var(--grain),
      radial-gradient(55% 80% at 50% 50%, rgba(108, 190, 228, 0.2), transparent 72%),
      radial-gradient(45% 70% at 0% 100%, rgba(64, 170, 74, 0.16), transparent 70%),
      radial-gradient(40% 60% at 100% 0%, rgba(250, 195, 68, 0.08), transparent 70%),
      linear-gradient(160deg, #123447 0%, #0a1f2b 100%);
  }

  /* No plate inset: the navy card itself is the sheet, so its edges sit on the page grid lines. */
  .cta-band-v2-wrap .sheet {
    padding: 0;
  }

  .cta-band-v2-wrap .sheet-body {
    padding: 0;
  }
</style>

<style>
  .cta-band-v2 {
    --pad: clamp(24px, 4.6vw, 64px);
    /* Not positioned: the grid layer below is placed against .sheet-card (the whole card, not just the copy). */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: clamp(40px, 5.4vw, 72px) var(--pad);
  }

  /* Inverted grid layer. It starts at the card's border box (inset -1px), whose top-left is a page grid
     line crossing, so the lines below are the page grid's own (same 100 x 26 cells, same -1px row offset
     as .sheet-section.has-grid). The mask dims the middle so the copy stays readable. */
  .cta-band-v2-grid {
    position: absolute;
    inset: -1px;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: var(--cell-w) var(--cell-h);
    background-position: 0 -1px;
    -webkit-mask-image: radial-gradient(ellipse 52% 62% at 50% 50%, rgba(0, 0, 0, 0.18) 0%, #000 100%);
    mask-image: radial-gradient(ellipse 52% 62% at 50% 50%, rgba(0, 0, 0, 0.18) 0%, #000 100%);
  }

  /* The global .tone-green/.tone-blue/.tone-yellow band classes (also on the cells) paint a paper-coloured
     background-color under the gradient: harmless on the white page, a pale block on navy. */
  .cta-band-v2-grid .sheet-glow i {
    background-color: transparent;
  }

  .cta-band-v2 h2 {
    max-width: 17ch;
    color: #fff;
  }

  .cta-band-v2-text {
    max-width: 32rem;
    margin: 0;
    font-size: clamp(1rem, 1.45vw, 1.125rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  .cta-band-v2-actions {
    margin-top: 8px;
  }

  /* Light button on navy: white fill, navy label, no hairline. */
  .cta-band-v2-actions :global(.cta-band-v2-btn) {
    --btn-bg: #fff;
    --btn-fg: var(--navy);
    --btn-border: #fff;
    background-image: linear-gradient(rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.05));
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-band-v2-actions :global(.cta-band-v2-btn:hover) {
      --btn-bg: var(--tint-blue);
      --btn-border: var(--tint-blue);
    }
  }

  .cta-band-v2-ticks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .cta-band-v2-ticks li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.84);
  }

  .cta-band-v2-ticks svg {
    flex: none;
  }

  @media (max-width: 479px) {
    .cta-band-v2-actions,
    .cta-band-v2-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
