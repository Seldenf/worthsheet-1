---
interface Props {
  class?: string;
  /** Colour of the leading rounded square (default green). */
  tone?: 'green' | 'blue' | 'yellow' | 'navy';
}
const { class: className, tone = 'green' } = Astro.props;
---

<p class:list={['eyebrow', 'eyebrow-chip', tone !== 'green' && `chip-${tone}`, className]}>
  <slot />
</p>
