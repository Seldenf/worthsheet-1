---
/**
 * CTA variant B, "Formula bar": a light card. A big Google-Sheets-style formula bar runs flush
 * across the top (name box, fx, =DOWNLOAD("WorthSheet") with a blinking caret), the centred copy and
 * button sit below it, and a row of five iso icons closes the card, laid out like spreadsheet
 * column headers A to E with a tiny label each.
 */
import Button from '../Button.astro';
import Sheet from '../Sheet.astro';
import IsoIcon from '../IsoIcon.astro';

const cols = [
  { letter: 'A', label: 'Assets', icon: 'bank', tone: 'green' },
  { letter: 'B', label: 'Liabilities', icon: 'document', tone: 'yellow' },
  { letter: 'C', label: 'Net worth', icon: 'scale', tone: 'blue', selected: true },
  { letter: 'D', label: 'DTI', icon: 'percent', tone: 'pink' },
  { letter: 'E', label: 'Mortgage', icon: 'house', tone: 'white' },
] as const;
---

<Sheet
  class="cta-b-sheet"
  tone="blue"
  grid
  rowsBelow={2}
  seed={14}
  aria-labelledby="cta-b-title"
>
  <div class="cta-b">
    <div class="cta-b-bar" aria-hidden="true">
      <span class="cta-b-name">
        A1
        <svg viewBox="0 0 10 6" width="9" height="6" focusable="false">
          <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="cta-b-fx">fx</span>
      <span class="cta-b-formula">
        <span class="cta-b-eq">=DOWNLOAD(</span><span class="cta-b-str">"WorthSheet"</span><span class="cta-b-eq">)</span><span class="cta-b-caret"></span>
      </span>
    </div>

    <div class="cta-b-main">
      <h2 id="cta-b-title">Download the personal financial statement template for free</h2>
      <p class="lead">
        Make your next loan or mortgage application easier: fill in your accounts once and let the template
        calculate the totals and your net worth.
      </p>
      <div class="cta-b-actions">
        <Button href="/download/" variant="primary" size="lg">Get the free template</Button>
      </div>
    </div>

    <ul class="cta-b-cols" aria-hidden="true">
      {
        cols.map((c, i) => (
          <li class:list={['cta-b-col', 'iso-hover', { 'is-selected': 'selected' in c }]}>
            <span class="cta-b-letter">{c.letter}</span>
            <span class="cta-b-cell">
              <IsoIcon icon={c.icon} tone={c.tone} size={60} delay={i * 0.4} />
              <span class="cta-b-label">{c.label}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Sheet>

<style is:global>
  .cta-b-sheet .sheet-body {
    padding: 0;
  }
</style>

<style>
  .cta-b {
    --line-b: rgba(12, 38, 53, 0.1);
    display: flex;
    flex-direction: column;
  }

  /* ---- Formula bar ---- */
  .cta-b-bar {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 20px);
    min-height: clamp(52px, 7vw, 76px);
    padding-inline: clamp(14px, 2.4vw, 28px);
    background: #fff;
    border-bottom: 1px solid var(--line-b);
    font-family: ui-monospace, 'SF Mono', 'Geist Mono', Menlo, Consolas, monospace;
    color: var(--navy);
    user-select: none;
  }

  .cta-b-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 6px clamp(8px, 1.4vw, 14px);
    border: 1px solid var(--line-b);
    border-radius: 8px;
    background: var(--surface);
    font-size: clamp(0.75rem, 1.4vw, 0.9rem);
    font-weight: 500;
    color: var(--muted);
  }

  .cta-b-fx {
    flex: none;
    padding-right: clamp(10px, 2vw, 20px);
    border-right: 1px solid var(--line-b);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-style: italic;
    line-height: 1.6;
    color: var(--muted-soft);
  }

  .cta-b-formula {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    font-size: clamp(0.8125rem, 2.6vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .cta-b-str {
    color: #137333;
  }

  .cta-b-caret {
    flex: none;
    width: 2px;
    height: 1.15em;
    margin-left: 3px;
    background: var(--navy);
    border-radius: 1px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta-b-caret {
      animation: cta-b-blink 1.1s steps(1, end) infinite;
    }
  }

  @keyframes cta-b-blink {
    0%,
    55% {
      opacity: 1;
    }
    56%,
    100% {
      opacity: 0;
    }
  }

  /* ---- Copy ---- */
  .cta-b-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(36px, 5.6vw, 72px) clamp(24px, 4.6vw, 64px) clamp(32px, 4.6vw, 56px);
    text-align: center;
  }

  .cta-b-main :global(.lead) {
    max-width: 34rem;
  }

  .cta-b-actions {
    margin-top: 8px;
  }

  /* ---- Column headers A to E ---- */
  .cta-b-cols {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-b);
    background: rgba(255, 255, 255, 0.6);
  }

  .cta-b-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-left: 1px solid var(--line-b);
    transition: background-color 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .cta-b-col:first-child {
    border-left: 0;
  }

  .cta-b-letter {
    display: block;
    padding: 5px 0;
    border-bottom: 1px solid var(--line-b);
    background: var(--surface);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    color: var(--muted);
    transition: background-color 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .cta-b-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 18px 4px 16px;
  }

  .cta-b-cell :global(.iso-ico) {
    width: clamp(40px, 6vw, 60px);
    height: auto;
  }

  .cta-b-label {
    max-width: 100%;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* One selected column, like a clicked header in Sheets. */
  .cta-b-col.is-selected .cta-b-letter {
    background: var(--tint-blue);
    border-bottom-color: var(--blue);
    box-shadow: inset 0 -1px 0 var(--blue);
    color: #2b7fae;
  }

  .cta-b-col.is-selected {
    background: rgba(108, 190, 228, 0.1);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-b-col:hover {
      background: rgba(255, 255, 255, 0.9);
    }

    .cta-b-col:hover .cta-b-letter {
      background: var(--beige-soft);
    }
  }

  @media (max-width: 479px) {
    .cta-b-name {
      display: none;
    }

    .cta-b-label {
      font-size: 0.625rem;
    }

    .cta-b-cell {
      padding-inline: 2px;
    }

    .cta-b-actions,
    .cta-b-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
