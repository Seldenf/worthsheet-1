---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', tC: '#f9f2e2' };

// Abstract tile-grid "map": one rounded cell per region, [row, col]. A diagram, not a geographic trace.
const grid: [number, number][] = [
  [0, 0], [0, 11], [1, 10], [1, 11],
  [2, 0], [2, 1], [2, 2], [2, 3], [2, 4], [2, 5], [2, 6], [2, 7], [2, 8], [2, 10], [2, 11],
  [3, 0], [3, 1], [3, 2], [3, 3], [3, 4], [3, 5], [3, 6], [3, 7], [3, 8], [3, 9],
  [4, 0], [4, 1], [4, 2], [4, 3], [4, 4], [4, 5], [4, 6], [4, 7], [4, 8], [4, 9],
  [5, 1], [5, 2], [5, 3], [5, 4], [5, 5], [5, 6], [5, 7], [5, 8],
  [6, 3], [6, 4], [6, 5], [6, 6], [6, 7],
  [7, 0], [7, 3], [7, 8],
];
const P = 27;
const PAD = 14;
const PW = 12 * P + 2 * PAD - 3;
const PH = 8 * P + 2 * PAD - 3;
const OX = 40;
const OY = 262;
const T = `matrix(1 -.5 1 .5 ${OX} ${OY}) `;
const tints = ['#d3ebf6', '#d4f1dc', '#f8ebc9'];
const pinCells: Record<string, string> = { '4,0': C.blue, '7,3': C.yellow, '2,8': C.green, '7,8': C.blue };
const cells = grid.map(([r, c]) => ({
  x: PAD + c * P,
  y: PAD + r * P,
  fill: pinCells[`${r},${c}`] ?? tints[(r + c * 2) % 3],
  pin: pinCells[`${r},${c}`],
}));
const pins = cells
  .filter((c) => c.pin)
  .map((c) => {
    const lx = c.x + 12;
    const ly = c.y + 12;
    return { x: OX + lx + ly, y: OY + (ly - lx) / 2, fill: c.pin };
  });
const PIN = 'M0 0C-9-12-14-17-14-26a14 14 0 1 1 28 0c0 9-5 14-14 26z';
const pills = [
  { x: 118, y: 96, l: 'Find banks by ZIP', dot: C.blue, cls: 'f2' },
  { x: 540, y: 410, l: 'FDIC-insured', dot: C.green, cls: 'f3' },
].map((p) => ({ ...p, w: Math.round(p.l.length * 14 * 0.54) + 48 }));
---

<svg
  class:list={['wsi', 'wsi-map', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 660 450"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-map-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="8"></feGaussianBlur></filter>
  </defs>

  <g transform={T}><rect x="-34" y="-34" width={PW + 68} height={PH + 68} rx="30" fill={C.tB} fill-opacity=".55" stroke="#fff" stroke-width="2"></rect></g>
  <g transform={`matrix(1 -.5 1 .5 ${OX} ${OY + 22})`} filter="url(#wsi-map-blur)"><rect width={PW} height={PH} rx="20" fill={C.ink} fill-opacity=".14"></rect></g>
  <g transform={`matrix(1 -.5 1 .5 ${OX} ${OY + 11})`}><rect width={PW} height={PH} rx="20" fill="#cfcdcb"></rect></g>
  <g transform={T}>
    <rect width={PW} height={PH} rx="20" fill="#fff" stroke={C.ink} stroke-opacity=".2"></rect>
    {cells.map((c) => <rect x={c.x} y={c.y} width="24" height="24" rx="6" fill={c.fill}></rect>)}
  </g>

  {pins.map((p) => (
    <ellipse cx={p.x} cy={p.y} rx="15" ry="6" fill={C.ink} fill-opacity=".18"></ellipse>
  ))}
  {pins.map((p, i) => (i === 0 || i === 2 ? (
    <ellipse class="wsi-map-ring" style={i === 2 ? 'animation-delay:-3s' : undefined} cx={p.x} cy={p.y} rx="15" ry="6" fill="none" stroke={p.fill} stroke-width="2"></ellipse>
  ) : null))}
  {pins.map((p, i) => (
    <g class="wsi-map-pin" style={`animation-delay:-${(i * 0.6).toFixed(1)}s`}>
      <g transform={`translate(${p.x} ${p.y})`}>
        <path d={PIN} fill={p.fill} stroke="#fff" stroke-width="3" stroke-linejoin="round"></path>
        <circle cy="-26" r="5.5" fill="#fff"></circle>
      </g>
    </g>
  ))}

  {pills.map((p) => (
    <g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-map-${p.cls}`}>
        <rect x={-p.w / 2} y="-15" width={p.w} height="38" rx="19" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="19" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
        <circle cx={-p.w / 2 + 22} cy="0" r="6" fill={p.dot}></circle>
        <text x={-p.w / 2 + 38} y="5" font-size="14" font-weight="600" fill={C.ink}>{p.l}</text>
      </g>
    </g>
  ))}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wsi-map-drift {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      33% { transform: translate(-1.5px, -4px) rotate(-0.8deg); }
      66% { transform: translate(1.5px, -2px) rotate(0.6deg); }
    }
    @keyframes wsi-map-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @keyframes wsi-map-ring {
      0% { transform: scale(0.9); opacity: 0.7; }
      100% { transform: scale(1.15); opacity: 0; }
    }
    .wsi-map-pin, .wsi-map-f2, .wsi-map-f3, .wsi-map-ring { transform-box: fill-box; transform-origin: center; will-change: transform; }
    .wsi-map-pin { animation: wsi-map-bob 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-map-ring { animation: wsi-map-ring 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-map-f2 { animation: wsi-map-drift 7s cubic-bezier(0.45, 0, 0.55, 1) -2s infinite; }
    .wsi-map-f3 { animation: wsi-map-drift 8.5s cubic-bezier(0.45, 0, 0.55, 1) -4s infinite; }
  }
</style>
