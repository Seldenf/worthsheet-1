---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', tC: '#f9f2e2' };

// Abstract tile-grid "map": one rounded cell per region, [row, col]. A diagram, not a geographic trace.
const grid: [number, number][] = [
  [0, 0], [0, 11], [1, 10], [1, 11],
  [2, 0], [2, 1], [2, 2], [2, 3], [2, 4], [2, 5], [2, 6], [2, 7], [2, 8], [2, 10], [2, 11],
  [3, 0], [3, 1], [3, 2], [3, 3], [3, 4], [3, 5], [3, 6], [3, 7], [3, 8], [3, 9],
  [4, 0], [4, 1], [4, 2], [4, 3], [4, 4], [4, 5], [4, 6], [4, 7], [4, 8], [4, 9],
  [5, 1], [5, 2], [5, 3], [5, 4], [5, 5], [5, 6], [5, 7], [5, 8],
  [6, 3], [6, 4], [6, 5], [6, 6], [6, 7],
  [7, 0], [7, 3], [7, 8],
];
const P = 27;
const PAD = 14;
const PW = 12 * P + 2 * PAD - 3;
const PH = 8 * P + 2 * PAD - 3;
const OX = 40;
const OY = 262;
const T = `matrix(1 -.5 1 .5 ${OX} ${OY}) `;
const inStyle = (d: number, dur: number, y: number, s = 1) => `--in-d:${d}ms;--in-dur:${dur}ms;--in-y:${y}px;--in-s:${s};transform-box:fill-box;transform-origin:center`;
const tints = ['#d3ebf6', '#d4f1dc', '#f8ebc9'];
const pinCells: Record<string, string> = { '4,0': C.blue, '7,3': C.yellow, '2,8': C.green, '7,8': C.blue };
const cells = grid.map(([r, c]) => ({
  x: PAD + c * P,
  y: PAD + r * P,
  fill: pinCells[`${r},${c}`] ?? tints[(r + c * 2) % 3],
  pin: pinCells[`${r},${c}`],
}));
// Pins are glued to the tile: they share its wrapper, so they move with its face.
const pins = cells
  .filter((c) => c.pin)
  .map((c, i) => {
    const lx = c.x + 12;
    const ly = c.y + 12;
    return { x: OX + lx + ly, y: OY + (ly - lx) / 2, fill: c.pin, d: +(0.3 + i * 0.3).toFixed(1) };
  });
// Dashed route between the first two pins, drawn in tile-face coordinates (pin cells at local 26,134 and 107,215).
const ROUTE = 'M26 134Q62 150 107 215';
const PIN = 'M0 0C-9-12-14-17-14-26a14 14 0 1 1 28 0c0 9-5 14-14 26z';
const pills = [
  { x: 118, y: 96, l: 'Find banks by ZIP', dot: C.blue, cls: 'f2', lift: -12, d: 0.8, dep: 1.5, ent: [880, 460, 14] },
  { x: 540, y: 410, l: 'FDIC-insured', dot: C.green, cls: 'f3', lift: -14, d: 1.2, dep: 0.9, ent: [920, 460, -16] },
].map((p) => ({ ...p, w: Math.round(p.l.length * 14 * 0.54) + 48 }));
---

<svg
  class:list={['wsi', 'wsi-map', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 660 450"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-map-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="8"></feGaussianBlur></filter>
  </defs>

  <!-- base layer: plain wrappers carry the animation; matrix groups keep their attribute transform -->
  <g class="wsi-in" style={inStyle(0, 900, 10, 0.96)}><g class="wsi-map-base wsi-breathe"><g transform={T}><rect x="-34" y="-34" width={PW + 68} height={PH + 68} rx="30" fill={C.tB} fill-opacity=".55" stroke="#fff" stroke-width="2"></rect></g></g></g>
  <g class="wsi-in" style={inStyle(120, 800, 0, 0.9)}><g class="wsi-map-shadow"><g transform={`matrix(1 -.5 1 .5 ${OX} ${OY + 22})`}><rect width={PW} height={PH} rx="20" fill={C.ink} fill-opacity=".14" filter="url(#wsi-map-blur)"></rect></g></g></g>
  <g class="wsi-in" style={inStyle(150, 700, 20, 0.94)}><g class="wsi-pt" style="--d:0.3"><g class="wsi-map-base wsi-breathe"><g transform={`matrix(1 -.5 1 .5 ${OX} ${OY + 11})`}><rect width={PW} height={PH} rx="20" fill="#cfcdcb"></rect></g></g></g></g>

  <!-- tile face with route, pins, ground shadows and pulse rings: one shared wrapper so everything on it moves together -->
  <g class="wsi-in" style={inStyle(150, 700, 20, 0.94)}><g class="wsi-pt" style="--d:0.3"><g class="wsi-map-base wsi-breathe">
    <g transform={T}>
      <rect width={PW} height={PH} rx="20" fill="#fff" stroke={C.ink} stroke-opacity=".2"></rect>
      {cells.map((c) => <rect x={c.x} y={c.y} width="24" height="24" rx="6" fill={c.fill}></rect>)}
      <path class="wsi-draw" pathLength="100" d={ROUTE} fill="none" stroke="#3f9cc9" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="3 4" style="--draw-d:1000ms"></path>
    </g>
    {pins.map((p) => (
      <ellipse class="wsi-map-pshadow" style={`animation-delay:${p.d}s`} cx={p.x} cy={p.y} rx="15" ry="6" fill={C.ink} fill-opacity=".18"></ellipse>
    ))}
    {pins.map((p, i) => (i === 0 || i === 2 ? (
      <ellipse class="wsi-map-ring" style={i === 2 ? 'animation-delay:-3s' : undefined} cx={p.x} cy={p.y} rx="15" ry="6" fill="none" stroke={p.fill} stroke-width="2"></ellipse>
    ) : null))}
    {pins.map((p) => (
      <g transform={`translate(${p.x} ${p.y})`}>
        <path d={PIN} fill={p.fill} stroke="#fff" stroke-width="3" stroke-linejoin="round"></path>
        <circle cy="-26" r="5.5" fill="#fff"></circle>
      </g>
    ))}
  </g></g></g>

  <!-- top layer: pills -->
  {pills.map((p) => (
    <g class="wsi-in" style={inStyle(p.ent[0], p.ent[1], p.ent[2])}><g class="wsi-pt" style={`--d:${p.dep}`}><g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-map-${p.cls} wsi-breathe`} style={`--lift:${p.lift}px;animation-delay:${p.d}s`}>
        <rect x={-p.w / 2} y="-15" width={p.w} height="38" rx="19" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="19" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
        <circle cx={-p.w / 2 + 22} cy="0" r="6" fill={p.dot}></circle>
        <text x={-p.w / 2 + 38} y="5" font-size="14" font-weight="600" fill={C.ink}>{p.l}</text>
      </g>
    </g>
    </g></g>
  ))}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wsi-breathe { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -6px) * var(--amp, 1)); } }
    @keyframes wsi-map-shade { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: 0.92; opacity: 0.7; } }
    @keyframes wsi-map-ring {
      0% { scale: 0.9; opacity: 0.7; }
      100% { scale: 1.15; opacity: 0; }
    }
    .wsi-map-base, .wsi-map-f2, .wsi-map-f3, .wsi-map-shadow, .wsi-map-pshadow, .wsi-map-ring {
      transform-box: fill-box;
      transform-origin: center;
      will-change: translate, scale;
    }
    .wsi-breathe { animation: wsi-breathe 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-map-base { --lift: -2px; }
    .wsi-map-shadow { animation: wsi-map-shade 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-map-pshadow { animation: wsi-map-shade 6.5s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-map-ring { animation: wsi-map-ring 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-map-f2 { --lift: -12px; }
    .wsi-map-f3 { --lift: -14px; }
  }
</style>
