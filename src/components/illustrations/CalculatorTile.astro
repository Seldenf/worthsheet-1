---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9' };
const iso = (cx: number, cy: number, s: number, k = 1) => `matrix(${k} ${-k / 2} ${k} ${k / 2} ${cx - s * k} ${cy})`;
const inStyle = (d: number, dur: number, y: number, s = 1) => `--in-d:${d}ms;--in-dur:${dur}ms;--in-y:${y}px;--in-s:${s};transform-box:fill-box;transform-origin:center`;

const labels = ['7', '8', '9', '÷', '4', '5', '6', '×', '1', '2', '3', '='];
const keys = labels.map((t, i) => {
  const c = i % 4;
  const r = Math.floor(i / 4);
  return { t, x: 12 + c * 28, y: 54 + r * 24, op: c === 3, eq: t === '=' };
});
const pills = [
  { x: 108, y: 150, l: 'DTI', v: '28%', dot: C.blue, cls: 'f2', lift: -12, d: 0.8, dep: 1.3, ent: [650, 520, 14] },
  { x: 462, y: 372, l: 'Net worth', v: '', dot: C.green, cls: 'f3', lift: -14, d: 1.2, dep: 0.9, ent: [880, 480, -16] },
].map((p) => ({ ...p, w: Math.round((p.l.length + p.v.length + 1) * 15 * 0.54) + 48 }));
---

<svg
  class:list={['wsi', 'wsi-calc', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 104 560 330"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-calc-blur" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter>
  </defs>

  <!-- base layer (plain wrappers carry the animation; iso groups keep their attribute transform) -->
  <g class="wsi-in" style={inStyle(0, 1000, 10, 0.96)}><g class="wsi-pt" style="--d:0.25"><g class="wsi-calc-base wsi-breathe"><g transform={iso(280, 300, 240)}><rect width="240" height="240" rx="26" fill={C.tG} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect></g></g></g></g>
  <g class="wsi-in" style={inStyle(100, 900, 10, 0.96)}><g class="wsi-pt" style="--d:0.25"><g class="wsi-calc-base wsi-breathe"><g transform={iso(280, 300, 196)}><rect width="196" height="196" rx="22" fill={C.tB} stroke="#fff" stroke-width="2"></rect></g></g></g></g>

  <!-- mid layer: calculator body (keys and display are part of the body face) -->
  <g class="wsi-in" style={inStyle(250, 800, 22, 0.94)}><g class="wsi-pt" style="--d:0.6">
    <g class="wsi-in" style={inStyle(200, 1000, 0, 0.9)}><g class="wsi-calc-shadow"><g transform={iso(280, 320, 170)}><rect width="170" height="170" rx="16" fill={C.ink} fill-opacity=".09" filter="url(#wsi-calc-blur)"></rect></g></g></g>
    <g class="wsi-calc-f1 wsi-breathe">
    <g transform={iso(280, 266, 130, 1.18)}><rect width="130" height="130" rx="16" fill="#cfcdcb"></rect></g>
    <g transform={iso(280, 252, 130, 1.18)}>
      <rect width="130" height="130" rx="16" fill="#fff" stroke={C.ink} stroke-opacity=".2"></rect>
      <rect x="12" y="12" width="106" height="30" rx="8" fill={C.ink}></rect>
      <text class="wsi-calc-display" x="110" y="33" font-size="15" font-weight="600" fill="#fff" text-anchor="end">$226,300</text>
      <path class="wsi-draw" pathLength="100" d="M38 39H110" fill="none" stroke={C.blue} stroke-width="2" stroke-linecap="round" style="--draw-d:700ms"></path>
      {keys.map((k, i) => (
        <g class="wsi-calc-key" style={`animation-delay:-${(i * 0.9).toFixed(1)}s`}>
          <rect x={k.x} y={k.y} width="22" height="18" rx="6" fill={k.eq ? C.yellow : k.op ? C.tB : C.surface}></rect>
          <text x={k.x + 11} y={k.y + 13} font-size="12" font-weight="600" fill={C.ink} text-anchor="middle">{k.t}</text>
        </g>
      ))}
    </g>
  </g></g></g>

  <!-- top layer: check -->
  <g class="wsi-extra">
  <g class="wsi-in" style={inStyle(800, 500, -18, 0.9)}><g class="wsi-pt" style="--d:1.6"><g transform="translate(436 150)">
    <g class="wsi-calc-f2 wsi-breathe" style="--lift:-10px;animation-delay:.3s">
      <circle r="27" fill={C.ink} fill-opacity=".08" transform="translate(0 8)"></circle>
      <circle r="25" fill={C.green} stroke="#fff" stroke-width="3"></circle>
      <path class="wsi-draw" pathLength="100" d="m-11 1 8 8 14-16" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" style="--draw-d:1000ms"></path>
    </g>
  </g>
  </g></g>
  </g>

  <!-- top layer: pills -->
  <g class="wsi-extra">
  {pills.map((p) => (
    <g class="wsi-in" style={inStyle(p.ent[0], p.ent[1], p.ent[2])}><g class="wsi-pt" style={`--d:${p.dep}`}><g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-calc-${p.cls} wsi-breathe`} style={`--lift:${p.lift}px;animation-delay:${p.d}s`}>
        <rect x={-p.w / 2} y="-15" width={p.w} height="38" rx="4" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="4" fill="#fff" stroke="#e3e0dd" stroke-width="1"></rect>
        <rect x={-p.w / 2 + 18.5} y="-3.5" width="7" height="7" rx="1.5" fill={p.dot}></rect>
        <text x={-p.w / 2 + 38} y="5" font-size="15" fill={C.ink}>
          <tspan fill-opacity={p.v ? '.66' : undefined} font-weight={p.v ? 500 : 600}>{p.l}</tspan>{p.v && ' '}{p.v && <tspan font-weight="700">{p.v}</tspan>}
        </text>
      </g>
    </g>
    </g></g>
  ))}
  </g>
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wsi-breathe { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -6px) * var(--amp, 1)); } }
    @keyframes wsi-calc-shade { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: 0.92; opacity: 0.7; } }
    @keyframes wsi-calc-tap { 0%, 100% { opacity: 1; } 50% { opacity: 0.86; } }
    .wsi-calc-base, .wsi-calc-f1, .wsi-calc-f2, .wsi-calc-f3, .wsi-calc-shadow {
      transform-box: fill-box;
      transform-origin: center;
      will-change: translate, scale;
    }
    .wsi-breathe { animation: wsi-breathe 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-calc-base { --lift: -2px; }
    .wsi-calc-f1 { --lift: -7px; }
    .wsi-calc-f2 { --lift: -12px; }
    .wsi-calc-f3 { --lift: -14px; }
    .wsi-calc-shadow { animation: wsi-calc-shade 7s cubic-bezier(0.45, 0, 0.55, 1) 0.4s infinite; }
    .wsi-calc-display { animation: wsi-calc-tap 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-calc-key { animation: wsi-calc-tap 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  }
</style>
