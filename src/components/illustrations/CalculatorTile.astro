---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9' };
const iso = (cx: number, cy: number, s: number, k = 1) => `matrix(${k} ${-k / 2} ${k} ${k / 2} ${cx - s * k} ${cy})`;

const labels = ['7', '8', '9', '÷', '4', '5', '6', '×', '1', '2', '3', '='];
const keys = labels.map((t, i) => {
  const c = i % 4;
  const r = Math.floor(i / 4);
  return { t, x: 12 + c * 28, y: 54 + r * 24, op: c === 3, eq: t === '=' };
});
const pills = [
  { x: 108, y: 150, l: 'DTI', v: '28%', dot: C.blue, cls: 'f2' },
  { x: 462, y: 372, l: 'Net worth', v: '', dot: C.green, cls: 'f3' },
].map((p) => ({ ...p, w: Math.round((p.l.length + p.v.length + 1) * 15 * 0.54) + 48 }));
---

<svg
  class:list={['wsi', 'wsi-calc', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 104 560 330"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-calc-blur" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter>
  </defs>

  <g transform={iso(280, 300, 240)}><rect width="240" height="240" rx="26" fill={C.tG} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect></g>
  <g transform={iso(280, 300, 196)}><rect width="196" height="196" rx="22" fill={C.tB} stroke="#fff" stroke-width="2"></rect></g>
  <g transform={iso(280, 320, 170)}><rect width="170" height="170" rx="16" fill={C.ink} fill-opacity=".09" filter="url(#wsi-calc-blur)"></rect></g>

  <g class="wsi-calc-f1">
    <g transform={iso(280, 266, 130, 1.18)}><rect width="130" height="130" rx="16" fill="#cfcdcb"></rect></g>
    <g transform={iso(280, 252, 130, 1.18)}>
      <rect width="130" height="130" rx="16" fill="#fff" stroke={C.ink} stroke-opacity=".2"></rect>
      <rect x="12" y="12" width="106" height="30" rx="8" fill={C.ink}></rect>
      <text x="110" y="33" font-size="15" font-weight="600" fill="#fff" text-anchor="end">$226,300</text>
      {keys.map((k) => (
        <g>
          <rect x={k.x} y={k.y} width="22" height="18" rx="6" fill={k.eq ? C.yellow : k.op ? C.tB : C.surface}></rect>
          <text x={k.x + 11} y={k.y + 13} font-size="12" font-weight="600" fill={C.ink} text-anchor="middle">{k.t}</text>
        </g>
      ))}
    </g>
  </g>

  <g class="wsi-calc-f2" transform="translate(436 150)">
    <circle r="27" fill={C.ink} fill-opacity=".08" transform="translate(0 8)"></circle>
    <circle r="25" fill={C.green} stroke="#fff" stroke-width="3"></circle>
    <path d="m-11 1 8 8 14-16" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
  </g>

  {pills.map((p) => (
    <g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-calc-${p.cls}`}>
        <rect x={-p.w / 2} y="-15" width={p.w} height="38" rx="19" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="19" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
        <circle cx={-p.w / 2 + 22} cy="0" r="6" fill={p.dot}></circle>
        <text x={-p.w / 2 + 38} y="5" font-size="15" fill={C.ink}>
          <tspan fill-opacity={p.v ? '.66' : undefined} font-weight={p.v ? 500 : 600}>{p.l}</tspan>{p.v && ' '}{p.v && <tspan font-weight="700">{p.v}</tspan>}
        </text>
      </g>
    </g>
  ))}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-calc-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-calc-f1 { animation: wsi-calc-float 6s ease-in-out infinite; }
    .wsi-calc-f2 { animation: wsi-calc-float 7s ease-in-out -2s infinite; }
    .wsi-calc-f3 { animation: wsi-calc-float 8s ease-in-out -4s infinite; }
  }
</style>
