---
/**
 * One isometric tile per "How to use" step, drawn in the same language as the other illustrations
 * (2:1 isometric square, darker side, white edge, flat outline icon). Colours match the step's
 * number chip: 1 blue, 2 green, 3 yellow, 4 navy. Static; the page lifts `.lift` on hover.
 */
interface Props {
  step: 1 | 2 | 3 | 4;
  class?: string;
}
const { step, class: className } = Astro.props;

const P = {
  1: { fill: '#6cbee4', side: '#4a9fc8', pad: '#e2f2f9', icon: '<path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/>' },
  2: { fill: '#0f9d58', side: '#0a7a43', pad: '#e2f9e9', icon: '<path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12.5h6M9 16h6M12 10v8"/>' },
  3: { fill: '#fac344', side: '#d9a02a', pad: '#f9f2e2', icon: '<path d="M4 20l1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19zM14 7l3 3"/>' },
  4: {
    fill: '#0c2635',
    side: '#06141c',
    pad: '#e6edf1',
    icon: '<path d="M7 9V4h10v5M7 17H5a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2M7 14h10v6H7z"/>',
  },
} as const;
const t = P[step];

// 2:1 isometric square of side s centred on (cx, cy).
const iso = (cx: number, cy: number, s: number) => `matrix(1 -.5 1 .5 ${cx - s} ${cy})`;
const S = 52; // tile side
const CX = 80;
const CY = 52; // tile top-face centre
const k = (S * 0.58) / 24; // icon scale (24px icon grid)
---

<svg
  class:list={['step-tile', className]}
  viewBox="0 0 160 120"
  width="160"
  height="120"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id={`step-tile-blur-${step}`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="4"></feGaussianBlur>
    </filter>
  </defs>

  <!-- ground pad and a soft contact shadow under the floating tile stay put. The animated class
       sits on a wrapper so its CSS transform-origin never shifts the isometric transform. -->
  <g transform={iso(CX, CY + 28, 70)}><rect width="70" height="70" rx="12" fill={t.pad} stroke="#fff" stroke-width="2"></rect></g>
  <g class="shadow">
    <g transform={iso(CX + 2, CY + 30, S - 6)} filter={`url(#step-tile-blur-${step})`}>
      <rect width={S - 6} height={S - 6} rx="9" fill="#0c2635" fill-opacity=".18"></rect>
    </g>
  </g>

  <!-- the tile itself lifts on hover -->
  <g class="lift">
    <g transform={iso(CX, CY + 8, S)}><rect width={S} height={S} rx="9" fill={t.side}></rect></g>
    <g transform={iso(CX, CY, S)}><rect width={S} height={S} rx="9" fill={t.fill} stroke="#fff" stroke-width="2"></rect></g>
    <g
      transform={`translate(${CX - 12 * k} ${CY - 12 * k - 1}) scale(${k})`}
      stroke="#fff"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
      set:html={t.icon}
    ></g>
  </g>
</svg>

<style>
  .step-tile {
    display: block;
    width: 120px;
    height: auto;
    overflow: visible;
  }

  .lift,
  .shadow {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
