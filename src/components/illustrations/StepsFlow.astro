---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', tC: '#f9f2e2', sheets: '#0f9d58' };
const iso = (cx: number, cy: number, s: number) => `matrix(1 -.5 1 .5 ${cx - s} ${cy})`;

const ICONS = [
  '<path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/>',
  '<path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12.5h6M9 16h6M12 10v8"/>',
  '<path d="M4 20l1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19zM14 7l3 3"/>',
  '<path d="M7 9V4h10v5M7 17H5a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2M7 14h10v6H7z"/>',
];
const steps = [
  { x: 120, y: 200, fill: C.blue, side: '#4a9fc8', ink: '#fff', pad: C.tB },
  { x: 360, y: 130, fill: C.sheets, side: '#0a7a43', ink: '#fff', pad: C.tG },
  { x: 600, y: 200, fill: C.yellow, side: '#d9a02a', ink: '#fff', pad: C.tC },
  { x: 840, y: 130, fill: C.tG, side: '#b6e2c1', ink: '#2f8a39', pad: C.tG },
];
const GAP = 34; // pad sits this far below the tile
const S = 64; // tile side
const k = (S * 0.58) / 24;
let path = `M${steps[0].x} ${steps[0].y + GAP}`;
for (let i = 1; i < steps.length; i++) {
  const a = steps[i - 1];
  const b = steps[i];
  path += `C${a.x + 120} ${a.y + GAP} ${b.x - 120} ${b.y + GAP} ${b.x} ${b.y + GAP}`;
}
---

<svg
  class:list={['wsi', 'wsi-steps', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 36 960 250"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}

  {steps.map((t) => (
    <g transform={iso(t.x, t.y + GAP, 88)}>
      <rect width="88" height="88" rx="14" fill={t.pad} stroke="#fff" stroke-width="2"></rect>
    </g>
  ))}

  <path d={path} stroke={C.ink} stroke-opacity=".35" stroke-width="2.5" stroke-dasharray="8 10" stroke-linecap="round" fill="none"></path>

  {steps.map((t, i) => (
    <g>
      <g transform={iso(t.x + 4, t.y + GAP + 6, S)}><rect width={S} height={S} rx="10" fill={C.ink} fill-opacity=".1"></rect></g>
      <g class={`wsi-steps-f${(i % 3) + 1}`}>
        <g transform={iso(t.x, t.y + 8, S)}><rect width={S} height={S} rx="10" fill={t.side}></rect></g>
        <g transform={iso(t.x, t.y, S)}><rect width={S} height={S} rx="10" fill={t.fill} stroke="#fff" stroke-width="2"></rect></g>
        <g
          transform={`translate(${t.x - 12 * k} ${t.y - 12 * k - 2}) scale(${k})`}
          color={t.ink}
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
          set:html={ICONS[i]}
        ></g>
        <circle cx={t.x} cy={t.y - 54} r="17" fill={C.ink} stroke="#fff" stroke-width="3"></circle>
        <text x={t.x} y={t.y - 48} font-size="17" font-weight="700" fill="#fff" text-anchor="middle">{i + 1}</text>
      </g>
    </g>
  ))}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-steps-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-steps-f1 { animation: wsi-steps-float 6s ease-in-out infinite; }
    .wsi-steps-f2 { animation: wsi-steps-float 7s ease-in-out -2s infinite; }
    .wsi-steps-f3 { animation: wsi-steps-float 8s ease-in-out -4s infinite; }
  }
</style>
