---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', tC: '#f9f2e2', sheets: '#0f9d58' };
const iso = (cx: number, cy: number, s: number) => `matrix(1 -.5 1 .5 ${cx - s} ${cy})`;
// Breathing layers: base 0s, mid +0.4s, top +0.8s; steps ripple left to right.
const lag = (s: number) => `animation-delay:${s.toFixed(2)}s`;
const jit = (i: number, amp: number) => (((i * 0.618) % 1) - 0.5) * 2 * amp;

const ICONS = [
  '<path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/>',
  '<path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12.5h6M9 16h6M12 10v8"/>',
  '<path d="M4 20l1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19zM14 7l3 3"/>',
  '<path d="M7 9V4h10v5M7 17H5a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2M7 14h10v6H7z"/>',
];
// Centers sit on quarter columns of the 960-wide viewBox (12.5%, 37.5%, 62.5%, 87.5%).
// Zig-zag: tiles 1 & 3 low, 2 & 4 high.
const LOW = 196;
const HIGH = 150;
const steps = [
  { x: 120, y: LOW, fill: C.blue, side: '#4a9fc8', ink: '#fff', pad: C.tB },
  { x: 360, y: HIGH, fill: C.sheets, side: '#0a7a43', ink: '#fff', pad: C.tG },
  { x: 600, y: LOW, fill: C.yellow, side: '#d9a02a', ink: '#fff', pad: C.tC },
  { x: 840, y: HIGH, fill: C.tG, side: '#b6e2c1', ink: '#2f8a39', pad: C.tG },
];
const GAP = 34; // pad sits this far below the tile
const S = 64; // tile side
const k = (S * 0.58) / 24;
let path = `M${steps[0].x} ${steps[0].y + GAP}`;
for (let i = 1; i < steps.length; i++) {
  const a = steps[i - 1];
  const b = steps[i];
  path += `C${a.x + 120} ${a.y + GAP} ${b.x - 120} ${b.y + GAP} ${b.x} ${b.y + GAP}`;
}
---

<svg
  class:list={['wsi', 'wsi-steps', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 62 960 216"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}

  <!-- pads (base) -->
  {steps.map((t, i) => (
    <g class={`wsi-steps-base wsi-steps-n${i + 1}`}><g transform={iso(t.x, t.y + GAP, 88)}>
      <rect width="88" height="88" rx="14" fill={t.pad} stroke="#fff" stroke-width="2"></rect>
    </g></g>
  ))}

  <path class="wsi-steps-path" d={path} stroke={C.ink} stroke-opacity=".35" stroke-width="2.5" stroke-dasharray="8 10" stroke-linecap="round" fill="none"></path>
  <!-- progress: same route, shown up to the active step via data-active on <svg> -->
  <path class="wsi-steps-progress" d={path} pathLength="100" stroke={C.ink} stroke-opacity=".55" stroke-width="2.5" stroke-linecap="round" fill="none"></path>

  {steps.map((t, i) => (
    <g class={`wsi-steps-n${i + 1}`}>
      <g class="wsi-steps-sh-mid" style={lag(0.4 + i * 0.4)}><g transform={iso(t.x + 4, t.y + GAP + 6, S)}><rect width={S} height={S} rx="10" fill={C.ink} fill-opacity=".1"></rect></g></g>
      <g class="wsi-steps-mid" style={lag(0.4 + i * 0.4)}>
        <g transform={iso(t.x, t.y + 8, S)}><rect width={S} height={S} rx="10" fill={t.side}></rect></g>
        <g transform={iso(t.x, t.y, S)}><rect width={S} height={S} rx="10" fill={t.fill} stroke="#fff" stroke-width="2"></rect></g>
      </g>
      <g class="wsi-steps-top" style={lag(0.8 + i * 0.4 + jit(i, 0.3))}>
        <g
          transform={`translate(${t.x - 12 * k} ${t.y - 12 * k - 2}) scale(${k})`}
          color={t.ink}
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
          set:html={ICONS[i]}
        ></g>
        <circle cx={t.x} cy={t.y - 54} r="17" fill={C.ink} stroke="#fff" stroke-width="3"></circle>
        <text x={t.x} y={t.y - 48} font-size="17" font-weight="700" fill="#fff" text-anchor="middle">{i + 1}</text>
      </g>
    </g>
  ))}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-steps-base { 0%, 100% { translate: 0 0; } 50% { translate: 0 -2px; } }
  @keyframes wsi-steps-mid { 0%, 100% { translate: 0 0; } 50% { translate: 0 -7px; } }
  @keyframes wsi-steps-top { 0%, 100% { translate: 0 0; } 50% { translate: 0 -12px; } }
  @keyframes wsi-steps-shadow { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: .92; opacity: .7; } }
  @keyframes wsi-steps-dash { to { stroke-dashoffset: -18; } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-steps-base, .wsi-steps-mid, .wsi-steps-top { transform-box: fill-box; transform-origin: center; will-change: translate; }
    .wsi-steps-sh-mid { transform-box: fill-box; transform-origin: center; will-change: scale, opacity; }
    .wsi-steps-base { animation: wsi-steps-base 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-steps-mid { animation: wsi-steps-mid 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-steps-top { animation: wsi-steps-top 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-steps-sh-mid { animation: wsi-steps-shadow 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-steps-path { animation: wsi-steps-dash 9s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  }

  /* Sequential highlight: only applies when <svg data-active="1..4"> is set by the page. */
  .wsi-steps-progress { opacity: 0; stroke-dasharray: 100; stroke-dashoffset: 100; }
  svg[data-active] .wsi-steps-progress { opacity: 1; }
  svg[data-active="1"] .wsi-steps-progress { stroke-dashoffset: 100; }
  svg[data-active="2"] .wsi-steps-progress { stroke-dashoffset: 66; }
  svg[data-active="3"] .wsi-steps-progress { stroke-dashoffset: 33; }
  svg[data-active="4"] .wsi-steps-progress { stroke-dashoffset: 0; }

  svg[data-active] .wsi-steps-n1, svg[data-active] .wsi-steps-n2,
  svg[data-active] .wsi-steps-n3, svg[data-active] .wsi-steps-n4 { filter: grayscale(.9); opacity: .45; }
  svg[data-active="1"] .wsi-steps-n1, svg[data-active="2"] .wsi-steps-n2,
  svg[data-active="3"] .wsi-steps-n3, svg[data-active="4"] .wsi-steps-n4 {
    filter: drop-shadow(0 8px 16px rgba(46,41,38,.18));
    opacity: 1;
    translate: 0 -6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wsi-steps-n1, .wsi-steps-n2, .wsi-steps-n3, .wsi-steps-n4 {
      transition: filter 600ms cubic-bezier(0.23, 1, 0.32, 1), opacity 600ms cubic-bezier(0.23, 1, 0.32, 1), translate 600ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .wsi-steps-progress {
      transition: opacity 600ms cubic-bezier(0.23, 1, 0.32, 1), stroke-dashoffset 900ms ease-out;
    }
  }
</style>
