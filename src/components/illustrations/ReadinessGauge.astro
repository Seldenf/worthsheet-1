---
interface Props {
  class?: string;
  title?: string;
  /** Active rating: 0 Poor · 1 Fair · 2 Good · 3 Very Good · 4 Excellent */
  level?: 0 | 1 | 2 | 3 | 4;
  /** Prefix for internal ids; set a distinct one when the gauge appears more than once on a page. */
  idPrefix?: string;
}
const { class: className, title, level = 3, idPrefix = 'wsi-gauge' } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', tB: '#e2f2f9', tG: '#e2f9e9' };
const iso = (cx: number, cy: number, s: number) => `matrix(1 -.5 1 .5 ${cx - s} ${cy})`;
const inStyle = (d: number, dur: number, y: number, s = 1) => `--in-d:${d}ms;--in-dur:${dur}ms;--in-y:${y}px;--in-s:${s};transform-box:fill-box;transform-origin:center`;

const CX = 300;
const CY = 276;
const R_OUT = 200;
const R_IN = 128;
const INSET = 4; // stroke of width 2*INSET rounds the corners
const GAP = 3; // degrees between segments
const segs = [
  { name: 'Poor', fill: '#ee9a86', dark: '#d97a64' },
  { name: 'Fair', fill: '#fac344', dark: '#d9a02a' },
  { name: 'Good', fill: '#a8d672', dark: '#84b24d' },
  { name: 'Very Good', fill: '#40aa4a', dark: '#2f8a39' },
  { name: 'Excellent', fill: '#0f9d58', dark: '#0a7a43' },
];
const rad = (d: number) => (d * Math.PI) / 180;
const pt = (r: number, deg: number) => `${(CX + r * Math.cos(rad(deg))).toFixed(1)} ${(CY - r * Math.sin(rad(deg))).toFixed(1)}`;
const sector = (i: number) => {
  const a0 = 180 - 36 * i - GAP / 2 - 1.2;
  const a1 = 180 - 36 * (i + 1) + GAP / 2 + 1.2;
  const ro = R_OUT - INSET;
  const ri = R_IN + INSET;
  return `M${pt(ro, a0)}A${ro} ${ro} 0 0 1 ${pt(ro, a1)}L${pt(ri, a1)}A${ri} ${ri} 0 0 0 ${pt(ri, a0)}z`;
};
const labels = segs.map((s, i) => {
  const deg = 180 - 36 * i - 18;
  const x = CX + (R_OUT + 20) * Math.cos(rad(deg));
  const y = CY - (R_OUT + 20) * Math.sin(rad(deg));
  const anchor = Math.abs(deg - 90) < 10 ? 'middle' : deg > 90 ? 'end' : 'start';
  return { t: s.name, x: +x.toFixed(1), y: +(y + (deg > 90 || deg < 90 ? 2 : -2)).toFixed(1), anchor };
});

// needle
const nd = 180 - 36 * level - 18;
const tip = pt(R_IN - 18, nd);
const baseA = pt(11, nd + 90);
const baseB = pt(11, nd - 90);
---

<svg
  class:list={['wsi', 'wsi-gauge', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 20 600 410"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id={`${idPrefix}-blur`} x="-20%" y="-30%" width="140%" height="160%"><feGaussianBlur stdDeviation="8"></feGaussianBlur></filter>
  </defs>

  <g class="wsi-in" style={inStyle(0, 1000, 10, 0.96)}><g class="wsi-gauge-base"><g transform={iso(CX, CY + 40, 196)}><rect width="196" height="196" rx="26" fill={C.tB} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect></g></g></g>
  <g class="wsi-in" style={inStyle(100, 900, 10, 0.96)}><g class="wsi-gauge-base"><g transform={iso(CX, CY + 40, 150)}><rect width="150" height="150" rx="22" fill={C.tG} fill-opacity=".7" stroke="#fff" stroke-width="2"></rect></g></g></g>
  <g class="wsi-in" style={inStyle(200, 1000, 0, 0.9)}><ellipse class="wsi-gauge-shadow" cx={CX} cy={CY + 40} rx="170" ry="26" fill={C.ink} fill-opacity=".07" filter={`url(#${idPrefix}-blur)`}></ellipse></g>

  <g class="wsi-gauge-f1">
    {segs.map((s, i) => (
      <g class="wsi-in" style={inStyle(300 + i * 80, 520, 12, 0.94)} opacity={i === level ? 1 : 0.4}>
        <path d={sector(i)} fill={s.dark} stroke={s.dark} stroke-width={INSET * 2} stroke-linejoin="round" transform="translate(0 9)"></path>
        <path d={sector(i)} fill={s.fill} stroke={s.fill} stroke-width={INSET * 2} stroke-linejoin="round"></path>
      </g>
    ))}
    <g class="wsi-in" style={inStyle(900, 480, 10)}><g font-size="14" font-weight="600" fill={C.ink}>
      {labels.map((l, i) => (
        <text x={l.x} y={l.y} text-anchor={l.anchor} fill-opacity={i === level ? 1 : 0.6}>{l.t}</text>
      ))}
    </g></g>
    <path d={`M${tip}L${baseA}L${baseB}z`} fill={C.ink} stroke={C.ink} stroke-width="4" stroke-linejoin="round"></path>
    <circle cx={CX} cy={CY} r="18" fill={C.ink} stroke="#fff" stroke-width="4"></circle>
    <circle cx={CX} cy={CY} r="5" fill="#fff"></circle>
    <g class="wsi-in" style={inStyle(900, 480, 10)}><text x={CX} y={CY + 62} font-size="24" font-weight="700" fill={C.ink} text-anchor="middle">{segs[level].name}</text></g>
  </g>
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wsi-gauge-breathe { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift) * -1); } }
    @keyframes wsi-gauge-shade { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: 0.92; opacity: 0.7; } }
    @keyframes wsi-gauge-glow { 0%, 100% { opacity: 1; } 50% { opacity: 0.8; } }
    .wsi-gauge-base, .wsi-gauge-f1, .wsi-gauge-shadow {
      transform-box: fill-box;
      transform-origin: center;
      will-change: translate, scale;
    }
    .wsi-gauge-base { --lift: 2px; animation: wsi-gauge-breathe 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-gauge-f1 { --lift: 7px; animation: wsi-gauge-breathe 7s cubic-bezier(0.45, 0, 0.55, 1) 0.4s infinite; }
    .wsi-gauge-shadow { animation: wsi-gauge-shade 7s cubic-bezier(0.45, 0, 0.55, 1) 0.4s infinite; }
    .wsi-gauge-f1 > g[opacity="1"] > path:last-of-type { animation: wsi-gauge-glow 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  }
</style>
