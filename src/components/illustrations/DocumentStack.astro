---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', tC: '#f9f2e2', sheets: '#0f9d58' };
const W = 200;
const H = 262;
const OX = 99;
const OY = 236;
const at = (dy: number) => `matrix(1 -.5 1 .5 ${OX} ${OY + dy})`;
const inStyle = (d: number, dur: number, y: number, s = 1) => `--in-d:${d}ms;--in-dur:${dur}ms;--in-y:${y}px;--in-s:${s};transform-box:fill-box;transform-origin:center`;

const assets = [['Checking', '$18,400'], ['Savings', '$45,000'], ['Retirement', '$149,100'], ['Real estate', '$200,000']];
const liabs = [['Mortgage', '$168,000'], ['Student loans', '$11,200'], ['Credit cards', '$7,000']];
const pills = [
  { x: 140, y: 120, l: 'Printable PDF', v: '', dot: C.blue, cls: 'f2', lift: -12, d: 0.8, dep: 0.9, ent: [940, 460, 14] },
  { x: 546, y: 396, l: 'Net worth', v: '$226,300', dot: C.green, cls: 'f3', lift: -14, d: 1.2, dep: 1.4, ent: [960, 440, -16] },
].map((p) => ({ ...p, w: Math.round((p.l.length + p.v.length + 1) * 14 * 0.54) + 48 }));
---

<svg
  class:list={['wsi', 'wsi-docs', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 60 660 400"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-docs-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="8"></feGaussianBlur></filter>
  </defs>

  <!-- base layer: plain wrappers carry the animation; matrix groups keep their attribute transform -->
  <g class="wsi-in" style={inStyle(0, 1000, 10, 0.96)}><g class="wsi-docs-base wsi-breathe"><g transform={at(0)}><rect x="-40" y="-40" width={W + 80} height={H + 80} rx="30" fill={C.tB} fill-opacity=".5" stroke="#fff" stroke-width="2"></rect></g></g></g>

  <!-- back sheets: lift increases toward the top of the stack -->
  <g class="wsi-docs-enter" style="--i:0"><g class="wsi-docs-s1 wsi-breathe" style="--lift:-2px;animation-delay:0s"><g transform={at(26)}><rect width={W} height={H} rx="12" fill="#d6d4d2"></rect></g></g></g>
  <g class="wsi-docs-enter" style="--i:1"><g class="wsi-docs-s2 wsi-breathe" style="--lift:-3px;animation-delay:.1s"><g transform={at(18)}><rect width={W} height={H} rx="12" fill={C.surface} stroke="#fff" stroke-width="2"></rect></g></g></g>
  <g class="wsi-docs-enter" style="--i:2"><g class="wsi-docs-s3 wsi-breathe" style="--lift:-5px;animation-delay:.2s"><g transform={at(12)}><rect width={W} height={H} rx="12" fill="#d6d4d2"></rect></g></g></g>
  <g class="wsi-docs-enter" style="--i:3"><g class="wsi-docs-s4 wsi-breathe" style="--lift:-7px;animation-delay:.3s"><g transform={at(6)}><rect width={W} height={H} rx="12" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect></g></g></g>

  <!-- top sheet -->
  <g class="wsi-docs-enter" style="--i:4"><g class="wsi-pt" style="--d:0.5">
  <g class="wsi-in" style={inStyle(120, 900, 0, 0.9)}><g class="wsi-docs-shadow"><g transform={at(46)}><rect width={W} height={H} rx="12" fill={C.ink} fill-opacity=".14" filter="url(#wsi-docs-blur)"></rect></g></g></g>
  <g class="wsi-docs-f1 wsi-breathe">
    <g transform={at(0)}>
      <rect width={W} height={H} rx="12" fill="#fff" stroke={C.ink} stroke-opacity=".2"></rect>
      <path d="M0 12a12 12 0 0 1 12-12h176a12 12 0 0 1 12 12v8H0z" fill={C.sheets}></path>
      <text x="16" y="42" font-size="11" font-weight="700" fill={C.ink}>Personal Financial Statement</text>
      <rect x="12" y="52" width="176" height="15" rx="4" fill={C.tG}></rect>
      <text x="18" y="63" font-size="9.5" font-weight="700" fill="#2f8a39">Assets</text>
      <g font-size="9.5" fill={C.ink} font-weight="500">
        {assets.map(([l, v], i) => (
          <g>
            <text x="18" y={82 + i * 15}>{l}</text>
            <text x="182" y={82 + i * 15} text-anchor="end">{v}</text>
          </g>
        ))}
      </g>
      <rect x="12" y="130" width="176" height="15" rx="4" fill={C.tC}></rect>
      <text x="18" y="141" font-size="9.5" font-weight="700" fill="#a8730a">Liabilities</text>
      <g font-size="9.5" fill={C.ink} font-weight="500">
        {liabs.map(([l, v], i) => (
          <g>
            <text x="18" y={160 + i * 15}>{l}</text>
            <text x="182" y={160 + i * 15} text-anchor="end">{v}</text>
          </g>
        ))}
      </g>
      <path d="M12 196H188" stroke={C.ink} stroke-opacity=".5" stroke-width="1.2"></path>
      <text x="18" y="211" font-size="10.5" font-weight="700" fill={C.ink}>Net worth</text>
      <text x="182" y="211" font-size="10.5" font-weight="700" fill={C.ink} text-anchor="end">$226,300</text>
      <g class="wsi-extra">
      <ellipse class="wsi-draw" pathLength="100" cx="156.5" cy="207.5" rx="36" ry="9.5" fill="none" stroke={C.green} stroke-width="1.6" style="--draw-d:1100ms"></ellipse>
      </g>
      <path class="wsi-draw" pathLength="100" d="M20 236c8-14 12-14 14-4s4 6 8-2 8-8 10 0 6 4 12-2" stroke="#3f9cc9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" style="--draw-d:300ms"></path>
      <path d="M16 244H112M130 244H184" stroke={C.ink} stroke-opacity=".5" stroke-width="1"></path>
      <g font-size="7" fill={C.ink} fill-opacity=".66"><text x="16" y="253">Signature</text><text x="130" y="253">Date</text></g>
    </g>
  </g>
  </g>
  </g>

  <!-- top layer: signed check -->
  <g class="wsi-extra">
  <g class="wsi-in" style={inStyle(860, 460, -18, 0.9)}><g class="wsi-pt" style="--d:1.6"><g transform="translate(572 168)">
    <g class="wsi-docs-f2 wsi-breathe" style="--lift:-10px;animation-delay:.5s">
      <circle r="27" fill={C.ink} fill-opacity=".08" transform="translate(0 8)"></circle>
      <circle r="25" fill={C.green} stroke="#fff" stroke-width="3"></circle>
      <path d="m-11 1 8 8 14-16" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
    </g>
  </g>
  </g></g>
  </g>

  <!-- top layer: pills -->
  <g class="wsi-extra">
  {pills.map((p) => (
    <g class="wsi-in" style={inStyle(p.ent[0], p.ent[1], p.ent[2])}><g class="wsi-pt" style={`--d:${p.dep}`}><g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-docs-${p.cls} wsi-breathe`} style={`--lift:${p.lift}px;animation-delay:${p.d}s`}>
        <rect x={-p.w / 2} y="-15" width={p.w} height="38" rx="4" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="4" fill="#fff" stroke="#e3e0dd" stroke-width="1"></rect>
        <rect x={-p.w / 2 + 18.5} y="-3.5" width="7" height="7" rx="1.5" fill={p.dot}></rect>
        <text x={-p.w / 2 + 38} y="5" font-size="14" fill={C.ink}>
          <tspan fill-opacity={p.v ? '.66' : undefined} font-weight={p.v ? 500 : 600}>{p.l}</tspan>{p.v && ' '}{p.v && <tspan font-weight="700">{p.v}</tspan>}
        </text>
      </g>
    </g>
    </g></g>
  ))}
  </g>
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wsi-breathe { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -6px) * var(--amp, 1)); } }
    @keyframes wsi-docs-shade { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: 0.92; opacity: 0.7; } }
    .wsi-docs-base, .wsi-docs-s1, .wsi-docs-s2, .wsi-docs-s3, .wsi-docs-s4, .wsi-docs-f1, .wsi-docs-f2, .wsi-docs-f3, .wsi-docs-shadow {
      transform-box: fill-box;
      transform-origin: center;
      will-change: translate, scale;
    }
    .wsi-breathe { animation: wsi-breathe 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-docs-base { --lift: -2px; }
    .wsi-docs-f1 { --lift: -9px; }
    .wsi-docs-f2 { --lift: -12px; }
    .wsi-docs-f3 { --lift: -14px; }
    .wsi-docs-shadow { animation: wsi-docs-shade 7s cubic-bezier(0.45, 0, 0.55, 1) 0.3s infinite; }

    @keyframes wsi-docs-land { from { opacity: 0; translate: 0 -24px; } to { opacity: 1; translate: 0 0; } }
    html.js svg.wsi-docs:not(.is-in) .wsi-docs-enter { opacity: 0; }
    html.js svg.wsi-docs.is-in .wsi-docs-enter { animation: wsi-docs-land 600ms cubic-bezier(0.23, 1, 0.32, 1) both; animation-delay: calc(var(--i, 0) * 110ms); }
  }
</style>
