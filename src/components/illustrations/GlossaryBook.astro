---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9' };
const W = 240;
const H = 170;
const OX = 115;
const OY = 280;
const at = (dy: number) => `matrix(1 -.5 1 .5 ${OX} ${OY + dy})`;
const left = [[22, 78, 74], [22, 96, 60], [22, 114, 70], [22, 132, 44]];
const right = [[134, 26, 72], [134, 44, 84], [134, 62, 56], [134, 80, 78], [134, 98, 64], [134, 116, 80], [134, 134, 50]];
const pills = [
  { x: 112, y: 116, l: 'PFS', dot: C.blue, cls: 'f2' },
  { x: 536, y: 190, l: 'Net worth', dot: C.green, cls: 'f3' },
  { x: 500, y: 380, l: 'DTI', dot: C.yellow, cls: 'f1' },
].map((p) => ({ ...p, w: Math.round(p.l.length * 15 * 0.56) + 50 }));
---

<svg
  class:list={['wsi', 'wsi-book', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 70 640 350"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-book-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="8"></feGaussianBlur></filter>
  </defs>

  <g transform={at(0)}><rect x="-46" y="-46" width={W + 92} height={H + 92} rx="30" fill={C.tG} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect></g>
  <g transform={at(30)}><rect width={W} height={H} rx="16" fill={C.ink} fill-opacity=".14" filter="url(#wsi-book-blur)"></rect></g>

  <g class="wsi-book-f1">
    <g transform={at(16)}><rect width={W} height={H} rx="16" fill="#4a9fc8"></rect></g>
    <g transform={at(0)}><rect width={W} height={H} rx="16" fill={C.blue} stroke="#fff" stroke-width="2"></rect></g>
    <g transform={at(-2)}><rect x="8" y="8" width={W - 16} height={H - 16} rx="10" fill={C.beige}></rect></g>
    <g transform={at(-9)}>
      <g class="wsi-book-pages">
        <rect x="8" y="8" width={W - 16} height={H - 16} rx="10" fill="#fff"></rect>
        <path d={`M${W / 2} 8V${H - 8}`} stroke={C.beige} stroke-width="2"></path>
        <rect x="22" y="22" width="34" height="34" rx="9" fill={C.tB}></rect>
        <text x="39" y="48" font-size="24" font-weight="700" fill="#3f9cc9" text-anchor="middle">A</text>
        <rect x="22" y="94" width="76" height="12" rx="6" fill={C.yellow} fill-opacity=".45"></rect>
        <g fill={C.beige}>
          {left.map(([x, y, w]) => <rect x={x} y={y - 3} width={w} height="7" rx="3.5"></rect>)}
          {right.map(([x, y, w]) => <rect x={x} y={y} width={w} height="7" rx="3.5"></rect>)}
        </g>
      </g>
    </g>
    <!-- ribbon -->
    <g transform={at(-9)}>
      <path class="wsi-book-ribbon" d={`M${W - 54} ${H - 8}h16v40l-8-7-8 7z`} fill={C.yellow} stroke="#fff" stroke-width="1.5" stroke-linejoin="round"></path>
    </g>
  </g>

  {pills.map((p) => (
    <g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-book-${p.cls}`}>
        <rect x={-p.w / 2} y="-15" width={p.w} height="38" rx="19" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="19" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
        <circle cx={-p.w / 2 + 22} cy="0" r="6" fill={p.dot}></circle>
        <text x={-p.w / 2 + 38} y="5" font-size="15" font-weight="600" fill={C.ink}>{p.l}</text>
      </g>
    </g>
  ))}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wsi-book-lift { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @keyframes wsi-book-drift {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      33% { transform: translate(-1.5px, -4px) rotate(-0.8deg); }
      66% { transform: translate(1.5px, -2px) rotate(0.6deg); }
    }
    @keyframes wsi-book-sway {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(0.6deg); }
    }
    @keyframes wsi-book-flutter {
      0%, 100% { transform: rotate(-0.9deg); }
      50% { transform: rotate(0.9deg); }
    }
    .wsi-book-f1, .wsi-book-f2, .wsi-book-f3, .wsi-book-pages, .wsi-book-ribbon { transform-box: fill-box; transform-origin: center; will-change: transform; }
    .wsi-book-ribbon { transform-origin: 50% 0; }
    .wsi-book-pages { transform-origin: 50% 100%; }
    .wsi-book-f1 { animation: wsi-book-lift 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-book-f2 { animation: wsi-book-drift 6.5s cubic-bezier(0.45, 0, 0.55, 1) -2s infinite; }
    .wsi-book-f3 { animation: wsi-book-drift 7.5s cubic-bezier(0.45, 0, 0.55, 1) -4s infinite; }
    .wsi-book-pages { animation: wsi-book-sway 9s cubic-bezier(0.45, 0, 0.55, 1) -1s infinite; }
    .wsi-book-ribbon { animation: wsi-book-flutter 5.5s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  }
</style>
