---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = {
  ink: '#2e2926', beige: '#e8e7e5', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344',
  tB: '#e2f2f9', tG: '#e2f9e9', tP: '#f9e2f3', tC: '#f9f2e2',
};
// Breathing layers: base 0s, mid +0.4s, top +0.8s; jit() staggers items within a layer.
const lag = (s: number) => `animation-delay:${s.toFixed(2)}s`;
const jit = (i: number, amp: number) => (((i * 0.618) % 1) - 0.5) * 2 * amp;
const intro = (d: number, dur: number, y: number, s = 0.94) =>
  `--in-d:${d}ms;--in-dur:${dur}ms;--in-y:${y}px;--in-s:${s}`;
// Strip-shaped isometric card: local x runs up-right, local y runs down-right.
const W = 220;
const H = 80;
const OX = 230;
const OY0 = 150;
const STEP = 60;
const stripT = (i: number, dy = 0) => `matrix(1 -.5 1 .5 ${OX} ${OY0 + STEP * i + dy})`;

// Tones: each slot paints an asset face (A) and a liability face (B); CSS cross-fades between them.
const T = {
  blue: { fill: C.tB, side: '#b9dcee', dot: C.blue },
  green: { fill: C.tG, side: '#b6e2c1', dot: C.green },
  yellow: { fill: C.tC, side: '#ecd9a8', dot: C.yellow },
  pink: { fill: C.tP, side: '#e8bde0', dot: '#e67fc6' },
};

// Slot 0 is the top card. `fm` = face shown in the mixed view (1 = A, 0 = B).
const slots = [
  { A: T.blue, B: T.yellow, fm: 1,
    mixed: { l: 'Checking', v: '$18,400' }, assets: { l: 'Checking', v: '$18,400' }, liab: { l: 'Credit cards', v: '$7,000' } },
  { A: T.green, B: T.yellow, fm: 1,
    mixed: { l: 'Savings', v: '$45,000' }, assets: { l: 'Savings', v: '$45,000' }, liab: { l: 'Mortgage', v: '$168,000' } },
  { A: T.blue, B: T.yellow, fm: 1,
    mixed: { l: 'Retirement', v: '$149,100' }, assets: { l: 'Retirement', v: '$149,100' }, liab: { l: 'HELOC', v: '$25,000' } },
  { A: T.green, B: T.pink, fm: 1,
    mixed: { l: 'Real estate', v: '$200,000' }, assets: { l: 'Investments', v: '$62,300' }, liab: { l: 'Student loans', v: '$11,200' } },
  { A: T.green, B: T.yellow, fm: 0,
    mixed: { l: 'Mortgage', v: '$168,000' }, assets: { l: 'Real estate', v: '$200,000' }, liab: { l: 'Auto loan', v: '$14,800' } },
  { A: T.blue, B: T.pink, fm: 0,
    mixed: { l: 'Student loans', v: '$11,200' }, assets: { l: 'Auto', v: '$21,500' }, liab: { l: 'Notes payable', v: '$5,000' } },
];

type Slot = (typeof slots)[number];
type View = 'mixed' | 'assets' | 'liab';
const VIEWS: View[] = ['mixed', 'assets', 'liab'];
const variantDot = (s: Slot, k: View) => (k === 'assets' ? s.A.dot : k === 'liab' ? s.B.dot : s.fm ? s.A.dot : s.B.dot);

// top card first; drawn bottom-up so upper cards overlap lower ones
const order = slots.map((s, i) => ({ ...s, i })).reverse();

const pillW = (text: string, fs: number) => Math.round(text.length * fs * 0.54) + 44;
const pills = [
  { key: 'assets', x: 652, y: 104, l: 'Assets', v: '27 categories', dot: C.green, cls: 'f1', d: 1.6, enter: intro(900, 480, -18, 0.95) },
  { key: 'liab', x: 652, y: 392, l: 'Liabilities', v: '13 categories', dot: C.yellow, cls: 'f3', d: 0.7, enter: intro(820, 460, 16, 0.95) },
].map((p) => ({ ...p, w: pillW(`${p.l} ${p.v}`, 14) }));

const menus: Record<View, string[]> = {
  mixed: ['Checking', 'Savings', 'Retirement'],
  assets: ['Checking', 'Savings', 'Retirement'],
  liab: ['Credit cards', 'Mortgage', 'Student loans'],
};
---

<svg
  class:list={['wsi', 'wsi-cats', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 780 520"
  font-family="inherit"
  focusable="false"
  data-view="mixed"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}

  <!-- stacked cards (mid): one shared phase and one depth so the stack lifts as a unit -->
  <g class="wsi-pt" style="--d:0.3">
  {order.map((s) => (
    <g class="wsi-cats-card" style={`animation-delay:${(s.i * 0.11).toFixed(2)}s;--i:${s.i};--fm:${s.fm}`}>
    <g class="wsi-breathe wsi-cats-mid" style={lag(0.4)}>
      <g class="wsi-cats-sh-mid"><g transform={stripT(s.i, 16)}><rect width={W} height={H} rx="14" fill={C.ink} fill-opacity=".07"></rect></g></g>
      <g transform={stripT(s.i, 8)}>
        <rect class="face-a" width={W} height={H} rx="14" fill={s.A.side}></rect>
        <rect class="face-b" width={W} height={H} rx="14" fill={s.B.side}></rect>
      </g>
      <g transform={stripT(s.i)}>
        <rect class="face-a" width={W} height={H} rx="14" fill={s.A.fill} stroke="#fff" stroke-width="2"></rect>
        <rect class="face-b" width={W} height={H} rx="14" fill={s.B.fill} stroke="#fff" stroke-width="2"></rect>
        {VIEWS.map((k) => (
          <g class={`v v-${k}`}>
            <circle cx="30" cy="50" r="10" fill={variantDot(s, k)} stroke="#fff" stroke-width="2.5"></circle>
            <text x="52" y="55" font-size="15" font-weight="600" fill={C.ink}>{s[k].l}</text>
            <text x="206" y="55" font-size="14" font-weight="500" fill={C.ink} fill-opacity=".66" text-anchor="end">{s[k].v}</text>
          </g>
        ))}
      </g>
    </g>
    </g>
  ))}
  </g>

  <!-- leaders (base) -->
  <g class="wsi-extra">
  <g class="wsi-breathe wsi-cats-base" stroke={C.ink} stroke-opacity=".3" stroke-width="1.5" stroke-dasharray="2 6" stroke-linecap="round" fill="none">
    <path d="M550 112h-35"></path>
    <path d="M550 392h-52"></path>
  </g>
  </g>

  <!-- pills (top) -->
  {pills.map((p, i) => (
    <g class="wsi-extra">
    <g class="wsi-in" style={p.enter}>
    <g class="wsi-pt wsi-cats-late" style={`--d:${p.d}`}>
    <g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-cats-pill pill-${p.key}`}>
      <g class={`wsi-breathe wsi-cats-top wsi-cats-${p.cls}`} style={lag(0.8 + jit(i, 0.5))}>
        <rect class="wsi-cats-sh-top" style={lag(0.8 + jit(i, 0.5))} x={-p.w / 2} y="-15" width={p.w} height="38" rx="19" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="19" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
        <circle cx={-p.w / 2 + 22} cy="0" r="6" fill={p.dot}></circle>
        <text x={-p.w / 2 + 38} y="5" font-size="14" fill={C.ink}>
          <tspan fill-opacity=".66" font-weight="500">{p.l}</tspan> <tspan font-weight="700">{p.v}</tspan>
        </text>
      </g>
      </g>
    </g>
    </g>
    </g>
    </g>
  ))}

  <!-- dropdown chip + open menu (top) -->
  <g class="wsi-extra">
  <g class="wsi-in" style={intro(700, 520, 14, 0.95)}>
  <g class="wsi-pt wsi-cats-late" style="--d:1.25">
  <g transform="translate(40 190)">
    <g class="wsi-breathe wsi-cats-top wsi-cats-f2" style={lag(0.8 + jit(2, 0.5))}>
      <rect class="wsi-cats-sh-top" style={lag(0.8 + jit(2, 0.5))} x="0" y="6" width="150" height="40" rx="20" fill={C.ink} fill-opacity=".1"></rect>
      <rect x="0" y="0" width="150" height="40" rx="20" fill="#fff" stroke={C.blue} stroke-width="2"></rect>
      <text class="chip-t chip-mixed" x="18" y="25" font-size="14" font-weight="600" fill={C.ink}>Category</text>
      <text class="chip-t chip-assets" x="18" y="25" font-size="14" font-weight="600" fill={C.ink}>Assets</text>
      <text class="chip-t chip-liab" x="18" y="25" font-size="14" font-weight="600" fill={C.ink}>Liabilities</text>
      <path d="m118 17 6 6 6-6" stroke={C.ink} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
      <g class="wsi-cats-sh-top" style={lag(0.8 + jit(2, 0.5))}><rect x="0" y="54" width="150" height="112" rx="16" fill={C.ink} fill-opacity=".08" transform="translate(0 5)"></rect></g>
      <rect x="0" y="54" width="150" height="112" rx="16" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
      <rect x="8" y="98" width="134" height="32" rx="10" fill={C.tB}></rect>
      <g font-size="14" fill={C.ink} font-weight="500">
        {VIEWS.map((k) => menus[k].map((m, i) => <text class={`menu-t menu-${k}`} x="20" y={80 + i * 36}>{m}</text>))}
      </g>
      <path class="wsi-draw" pathLength="100" d="m118 109 5 5 9-10" stroke="#3f9cc9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none" style="--draw-d:1200ms"></path>
    </g>
  </g>
  </g>
  </g>
  </g>
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-cats-base { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -2px) * var(--amp, 1)); } }
  @keyframes wsi-cats-mid { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -7px) * var(--amp, 1)); } }
  @keyframes wsi-cats-top { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -12px) * var(--amp, 1)); } }
  @keyframes wsi-cats-shadow { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: .92; opacity: .7; } }
  @keyframes wsi-cats-drop { from { opacity: 0; translate: 0 -28px; } to { opacity: 1; translate: 0 0; } }
  @keyframes wsi-cats-fade { from { opacity: 0; } to { opacity: 1; } }

  /* view state (instant; motion is layered on in the media query below) */
  svg.wsi-cats .wsi-cats-card { --fa: var(--fm, 1); }
  svg.wsi-cats[data-view="assets"] .wsi-cats-card { --fa: 1; }
  svg.wsi-cats[data-view="liabilities"] .wsi-cats-card { --fa: 0; }
  svg.wsi-cats .face-a { opacity: var(--fa); }
  svg.wsi-cats .face-b { opacity: calc(1 - var(--fa)); }
  svg.wsi-cats .v { opacity: 0; }
  svg.wsi-cats[data-view="mixed"] .v-mixed,
  svg.wsi-cats[data-view="assets"] .v-assets,
  svg.wsi-cats[data-view="liabilities"] .v-liab { opacity: 1; }
  svg.wsi-cats .chip-t { opacity: 0; }
  svg.wsi-cats[data-view="mixed"] .chip-mixed,
  svg.wsi-cats[data-view="assets"] .chip-assets,
  svg.wsi-cats[data-view="liabilities"] .chip-liab { opacity: 1; }
  svg.wsi-cats[data-view="liabilities"] .pill-assets,
  svg.wsi-cats[data-view="assets"] .pill-liab { opacity: .4; }
  svg.wsi-cats .menu-t { opacity: 0; }
  svg.wsi-cats[data-view="mixed"] .menu-mixed,
  svg.wsi-cats[data-view="assets"] .menu-assets,
  svg.wsi-cats[data-view="liabilities"] .menu-liab { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .wsi-cats-base, .wsi-cats-mid, .wsi-cats-top { transform-box: fill-box; transform-origin: center; will-change: translate; }
    .wsi-cats-sh-mid, .wsi-cats-sh-top { transform-box: fill-box; transform-origin: center; will-change: scale, opacity; }
    .wsi-cats-base { --lift: -2px; animation: wsi-cats-base 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-cats-mid { --lift: -7px; animation: wsi-cats-mid 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-cats-top { --lift: -12px; animation: wsi-cats-top 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-cats-sh-mid { animation: wsi-cats-shadow 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-cats-sh-top { animation: wsi-cats-shadow 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    html.js svg.wsi-cats:not(.is-in) .wsi-cats-card { opacity: 0; translate: 0 -28px; }
    html.js svg.wsi-cats:not(.is-in) .wsi-cats-late { opacity: 0; }
    svg.wsi-cats.is-in .wsi-cats-card { animation: wsi-cats-drop 600ms cubic-bezier(0.23, 1, 0.32, 1) both; }
    svg.wsi-cats.is-in .wsi-cats-late { animation: wsi-cats-fade 500ms cubic-bezier(0.23, 1, 0.32, 1) 0.7s both; }

    /* view swap: faces cross-fade; labels flip (out 175ms, in 175ms), each card staggered 50ms top to bottom */
    svg.wsi-cats .face-a,
    svg.wsi-cats .face-b { transition: opacity 350ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i, 0) * 50ms); }
    svg.wsi-cats .v {
      translate: 0 -6px;
      transition: opacity 175ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i, 0) * 50ms),
        translate 175ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i, 0) * 50ms);
    }
    svg.wsi-cats[data-view="mixed"] .v-mixed,
    svg.wsi-cats[data-view="assets"] .v-assets,
    svg.wsi-cats[data-view="liabilities"] .v-liab {
      translate: 0 0;
      transition-delay: calc(var(--i, 0) * 50ms + 175ms);
    }
    svg.wsi-cats .chip-t { transition: opacity 175ms cubic-bezier(0.23, 1, 0.32, 1); }
    /* chip flip (out 175ms, in after 175ms) so the outgoing and incoming label never overlap, like the .v labels */
    svg.wsi-cats[data-view="mixed"] .chip-mixed,
    svg.wsi-cats[data-view="assets"] .chip-assets,
    svg.wsi-cats[data-view="liabilities"] .chip-liab { transition-delay: 175ms; }
    svg.wsi-cats .menu-t { transition: opacity 175ms cubic-bezier(0.23, 1, 0.32, 1); }
    svg.wsi-cats[data-view="mixed"] .menu-mixed,
    svg.wsi-cats[data-view="assets"] .menu-assets,
    svg.wsi-cats[data-view="liabilities"] .menu-liab { transition-delay: 175ms; }
    svg.wsi-cats .wsi-cats-pill { transition: opacity 350ms cubic-bezier(0.23, 1, 0.32, 1), scale 350ms cubic-bezier(0.23, 1, 0.32, 1); }
    svg.wsi-cats[data-view="assets"] .pill-assets,
    svg.wsi-cats[data-view="liabilities"] .pill-liab { scale: 1.04; }
  }
</style>
