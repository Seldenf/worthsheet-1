---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = {
  ink: '#2e2926', beige: '#e8e7e5', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344',
  tB: '#e2f2f9', tG: '#e2f9e9', tP: '#f9e2f3', tC: '#f9f2e2',
};
const iso = (cx: number, cy: number, s: number, k = 1) =>
  `matrix(${k} ${-k / 2} ${k} ${k / 2} ${cx - s * k} ${cy})`;
// Breathing layers: base 0s, mid +0.4s, top +0.8s; jit() staggers items within a layer.
const lag = (s: number) => `animation-delay:${s.toFixed(2)}s`;
const jit = (i: number, amp: number) => (((i * 0.618) % 1) - 0.5) * 2 * amp;
const intro = (d: number, dur: number, y: number, s = 0.94) =>
  `--in-d:${d}ms;--in-dur:${dur}ms;--in-y:${y}px;--in-s:${s}`;
const rr = (x: number, y: number, w: number, h: number, r: number) =>
  `M${x + r} ${y}H${x + w - r}A${r} ${r} 0 0 1 ${x + w} ${y + r}V${y + h - r}A${r} ${r} 0 0 1 ${x + w - r} ${y + h}H${x + r}A${r} ${r} 0 0 1 ${x} ${y + h - r}V${y + r}A${r} ${r} 0 0 1 ${x + r} ${y}Z`;

const ICONS: Record<string, string> = {
  house: '<path d="M3.5 11.5 12 4l8.5 7.5M6 10v10h12V10M10 20v-5.5h4V20"/>',
  car: '<path d="M4 16v-4l2-5h12l2 5v4zM4 12h16"/><circle cx="7.5" cy="17" r="2.2" fill="currentColor" stroke="none"/><circle cx="16.5" cy="17" r="2.2" fill="currentColor" stroke="none"/>',
  bank: '<path d="M3 9.5 12 4l9 5.5zM5.5 12v6M10 12v6M14 12v6M18.5 12v6M3 20.5h18"/>',
  card: '<rect x="3" y="6" width="18" height="12" rx="2.5"/><path d="M3 10.5h18M6.5 15h4"/>',
  chart: '<path d="M4 4v16h16M8 16v-4M12.5 16V8M17 16V9"/>',
  piggy: '<path d="M5 13.5C5 10 8 8 11.5 8c2 0 3.5.5 4.5 1.3L19 8v3.2c.7.7 1 1.5 1 2.3v2l-2 .6V19h-3v-2H9v2H6v-3.2c-.6-.7-1-1.4-1-2.3zM9.5 8.2V6.5M9 6h3"/><circle cx="15.5" cy="12.3" r=".9" fill="currentColor" stroke="none"/>',
  coins: '<ellipse cx="12" cy="7" rx="7" ry="3"/><path d="M5 7v5c0 1.7 3.1 3 7 3s7-1.3 7-3V7M5 12v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"/>',
  percent: '<path d="M18 6 6 18"/><circle cx="7.5" cy="7.5" r="2.3"/><circle cx="16.5" cy="16.5" r="2.3"/>',
};

const tiles = [
  { x: 320, y: 112, s: 70, fill: C.blue, side: '#4a9fc8', ink: '#fff', icon: 'chart', z: 62, f: 1, d: 1.0, enter: intro(380, 620, -18, 0.9) },
  { x: 168, y: 196, s: 74, fill: C.tG, side: '#b6e2c1', ink: '#2f8a39', icon: 'house', z: 52, f: 2, d: 0.55, enter: intro(420, 680, 18, 0.9) },
  { x: 472, y: 196, s: 74, fill: C.yellow, side: '#d9a02a', ink: '#fff', icon: 'car', z: 52, f: 3, d: 1.3, enter: intro(480, 700, 14, 0.9) },
  { x: 320, y: 250, s: 88, fill: '#fff', side: '#d6d4d2', ink: '#3f9cc9', icon: 'bank', z: 46, f: 2, line: true, d: 0.45, draw: true, enter: intro(120, 780, 22, 0.92) },
  { x: 142, y: 338, s: 70, fill: C.tP, side: '#e8bde0', ink: '#b5388f', icon: 'card', z: 48, f: 3, d: 1.6, enter: intro(560, 820, 24, 0.9) },
  { x: 498, y: 344, s: 70, fill: C.tC, side: '#ecd9a8', ink: '#a8730a', icon: 'piggy', z: 48, f: 1, d: 0.75, enter: intro(520, 760, 20, 0.9) },
  { x: 320, y: 392, s: 66, fill: C.green, side: '#2f8a39', ink: '#fff', icon: 'coins', z: 42, f: 2, d: 1.2, enter: intro(700, 600, 16, 0.9) },
  { x: 560, y: 252, s: 34, fill: C.tB, side: '#b9dcee', ink: '#3f9cc9', icon: 'percent', z: 40, f: 3, d: 0.3, enter: intro(640, 520, -12, 0.9) },
  { x: 78, y: 254, s: 34, fill: C.tC, side: '#ecd9a8', ink: '#a8730a', icon: '$', z: 40, f: 1, d: 0.25, enter: intro(900, 480, -16, 0.9) },
];
// Index of the centre bank tile in `tiles`: the only tile left visible at rest (wsi-extra on every other tile + its shadow).
const MAIN_TILE = 3;
const lines = Array.from({ length: 7 }, (_, i) => `M0 ${(i + 1) * 32.75}H262M${(i + 1) * 32.75} 0V262`).join('');
---

<svg
  class:list={['wsi', 'wsi-tiles', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 56 640 420"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-tiles-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6"></feGaussianBlur></filter>
  </defs>

  <!-- halo frames (base) -->
  <g class="wsi-in" style={intro(0, 1000, 10, 0.96)}>
  <g class="wsi-breathe wsi-tiles-base"><g transform={iso(320, 300, 310)}>
    <rect width="310" height="310" rx="26" fill={C.tB} fill-opacity=".55" stroke="#fff" stroke-width="2"></rect>
  </g></g>
  <g class="wsi-breathe wsi-tiles-base"><g transform={iso(320, 300, 262)}>
    <rect width="262" height="262" rx="22" fill={C.tG} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect>
    <path d={lines} stroke="#fff" stroke-width="1.5" fill="none"></path>
  </g></g>
  </g>

  {tiles.map((t, i) => {
    const k = (t.s * 0.58) / 24;
    return (
      <g class={i === MAIN_TILE ? undefined : 'wsi-extra'}>
        <g class="wsi-in" style={t.enter}>
        {/* The centre bank tile is the anchor: no cursor push/drag and no breathing. */}
        <g class={i === MAIN_TILE ? undefined : 'wsi-pt'} style={`--d:${t.d}`}>
        <!-- ground shadow: first child of the tile's wsi-pt so it moves with the tile (intro comes from the wsi-in above) -->
        <g fill={C.ink} fill-opacity=".08" filter="url(#wsi-tiles-blur)"><g class={i === MAIN_TILE ? undefined : 'wsi-tiles-sh-mid'} style={lag(0.4 + jit(i, 0.2))}><g transform={iso(t.x + 8, t.y + t.z * 0.7 + 8, t.s)}><rect width={t.s} height={t.s} rx={t.s * 0.17}></rect></g></g></g>
        <g class={i === MAIN_TILE ? undefined : `wsi-breathe wsi-tiles-mid wsi-tiles-f${t.f}`} style={lag(0.4 + jit(i, 0.2))}>
          <g transform={iso(t.x, t.y + 9, t.s)}><rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.side}></rect></g>
          <g transform={iso(t.x, t.y, t.s)}>
            <rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.fill} stroke={t.line ? C.beige : '#fff'} stroke-width="2"></rect>
            {t.draw && <path class="wsi-draw" pathLength="100" fill="none" stroke={C.blue} stroke-width="2" stroke-linecap="round" style="--draw-d:900ms" d={rr(7, 7, t.s - 14, t.s - 14, 10)}></path>}
            {t.icon === '$' ? (
              <text x={t.s / 2} y={t.s * 0.75} font-size={t.s * 0.7} font-weight="700" fill={t.ink} text-anchor="middle">$</text>
            ) : (
              <g
                transform={`translate(${t.s / 2} ${t.s / 2}) scale(${k}) translate(-12 -12)`}
                color={t.ink}
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"
                set:html={ICONS[t.icon]}
              ></g>
            )}
          </g>
        </g>
        </g>
        </g>
      </g>
    );
  })}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-tiles-base { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -2px) * var(--amp, 1)); } }
  @keyframes wsi-tiles-mid { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -7px) * var(--amp, 1)); } }
  @keyframes wsi-tiles-shadow { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: .92; opacity: .7; } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-tiles-base, .wsi-tiles-mid { transform-box: fill-box; transform-origin: center; will-change: translate; }
    .wsi-tiles-sh-mid { transform-box: fill-box; transform-origin: center; will-change: scale, opacity; }
    .wsi-tiles-base { --lift: -2px; animation: wsi-tiles-base 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-tiles-mid { --lift: -7px; animation: wsi-tiles-mid 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-tiles-sh-mid { animation: wsi-tiles-shadow 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  }
</style>
