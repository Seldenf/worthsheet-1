---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = {
  ink: '#2e2926', beige: '#e8e7e5', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344',
  tB: '#e2f2f9', tG: '#e2f9e9', tP: '#f9e2f3', tC: '#f9f2e2',
};
const iso = (cx: number, cy: number, s: number, k = 1) =>
  `matrix(${k} ${-k / 2} ${k} ${k / 2} ${cx - s * k} ${cy})`;

const ICONS: Record<string, string> = {
  house: '<path d="M3.5 11.5 12 4l8.5 7.5M6 10v10h12V10M10 20v-5.5h4V20"/>',
  car: '<path d="M4 16v-4l2-5h12l2 5v4zM4 12h16"/><circle cx="7.5" cy="17" r="2.2" fill="currentColor" stroke="none"/><circle cx="16.5" cy="17" r="2.2" fill="currentColor" stroke="none"/>',
  bank: '<path d="M3 9.5 12 4l9 5.5zM5.5 12v6M10 12v6M14 12v6M18.5 12v6M3 20.5h18"/>',
  card: '<rect x="3" y="6" width="18" height="12" rx="2.5"/><path d="M3 10.5h18M6.5 15h4"/>',
  chart: '<path d="M4 4v16h16M8 16v-4M12.5 16V8M17 16V9"/>',
  piggy: '<path d="M5 13.5C5 10 8 8 11.5 8c2 0 3.5.5 4.5 1.3L19 8v3.2c.7.7 1 1.5 1 2.3v2l-2 .6V19h-3v-2H9v2H6v-3.2c-.6-.7-1-1.4-1-2.3zM9.5 8.2V6.5M9 6h3"/><circle cx="15.5" cy="12.3" r=".9" fill="currentColor" stroke="none"/>',
  coins: '<ellipse cx="12" cy="7" rx="7" ry="3"/><path d="M5 7v5c0 1.7 3.1 3 7 3s7-1.3 7-3V7M5 12v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"/>',
  percent: '<path d="M18 6 6 18"/><circle cx="7.5" cy="7.5" r="2.3"/><circle cx="16.5" cy="16.5" r="2.3"/>',
};

const tiles = [
  { x: 320, y: 112, s: 70, fill: C.blue, side: '#4a9fc8', ink: '#fff', icon: 'chart', z: 62, f: 1 },
  { x: 168, y: 196, s: 74, fill: C.tG, side: '#b6e2c1', ink: '#2f8a39', icon: 'house', z: 52, f: 2 },
  { x: 472, y: 196, s: 74, fill: C.yellow, side: '#d9a02a', ink: '#fff', icon: 'car', z: 52, f: 3 },
  { x: 320, y: 250, s: 88, fill: '#fff', side: '#d6d4d2', ink: '#3f9cc9', icon: 'bank', z: 46, f: 2, line: true },
  { x: 142, y: 338, s: 70, fill: C.tP, side: '#e8bde0', ink: '#b5388f', icon: 'card', z: 48, f: 3 },
  { x: 498, y: 344, s: 70, fill: C.tC, side: '#ecd9a8', ink: '#a8730a', icon: 'piggy', z: 48, f: 1 },
  { x: 320, y: 392, s: 66, fill: C.green, side: '#2f8a39', ink: '#fff', icon: 'coins', z: 42, f: 2 },
  { x: 560, y: 252, s: 34, fill: C.tB, side: '#b9dcee', ink: '#3f9cc9', icon: 'percent', z: 40, f: 3 },
  { x: 78, y: 254, s: 34, fill: C.tC, side: '#ecd9a8', ink: '#a8730a', icon: '$', z: 40, f: 1 },
];
const lines = Array.from({ length: 7 }, (_, i) => `M0 ${(i + 1) * 32.75}H262M${(i + 1) * 32.75} 0V262`).join('');
---

<svg
  class:list={['wsi', 'wsi-tiles', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 56 640 420"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <filter id="wsi-tiles-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6"></feGaussianBlur></filter>
  </defs>

  <g transform={iso(320, 300, 310)}>
    <rect width="310" height="310" rx="26" fill={C.tB} fill-opacity=".55" stroke="#fff" stroke-width="2"></rect>
  </g>
  <g transform={iso(320, 300, 262)}>
    <rect width="262" height="262" rx="22" fill={C.tG} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect>
    <path d={lines} stroke="#fff" stroke-width="1.5" fill="none"></path>
  </g>

  <g fill={C.ink} fill-opacity=".08" filter="url(#wsi-tiles-blur)">
    {tiles.map((t) => <g transform={iso(t.x + 8, t.y + t.z * 0.7 + 8, t.s)}><rect width={t.s} height={t.s} rx={t.s * 0.17}></rect></g>)}
  </g>

  {tiles.map((t) => {
    const k = (t.s * 0.58) / 24;
    return (
      <g class={`wsi-tiles-f${t.f}`}>
        <g transform={iso(t.x, t.y + 9, t.s)}><rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.side}></rect></g>
        <g transform={iso(t.x, t.y, t.s)}>
          <rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.fill} stroke={t.line ? C.beige : '#fff'} stroke-width="2"></rect>
        </g>
        {t.icon === '$' ? (
          <text x={t.x} y={t.y + t.s * 0.2} font-size={t.s * 0.8} font-weight="700" fill={t.ink} text-anchor="middle">$</text>
        ) : (
          <g
            transform={`translate(${t.x - 12 * k} ${t.y - 12 * k - 2}) scale(${k})`}
            color={t.ink}
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
            set:html={ICONS[t.icon]}
          ></g>
        )}
      </g>
    );
  })}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-tiles-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-tiles-f1 { animation: wsi-tiles-float 6s ease-in-out infinite; }
    .wsi-tiles-f2 { animation: wsi-tiles-float 7s ease-in-out -2s infinite; }
    .wsi-tiles-f3 { animation: wsi-tiles-float 8s ease-in-out -4s infinite; }
  }
</style>
