---
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = { ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a', yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', sheets: '#0f9d58' };
const iso = (cx: number, cy: number, s: number) => `matrix(1 -.5 1 .5 ${cx - s} ${cy})`;

const SH = 'M0-88 72-62V8C72 50 42 76 0 92-42 76-72 50-72 8v-70z';
const T = 190;
const lines = Array.from({ length: 5 }, (_, i) => `M0 ${34 + i * 31.2}H${T}`).join('') + [38, 78, 118, 154].map((x) => `M${x} 0V${T}`).join('');
const pills = [
  { x: 112, y: 214, l: 'Your own copy', dot: C.green, cls: 'f2' },
  { x: 458, y: 150, l: 'Free template', dot: C.blue, cls: 'f3' },
].map((p) => ({ ...p, w: Math.round(p.l.length * 14 * 0.54) + 48 }));
---

<svg
  class:list={['wsi', 'wsi-shield', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 84 560 440"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <clipPath id="wsi-shield-clip"><rect width={T} height={T} rx="14"></rect></clipPath>
    <filter id="wsi-shield-blur" x="-30%" y="-60%" width="160%" height="220%"><feGaussianBlur stdDeviation="8"></feGaussianBlur></filter>
  </defs>

  <g transform={iso(280, 384, 256)}><rect width="256" height="256" rx="26" fill={C.tB} fill-opacity=".55" stroke="#fff" stroke-width="2"></rect></g>
  <g transform={iso(280, 384, 214)}><rect width="214" height="214" rx="22" fill={C.tG} fill-opacity=".65" stroke="#fff" stroke-width="2"></rect></g>

  <!-- sheet tile -->
  <g transform={iso(280, 408, T)}><rect width={T} height={T} rx="16" fill={C.ink} fill-opacity=".14" filter="url(#wsi-shield-blur)"></rect></g>
  <g transform={iso(280, 394, T)}><rect width={T} height={T} rx="16" fill="#cfcdcb"></rect></g>
  <g transform={iso(280, 384, T)}>
    <rect width={T} height={T} rx="16" fill="#fff" stroke={C.ink} stroke-opacity=".2"></rect>
    <g clip-path="url(#wsi-shield-clip)">
      <rect width={T} height="34" fill={C.sheets}></rect>
      <rect y="65.2" width={T} height="31.2" fill={C.tG}></rect>
      <path d={lines} stroke={C.beige} stroke-width="1" fill="none"></path>
      <path d={`M38 0V${T}`} stroke="#fff" stroke-opacity=".5" stroke-width="1"></path>
      <rect x="46" y="10" width="62" height="14" rx="7" fill="#fff" fill-opacity=".85"></rect>
    </g>
  </g>

  <!-- shield shadow on tile -->
  <ellipse cx="280" cy="388" rx="64" ry="21" fill={C.ink} fill-opacity=".22" filter="url(#wsi-shield-blur)"></ellipse>

  <!-- shield -->
  <g class="wsi-shield-f1" transform="translate(280 184)">
    <path d={SH} fill="#2f8a39" transform="translate(8 11)"></path>
    <path d={SH} fill={C.green} stroke="#fff" stroke-width="3" stroke-linejoin="round"></path>
    <path d="M0-88 72-62V8C72 50 42 76 0 92z" fill="#fff" fill-opacity=".14"></path>
    <path d="M-13-6v-12a13 13 0 0 1 26 0v12" stroke="#fff" stroke-width="7" stroke-linecap="round" fill="none"></path>
    <rect x="-26" y="-8" width="52" height="42" rx="10" fill="#fff"></rect>
    <circle cx="0" cy="10" r="5.5" fill={C.green}></circle>
    <rect x="-2.5" y="12" width="5" height="12" rx="2.5" fill={C.green}></rect>
  </g>

  {pills.map((p) => (
    <g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-shield-${p.cls}`}>
        <rect x={-p.w / 2} y="-15" width={p.w} height="38" rx="19" fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y="-19" width={p.w} height="38" rx="19" fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
        <circle cx={-p.w / 2 + 22} cy="0" r="6" fill={p.dot}></circle>
        <text x={-p.w / 2 + 38} y="5" font-size="14" font-weight="600" fill={C.ink}>{p.l}</text>
      </g>
    </g>
  ))}
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-shield-float { 0%, 100% { transform: translate(280px, 184px); } 50% { transform: translate(280px, 176px); } }
  @keyframes wsi-shield-pill { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-shield-f1 { animation: wsi-shield-float 6s ease-in-out infinite; }
    .wsi-shield-f2 { animation: wsi-shield-pill 7s ease-in-out -2s infinite; }
    .wsi-shield-f3 { animation: wsi-shield-pill 8s ease-in-out -4s infinite; }
  }
</style>
