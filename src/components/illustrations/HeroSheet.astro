---
interface Props {
  class?: string;
  title?: string;
  /** Floating Assets / Liabilities / Net worth pills. The home hero shows those values in sheet cells instead. */
  pills?: boolean;
}
const { class: className, title, pills: showPills = true } = Astro.props;

const C = {
  ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a',
  yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', tC: '#f9f2e2', sheets: '#0f9d58',
};
// 2:1 isometric square of side s*k centred on (cx, cy); local origin = left corner.
const iso = (cx: number, cy: number, s: number, k = 1) =>
  `matrix(${k} ${-k / 2} ${k} ${k / 2} ${cx - s * k} ${cy})`;
// Breathing layers: base 0s, mid +0.4s, top +0.8s; jit() staggers items within a layer.
const lag = (s: number) => `animation-delay:${s.toFixed(2)}s`;
const jit = (i: number, amp: number) => (((i * 0.618) % 1) - 0.5) * 2 * amp;

// ---- spreadsheet board (local 300x300 plane, scaled 1.1) ----
const S = 300;
const K = 1.1;
const colX = [0, 22, 102, 164, 198, 232, 266, 300];
const HDR = 22;
const RH = (S - HDR) / 9;
const rowY = (i: number) => +(HDR + i * RH).toFixed(1);
const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
const rows = [
  { l: 'Assets', v: '$412,500', h: C.tG, col: C.green },
  { l: 'Checking', v: '$18,400', f: 0.09 },
  { l: 'Savings', v: '$45,000', f: 0.225 },
  { l: 'Retirement', v: '$149,100', f: 0.75 },
  { l: 'Real estate', v: '$200,000', f: 1 },
  { l: 'Liabilities', v: '$186,200', h: C.tC, col: '#b57f0b' },
  { l: 'Mortgage', v: '$168,000', f: 1, y: 1 },
  { l: 'Student loans', v: '$11,200', f: 0.07, y: 1 },
  { l: 'Credit cards', v: '$7,000', f: 0.04, y: 1 },
];
const grid =
  rows.map((_, i) => `M0 ${rowY(i + 1)}H${S}`).join('') +
  `M0 ${HDR}H${S}` +
  colX.slice(1, 7).map((x) => `M${x} 0V${S}`).join('');

// ---- floating tiles (mid layer) ----
const tiles = [
  { x: 262, y: 232, s: 92, fill: C.sheets, side: '#0a7a43', z: 150, cls: 'f1', kind: 'sheets' },
  { x: 872, y: 392, s: 44, fill: C.yellow, side: '#d9a02a', z: 44, cls: 'f3', kind: 'dollar' },
  { x: 104, y: 330, s: 40, fill: C.tB, side: '#b9dcee', z: 40, cls: 'f2', kind: 'bars' },
];

// ---- pills (top layer) ----
const pills = [
  { x: 690, y: 150, l: 'Assets', v: '$412,500', dot: C.green, fs: 15, cls: 'f2' },
  { x: 224, y: 470, l: 'Liabilities', v: '$186,200', dot: C.yellow, fs: 15, cls: 'f3' },
  { x: 706, y: 536, l: 'Net worth', v: '$226,300', dot: C.blue, fs: 18, cls: 'f1', big: true },
].map((p) => {
  const w = Math.round((p.l.length + 1 + p.v.length) * p.fs * 0.54) + 44;
  return { ...p, w, h: p.big ? 48 : 38 };
});
---

<svg
  class:list={['wsi', 'wsi-hero', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 960 640"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <clipPath id="wsi-hero-clip"><rect width={S} height={S} rx="14"></rect></clipPath>
    <filter id="wsi-hero-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter>
  </defs>

  <g transform="translate(480 346) scale(1.1) translate(-480 -372)">
  <!-- halo frames (base) -->
  <g class="wsi-hero-base"><g transform={iso(480, 372, 430)}><rect width="430" height="430" rx="30" fill={C.tB} fill-opacity=".55" stroke="#fff" stroke-width="2"></rect></g></g>
  <g class="wsi-hero-base"><g transform={iso(480, 372, 372)}><rect width="372" height="372" rx="26" fill={C.tG} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect></g></g>

  <!-- board shadow + slab (base) -->
  <g class="wsi-hero-sh-base"><g transform={iso(480, 408, 340)} filter="url(#wsi-hero-blur)"><rect width="340" height="340" rx="20" fill={C.ink} fill-opacity=".16"></rect></g></g>
  <g class="wsi-hero-base"><g transform={iso(480, 382, 330)}><rect width="330" height="330" rx="18" fill="#cfcdcb"></rect></g></g>
  <g class="wsi-hero-base"><g transform={iso(480, 372, 330)}><rect width="330" height="330" rx="18" fill="#fff" stroke={C.ink} stroke-opacity=".2"></rect></g></g>

  <!-- board content (base) -->
  <g class="wsi-hero-base"><g transform={iso(480, 372, S, K)}>
    <g clip-path="url(#wsi-hero-clip)">
      <rect width={S} height={HDR} fill={C.surface}></rect>
      <rect y={rowY(0)} width={S} height={RH} fill={rows[0].h}></rect>
      <rect y={rowY(5)} width={S} height={RH} fill={rows[5].h}></rect>
      {rows.map((r, i) => r.f && (
        <rect x="172" y={rowY(i) + RH / 2 - 4} width={Math.max(5, 120 * r.f)} height="8" rx="4" fill={r.y ? C.yellow : C.blue} fill-opacity={r.y ? '.85' : '.7'}></rect>
      ))}
      <path d={grid} stroke={C.beige} stroke-width="1" fill="none"></path>
      <g font-size="10" fill={C.ink} fill-opacity=".5" text-anchor="middle" font-weight="500">
        {letters.map((t, i) => <text x={(colX[i + 1] + colX[i + 2]) / 2} y="15">{t}</text>)}
        {rows.map((_, i) => <text x="11" y={rowY(i) + RH / 2 + 3}>{i + 1}</text>)}
      </g>
      <g font-size="10" fill={C.ink}>
        {rows.map((r, i) => (
          <text x="27" y={rowY(i) + RH / 2 + 3.5} font-weight={r.h ? 700 : 500} fill={r.col ?? C.ink}>{r.l}</text>
        ))}
        {rows.map((r, i) => (
          <text x="160" y={rowY(i) + RH / 2 + 3.5} text-anchor="end" font-weight={r.h ? 700 : 500} fill={r.col ?? C.ink}>{r.v}</text>
        ))}
      </g>
      <rect x="102" y={rowY(0)} width="62" height={RH} fill="none" stroke={C.blue} stroke-width="2.5"></rect>
      <rect x="160" y={rowY(1) - 4} width="7" height="7" rx="1.5" fill={C.blue} stroke="#fff" stroke-width="1.5"></rect>
    </g>
  </g></g>

  <!-- leaders (base) -->
  <g class="wsi-hero-base" stroke={C.ink} stroke-opacity=".3" stroke-width="1.5" stroke-dasharray="2 6" stroke-linecap="round" fill="none">
    <path d="M440 168 340 296"></path>
  </g>

  <!-- tile ground shadows (inverse to tile lift) -->
  <g fill={C.ink} fill-opacity=".1" filter="url(#wsi-hero-blur)">
    {tiles.map((t, i) => (
      <g class="wsi-hero-sh-mid" style={lag(0.4 + jit(i, 0.2))}><g transform={iso(t.x + 6, t.y + t.z, t.s)}><rect width={t.s} height={t.s} rx="12"></rect></g></g>
    ))}
  </g>

  <!-- floating tiles (mid) -->
  {tiles.map((t, i) => (
    <g class={`wsi-hero-mid wsi-hero-${t.cls}`} style={lag(0.4 + jit(i, 0.2))}>
      <g transform={iso(t.x, t.y + 8, t.s)}><rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.side}></rect></g>
      <g transform={iso(t.x, t.y, t.s)}>
        <rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.fill} stroke="#fff" stroke-width="2"></rect>
        {t.kind === 'sheets' && (
          <g>
            <rect x="27" y="17" width="38" height="58" rx="6" fill="#fff"></rect>
            <path d="M52 17h13v13z" fill="#a8dcc0"></path>
            <path d="M34 42h24M34 52h24M34 62h24M44 36v32" stroke={C.sheets} stroke-width="2.2" fill="none"></path>
          </g>
        )}
        {t.kind === 'dollar' && (
          <text x={t.s / 2} y={t.s * 0.7} font-size={t.s * 0.62} font-weight="700" fill="#fff" text-anchor="middle">$</text>
        )}
        {t.kind === 'bars' && (
          <g fill="#4a9fc8">
            <rect x="9" y="22" width="5" height="9" rx="1.5"></rect>
            <rect x="17.5" y="15" width="5" height="16" rx="1.5"></rect>
            <rect x="26" y="8" width="5" height="23" rx="1.5"></rect>
          </g>
        )}
      </g>
    </g>
  ))}

  <!-- verified check (top) -->
  <g class="wsi-hero-top wsi-hero-f2" style={lag(0.8 + jit(7, 0.5))}>
    <g class="wsi-hero-sh-top" style={lag(0.8 + jit(7, 0.5))}><circle cx="644" cy="232" r="28" fill={C.ink} fill-opacity=".08" transform="translate(0 8)"></circle></g>
    <circle cx="644" cy="232" r="26" fill={C.green} stroke="#fff" stroke-width="3"></circle>
    <path d="M632 233l8 8 15-17" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
  </g>

  <!-- =SUM() chip (top) -->
  <g transform="translate(430 144)">
    <g class="wsi-hero-top wsi-hero-f3" style={lag(0.8 + jit(8, 0.5))}>
      <g class="wsi-hero-pulse">
        <rect class="wsi-hero-sh-top" style={lag(0.8 + jit(8, 0.5))} x="-52" y="-16" width="104" height="36" rx="18" fill={C.ink} fill-opacity=".1"></rect>
        <rect x="-52" y="-20" width="104" height="36" rx="18" fill={C.ink}></rect>
        <text x="0" y="3" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">=SUM()</text>
      </g>
    </g>
  </g>

  <!-- pills (top) -->
  {showPills && pills.map((p, i) => (
    <g transform={`translate(${p.x} ${p.y})`}>
      <g class={`wsi-hero-top wsi-hero-${p.cls}`} style={lag(0.8 + jit(i + 3, 0.5))}>
        <rect class="wsi-hero-sh-top" style={lag(0.8 + jit(i + 3, 0.5))} x={-p.w / 2} y={-p.h / 2 + 4} width={p.w} height={p.h} rx={p.h / 2} fill={C.ink} fill-opacity=".1"></rect>
        <rect x={-p.w / 2} y={-p.h / 2} width={p.w} height={p.h} rx={p.h / 2} fill="#fff" stroke={C.beige} stroke-width="1.5"></rect>
        <circle cx={-p.w / 2 + 22} cy="0" r={p.big ? 7 : 6} fill={p.dot}></circle>
        <text x={-p.w / 2 + 38} y={p.fs * 0.35} font-size={p.fs} fill={C.ink}>
          <tspan fill-opacity=".66" font-weight="500">{p.l}</tspan> <tspan font-weight="700">{p.v}</tspan>
        </text>
      </g>
    </g>
  ))}
  </g>
</svg>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  @keyframes wsi-hero-base { 0%, 100% { translate: 0 0; } 50% { translate: 0 -2px; } }
  @keyframes wsi-hero-mid { 0%, 100% { translate: 0 0; } 50% { translate: 0 -7px; } }
  @keyframes wsi-hero-top { 0%, 100% { translate: 0 0; } 50% { translate: 0 -12px; } }
  @keyframes wsi-hero-shadow { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: .92; opacity: .7; } }
  @keyframes wsi-hero-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .85; } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-hero-base, .wsi-hero-mid, .wsi-hero-top { transform-box: fill-box; transform-origin: center; will-change: translate; }
    .wsi-hero-sh-base, .wsi-hero-sh-mid, .wsi-hero-sh-top { transform-box: fill-box; transform-origin: center; will-change: scale, opacity; }
    .wsi-hero-base { animation: wsi-hero-base 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-mid { animation: wsi-hero-mid 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-top { animation: wsi-hero-top 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-sh-base { animation: wsi-hero-shadow 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-sh-mid { animation: wsi-hero-shadow 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-sh-top { animation: wsi-hero-shadow 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-pulse { animation: wsi-hero-pulse 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  }
</style>
