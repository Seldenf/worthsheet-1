---
import { LUCIDE } from '../../lib/lucide-glyphs';
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;

const C = {
  ink: '#2e2926', beige: '#e8e7e5', surface: '#f5f3f2', blue: '#6cbee4', green: '#40aa4a',
  yellow: '#fac344', tB: '#e2f2f9', tG: '#e2f9e9', tC: '#f9f2e2', sheets: '#0f9d58',
};
// 2:1 isometric square of side s*k centred on (cx, cy); local origin = left corner.
const iso = (cx: number, cy: number, s: number, k = 1) =>
  `matrix(${k} ${-k / 2} ${k} ${k / 2} ${cx - s * k} ${cy})`;
// Breathing layers: base 0s, mid +0.4s, top +0.8s; jit() staggers items within a layer.
const lag = (s: number) => `animation-delay:${s.toFixed(2)}s`;
const jit = (i: number, amp: number) => (((i * 0.618) % 1) - 0.5) * 2 * amp;
const intro = (d: number, dur: number, y: number, s = 0.94) =>
  `--in-d:${d}ms;--in-dur:${dur}ms;--in-y:${y}px;--in-s:${s}`;

// ---- spreadsheet board (local 300x300 plane, scaled 1.1) ----
const S = 300;
const K = 1.1;
const colX = [0, 22, 102, 164, 198, 232, 266, 300];
const HDR = 22;
// Board floats BY px-centre above the halo plate (plate centre y = 372); shadow lands on the plate, lower and softer.
const BY = 352;
const BOARD_R = 14 * K;
const wsKey = (i: number) => (i === 0 ? 'assets' : i === 5 ? 'liab' : 'cell');
const RH = (S - HDR) / 9;
const rowY = (i: number) => +(HDR + i * RH).toFixed(1);
const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
const rows = [
  { l: 'Assets', v: '$412,500', h: C.tG, col: C.green },
  { l: 'Checking', v: '$18,400', f: 0.09 },
  { l: 'Savings', v: '$45,000', f: 0.225 },
  { l: 'Retirement', v: '$149,100', f: 0.75 },
  { l: 'Real estate', v: '$200,000', f: 1 },
  { l: 'Liabilities', v: '$186,200', h: C.tC, col: '#b57f0b' },
  { l: 'Mortgage', v: '$168,000', f: 1, y: 1 },
  { l: 'Student loans', v: '$11,200', f: 0.07, y: 1 },
  { l: 'Credit cards', v: '$7,000', f: 0.04, y: 1 },
];
const grid =
  rows.map((_, i) => `M0 ${rowY(i + 1)}H${S}`).join('') +
  `M0 ${HDR}H${S}` +
  colX.slice(1, 7).map((x) => `M${x} 0V${S}`).join('');

// ---- floating tiles (mid layer) ----
const tiles = [
  { x: 262, y: 232, s: 92, fill: C.sheets, side: '#0b7a43', z: 150, cls: 'f1', kind: 'sheets', d: 1.5, enter: intro(200, 700, 20, 0.92), lift: -3.5 },
  { x: 872, y: 392, s: 44, fill: C.yellow, side: '#d9a02a', z: 44, cls: 'f3', kind: 'dollar', d: 0.35, enter: intro(320, 500, 14, 0.9), lift: -3.5 },
  { x: 104, y: 330, s: 40, fill: C.tB, side: '#b9dcee', z: 40, cls: 'f2', kind: 'bars', d: 0.9, enter: intro(400, 480, 12, 0.92) },
];

---

<svg
  class:list={['wsi', 'wsi-hero', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 100 960 423"
  overflow="visible"
  font-family="inherit"
  focusable="false"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <clipPath id="wsi-hero-clip"><rect width={S} height={S} rx="14"></rect></clipPath>
    <filter id="wsi-hero-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter>
    <filter id="wsi-hero-soft" x="-50%" y="-100%" width="200%" height="300%"><feGaussianBlur stdDeviation="6"></feGaussianBlur></filter>
    <filter id="wsi-hero-shadow" x="-30%" y="-60%" width="160%" height="220%"><feGaussianBlur stdDeviation="14"></feGaussianBlur></filter>
  </defs>

  <g transform="translate(480 346) scale(1.1) translate(-480 -372)">
  <!-- halo frame (base) -->
  <g class="wsi-in" style={intro(0, 900, 10, 0.96)}>
  <g class="wsi-breathe wsi-hero-base"><g transform={iso(480, 372, 372)}><rect width="372" height="372" rx="26" fill={C.tG} fill-opacity=".6" stroke="#fff" stroke-width="2"></rect></g></g>
  </g>

  <g class="wsi-in" style={intro(120, 760, 22, 0.97)}>
  <!-- board shadow + slab (base) -->
  <g class="wsi-hero-sh-base"><g transform={iso(480, BY + 34, 312)} filter="url(#wsi-hero-shadow)"><rect width="312" height="312" rx="22" fill="#1f6b2e" fill-opacity=".15"></rect></g></g>
  <g class="wsi-breathe wsi-hero-base"><g transform={iso(480, BY + 7, 330)}><rect width="330" height="330" rx={BOARD_R} fill="#cfe0d5"></rect></g></g>

  <!-- board content (base) -->
  <g class="wsi-breathe wsi-hero-base"><g transform={iso(480, BY, S, K)}>
    <rect width={S} height={S} rx="14" fill="#fff"></rect>
    <g clip-path="url(#wsi-hero-clip)">
      <rect width={S} height={HDR} fill={C.surface}></rect>
      <rect y={rowY(0)} width={S} height={RH} fill={rows[0].h}></rect>
      <rect y={rowY(5)} width={S} height={RH} fill={rows[5].h}></rect>
      {rows.map((r, i) => r.f && (
        <rect x="172" y={rowY(i) + RH / 2 - 4} width={Math.max(5, 120 * r.f)} height="8" rx="4" fill={r.y ? C.yellow : C.blue} fill-opacity={r.y ? '.85' : '.7'}></rect>
      ))}
      <path d={grid} stroke={C.beige} stroke-width="1" fill="none"></path>
      <g font-size="10" fill={C.ink} fill-opacity=".5" text-anchor="middle" font-weight="500">
        {letters.map((t, i) => <text x={(colX[i + 1] + colX[i + 2]) / 2} y="15">{t}</text>)}
        {rows.map((_, i) => <text x="11" y={rowY(i) + RH / 2 + 3}>{i + 1}</text>)}
      </g>
      <g font-size="10" fill={C.ink}>
        {rows.map((r, i) => (
          <text x="27" y={rowY(i) + RH / 2 + 3.5} font-weight={r.h ? 700 : 500} fill={r.col ?? C.ink}>{r.l}</text>
        ))}
        {rows.map((r, i) => (
          <text x="160" y={rowY(i) + RH / 2 + 3.5} text-anchor="end" font-weight={r.h ? 700 : 500} fill={r.col ?? C.ink} style="font-variant-numeric:tabular-nums" data-ws={wsKey(i)} data-i={i}>{r.v}</text>
        ))}
      </g>
      <rect x="160" y={rowY(1) - 4} width="7" height="7" rx="1.5" fill={C.blue} stroke="#fff" stroke-width="1.5"></rect>
    </g>
    <rect width={S} height={S} rx="14" fill="none" stroke="#bccac1" stroke-width="1" vector-effect="non-scaling-stroke"></rect>
  </g></g>

  </g>

  <!-- floating tiles (mid) -->
  {tiles.map((t, i) => (
    <g class="wsi-extra">
    <g class="wsi-in" style={t.enter}>
    <g class="wsi-pt" style={`--d:${t.d}`}>
    <!-- ground shadow: first child of the tile's wsi-pt so it moves with the tile (intro comes from the wsi-in above) -->
    <g fill={C.ink} fill-opacity=".1" filter="url(#wsi-hero-blur)"><g class="wsi-hero-sh-mid" style={lag(0.4 + jit(i, 0.2))}><g transform={iso(t.x + 6, t.y + t.z, t.s)}><rect width={t.s} height={t.s} rx="12"></rect></g></g></g>
    <g class={`wsi-breathe wsi-hero-mid wsi-hero-${t.cls}`} style={`${lag(0.4 + jit(i, 0.2))}${t.lift ? `;--lift:${t.lift}px` : ''}`}>
      <g transform={iso(t.x, t.y + 8, t.s)}><rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.side}></rect></g>
      <g transform={iso(t.x, t.y, t.s)}>
        <rect width={t.s} height={t.s} rx={t.s * 0.17} fill={t.fill} stroke="#fff" stroke-width="2"></rect>
      </g>
      {t.kind === 'sheets' && (
        <g transform={iso(t.x, t.y, t.s)}>
          <g transform="translate(23.6 15) scale(.95)">
            <path d="M29.375 0H4.406C1.983 0 0 1.994 0 4.431v56.138C0 63.006 1.983 65 4.406 65h38.188C45.017 65 47 63.006 47 60.569V17.625L29.375 0z" fill="#fff"></path>
            <path d="M29.375 0v13.19c0 2.43 1.98 4.435 4.4 4.435H47L29.375 0z" fill="#b7e1cd"></path>
            <rect x="11.75" y="33.5" width="23.5" height="19.5" rx="2" fill={C.sheets}></rect>
            <path d="M11.75 40.2H35.25M11.75 46.8H35.25M19.6 33.5V53" stroke="#fff" stroke-width="2.3" fill="none"></path>
          </g>
        </g>
      )}
      <g transform={iso(t.x, t.y, t.s)}>
        {(t.kind === 'dollar' || t.kind === 'bars') && (
          <g
            transform={`translate(${t.s / 2} ${t.s / 2}) scale(${(t.s * 0.62) / 24}) translate(-12 -12)`}
            stroke={t.kind === 'dollar' ? '#fff' : '#4a9fc8'}
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
            set:html={t.kind === 'dollar' ? LUCIDE.dollar : LUCIDE.chart}
          ></g>
        )}
      </g>
    </g>
    </g>
    </g>
    </g>
  ))}

  <!-- verified check (top) -->
  <g class="wsi-extra">
  <g class="wsi-in" style={intro(950, 450, 12, 0.8)}>
  <g class="wsi-pt" style="--d:0.25">
  <!-- ground shadow: first child of the check's wsi-pt so it renders under the piece (same top-layer breathing wrapper keeps its rest position) -->
  <g class="wsi-breathe wsi-hero-top wsi-hero-f2" style={`${lag(0.8 + jit(7, 0.5))};--lift:-6px`}>
    <g class="wsi-hero-sh-top" style={lag(0.8 + jit(7, 0.5))}><circle cx="806" cy="262" r="28" fill={C.ink} fill-opacity=".08" transform="translate(0 8)"></circle></g>
  </g>
  <g class="wsi-breathe wsi-hero-top wsi-hero-f2" style={`${lag(0.8 + jit(7, 0.5))};--lift:-6px`}>
    <circle cx="806" cy="262" r="26" fill={C.green} stroke="#fff" stroke-width="3"></circle>
    <path d="M795 263l7.5 7.5 14-15" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
  </g>
  </g>
  </g>
  </g>

  <!-- formula bar (bottom-left, rises from below board) -->
  <g class="wsi-extra">
  <g class="wsi-in" style={intro(560, 520, 16, 0.97)}>
  <g class="wsi-pt" style="--d:0.45">
  <g transform="translate(50 484)">
    <rect x="0" y="4" width="300" height="34" rx="4" fill={C.ink} fill-opacity=".12" filter="url(#wsi-hero-soft)"></rect>
    <rect width="300" height="34" rx="4" fill="#fff" stroke="#e3e0dd" stroke-width="1"></rect>
    <path d="M44 0V34" stroke="#e3e0dd" stroke-width="1"></path>
    <text x="22" y="21.5" text-anchor="middle" font-size="13" font-style="italic" font-weight="500" fill={C.ink} fill-opacity=".45">fx</text>
    <text x="58" y="21.5" font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" font-size="13" fill={C.ink}>=SUM(B2:B5) − SUM(B7:B9)</text>
  </g>
  </g>
  </g>
  </g>
  <!-- summary panel (top, slides in from right, overlaps board's top-right edge) -->
  <g class="wsi-extra">
  <g class="wsi-in" style={intro(640, 560, 0, 1)}>
  <g class="wsi-pt" style="--d:0.6">
  <g class="wsi-hero-slide" style="--in-d:640ms;--in-dur:560ms">
  <g transform="translate(588 166)">
    <rect y="8" width="180" height="112" rx="6" fill={C.ink} fill-opacity=".14" filter="url(#wsi-hero-soft)"></rect>
    <rect width="180" height="112" rx="6" fill="#fff" stroke="#e3e0dd" stroke-width="1"></rect>
    <path d="M0 6a6 6 0 0 1 6-6h168a6 6 0 0 1 6 6v18H0z" fill={C.surface}></path>
    <rect y="24" width="180" height="1" fill="#e3e0dd"></rect>
    <text x="12" y="16" font-size="10" font-weight="600" fill={C.ink} fill-opacity=".5">Summary</text>
    <g font-size="12" fill={C.ink} style="font-variant-numeric:tabular-nums">
      <rect x="12" y="36.5" width="7" height="7" rx="1.5" fill={C.green}></rect>
      <text x="26" y="44" font-weight="500" fill-opacity=".66">Assets</text>
      <text x="168" y="44" text-anchor="end" font-weight="600" data-ws="assets">$412,500</text>
      <rect x="12" y="56.5" width="7" height="7" rx="1.5" fill={C.yellow}></rect>
      <text x="26" y="64" font-weight="500" fill-opacity=".66">Liabilities</text>
      <text x="168" y="64" text-anchor="end" font-weight="600" data-ws="liab">$186,200</text>
    </g>
    <rect x="12" y="74" width="156" height="1" fill="#e3e0dd"></rect>
    <rect x="12" y="86.5" width="7" height="7" rx="1.5" fill={C.blue}></rect>
    <text x="26" y="94" font-size="13" font-weight="700" fill={C.ink}>Net worth</text>
    <text x="168" y="94" font-size="13" font-weight="700" text-anchor="end" fill={C.ink} style="font-variant-numeric:tabular-nums" data-ws="net">$226,300</text>
  </g>
  </g>
  </g>
  </g>
  </g>
  </g>
</svg>

<script>
  // Split-flap "recalculation": mutates value <text> nodes while the hero is in view. SSR markup keeps the original numbers.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  const fmt = (n: number) => '$' + n.toLocaleString('en-US');
  const isDigit = (c: string) => c >= '0' && c <= '9';
  const DIGIT_STAGGER = 40;
  const FLIP_STEP = 60;

  function flip(el: SVGTextElement, to: string) {
    const from = el.textContent ?? '';
    if (from === to) return;
    const ch = [...to];
    const old = [...from];
    const off = old.length - ch.length;
    let order = 0;
    const plan = ch.map((c) => {
      if (!isDigit(c)) return null;
      const n = 2 + Math.floor(Math.random() * 3);
      const start = order++ * DIGIT_STAGGER;
      return { start, step: FLIP_STEP, seq: Array.from({ length: n }, () => String(Math.floor(Math.random() * 10))), end: start + n * FLIP_STEP };
    });
    const total = Math.max(...plan.map((p) => p?.end ?? 0));
    const t0 = performance.now();
    const frame = (now: number) => {
      const t = now - t0;
      if (t >= total) { el.textContent = to; return; }
      let s = '';
      for (let i = 0; i < ch.length; i++) {
        const p = plan[i];
        if (!p) s += ch[i];
        else if (t >= p.end) s += ch[i];
        else if (t < p.start) s += old[i + off] ?? ch[i];
        else s += p.seq[Math.min(p.seq.length - 1, Math.floor((t - p.start) / p.step))];
      }
      if (el.textContent !== s) el.textContent = s;
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  function setup(svg: SVGSVGElement) {
    const num = (el: Element) => parseInt((el.textContent ?? '').replace(/\D/g, ''), 10);
    const cells = [...svg.querySelectorAll<SVGTextElement>('text[data-ws="cell"]')].map((el) => {
      const v = num(el);
      return { el, v, lo: v * 0.6, hi: v * 1.5, group: Number(el.dataset.i) < 5 ? 'assets' : 'liab' };
    });
    if (!cells.length) return;
    const totals = {
      assets: [...svg.querySelectorAll<SVGTextElement>('text[data-ws="assets"]')],
      liab: [...svg.querySelectorAll<SVGTextElement>('text[data-ws="liab"]')],
      net: [...svg.querySelectorAll<SVGTextElement>('text[data-ws="net"]')],
    };
    let tick = 0;
    let timer = 0;
    let visible = false;

    const run = () => {
      tick++;
      const pool = [...cells].sort(() => Math.random() - 0.5).slice(0, 1 + Math.floor(Math.random() * 3));
      for (const c of pool) {
        let next = c.v;
        for (let tries = 0; tries < 6 && next === c.v; tries++) {
          const d = rnd(0.02, 0.09) * (Math.random() < 0.5 ? -1 : 1);
          next = Math.round((c.v * (1 + d)) / 100) * 100;
          next = Math.min(c.hi, Math.max(c.lo, next));
        }
        if (next === c.v) continue;
        c.v = next;
        flip(c.el, fmt(next));
      }
      if (tick % 3 === 0) {
        const a = cells.filter((c) => c.group === 'assets').reduce((s, c) => s + c.v, 0);
        const l = cells.filter((c) => c.group === 'liab').reduce((s, c) => s + c.v, 0);
        totals.assets.forEach((el) => flip(el, fmt(a)));
        totals.liab.forEach((el) => flip(el, fmt(l)));
        totals.net.forEach((el) => flip(el, fmt(a - l)));
      }
      schedule();
    };
    const schedule = () => {
      clearTimeout(timer);
      if (visible && !document.hidden && !reduce.matches) timer = window.setTimeout(run, rnd(3500, 5000));
    };

    new IntersectionObserver((entries) => {
      visible = entries[entries.length - 1].isIntersecting;
      visible ? schedule() : clearTimeout(timer);
    }).observe(svg);
    document.addEventListener('visibilitychange', schedule);
    reduce.addEventListener('change', schedule);
  }

  document.querySelectorAll<SVGSVGElement>('svg.wsi-hero').forEach(setup);
</script>

<style is:global>
  :where(svg.wsi) { display: block; width: 100%; height: auto; }
  svg.wsi-hero { overflow: visible; }
  @keyframes wsi-hero-base { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -2px) * var(--amp, 1)); } }
  @keyframes wsi-hero-mid { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -7px) * var(--amp, 1)); } }
  @keyframes wsi-hero-top { 0%, 100% { translate: 0 0; } 50% { translate: 0 calc(var(--lift, -12px) * var(--amp, 1)); } }
  @keyframes wsi-hero-shadow { 0%, 100% { scale: 1; opacity: 1; } 50% { scale: .92; opacity: .7; } }
  @keyframes wsi-hero-slide { from { translate: 48px 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .wsi-hero-base, .wsi-hero-mid, .wsi-hero-top { transform-box: fill-box; transform-origin: center; will-change: translate; }
    .wsi-hero-sh-base, .wsi-hero-sh-mid, .wsi-hero-sh-top { transform-box: fill-box; transform-origin: center; will-change: scale, opacity; }
    .wsi-hero-base { --lift: -2px; animation: wsi-hero-base 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-mid { --lift: -7px; animation: wsi-hero-mid 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-top { --lift: -12px; animation: wsi-hero-top 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-sh-base { animation: wsi-hero-shadow 8s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-sh-mid { animation: wsi-hero-shadow 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    .wsi-hero-sh-top { animation: wsi-hero-shadow 6s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
    svg.wsi.is-in .wsi-hero-slide { animation: wsi-hero-slide var(--in-dur, 700ms) cubic-bezier(0.23, 1, 0.32, 1) var(--in-d, 0ms) backwards; }
  }
</style>
