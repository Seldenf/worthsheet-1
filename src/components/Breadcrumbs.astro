---
import { url } from '../lib/url';

interface Props {
  items: { name: string; path: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{
  items.length > 0 && (
    <nav class:list={['breadcrumbs', className]} aria-label="Breadcrumb">
      <ol>
        {items.map((item, i) => (
          <li>
            {i < items.length - 1 ? (
              <a href={url(item.path)}>{item.name}</a>
            ) : (
              <span aria-current="page">{item.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    list-style: none;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    color: var(--muted-soft);
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--ink);
  }
</style>
