---
import type { CollectionEntry } from 'astro:content';
import PostCover from './PostCover.astro';
import { url } from '../lib/url';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Heading level for the card title (default 3). */
  level?: 2 | 3;
  /** Load the card image eagerly (first row of the index). */
  eager?: boolean;
}

const { post, level = 3, eager = false } = Astro.props;
const { title, description, pubDate, cover } = post.data;
const Heading = `h${level}` as 'h2' | 'h3';
const date = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

type Cover = NonNullable<CollectionEntry<'blog'>['data']['cover']>;

const BLUE = 'rgba(108, 190, 228, 0.9)';
const GREEN = 'rgba(64, 170, 74, 0.85)';
const PINK = 'rgba(224, 127, 184, 0.85)';
// Edge ring per cover tint, mirroring PostCover's tint rotation.
// Cream covers have no edge colour and keep the default.
const COVER_EDGE: Record<Cover, string | undefined> = {
  HeroSheet: BLUE,
  IsoTiles: GREEN,
  CategoriesStack: undefined,
  StepsFlow: PINK,
  ShieldSecure: BLUE,
  CalculatorTile: GREEN,
  BankMap: undefined,
  GlossaryBook: PINK,
  DocumentStack: BLUE,
  ReadinessGauge: GREEN,
  CtaTiles: undefined,
};
const edge = COVER_EDGE[cover ?? 'DocumentStack'];
---

<article class="post-card card" style={edge ? `--edge: ${edge}` : undefined}>
  <a class="post-card-link" href={url(`/${post.id}/`)}>
    <div class="post-card-media">
      <PostCover cover={cover} />
    </div>
    <div class="post-card-body">
      <Heading class="post-card-title">{title}</Heading>
      <p class="post-card-desc">{description}</p>
      <p class="post-card-date muted">
        <time datetime={pubDate.toISOString().slice(0, 10)}>{date}</time>
      </p>
    </div>
  </a>
</article>

<style>
  .post-card {
    padding: 0;
    overflow: hidden;
    border-radius: 20px;
    color: var(--ink);
  }

  .post-card-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
    border-radius: inherit;
  }

  .post-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .post-card-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .post-card-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: clamp(18px, 2.4vw, 26px);
  }

  .post-card-title {
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .post-card-desc {
    color: var(--muted);
    font-size: 0.975rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-date {
    margin-top: auto;
    padding-top: 6px;
    font-size: 0.875rem;
  }
</style>
