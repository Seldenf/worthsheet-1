<a class="sr-logo" href="#" data-sr-logo aria-label="WorthSheet home">
  <svg class="sr-mark" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="#2e2926" />
    <rect x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a" />
    <rect x="34" y="14" width="16" height="16" rx="4" fill="#fdfcfa" />
    <rect x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4" />
    <rect x="14" y="34" width="16" height="16" rx="4" fill="#fdfcfa" />
    <rect class="sr-tint" x="12" y="12" width="40" height="40" />
    <rect class="sr-sel" x="12" y="12" width="40" height="40" />
    <rect class="sr-handle" x="-4" y="-4" width="8" height="8" />
  </svg>
  <span class="sr-word">WorthSheet</span>
</a>

<style>
  .sr-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: #2e2926;
    border-radius: 10px;
  }

  .sr-logo:focus-visible {
    outline: 2px solid #3b9fd6;
    outline-offset: 4px;
  }

  .sr-mark {
    display: block;
    flex: none;
    overflow: visible;
  }

  .sr-tint,
  .sr-sel,
  .sr-handle {
    opacity: 0;
    vector-effect: non-scaling-stroke;
  }

  .sr-tint {
    fill: rgba(59, 159, 214, 0.16);
    stroke: none;
    transform-box: view-box;
    transform-origin: 12px 12px;
    transform: scale(0.5);
  }

  .sr-sel {
    fill: none;
    stroke: #3b9fd6;
    stroke-width: 1.5;
    transform-box: view-box;
    transform-origin: 12px 12px;
    transform: scale(0.5);
  }

  .sr-handle {
    fill: #3b9fd6;
    stroke: #fdfcfa;
    stroke-width: 1;
    transform: translate(32px, 32px);
  }

  .sr-word {
    font-family: "Geist", system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 580;
    letter-spacing: -0.01em;
    line-height: 1;
    color: #2e2926;
  }
</style>

<script>
  const DURATION = 900;
  const EASE_UI = "cubic-bezier(0.23,1,0.32,1)";
  const EASE_TRAVEL = "cubic-bezier(0.65,0,0.35,1)";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  document
    .querySelectorAll<HTMLAnchorElement>("a[data-sr-logo]")
    .forEach((link) => {
      if (link.dataset.srReady) return;
      link.dataset.srReady = "1";
      if (reduceMotion.matches) return;

      const sel = link.querySelector<SVGRectElement>(".sr-sel")!;
      const tint = link.querySelector<SVGRectElement>(".sr-tint")!;
      const handle = link.querySelector<SVGRectElement>(".sr-handle")!;

      // Timeline (ms of 900): 0–198 outline + handle appear on A1 (ease-out);
      // 198–702 outline grows to A1:B2 (travel easing), handle tracks the
      // corner, tint ramps in; 702–900 hold. Keyframe easing applies to the
      // segment that starts at that keyframe, so all three stay in lockstep.
      const make = (el: Element, frames: Keyframe[]) => {
        const a = el.animate(frames, { duration: DURATION, fill: "both" });
        a.pause();
        a.currentTime = 0;
        return a;
      };

      const anims = [
        make(sel, [
          { transform: "scale(0.5)", opacity: 0, easing: EASE_UI, offset: 0 },
          { transform: "scale(0.5)", opacity: 1, easing: EASE_TRAVEL, offset: 0.22 },
          { transform: "scale(1)", opacity: 1, offset: 0.78 },
          { transform: "scale(1)", opacity: 1, offset: 1 },
        ]),
        make(tint, [
          { transform: "scale(0.5)", opacity: 0, easing: EASE_UI, offset: 0 },
          { transform: "scale(0.5)", opacity: 0, easing: EASE_TRAVEL, offset: 0.22 },
          { transform: "scale(1)", opacity: 1, offset: 0.78 },
          { transform: "scale(1)", opacity: 1, offset: 1 },
        ]),
        make(handle, [
          { transform: "translate(32px, 32px)", opacity: 0, easing: EASE_UI, offset: 0 },
          { transform: "translate(32px, 32px)", opacity: 1, easing: EASE_TRAVEL, offset: 0.22 },
          { transform: "translate(52px, 52px)", opacity: 1, offset: 0.78 },
          { transform: "translate(52px, 52px)", opacity: 1, offset: 1 },
        ]),
      ];

      let hover = false;
      let focus = false;

      // Boomerang: always drive from the current progress.
      const sync = () => {
        const want = hover || focus;
        const t = Number(anims[0].currentTime ?? 0);
        if (want) {
          if (t >= DURATION) return;
        } else if (t <= 0) {
          anims.forEach((a) => {
            a.pause();
            a.currentTime = 0;
          });
          return;
        }
        const rate = want ? 1 : -1;
        anims.forEach((a) => {
          a.playbackRate = rate;
          a.play();
        });
      };

      link.addEventListener("pointerenter", () => {
        if (!finePointer.matches) return;
        hover = true;
        sync();
      });
      link.addEventListener("pointerleave", () => {
        hover = false;
        sync();
      });
      link.addEventListener("focus", () => {
        focus = link.matches(":focus-visible");
        sync();
      });
      link.addEventListener("blur", () => {
        focus = false;
        sync();
      });
    });
</script>
