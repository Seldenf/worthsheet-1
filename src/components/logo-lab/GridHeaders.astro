<a class="lab-logo gh-logo" href="#" data-logo-lab="grid-headers">
  <svg class="gh-svg" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true" focusable="false">
    <g class="gh-mark">
      <rect class="gh-tile" width="64" height="64" rx="16" fill="#2e2926" />

      <g class="gh-grid" stroke="#fdfcfa" stroke-opacity="0.42" stroke-width="1" fill="none">
        <path class="gh-line" d="M32 32V0" pathLength="1" />
        <path class="gh-line" d="M32 32V64" pathLength="1" />
        <path class="gh-line" d="M32 32H0" pathLength="1" />
        <path class="gh-line" d="M32 32H64" pathLength="1" />
      </g>

      <rect class="gh-cell" x="14" y="14" width="16" height="16" rx="4" fill="#40aa4a" />
      <rect class="gh-cell" x="34" y="14" width="16" height="16" rx="4" fill="#fdfcfa" />
      <rect class="gh-cell" x="34" y="34" width="16" height="16" rx="4" fill="#6cbee4" />
      <rect class="gh-cell" x="14" y="34" width="16" height="16" rx="4" fill="#fdfcfa" />

      <text class="gh-col gh-col-a" x="22" y="9.5" text-anchor="middle" fill="#fdfcfa">A</text>
      <text class="gh-col gh-col-b" x="42" y="9.5" text-anchor="middle" fill="#fdfcfa">B</text>
      <text class="gh-row gh-row-1" x="7" y="25.5" text-anchor="middle" fill="#fdfcfa">1</text>
      <text class="gh-row gh-row-2" x="7" y="45.5" text-anchor="middle" fill="#fdfcfa">2</text>

      <rect class="gh-cursor" x="11.5" y="11.5" width="21" height="21" rx="2.5" fill="none" stroke="#fdfcfa" stroke-width="3" />
    </g>
  </svg>
  <span class="gh-word">WorthSheet</span>
</a>

<style>
  .gh-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: #2e2926;
    border-radius: 8px;
  }

  .gh-logo:focus-visible {
    outline: 2px solid #6cbee4;
    outline-offset: 4px;
  }

  .gh-svg {
    flex: none;
    display: block;
    overflow: visible;
  }

  .gh-mark {
    transform-box: view-box;
    transform-origin: 32px 32px;
  }

  .gh-cell {
    transform-box: fill-box;
    transform-origin: center;
  }

  .gh-line {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  .gh-col,
  .gh-row {
    font-family: Geist, ui-sans-serif, system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    opacity: 0;
  }

  .gh-cursor {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }

  .gh-word {
    font-family: Geist, ui-sans-serif, system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 580;
    letter-spacing: -0.01em;
    color: #2e2926;
    line-height: 1;
  }
</style>

<script>
  const SELECTOR = 'a[data-logo-lab="grid-headers"]';
  const DURATION = 800;
  const EASE_OUT = 'cubic-bezier(0.23,1,0.32,1)';
  const EASE_TRAVEL = 'cubic-bezier(0.65,0,0.35,1)';

  interface Segment {
    target: string;
    from: Record<string, string | number>;
    to: Record<string, string | number>;
    start: number;
    end: number;
    easing: string;
  }

  // Forward timeline in ms (total 800). Reversed on leave, same keyframes.
  const SEGMENTS: Segment[] = [
    { target: '.gh-mark', from: { transform: 'scale(1)' }, to: { transform: 'scale(1.08)' }, start: 0, end: 640, easing: EASE_OUT },
    { target: '.gh-line', from: { strokeDashoffset: 1 }, to: { strokeDashoffset: 0 }, start: 60, end: 420, easing: EASE_TRAVEL },
    { target: '.gh-cell', from: { transform: 'scale(1)' }, to: { transform: 'scale(0.9)' }, start: 120, end: 520, easing: EASE_OUT },
    { target: '.gh-col-a', from: { transform: 'translateY(-5px)', opacity: 0 }, to: { transform: 'translateY(0px)', opacity: 1 }, start: 240, end: 520, easing: EASE_OUT },
    { target: '.gh-col-b', from: { transform: 'translateY(-5px)', opacity: 0 }, to: { transform: 'translateY(0px)', opacity: 1 }, start: 300, end: 580, easing: EASE_OUT },
    { target: '.gh-row-1', from: { transform: 'translateX(-6px)', opacity: 0 }, to: { transform: 'translateX(0px)', opacity: 1 }, start: 320, end: 600, easing: EASE_OUT },
    { target: '.gh-row-2', from: { transform: 'translateX(-6px)', opacity: 0 }, to: { transform: 'translateX(0px)', opacity: 1 }, start: 380, end: 660, easing: EASE_OUT },
    { target: '.gh-cursor', from: { transform: 'translate(-5px,-5px) scale(1.2)', opacity: 0 }, to: { transform: 'translate(0px,0px) scale(1)', opacity: 1 }, start: 460, end: 760, easing: EASE_OUT },
  ];

  function init(root: HTMLAnchorElement) {
    if (root.dataset.ghReady === 'true') return;
    root.dataset.ghReady = 'true';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const animations: Animation[] = [];

    for (const seg of SEGMENTS) {
      root.querySelectorAll<SVGElement>(seg.target).forEach((el) => {
        const frames = [
          { offset: 0, ...seg.from, easing: 'linear' },
          { offset: seg.start / DURATION, ...seg.from, easing: seg.easing },
          { offset: seg.end / DURATION, ...seg.to, easing: 'linear' },
          { offset: 1, ...seg.to },
        ] as Keyframe[];
        const anim = el.animate(frames, { duration: DURATION, fill: 'both' });
        anim.pause();
        animations.push(anim);
      });
    }

    let hover = false;
    let focus = false;
    let dir: 1 | -1 = -1;

    const sync = () => {
      const next: 1 | -1 = hover || focus ? 1 : -1;
      if (next === dir) return;
      dir = next;
      for (const anim of animations) {
        anim.playbackRate = next;
        anim.play();
      }
    };

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch' || !fine.matches) return;
      hover = true;
      sync();
    });
    root.addEventListener('pointerleave', () => {
      hover = false;
      sync();
    });
    root.addEventListener('focusin', () => {
      if (root.matches(':focus-visible')) {
        focus = true;
        sync();
      }
    });
    root.addEventListener('focusout', () => {
      focus = false;
      sync();
    });
  }

  document.querySelectorAll<HTMLAnchorElement>(SELECTOR).forEach(init);
</script>
