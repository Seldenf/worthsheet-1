---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/Sheet.astro';
import Prose from '../../components/Prose.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import GlossaryBook from '../../components/illustrations/GlossaryBook.astro';
import CtaTiles from '../../components/illustrations/CtaTiles.astro';
import { url } from '../../lib/url';
import { abs } from '../../lib/seo';
import { GLOSSARY_META } from '../../data/glossary-meta';

export async function getStaticPaths() {
  const entries = await getCollection('glossary');
  const termBySlug = new Map(entries.map((e) => [e.id, e.data.term]));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, termBySlug },
  }));
}

const { entry, termBySlug } = Astro.props;
const slug = entry.id;
const { term, definition, description, related = [], relatedLinks = [] } = entry.data;

const meta = GLOSSARY_META[slug];
if (!meta) throw new Error(`Missing GLOSSARY_META entry for "${slug}" in src/data/glossary-meta.ts`);

const relatedTerms = related.map((s) => {
  const name = termBySlug.get(s);
  if (!name) throw new Error(`Glossary "${slug}" lists unknown related slug "${s}"`);
  return { slug: s, term: name };
});

const { Content } = await render(entry);
const path = `/glossary/${slug}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    '@id': abs(path) + '#term',
    name: term,
    description: definition,
    url: abs(path),
    inLanguage: 'en-US',
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      '@id': abs('/glossary/') + '#glossary',
      name: 'WorthSheet personal finance and mortgage glossary',
      url: abs('/glossary/'),
    },
  },
];
---

<Base
  title={meta.title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Glossary', path: '/glossary/' },
    { name: term, path },
  ]}
>
  <Sheet grid seed={29} id="hero" aria-labelledby="term-title">
    <div class="split">
      <div class="split-copy stack" style="--stack-gap: 1.25rem">
        <Eyebrow tone="green">Glossary · {meta.topic}</Eyebrow>
        <h1 id="term-title">{meta.h1}</h1>
        <p class="lead">{definition}</p>
      </div>
      <GlossaryBook class="float" />
    </div>
  </Sheet>

  <Sheet>
    <Prose>
      <Content />
    </Prose>
  </Sheet>

  {
    (relatedTerms.length > 0 || relatedLinks.length > 0) && (
      <Sheet tone="cream">
        {relatedTerms.length > 0 && (
          <section class="aside-block" aria-labelledby="related-terms">
            <h2 id="related-terms">Related terms</h2>
            <ul class="chips">
              {relatedTerms.map((r) => (
                <li>
                  <a class="pill" href={url(`/glossary/${r.slug}/`)}>
                    {r.term}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {relatedLinks.length > 0 && (
          <section class="aside-block" aria-labelledby="related-links">
            <h2 id="related-links">Tools and guides</h2>
            <ul class="links">
              {relatedLinks.map((l) => (
                <li>
                  <a class="card" href={url(l.path)}>{l.label}</a>
                </li>
              ))}
              <li>
                <a class="card" href={url('/glossary/')}>All glossary terms</a>
              </li>
            </ul>
          </section>
        )}
      </Sheet>
    )
  }

  <CtaBand>
    <CtaTiles slot="art" />
  </CtaBand>
</Base>

<style>
  .aside-block + .aside-block {
    margin-top: clamp(32px, 5vw, 48px);
  }

  .aside-block h2 {
    margin: 0 0 16px;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .chips,
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }

  .links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 16px 18px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
</style>

