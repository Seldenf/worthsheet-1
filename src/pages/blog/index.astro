---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import CtaTiles from '../../components/illustrations/CtaTiles.astro';
import { abs } from '../../lib/seo';
import { url } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const TOPICS = [
  { id: 'mortgage', label: 'Mortgage', test: /mortgage|lender|home|pre-?approval|debt-to-income|dti/i },
  { id: 'credit', label: 'Credit', test: /credit/i },
  { id: 'pfs-net-worth', label: 'PFS & net worth', test: /personal financial statement|\bpfs\b|net worth|assets/i },
  { id: 'sba', label: 'SBA', test: /\bsba\b|413|business loan/i },
];

const topics = TOPICS.map((topic) => ({
  ...topic,
  posts: posts.filter((post) =>
    topic.test.test([post.id.replace(/-/g, ' '), post.data.title, ...(post.data.keywords ?? [])].join(' | ')),
  ),
})).filter((topic) => topic.posts.length > 0);

const featuredSlugs = [
  'what-is-a-personal-financial-statement',
  'mortgage-readiness-checklist',
  'how-to-fill-out-sba-form-413',
];
const featured = featuredSlugs
  .map((slug) => posts.find((post) => post.id === slug))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const title = 'PFS, Credit & Mortgage Guides | WorthSheet Blog';
const description =
  'Guides on personal financial statements, net worth, credit reports, debt-to-income and mortgage readiness, with sources from the CFPB, Fannie Mae, SBA and FDIC.';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'WorthSheet guides',
  description,
  url: abs('/blog/'),
  inLanguage: 'en-US',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: abs(`/${post.id}/`),
      name: post.data.title,
    })),
  },
};
---

<Base
  title={title}
  description={description}
  path="/blog/"
  breadcrumbs={[{ name: 'Blog', path: '/blog/' }]}
  jsonLd={[collectionLd]}
>
  <Section tone="surface" aria-labelledby="blog-title">
    <div class="stack blog-hero" style="--stack-gap: 1.25rem">
      <Eyebrow>Guides</Eyebrow>
      <h1 id="blog-title">WorthSheet guides: personal financial statements, credit and mortgages</h1>
      <p class="lead">
        Plain-English guides on how to build a personal financial statement, what lenders look at
        when they review your finances, and how to get ready for a mortgage or an SBA loan. Pair
        them with the <a href={url('/download/')}>free WorthSheet template</a>.
      </p>
      {
        featured.length > 0 && (
          <p class="featured muted">
            Start here:
            {featured.map((post, i) => (
              <>
                {i > 0 && ' · '}
                <a href={url(`/${post.id}/`)}>{post.data.title}</a>
              </>
            ))}
          </p>
        )
      }
      {
        topics.length > 1 && (
          <nav class="chips" aria-label="Jump to a topic">
            <ul>
              {topics.map((topic) => (
                <li>
                  <a class="pill" href={`#topic-${topic.id}`}>
                    {topic.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </Section>

  <Section aria-labelledby="latest-title">
    <h2 id="latest-title" class="section-title">Latest guides</h2>
    {
      posts.length > 0 ? (
        <div class="grid grid-3 posts">
          {posts.map((post, i) => (
            <PostCard post={post} eager={i < 3} />
          ))}
        </div>
      ) : (
        <p class="muted">New guides are on the way. Meanwhile, get the free template below.</p>
      )
    }
  </Section>

  {
    topics.length > 1 && (
      <Section tone="surface" aria-labelledby="topics-title">
        <h2 id="topics-title" class="section-title">
          Browse by topic
        </h2>
        <div class="grid grid-2 topics">
          {topics.map((topic) => (
            <div id={`topic-${topic.id}`} class="card topic">
              <h3>{topic.label}</h3>
              <ul>
                {topic.posts.map((post) => (
                  <li>
                    <a href={url(`/${post.id}/`)}>{post.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  <CtaBand>
    <CtaTiles slot="art" />
  </CtaBand>
</Base>

<style>
  .blog-hero {
    max-width: 52rem;
  }

  .featured a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  .chips ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
  }

  .chips a.pill {
    min-height: 40px;
    padding-inline: 1.1em;
    text-decoration: none;
  }

  .chips a.pill:hover {
    border-color: var(--line-strong);
    background: var(--paper);
  }

  .section-title {
    margin-bottom: clamp(20px, 3vw, 36px);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }

  .topic {
    scroll-margin-top: 96px;
  }

  .topic h3 {
    margin-bottom: 0.75em;
    font-size: 1.25rem;
  }

  .topic ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .topic a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .topic a:hover {
    text-decoration-color: var(--ink);
  }
</style>
