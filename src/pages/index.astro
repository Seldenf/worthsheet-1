---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Sheet from '../components/Sheet.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroSheet from '../components/illustrations/HeroSheet.astro';
import IsoTiles from '../components/illustrations/IsoTiles.astro';
import CategoriesStack from '../components/illustrations/CategoriesStack.astro';
import StepTile from '../components/illustrations/StepTile.astro';
import ShieldSecure from '../components/illustrations/ShieldSecure.astro';
import IsoIcon from '../components/IsoIcon.astro';
import PostCover from '../components/PostCover.astro';
import chaseLogo from '../assets/banks/chase.svg';
import bofaLogo from '../assets/banks/bank-of-america.svg';
import wellsLogo from '../assets/banks/wells-fargo.svg';
import { STATS } from '../config';
import { url } from '../lib/url';
import { faqLd, webAppLd } from '../lib/seo';

const title = 'Free Personal Financial Statement Template | WorthSheet';
const description =
  'Free personal financial statement template for Google Sheets and Excel: 27 asset and 13 liability categories, automatic net worth, bank-ready. 9,000+ downloads.';

const banks = [
  { name: 'Chase', logo: chaseLogo, height: 22 },
  { name: 'Bank of America', logo: bofaLogo, height: 38 },
  { name: 'Wells Fargo', logo: wellsLogo, height: 30 },
];

// Highlighted grid cells around the hero sheet (soft fading gradients + grain, after equals.com).
// [column, row, tone, strength %, strongest end]. Columns/rows count from the sheet's top-left cell;
// rows >= 26 sit below the sheet. Columns -1 and 12 show at 1400px; -2, -3, 13, 14 on wider screens.
type Tone = 'green' | 'blue' | 'yellow' | 'pink';
const glow: [number, number, Tone, number, 'l' | 'r'][] = [
  [1, -1, 'green', 30, 'r'], [2, -1, 'green', 16, 'r'],
  [6, -2, 'yellow', 34, 'l'], [7, -2, 'yellow', 16, 'l'],
  [9, -1, 'blue', 28, 'r'], [10, -2, 'pink', 22, 'l'], [10, -1, 'blue', 14, 'r'],
  [-1, 2, 'green', 46, 'l'], [-1, 3, 'green', 34, 'l'], [-1, 4, 'green', 22, 'l'], [-1, 5, 'green', 11, 'l'],
  [-1, 11, 'yellow', 42, 'l'], [-1, 12, 'yellow', 26, 'l'], [-1, 13, 'yellow', 12, 'l'],
  [-1, 19, 'blue', 36, 'l'], [-1, 20, 'blue', 20, 'l'],
  [-2, 6, 'blue', 34, 'r'], [-2, 7, 'blue', 22, 'r'], [-2, 8, 'blue', 12, 'r'],
  [-2, 15, 'pink', 28, 'r'], [-2, 16, 'pink', 16, 'r'],
  [-3, 3, 'yellow', 30, 'r'], [-3, 4, 'yellow', 16, 'r'],
  [12, 1, 'blue', 44, 'r'], [12, 2, 'blue', 30, 'r'], [12, 3, 'blue', 16, 'r'],
  [12, 9, 'pink', 30, 'r'], [12, 10, 'pink', 18, 'r'],
  [12, 15, 'green', 40, 'r'], [12, 16, 'green', 28, 'r'], [12, 17, 'green', 14, 'r'],
  [12, 23, 'yellow', 34, 'r'], [12, 24, 'yellow', 18, 'r'],
  [13, 5, 'green', 30, 'l'], [13, 6, 'green', 16, 'l'],
  [13, 12, 'yellow', 34, 'l'], [13, 13, 'yellow', 20, 'l'],
  [14, 2, 'pink', 24, 'l'], [14, 19, 'blue', 30, 'l'],
  [2, 26, 'yellow', 32, 'r'], [3, 27, 'yellow', 16, 'r'],
  [7, 26, 'blue', 26, 'l'], [11, 27, 'green', 30, 'r'],
];

const steps = [
  {
    title: 'Download the template',
    tone: 'blue',
    text: 'Enter your name and email on the download page. You get your own copy in Google Sheets, with an Excel (.xlsx) download one click away.',
    cta: true,
  },
  {
    title: 'Open the spreadsheet',
    tone: 'green',
    text: 'Open your copy in Google Sheets, or open the .xlsx file in Excel. The Personal Finance Statement (PFS) tab is the main sheet; Homebuyer Readiness is a second tab.',
  },
  {
    title: 'Enter your accounts',
    tone: 'yellow',
    text: 'Under each asset and liability category, type the institution name and the latest balance. Add a row if you have more accounts than the template shows. Category totals, total assets, total liabilities and net worth calculate automatically.',
  },
  {
    title: 'Review, print and sign',
    tone: 'green',
    text: 'Check the numbers against your latest statements, set the "as of" date, then print the PFS tab or export it to PDF. Sign and date it before you send it to your lender or advisor.',
  },
];

const securityCards = [
  {
    title: 'Trusted',
    text: 'A universal template that can be tailored for personal or financial services needs.',
    icon: '<path d="M12 3l7 3v5c0 4.5-3 8-7 9.5C8 19 5 15.5 5 11V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  },
  {
    title: 'Safe & Secure',
    text: 'Available to download for Google Sheets or Excel. Save and store it in your own folder.',
    icon: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  },
  {
    title: 'Easy to use',
    text: 'Add categories and accounts to create your own custom personal financial statement.',
    icon: '<path d="M5 4l6 16 2.5-6.5L20 11z"/>',
  },
  {
    title: 'Automated',
    text: 'Sections are pre-built to calculate category totals, asset totals, liability totals and net worth.',
    icon: '<path d="M17 5H7l5 7-5 7h10"/>',
  },
  {
    title: 'Simple customization',
    text: 'Create tabs for multiple time periods and add notes or links to documents for future reference.',
    icon: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
  },
];

const testimonials = [
  {
    quote: 'Bank requested Personal Financial Statement as part of a SBIC business loan application',
    name: 'Zach, 39',
    place: 'Nashville, Tennessee',
  },
  {
    quote: 'My Financial Advisor asked me for my financial data to create a personal balance sheet',
    name: 'William, 22',
    place: 'Whitefish, Montana',
  },
  {
    quote: 'Created Personal Financial Statement for two banks to get pre-approved for a mortgage',
    name: 'Wendy, 34',
    place: 'Austin, Texas',
  },
];

const tools = [
  {
    href: '/mortgage-calculator/',
    icon: 'house',
    tone: 'blue',
    title: 'Mortgage calculator',
    text: 'Monthly principal and interest, total interest and a yearly amortization schedule.',
  },
  {
    href: '/net-worth-calculator/',
    icon: 'scale',
    tone: 'green',
    title: 'Net worth calculator',
    text: 'Add up assets and liabilities by the template’s categories.',
  },
  {
    href: '/debt-to-income-ratio-calculator/',
    icon: 'percent',
    tone: 'yellow',
    title: 'Debt-to-income calculator',
    text: 'Front-end and back-end DTI against the 28/36 benchmarks.',
  },
  {
    href: '/how-much-house-can-i-afford/',
    icon: 'key',
    tone: 'pink',
    title: 'Home affordability calculator',
    text: 'Estimate a price range from income, debts, down payment and rate.',
  },
  {
    href: '/mortgage-readiness-assessment/',
    icon: 'gauge',
    tone: 'white',
    title: 'Mortgage readiness assessment',
    text: 'Score your credit, income, loan-to-value, DTI and PFS on five criteria.',
  },
  {
    href: '/banks/',
    icon: 'bank',
    tone: 'blue',
    title: 'Find banks near you',
    text: 'Search FDIC-insured banks by ZIP code or browse by state.',
  },
  {
    href: '/sba-form-413/',
    icon: 'document',
    tone: 'green',
    title: 'SBA Form 413 guide',
    text: 'What the SBA personal financial statement asks for, line by line.',
  },
  {
    href: '/personal-financial-statement-example/',
    icon: 'sheet',
    tone: 'yellow',
    title: 'PFS example',
    text: 'A filled-in sample plus printable blank and example PDFs.',
  },
] as const;

const faq = [
  {
    q: 'What is a personal financial statement?',
    a: 'A personal financial statement (PFS) is a formal report that shows what an individual owns (assets), what they owe (liabilities), and the difference between the two (net worth). Lenders and advisors use it to see your financial position on a given date. WorthSheet’s free template walks you through every section and calculates the totals for you.',
  },
  {
    q: 'Is the WorthSheet template free?',
    a: 'Yes. You enter your name and email on the download page, then open your own copy in Google Sheets or download an Excel (.xlsx) file.',
  },
  {
    q: 'Does it work in Excel?',
    a: 'Yes. After the form you can open a copy in Google Sheets or download the .xlsx version for Excel.',
  },
  {
    q: 'Why do I need to prepare a personal financial statement?',
    a: 'Lenders often ask for one with a business, SBA or personal loan application, and some mortgage lenders ask for one too. It is also useful for planning your finances, comparing investment decisions and working with a financial advisor, because it gives a clear picture of where you stand.',
  },
  {
    q: 'What should be included in a personal financial statement?',
    a: 'List all assets, such as bank accounts, real estate, investments and valuable personal property, and all liabilities, such as mortgages, personal loans, credit card balances and other obligations. Net worth is total assets minus total liabilities.',
  },
  {
    q: 'Will my bank accept it?',
    a: 'Many lenders accept a clear, signed statement, but each lender decides. The SBA accepts equivalent formats that contain the same information as SBA Form 413 for 7(a), 504 and surety applications; ask your lender first.',
  },
  {
    q: 'How often should I update my personal financial statement?',
    a: 'Update it at least once a year and whenever your financial situation changes significantly. When you submit one to a lender, use current balances and the “as of” date they ask for.',
  },
  {
    q: 'What else is in the template?',
    a: 'A second tab, Homebuyer Readiness, scores your credit score, income, loan-to-value, debt-to-income and PFS against five criteria.',
  },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const jsonLd = [
  webAppLd({
    name: 'WorthSheet Personal Financial Statement Template',
    description:
      'Free personal financial statement template for Google Sheets and Excel with 27 asset and 13 liability categories and automatic net worth.',
    path: '/',
    category: 'Spreadsheet template',
  }),
  faqLd(faq),
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="sheet-section has-grid hero" style="--rows-above:2;--rows-below:2" aria-labelledby="hero-title">
    <div class="sheet-frame">
      <div class="sheet-glow" aria-hidden="true">
        {
          glow.map(([c, r, tone, a, end], i) => (
            <i
              class:list={[`tone-${tone}`, { below: r >= 26 }]}
              style={`--c:${c};--r:${r >= 26 ? r - 26 : r};--a:${a}%;--dir:${end === 'l' ? '90deg' : '270deg'};--i:${i}`}
            />
          ))
        }
      </div>
      <div class="sheet hero-sheet" data-sheet>
        <div class="sheet-card">
          <div class="hero-body" data-sheet-body>
            <div class="hero-copy">
              <p class="hero-proof">
                <span class="proof-checks" aria-hidden="true"><i></i><i></i><i></i></span>
                {STATS.downloads} downloads
              </p>
              <h1 id="hero-title" class="hero-title">
                <span class="title-line"><span>Free personal financial</span></span>
                <span class="title-line">
                  <span class="title-row">
                    statement
                    <span class="title-pill">
                      <span class="title-icons" aria-hidden="true">
                        <svg class="title-icon title-icon-excel" viewBox="0 0 48 48">
                          <rect x="15" y="6" width="29" height="36" rx="5" fill="#21a366"></rect>
                          <path d="M30 6v36M15 18h29M15 30h29" stroke="#fff" stroke-opacity=".35" stroke-width="1.5"></path>
                          <rect x="4" y="12" width="24" height="24" rx="5" fill="#107c41"></rect>
                          <path d="M9.6 17.5h4.1l2.3 4 2.3-4h4.1l-4.3 6.5 4.4 6.5h-4.1l-2.4-4.1-2.4 4.1H9.5l4.4-6.5z" fill="#fff"></path>
                        </svg>
                        <svg class="title-icon title-icon-sheets" viewBox="0 0 48 48">
                          <path d="M12 3h18l10 10v28a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z" fill="#0f9d58"></path>
                          <path d="M30 3v6a4 4 0 0 0 4 4h6z" fill="#87ceac"></path>
                          <path d="M15 22h18v16H15zM15 27.3h18M15 32.7h18M24 22v16" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                      template
                    </span>
                  </span>
                </span>
              </h1>
              <ul class="hero-points">
                <li>Works in Google Sheets and Excel</li>
                <li>Customizable, bank-ready format</li>
                <li>Wave goodbye to manual calculations</li>
              </ul>
              <div class="hero-actions">
                <Button href="/download/" variant="primary">Get the template for free</Button>
                <Button href="#features" variant="secondary">Learn more</Button>
              </div>
            </div>

            <div class="hero-art">
              <HeroSheet />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bank logos strip -->
  <Sheet id="banks" compact>
    <div class="banks-row">
      <ul class="bank-logos" aria-label="Banks whose personal financial statement forms the template is built on">
        {
          banks.map((b) => (
            <li>
              <Image
                src={b.logo}
                alt={`${b.name} logo`}
                width={70}
                height={70}
                style={`height: ${b.height}px`}
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>
      <p class="disclaimer">The template follows the structure of common bank personal financial statement forms. It is not affiliated with or endorsed by these banks.</p>
    </div>
  </Sheet>

  <!-- Saves time. .reveal-sheet carries the cursor-revealed spreadsheet background (data-cursor-sheet) and bleeds to the card edges. -->
  <Sheet id="features" aria-labelledby="saves-title">
    <div class="reveal-sheet" data-cursor-sheet>
      <div class="split">
        <div class="stack split-copy" style="--stack-gap: 1.25rem">
          <Eyebrow tone="green">WorthSheet™ saves time</Eyebrow>
          <h2 id="saves-title">Avoid manual calculations and messy bank personal financial statement forms</h2>
          <p class="lead">The WorthSheet™ template is built to be faster than filling out a blank bank personal financial statement by hand.</p>
          <ul class="list-check">
            <li>Time-saving layout for quick financial data organization.</li>
            <li>Designed for error reduction and accuracy in your personal financial statement.</li>
            <li>Spreadsheet format that covers what banks typically ask for.</li>
          </ul>
          <div>
            <Button href="/download/" variant="primary">Get the template for free</Button>
          </div>
        </div>
        <div class="split-art"><IsoTiles /></div>
      </div>
    </div>
  </Sheet>

  <!-- Dynamic categories -->
  <Sheet id="categories" tone="green" aria-labelledby="categories-title">
    <div class="split split-reverse">
      <div class="stack split-copy" style="--stack-gap: 1.25rem">
        <Eyebrow tone="green">Dynamic categories</Eyebrow>
        <h2 id="categories-title">Tailored to create a personal financial statement <span class="accent">super-fast</span></h2>
        <p class="lead">A comprehensive list of categories modeled on common personal financial statement forms, with the flexibility to add your own.</p>
        <ul class="list-check">
          <li data-view="assets" tabindex="0"><span class="sel">{STATS.assetCategories} asset categories<span class="sel-tint" aria-hidden="true"></span></span></li>
          <li data-view="liabilities" tabindex="0"><span class="sel">{STATS.liabilityCategories} liability categories<span class="sel-tint" aria-hidden="true"></span></span></li>
          <li data-view="formulas" tabindex="0">Dynamic calculation formulas</li>
        </ul>
        <div>
          <Button href="/download/" variant="primary">Get the template for free</Button>
        </div>
      </div>
      <div class="split-art iso-panel art-plate"><CategoriesStack /></div>
    </div>
  </Sheet>

  <!-- How to use -->
  <Sheet id="how-to-use" aria-labelledby="how-title">
    <div class="sec-head stack" style="--stack-gap: 1rem">
      <Eyebrow tone="blue">Getting started</Eyebrow>
      <h2 id="how-title">How to use the WorthSheet™ <span class="accent accent-blue">personal financial statement template</span></h2>
      <p class="lead">Preparing a statement for a bank loan takes four steps, and the template does the arithmetic for you.</p>
    </div>
    <div class="steps-wrap">
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step tile" style={`--i:${i}`}>
              <StepTile step={(i + 1) as 1 | 2 | 3 | 4} />
              <div class="step-head">
                <span class="step-num num" aria-hidden="true">{i + 1}</span>
                <h3><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
              </div>
              <p class="muted">{s.text}</p>
              {s.cta && (
                <div class="step-cta">
                  <Button href="/download/" variant="secondary">Download PFS template</Button>
                </div>
              )}
            </li>
          ))
        }
      </ol>
      <div class="links" aria-hidden="true">
        {
          [0, 1, 2].map((i) => (
            <span class="link" style={`--i:${i}`}>
              <span class="link-fill"><span class="link-dots"></span></span>
            </span>
          ))
        }
      </div>
    </div>
    <p class="steps-more muted">
      Want to see a finished statement first? Browse the <a href={url('/personal-financial-statement-example/')}>personal financial statement example</a>.
    </p>
  </Sheet>

  <!-- Safe and secure -->
  <Sheet id="safe-and-secure" aria-labelledby="safe-title">
    <div class="reveal-sheet" data-cursor-sheet>
      <div class="split split-safe">
        <div class="stack split-copy" style="--stack-gap: 1.25rem">
          <Eyebrow tone="blue">Why WorthSheet</Eyebrow>
          <h2 id="safe-title">Safe and secure <span class="accent">template</span></h2>
          <p class="lead">Your copy lives in your own Google account or on your own computer, so you decide where your financial data is stored.</p>
        </div>
        <div class="split-art split-art-small"><ShieldSecure /></div>
      </div>
      <ul class="feature-list">
        {
          securityCards.map((c, i) => (
            <li class="feature-item tile">
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={c.icon} />
              </span>
              <h3>{c.title}</h3>
              <p class="muted">{c.text}</p>
            </li>
          ))
        }
        <li class="feature-item feature-cta tile">
          <a class="feature-link" href={url('/download/')}>Get the free template <span aria-hidden="true">→</span></a>
        </li>
      </ul>
    </div>
  </Sheet>

  <!-- Community / social proof -->
  <Sheet id="community" tone="blue" aria-labelledby="community-title">
    <div class="community-top">
      <div class="sec-head stack" style="--stack-gap: 1rem">
        <Eyebrow tone="green">Join our community</Eyebrow>
        <h2 id="community-title">Over {STATS.downloads.replace('+', '')} downloads <span class="accent">of WorthSheet personal financial statements</span></h2>
        <p class="lead">Prepare, tailor and submit your personal financial statement for a bank loan, a mortgage or your advisor with one reusable template.</p>
      </div>
      <div class="community-cta">
        <Button href="/download/" variant="primary">Get the template for free</Button>
      </div>
    </div>
    <dl class="stats">
      <div class="tile">
        <dt>Downloads of the PFS template</dt>
        <dd class="num">{STATS.downloads}</dd>
      </div>
      <div class="tile">
        <dt>Defined asset categories</dt>
        <dd class="num">{STATS.assetCategories}</dd>
      </div>
      <div class="tile">
        <dt>Defined liability categories</dt>
        <dd class="num">{STATS.liabilityCategories}</dd>
      </div>
    </dl>
    <ul class="testimonials">
      {
        testimonials.map((t) => (
          <li class="tile">
            <figure class="testimonial">
              <blockquote>
                <p>“{t.quote}”</p>
              </blockquote>
              <figcaption>
                <span class="avatar" aria-hidden="true">{t.name.charAt(0)}</span>
                <span class="who">
                  <strong>{t.name}</strong>
                  <span class="muted">{t.place}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </Sheet>

  <!-- Free tools -->
  <Sheet id="free-tools" aria-labelledby="tools-title">
    <div class="sec-head stack" style="--stack-gap: 1rem">
      <Eyebrow tone="blue">Free tools</Eyebrow>
      <h2 id="tools-title">Free calculators and guides <span class="accent accent-blue">for your loan application</span></h2>
      <p class="lead">Check your numbers before you apply, then put them in a bank-ready statement.</p>
    </div>
    <ul class="grid grid-4 tools">
      {
        tools.map((t) => (
          <li>
            <a class="card tool" data-tone={t.tone} href={url(t.href)}>
              <IsoIcon icon={t.icon} tone={t.tone} size={56} />
              <h3>{t.title}</h3>
              <span class="tool-arrow" aria-hidden="true">↗</span>
              <p class="muted">{t.text}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="tools-note small muted">Calculators are estimates for educational purposes only and are not a loan offer or financial advice.</p>
  </Sheet>

  <!-- Latest guides -->
  {
    posts.length > 0 && (
      <Sheet id="latest" tone="cream" aria-labelledby="latest-title">
        <div class="latest-head">
          <div class="stack" style="--stack-gap: 1rem">
            <Eyebrow tone="yellow">From the blog</Eyebrow>
            <h2 id="latest-title">Read our latest guides</h2>
          </div>
          <Button href="/blog/" variant="secondary">All guides</Button>
        </div>
        <ul class="grid grid-3 posts">
          {posts.map((p) => (
            <li>
              <a class="card post" href={url(`/${p.id}/`)}>
                <PostCover cover={p.data.cover} class="post-img" />
                <div class="post-body">
                  <time class="small muted" datetime={p.data.pubDate.toISOString()}>
                    {fmtDate(p.data.pubDate)}
                  </time>
                  <h3>{p.data.title}</h3>
                  <span class="post-more">Read more »</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </Sheet>
    )
  }

  <!-- FAQ -->
  <Sheet id="faq" aria-labelledby="faq-title">
    <div class="faq-wrap">
      <div class="stack faq-head" style="--stack-gap: 1rem">
        <Eyebrow tone="navy">Still have questions?</Eyebrow>
        <h2 id="faq-title">Frequently asked questions</h2>
        <p class="muted">Short answers about the template and the personal financial statement.</p>
      </div>
      <Faq items={faq} />
    </div>
  </Sheet>

  <CtaBand />
</Base>

<style>
  /* Grid, sheets, cards and highlighted cells come from global.css (.sheet-*) and Sheet.astro.
     Every section below the hero is a <Sheet>; this file only lays out what sits inside them. */

  :global(#features),
  :global(#how-to-use) {
    scroll-margin-top: 72px;
  }

  /* ---------- Hero (Figma "Section" 1:1277) ----------
     Sheet 1200 x 676 (26 rows) inside two rows of cells above and below; the card is inset 7px
     (shared .sheet), white with the #e8e7e5 hairline and 24px radius. */
  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: 35px clamp(20px, 2.8vw, 39px) 0;
    /* The copy column overlaps the art; only its actual content should catch the pointer so art pieces stay draggable. */
    pointer-events: none;
  }

  .hero-copy > * {
    pointer-events: auto;
  }

  .hero-proof {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .proof-checks {
    display: flex;
    gap: 4px;
  }

  .proof-checks i {
    position: relative;
    display: block;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--sheen), var(--green);
  }

  .proof-checks i:nth-child(2) {
    background: var(--sheen), var(--yellow);
  }

  .proof-checks i:nth-child(3) {
    background: var(--sheen), var(--blue);
  }

  .proof-checks i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--icon-check) center / 60% no-repeat;
  }

  /* Pill sizes are in em so they track the fluid h1 (Figma at 64.8px: 48px icon, 12px gap). */
  .hero-title {
    max-width: 650px;
    animation: none;
  }

  .title-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .title-line > span {
    display: block;
  }

  .title-line > .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.06em 0.185em;
  }

  .title-pill {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.105em;
    padding: 0 0.185em 0 0.123em;
    border: 1px solid transparent;
    border-radius: 0.37em;
    color: var(--green);
  }

  /* The frame (border + white fill) is its own layer so it can fade in after the headline. */
  .title-pill::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border: 1px solid var(--line-strong);
    border-radius: inherit;
    background: var(--white);
    pointer-events: none;
  }

  /* Two marks stacked in one box: Excel (green "X" tile over a sheet) and Google Sheets. */
  .title-icons {
    position: relative;
    flex: none;
    width: 0.74em;
    height: 0.74em;
    perspective: 3em;
  }

  .title-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-points {
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 1rem;
    line-height: 1.6;
    letter-spacing: -0.02em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Small screens: the illustration flows under the copy and bleeds off the card. */
  .hero-art {
    position: relative;
    width: 124%;
    margin: 8px -12% -10%;
  }

  @media (min-width: 960px) {
    .hero-sheet {
      --sheet-min: calc(var(--cell-h) * 26);
    }

    /* Our HeroSheet (viewBox 960 x 557) fills the lower right of the card, under the copy's
       right edge; positioned against the card and sized so it stays inside the 26-row sheet. */
    .hero-art {
      position: absolute;
      top: 226px;
      left: 36%;
      width: 64%;
      margin: 0;
    }
  }

  /* Entrance, 100ms apart (better-ui staged entrance): proof row, title, points, actions + art,
     then the highlighted cells settle in around the sheet. Fades run for everyone; rise, blur,
     scale and the title mask only without reduced motion. The h1 text is never transparent. */
  @keyframes title-rise {
    from {
      translate: 0 105%;
    }
  }

  /* Everything in the hero card starts after the card itself has faded in: motion.css sets --intro-inner
     (400ms) on the hero section under html.js, and each delay below adds it. */
  .hero-proof {
    animation: ws-fade var(--enter-ms) var(--ease-out) var(--intro-inner, 0ms) backwards;
  }

  /* Checks appear like contextual icons: scale 0.25 -> 1, opacity, 4px blur. */
  .proof-checks i::after {
    animation: ws-fade var(--enter-ms) var(--ease-icon) backwards;
  }

  .proof-checks i:nth-child(1)::after {
    animation-delay: calc(150ms + var(--intro-inner, 0ms));
  }

  .proof-checks i:nth-child(2)::after {
    animation-delay: calc(250ms + var(--intro-inner, 0ms));
  }

  .proof-checks i:nth-child(3)::after {
    animation-delay: calc(350ms + var(--intro-inner, 0ms));
  }

  /* The pill's frame is invisible until the headline lines have revealed (they finish ~700ms in),
     then fades in; the Excel / Sheets mark pops in just after. The text itself is never hidden. */
  @keyframes pill-frame-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes pill-frame-pop {
    from {
      opacity: 0;
      scale: 0.96;
    }
  }

  .title-pill::before {
    animation: pill-frame-fade 450ms var(--ease-out) calc(700ms + var(--intro-inner, 0ms)) backwards;
  }

  .title-icons {
    animation: ws-fade var(--enter-ms) var(--ease-icon) calc(900ms + var(--intro-inner, 0ms)) backwards;
  }

  /* Excel <-> Google Sheets: every 8s cycle each mark flips out and the other in (a swap every 4s).
     Without motion only the Excel mark is shown. */
  .title-icon-sheets {
    opacity: 0;
  }

  @keyframes icon-swap-excel {
    0%,
    40% {
      opacity: 1;
      transform: rotateY(0deg) scale(1);
    }
    48%,
    90% {
      opacity: 0;
      transform: rotateY(-80deg) scale(0.85);
    }
    100% {
      opacity: 1;
      transform: rotateY(0deg) scale(1);
    }
  }

  @keyframes icon-swap-sheets {
    0%,
    42% {
      opacity: 0;
      transform: rotateY(80deg) scale(0.85);
    }
    50%,
    90% {
      opacity: 1;
      transform: rotateY(0deg) scale(1);
    }
    98%,
    100% {
      opacity: 0;
      transform: rotateY(80deg) scale(0.85);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-proof {
      animation-name: ws-rise;
    }

    .proof-checks i::after,
    .title-icons {
      animation-name: ws-icon-in;
    }

    .title-pill::before {
      animation-name: pill-frame-pop;
    }

    .title-icon-excel {
      animation: icon-swap-excel 8s cubic-bezier(0.23, 1, 0.32, 1) calc(1400ms + var(--intro-inner, 0ms)) infinite backwards;
    }

    .title-icon-sheets {
      animation: icon-swap-sheets 8s cubic-bezier(0.23, 1, 0.32, 1) calc(1400ms + var(--intro-inner, 0ms)) infinite backwards;
    }

    /* Display headline: each line rises out of its own mask, 80ms apart. */
    .title-line > span {
      animation: title-rise 500ms var(--ease-out) calc(100ms + var(--intro-inner, 0ms)) backwards;
    }

    .title-line + .title-line > span {
      animation-delay: calc(180ms + var(--intro-inner, 0ms));
    }
  }

  /* ---------- Banks strip ---------- */
  .banks-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .bank-logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px 56px;
  }

  .bank-logos :global(img) {
    display: block;
    width: auto;
    opacity: 0.6;
    filter: grayscale(1);
    transition: opacity 150ms var(--ease-out);
  }

  @media (hover: hover) {
    .bank-logos :global(img:hover) {
      opacity: 1;
    }
  }

  .banks-row .disclaimer {
    max-width: 36em;
    margin-inline: auto;
  }

  /* ---------- Steps: a tile above each step, joined by a dotted line in the 4-up layout ----------
     The script marks the hovered step (.is-active on the step, .is-picking on .steps-wrap) and sets
     --p (0 to 3, eased) on .steps-wrap; each dotted link fills by clamp(--p - --i). */
  .steps-wrap {
    position: relative;
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 40px;
    }
  }

  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Pull the tile up and left so its pad lines up optically with the text below. */
  .step :global(.step-tile) {
    margin: -8px 0 4px -8px;
  }

  /* Links sit outside the steps so a greyed step never greys the progress line. Same 4 columns and
     gap as .steps; each link runs from its tile's pad (centre 52px down, right edge ~104px in)
     to the next one. */
  .links {
    display: none;
  }

  @media (min-width: 1100px) {
    .links {
      position: absolute;
      top: 51px;
      left: 0;
      right: 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 40px;
      pointer-events: none;
    }

    .link {
      --f: clamp(0, calc(var(--p, 0) - var(--i)), 1);
      position: relative;
      height: 2px;
      margin: 0 -32px 0 112px;
      overflow: hidden;
      background: linear-gradient(to right, rgba(12, 38, 53, 0.22) 50%, transparent 0) 0 0 / 8px 2px repeat-x;
    }

    /* Fill: the coloured dots slide in from the left, drawn with transforms only (the wrapper moves
       left by the unfilled share, the dots move back by the same amount, so they never shift). */
    .link-fill {
      position: absolute;
      inset: 0;
      overflow: hidden;
      transform: translateX(calc((var(--f) - 1) * 100%));
    }

    .link-dots {
      position: absolute;
      inset: 0;
      transform: translateX(calc((1 - var(--f)) * 100%));
      background: linear-gradient(to right, var(--link-color) 50%, transparent 0) 0 0 / 8px 2px repeat-x;
    }

    .link:nth-child(1) {
      --link-color: #0f9d58;
    }

    .link:nth-child(2) {
      --link-color: #f0b52e;
    }

    .link:nth-child(3) {
      --link-color: #0c2635;
    }
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Step numbers: rounded squares in the same colours as their tiles. */
  .step-num {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--sheen), var(--blue);
    color: var(--ink);
    font-weight: 600;
  }

  .step:nth-child(2) .step-num {
    background: var(--sheen), var(--green);
    color: var(--white);
  }

  .step:nth-child(3) .step-num {
    background: var(--sheen), var(--yellow);
    color: var(--ink);
  }

  .step:nth-child(4) .step-num {
    background: var(--sheen), var(--navy);
    color: var(--white);
  }

  .step h3 {
    font-size: 1.25rem;
  }

  .step-cta {
    margin-top: auto;
    padding-top: 8px;
  }

  .steps-more {
    margin-top: clamp(28px, 4vw, 44px);
  }

  /* Picking: while a step is hovered or focused, the others (tile and text) are greyed. Applied to
     the step's children, never to the step itself, which the scroll reveal owns. With nothing
     picked (or without the script) every step is fully visible. */
  .step > :global(*) {
    transition:
      opacity 450ms var(--ease-out),
      filter 450ms var(--ease-out);
  }

  .steps-wrap.is-picking .step:not(.is-active) > :global(*) {
    opacity: 0.45;
    filter: grayscale(1);
  }

  /* The selected step's tile lifts off its pad (interruptible); the tile's glow lives in StepTile. */
  @media (prefers-reduced-motion: no-preference) {
    .step :global(.lift) {
      transition: translate 300ms var(--ease-out);
    }
  }

  .steps-wrap.is-picking .step.is-active :global(.lift) {
    translate: 0 -6px;
  }

  /* Without the script every step stays normal; hover still lifts a tile. */
  @media (hover: hover) {
    .steps-wrap:not(.is-picking) .step:hover :global(.lift) {
      translate: 0 -6px;
    }
  }

  /* ---------- Safe and secure: our feature list inside the card ---------- */
  .feature-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px 40px;
    margin-top: clamp(32px, 5vw, 56px);
  }

  @media (min-width: 640px) {
    .feature-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .feature-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid rgba(12, 38, 53, 0.12);
  }

  .feature-item:nth-child(3n + 1) {
    --tint: #40aa4a;
    --tint-bg: rgba(64, 170, 74, 0.12);
  }

  .feature-item:nth-child(3n + 2) {
    --tint: #6cbee4;
    --tint-bg: rgba(108, 190, 228, 0.16);
  }

  .feature-item:nth-child(3n) {
    --tint: #fac344;
    --tint-bg: rgba(250, 195, 68, 0.18);
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--tint-bg);
    color: var(--tint);
  }

  .feature-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-item h3 {
    font-size: 1.0625rem;
    font-weight: 580;
  }

  .feature-item p {
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 38ch;
  }

  .feature-cta {
    justify-content: center;
  }

  .feature-link {
    font-weight: 580;
    color: var(--ink);
  }

  .feature-link:hover {
    text-decoration: underline;
  }

  /* The cursor-revealed spreadsheet sits on this block; negative margins match .sheet-body's
     padding so it covers the whole card. */
  .reveal-sheet {
    --pad: clamp(24px, 4.6vw, 64px);
    margin: calc(var(--pad) * -1);
    padding: var(--pad);
  }

  /* ---------- Community ---------- */
  .community-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(32px, 4.5vw, 56px);
  }

  .community-top .sec-head {
    margin-bottom: 0;
  }

  .community-cta {
    flex: none;
  }

  /* Stats read as one spreadsheet row: three cells between hairlines. */
  .stats {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0 0 clamp(32px, 4.5vw, 56px);
    border-block: 1px solid rgba(12, 38, 53, 0.12);
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 20px 0;
  }

  .stats > div + div {
    border-top: 1px solid rgba(12, 38, 53, 0.12);
  }

  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .stats > div {
      padding: 24px 28px;
    }

    .stats > div:first-child {
      padding-left: 0;
    }

    .stats > div + div {
      border-top: 0;
      border-left: 1px solid rgba(12, 38, 53, 0.12);
    }
  }

  .stats dd {
    margin: 0;
    font-size: clamp(2.25rem, 4.6vw, 3.5rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .stats dt {
    color: var(--muted);
  }

  .testimonials {
    list-style: none;
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .testimonials {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .testimonial {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    padding: 24px;
    border: 1px solid transparent;
    border-radius: 16px;
    background: var(--white);
    box-shadow: var(--shadow-border);
  }

  .testimonial blockquote p {
    font-size: 1.1875rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .testimonial figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9375rem;
  }

  /* Initials in a logo-coloured rounded square. */
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--sheen), var(--green);
    color: var(--white);
    font-weight: 600;
  }

  .testimonials li:nth-child(2) .avatar {
    background: var(--sheen), var(--yellow);
    color: var(--ink);
  }

  .testimonials li:nth-child(3) .avatar {
    background: var(--sheen), var(--blue);
    color: var(--ink);
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* ---------- FAQ ---------- */
  /* Extra room at the bottom of the card before the closing CTA's grid. */
  :global(#faq .sheet-body) {
    padding-bottom: clamp(88px, 13vw, 184px);
  }

  .faq-wrap {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
  }

  @media (min-width: 900px) {
    .faq-wrap {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      align-items: start;
    }

    .faq-head {
      position: sticky;
      top: 96px;
    }
  }

  /* ---------- Dynamic categories: hover or focus on a row drives the illustration ----------
     The row's text takes the bullet's tone and the bullet scales up. On the asset and liability rows a
     soft tint draws in behind the whole line from the left and, on leave, retracts towards the right.
     The formulas row has no hover state; it only drives the illustration. */
  :global(#categories) ul.list-check li[data-view] {
    --tone: #0a7a43;
    width: fit-content;
    max-width: 100%;
    cursor: default;
  }

  /* Tones follow meaning, as in the illustration: assets green, liabilities yellow, formulas blue. */
  :global(#categories) ul.list-check li[data-view='liabilities'] {
    --tone: #9a6700;
  }

  :global(#categories) ul.list-check li[data-view='formulas'] {
    --tone: #1b78a8;
  }

  :global(#categories) ul.list-check li[data-view='liabilities']::before {
    background-color: var(--yellow);
  }

  :global(#categories) ul.list-check li[data-view='formulas']::before {
    background-color: var(--blue);
  }

  /* .sel wraps the row's text; the tint sits behind it without affecting layout. */
  :global(#categories) .sel {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  :global(#categories) .sel-tint {
    position: absolute;
    inset: -3px -8px;
    z-index: -1;
    border-radius: 4px;
    background: color-mix(in srgb, var(--tone) 10%, transparent);
    transform: scaleX(0);
    transform-origin: right center;
    pointer-events: none;
  }

  :global(#categories) ul.list-check li[data-view]:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
    border-radius: 4px;
    color: var(--tone);
  }

  :global(#categories) ul.list-check li[data-view]:focus-visible::before {
    scale: 1.08;
  }

  :global(#categories) ul.list-check li[data-view]:focus-visible .sel-tint {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(#categories) ul.list-check li[data-view]:not([data-view="formulas"]):hover {
      color: var(--tone);
    }

    :global(#categories) ul.list-check li[data-view]:not([data-view="formulas"]):hover::before {
      scale: 1.08;
    }

    :global(#categories) ul.list-check li[data-view]:not([data-view="formulas"]):hover .sel-tint {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(#categories) ul.list-check li[data-view] {
      transition: color 200ms var(--ease-out);
    }

    :global(#categories) ul.list-check li[data-view]::before {
      transition: scale 200ms var(--ease-out);
    }

    /* Draws in from the left on hover/focus; on leave the origin flips, so it retracts to the right. */
    :global(#categories) .sel-tint {
      transition: transform 420ms var(--ease-out);
    }
  }

  /* ---------- Free tools ---------- */
  .tools {
    list-style: none;
    gap: 20px;
  }

  .tool {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(22px, 2.6vw, 30px);
  }

  .tool h3 {
    font-size: 1.1875rem;
    line-height: 1.25;
  }

  .tool p {
    font-size: 0.9688rem;
    line-height: 1.55;
  }

  /* --edge: rim light; --tone: arrow colour. */
  .tool[data-tone='blue'] {
    --edge: rgba(108, 190, 228, 0.9);
    --tone: #6cbee4;
  }

  .tool[data-tone='green'] {
    --edge: rgba(64, 170, 74, 0.85);
    --tone: #40aa4a;
  }

  .tool[data-tone='yellow'] {
    --edge: rgba(250, 195, 68, 0.95);
    --tone: #c9921a;
  }

  .tool[data-tone='pink'] {
    --edge: rgba(224, 127, 184, 0.85);
    --tone: #e07fb8;
  }

  /* Diagonal arrow in the card's top-right corner: only on hover or keyboard focus. */
  .tool-arrow {
    position: absolute;
    top: 14px;
    right: 16px;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--tone);
    opacity: 0;
    pointer-events: none;
  }

  .tool:focus-visible .tool-arrow {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .tool:hover .tool-arrow {
