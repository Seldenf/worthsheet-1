<script>
  const section = document.getElementById('how-to-use');
  const list = section?.querySelector<HTMLOListElement>('.steps') ?? null;
  const art = section?.querySelector<SVGSVGElement>('.steps-art svg.wsi') ?? null;
  const items = list
    ? Array.from(list.children).filter((el): el is HTMLElement => el instanceof HTMLElement)
    : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && list && art && items.length === 4 && !reduceMotion && 'IntersectionObserver' in window) {
    const LOOP_MS = 10000;
    const HOLD_MS = 1600;
    const FADE_MS = 300;
    const LERP_MS = 400;
    const TILES = [0, 100 / 3, 200 / 3, 100];

    type Phase = 'run' | 'hold' | 'fade' | 'lerp' | 'pinned';
    let phase: Phase = 'run';
    let elapsed = 0;
    let p = 0;
    let active = -1;
    let lerpFrom = 0;
    let lerpTo = 0;
    let visible = false;
    let overridden = false;
    let pointerOver = false;
    let focusWithin = false;
    let raf = 0;
    let lastTs = 0;

    const indexFor = (v: number) => (v >= 100 ? 3 : v >= 200 / 3 ? 2 : v >= 100 / 3 ? 1 : 0);

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      art.setAttribute('data-active', String(i + 1));
      items.forEach((item, j) => item.classList.toggle('is-active', j === i));
    };

    const setP = (v: number) => {
      p = v;
      art.style.setProperty('--p', String(v));
    };

    const tick = (now: number) => {
      raf = 0;
      const dt = lastTs ? Math.min(now - lastTs, 100) : 0;
      lastTs = now;

      if (phase === 'lerp') {
        elapsed += dt;
        const t = Math.min(1, elapsed / LERP_MS);
        const e = 1 - (1 - t) ** 3;
        setP(lerpFrom + (lerpTo - lerpFrom) * e);
        if (t >= 1) {
          phase = 'pinned';
          return;
        }
      } else if (visible) {
        if (phase === 'run') {
          setP(Math.min(100, p + (dt * 100) / LOOP_MS));
          setActive(indexFor(p));
          if (p >= 100) {
            phase = 'hold';
            elapsed = 0;
          }
        } else if (phase === 'hold') {
          elapsed += dt;
          if (elapsed >= HOLD_MS) {
            phase = 'fade';
            elapsed = 0;
            art.classList.add('is-resetting');
          }
        } else if (phase === 'fade') {
          elapsed += dt;
          if (elapsed >= FADE_MS) {
            setP(0);
            setActive(0);
            art.classList.remove('is-resetting');
            phase = 'run';
            elapsed = 0;
          }
        }
      }

      if (phase === 'lerp' || (visible && phase !== 'pinned')) {
        raf = requestAnimationFrame(tick);
      }
    };

    const kick = () => {
      if (raf) return;
      if (!visible && phase !== 'lerp') return;
      lastTs = 0;
      raf = requestAnimationFrame(tick);
    };

    const pin = (i: number) => {
      overridden = true;
      setActive(i);
      lerpFrom = p;
      lerpTo = TILES[i] ?? 0;
      elapsed = 0;
      art.classList.remove('is-resetting');
      phase = 'lerp';
      kick();
    };

    const release = () => {
      if (!overridden) return;
      overridden = false;
      phase = 'run';
      elapsed = 0;
      kick();
    };

    list.classList.add('is-sequencing');
    setP(0);
    setActive(0);

    new IntersectionObserver((entries) => {
      visible = entries[0]?.isIntersecting ?? false;
      if (visible) kick();
    }, { threshold: 0.4 }).observe(list);

    items.forEach((item, i) => {
      item.addEventListener('pointerenter', () => {
        pointerOver = true;
        pin(i);
      });
    });

    art.querySelectorAll<SVGElement>('[data-step]').forEach((tile) => {
      const i = Number(tile.getAttribute('data-step')) - 1;
      if (!Number.isInteger(i) || i < 0 || i >= items.length) return;
      tile.addEventListener('pointerenter', () => {
        pointerOver = true;
        pin(i);
      });
    });

    section.addEventListener('pointerleave', () => {
      pointerOver = false;
      if (!focusWithin) release();
    });

    list.addEventListener('focusin', (e) => {
      const i = items.findIndex((item) => item.contains(e.target as Node));
      if (i < 0) return;
      focusWithin = true;
      pin(i);
    });

    section.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && list.contains(next)) return;
      focusWithin = false;
      if (!pointerOver) release();
    });
  }
</script>

<script>
  // Hover or focus on a category row picks the illustration view; leaving the list returns to mixed.
  const section = document.getElementById('categories');
  const list = section?.querySelector<HTMLUListElement>('ul.list-check') ?? null;
  const svg = section?.querySelector<SVGSVGElement>('svg.wsi-cats') ?? null;
  if (list && svg) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    let hovered: string | null = null;
    let focused: string | null = null;
    const apply = () => svg.setAttribute('data-view', hovered ?? focused ?? 'mixed');

    list.querySelectorAll<HTMLLIElement>('li[data-view]').forEach((li) => {
      li.addEventListener('pointerenter', () => {
        if (!fine.matches) return;
        hovered = li.dataset.view ?? null;
        apply();
      });
    });
    list.addEventListener('pointerleave', () => {
      hovered = null;
      apply();
    });
    list.addEventListener('focusin', (e) => {
      const li = (e.target as Element).closest<HTMLLIElement>('li[data-view]');
      if (!li) return;
      focused = li.dataset.view ?? null;
      apply();
    });
    list.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && list.contains(next)) return;
      focused = null;
      apply();
    });
  }
</script>
