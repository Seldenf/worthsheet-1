<script>
  // How to use: with nothing hovered every step is fully visible. Hovering (or keyboard-focusing) a
  // step, card or tile, highlights it, greys the others and fills the dotted links up to it;
  // leaving the section restores everything. Reduced motion: same states, but --p jumps.
  const wrap = document.querySelector<HTMLElement>('#how-to-use .steps-wrap');
  const items = wrap ? Array.from(wrap.querySelectorAll<HTMLElement>('.steps > .step')) : [];

  if (wrap && items.length === 4) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const EASE_MS = 150;

    let hovered = -1;
    let focused = -1;
    let p = 0;
    let target = 0;
    let raf = 0;
    let last = 0;

    const render = () => wrap.style.setProperty('--p', p.toFixed(4));

    // Ease --p toward the active step's index; the dotted links read it, so the fill is continuous.
    const frame = (now: number) => {
      const dt = last ? Math.min(now - last, 64) : 16;
      last = now;
      p += (target - p) * (1 - Math.exp(-dt / EASE_MS));
      if (Math.abs(target - p) < 0.002) {
        p = target;
        raf = 0;
      } else {
        raf = requestAnimationFrame(frame);
      }
      render();
    };

    const move = (to: number) => {
      target = to;
      if (reduce.matches) {
        cancelAnimationFrame(raf);
        raf = 0;
        p = to;
        render();
      } else if (!raf) {
        last = 0;
        raf = requestAnimationFrame(frame);
      }
    };

    const apply = () => {
      const i = hovered >= 0 ? hovered : focused;
      wrap.classList.toggle('is-picking', i >= 0);
      items.forEach((item, j) => item.classList.toggle('is-active', j === i));
      move(i >= 0 ? i : 0);
    };

    items.forEach((item, i) => {
      item.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        hovered = i;
        apply();
      });
    });
    wrap.addEventListener('pointerleave', () => {
      hovered = -1;
      apply();
    });
    wrap.addEventListener('focusin', (e) => {
      const el = e.target as Element;
      if (!el.matches(':focus-visible')) return;
      focused = items.findIndex((item) => item.contains(el));
      apply();
    });
    wrap.addEventListener('focusout', () => {
      focused = -1;
      apply();
    });
  }
</script>

<script>
  // Hover or focus on a category row picks the illustration view; leaving the row returns to mixed.
  const section = document.getElementById('categories');
  const list = section?.querySelector<HTMLUListElement>('ul.list-check') ?? null;
  const svg = section?.querySelector<SVGSVGElement>('svg.wsi-cats') ?? null;
  if (list && svg) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    let hovered: string | null = null;
    let focused: string | null = null;
    const apply = () => svg.setAttribute('data-view', hovered ?? focused ?? 'mixed');

    list.querySelectorAll<HTMLLIElement>('li[data-view]').forEach((li) => {
      li.addEventListener('pointerenter', () => {
        if (!fine.matches) return;
        hovered = li.dataset.view ?? null;
        apply();
      });
      li.addEventListener('pointerleave', () => {
        hovered = null;
        apply();
      });
    });
    list.addEventListener('focusin', (e) => {
      const li = (e.target as Element).closest<HTMLLIElement>('li[data-view]');
      if (!li) return;
      focused = li.dataset.view ?? null;
      apply();
    });
    list.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && list.contains(next)) return;
      focused = null;
      apply();
    });
  }
</script>
