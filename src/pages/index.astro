<script>
  // How to use: steps 1 to 4 take turns (inactive ones are greyed) while the dotted links fill toward
  // the active step. Hovering or focusing a step (or its tile) selects it. Reduced motion: no loop.
  const wrap = document.querySelector<HTMLElement>('#how-to-use .steps-wrap');
  const items = wrap ? Array.from(wrap.querySelectorAll<HTMLElement>('.steps > .step')) : [];

  if (wrap && items.length === 4 && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const STEP_MS = 2400;
    const RESET_MS = 320;
    const EASE_MS = 150;

    let active = -1;
    let p = 0;
    let target = 0;
    let raf = 0;
    let last = 0;
    let timer = 0;
    let resetTimer = 0;
    let visible = false;
    let pinned = false;

    const render = () => wrap.style.setProperty('--p', p.toFixed(4));

    // Ease --p toward the active step's index; the dotted links read it, so the fill is continuous.
    const frame = (now: number) => {
      const dt = last ? Math.min(now - last, 64) : 16;
      last = now;
      p += (target - p) * (1 - Math.exp(-dt / EASE_MS));
      if (Math.abs(target - p) < 0.002) {
        p = target;
        raf = 0;
      } else {
        raf = requestAnimationFrame(frame);
      }
      render();
    };

    const move = (to: number) => {
      target = to;
      if (!raf) {
        last = 0;
        raf = requestAnimationFrame(frame);
      }
    };

    const setActive = (i: number) => {
      active = i;
      items.forEach((item, j) => item.classList.toggle('is-active', j === i));
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (visible && !pinned) timer = window.setTimeout(advance, STEP_MS);
    };

    const advance = () => {
      const next = (active + 1) % items.length;
      if (next === 0) {
        // Wrap: fade the fills out, activate step 1, then reset the progress while it is invisible.
        wrap.classList.add('is-resetting');
        setActive(0);
        resetTimer = window.setTimeout(() => {
          p = target = 0;
          render();
          wrap.classList.remove('is-resetting');
        }, RESET_MS);
      } else {
        setActive(next);
        move(next);
      }
      schedule();
    };

    const pin = (i: number) => {
      pinned = true;
      window.clearTimeout(timer);
      window.clearTimeout(resetTimer);
      wrap.classList.remove('is-resetting');
      setActive(i);
      move(i);
    };

    const unpin = () => {
      if (!pinned) return;
      pinned = false;
      schedule();
    };

    wrap.classList.add('is-sequencing');
    setActive(0);
    render();

    new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? false;
        if (visible) schedule();
        else window.clearTimeout(timer);
      },
      { threshold: 0.25 },
    ).observe(wrap);

    items.forEach((item, i) => {
      item.addEventListener('pointerenter', () => pin(i));
    });
    wrap.addEventListener('pointerleave', () => {
      if (!wrap.contains(document.activeElement)) unpin();
    });
    wrap.addEventListener('focusin', (e) => {
      const i = items.findIndex((item) => item.contains(e.target as Node));
      if (i >= 0) pin(i);
    });
    wrap.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && wrap.contains(next)) return;
      unpin();
    });
  }
</script>

<script>
  // Hover or focus on a category row picks the illustration view; leaving the row returns to mixed.
  const section = document.getElementById('categories');
  const list = section?.querySelector<HTMLUListElement>('ul.list-check') ?? null;
  const svg = section?.querySelector<SVGSVGElement>('svg.wsi-cats') ?? null;
  if (list && svg) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    let hovered: string | null = null;
    let focused: string | null = null;
    const apply = () => svg.setAttribute('data-view', hovered ?? focused ?? 'mixed');

    list.querySelectorAll<HTMLLIElement>('li[data-view]').forEach((li) => {
      li.addEventListener('pointerenter', () => {
        if (!fine.matches) return;
        hovered = li.dataset.view ?? null;
        apply();
      });
      li.addEventListener('pointerleave', () => {
        hovered = null;
        apply();
      });
    });
    list.addEventListener('focusin', (e) => {
      const li = (e.target as Element).closest<HTMLLIElement>('li[data-view]');
      if (!li) return;
      focused = li.dataset.view ?? null;
      apply();
    });
    list.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && list.contains(next)) return;
      focused = null;
      apply();
    });
  }
</script>
