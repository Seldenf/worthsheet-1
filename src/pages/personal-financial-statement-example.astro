---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Prose from '../components/Prose.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import DocumentStack from '../components/illustrations/DocumentStack.astro';
import CtaTiles from '../components/illustrations/CtaTiles.astro';
import { faqLd } from '../lib/seo';
import { url } from '../lib/url';
import { formatUSD } from '../lib/finance';
import example from '../../scripts/pfs-example.json';

type Row = { label: string; value: number };
type Group = { name: string; rows: Row[] };

const assets = example.assets as Group[];
const liabilities = example.liabilities as Group[];
const groupTotal = (g: Group) => g.rows.reduce((s, r) => s + r.value, 0);
const sum = (groups: Group[]) => groups.reduce((t, g) => t + groupTotal(g), 0);
const totalAssets = sum(assets);
const totalLiabilities = sum(liabilities);
const netWorth = totalAssets - totalLiabilities;

const BLANK_PDF = '/downloads/personal-financial-statement-template-blank.pdf';
const EXAMPLE_PDF = '/downloads/personal-financial-statement-example.pdf';

const faq = [
  {
    q: 'What does a personal financial statement example include?',
    a: 'Assets (cash, accounts, real estate, vehicles, business interests), liabilities (credit cards, loans), net worth, and a date and signature.',
  },
  {
    q: 'Is this example based on real data?',
    a: 'No, the example numbers are illustrative only.',
  },
  {
    q: 'Can I download a blank PFS?',
    a: 'Yes. A printable blank PDF and the filled example are available on this page; the editable template is on the download page.',
  },
  {
    q: 'How do I use this example for my own statement?',
    a: 'Follow the same categories, replace the numbers with yours at current market value and date it.',
  },
  {
    q: 'Will a bank accept this format?',
    a: 'Many do, but each lender decides; ask for their form or confirm they accept yours.',
  },
];
---

<Base
  title="Personal Financial Statement Example (Free PDF) | WorthSheet"
  description="See a completed personal financial statement example with assets, liabilities and net worth, and download a free printable blank PFS and filled example as PDFs."
  path="/personal-financial-statement-example/"
  breadcrumbs={[{ name: 'Personal financial statement example', path: '/personal-financial-statement-example/' }]}
  jsonLd={[faqLd(faq)]}
>
  <Sheet grid seed={35} id="hero" aria-labelledby="hero-title">
    <div class="split">
      <div class="stack split-copy" style="--stack-gap: 1.25rem">
        <Eyebrow tone="green">Free PDF examples</Eyebrow>
        <h1 id="hero-title">Personal financial statement <span class="accent">example</span></h1>
        <p class="lead">
          A personal financial statement example shows how everything fits on one page: list what
          you own (assets), list what you owe (liabilities), and subtract to get your net worth as
          of a single date. The statement below is fully filled in with fictional numbers.
        </p>
        <div class="actions">
          <Button href={EXAMPLE_PDF} variant="primary" size="lg" download>Download the example (PDF)</Button>
          <Button href={BLANK_PDF} variant="secondary" size="lg" download>Download the blank PFS (PDF)</Button>
        </div>
        <p class="muted small">
          Both PDFs are US Letter, free, and need no signup. Want an editable version with automatic
          totals? <a href={url('/download/')}>Get the free Google Sheets and Excel template</a>.
        </p>
      </div>
      <div class="split-art"><DocumentStack /></div>
    </div>
  </Sheet>

  <Sheet id="example" aria-labelledby="example-title">
    <div class="sec-head stack" style="--stack-gap: 1rem">
      <h2 id="example-title">Completed example: assets, liabilities and net worth</h2>
      <p class="lead">
        Alex and Sam are a made-up household. Every name, address and number below is fictional and
        matches the example PDF line for line.
      </p>
    </div>

    <div class="card statement" role="group" aria-labelledby="statement-heading">
      <div class="statement-top">
        <p id="statement-heading" class="statement-of">
          <span class="label">Personal financial statement of:</span>
          <strong>{example.name}</strong>
        </p>
        <p class="statement-of">
          <span class="label">As of:</span>
          <strong>{example.asOf}</strong>
        </p>
        <p class="tag">Example — fictional data</p>
      </div>

      <div class="cols">
        <div class="table-wrap">
          <table>
            <caption>Assets</caption>
            <thead>
              <tr>
                <th scope="col">Category and account</th>
                <th scope="col" class="num">Value</th>
              </tr>
            </thead>
            {
              assets.map((g) => (
                <tbody>
                  <tr class="group">
                    <th scope="row">{g.name}</th>
                    <td class="num">{formatUSD(groupTotal(g))}</td>
                  </tr>
                  {g.rows.map((r) => (
                    <tr class="item">
                      <th scope="row">{r.label}</th>
                      <td class="num">{formatUSD(r.value)}</td>
                    </tr>
                  ))}
                </tbody>
              ))
            }
            <tfoot>
              <tr>
                <th scope="row">Total assets</th>
                <td class="num">{formatUSD(totalAssets)}</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="table-wrap">
          <table>
            <caption>Liabilities</caption>
            <thead>
              <tr>
                <th scope="col">Category and account</th>
                <th scope="col" class="num">Balance owed</th>
              </tr>
            </thead>
            {
              liabilities.map((g) => (
                <tbody>
                  <tr class="group">
                    <th scope="row">{g.name}</th>
                    <td class="num">{formatUSD(groupTotal(g))}</td>
                  </tr>
                  {g.rows.map((r) => (
                    <tr class="item">
                      <th scope="row">{r.label}</th>
                      <td class="num">{formatUSD(r.value)}</td>
                    </tr>
                  ))}
                </tbody>
              ))
            }
            <tfoot>
              <tr>
                <th scope="row">Total liabilities</th>
                <td class="num">{formatUSD(totalLiabilities)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <div class="table-wrap networth">
        <table>
          <caption>Net worth</caption>
          <tbody>
            <tr>
              <th scope="row">Total assets</th>
              <td class="num">{formatUSD(totalAssets)}</td>
            </tr>
            <tr>
              <th scope="row">Minus total liabilities</th>
              <td class="num">{formatUSD(totalLiabilities)}</td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Net worth</th>
              <td class="num">{formatUSD(netWorth)}</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="signoff">
        <span><span class="label">Signature:</span> <em>{example.signedBy}</em></span>
        <span><span class="label">Date:</span> {example.asOf}</span>
      </p>
    </div>

    <p class="muted small statement-note">
      Categories with no balance are left off in this example. The blank PDF and the template keep
      every category so you can fill in whatever applies to you.
    </p>
  </Sheet>

  <Sheet tone="blue" aria-labelledby="sections-title">
    <Prose>
      <h2 id="sections-title">What each section of the example means</h2>
      <h3>Header: name and “as of” date</h3>
      <p>
        A personal financial statement is a snapshot. The “as of” date tells the reader which day
        every balance was taken from, so use the most recent statement for each account and keep the
        date current. Lenders often ask for figures from within a recent window; ask yours how
        recent they need it.
      </p>
      <h3>Assets: what you own</h3>
      <ul>
        <li>
          <strong>Checking and savings accounts</strong> use the balance on your latest statement.
          Savings you keep as an emergency fund still count; list it separately so the reader sees
          how liquid you are.
        </li>
        <li>
          <strong>Retirement accounts</strong> (401(k), IRA, Roth IRA) use the current account
          balance from the latest statement.
        </li>
        <li>
          <strong>Real estate</strong> uses an estimate of current market value, not what you paid.
          The mortgage on the property goes on the other side of the statement, under liabilities.
        </li>
        <li>
          Vehicles, investment accounts, a private business interest or valuables each get their
          own category when you have them. See the full list of categories in the{' '}
          <a href={url('/download/')}>free template</a>.
        </li>
      </ul>
      <p>
        More background: <a href={url('/glossary/assets/')}>what are assets</a>.
      </p>
      <h3>Liabilities: what you owe</h3>
      <ul>
        <li>
          <strong>Credit cards</strong> list the balance you owe today, not the credit limit.
        </li>
        <li>
          <strong>Home loans</strong> list the remaining principal on your mortgage or home equity
          line.
        </li>
        <li>
          <strong>Student loans</strong> list the outstanding balance. The example separates
          subsidized and non-subsidized loans, as the template does.
        </li>
        <li>
          Auto, boat and RV loans, notes payable and other obligations such as alimony or child
          support have their own categories when they apply.
        </li>
      </ul>
      <p>
        More background: <a href={url('/glossary/liabilities/')}>what are liabilities</a>.
      </p>
      <h3>Net worth: assets minus liabilities</h3>
      <p>
        Net worth is total assets minus total liabilities: {formatUSD(totalAssets)} −
        {' '}{formatUSD(totalLiabilities)} = {formatUSD(netWorth)} in this example. Each category
        total is the sum of the accounts under it, and the grand totals are the sums of the category
        totals, so the page always ties out. Read the definition at{' '}
        <a href={url('/glossary/net-worth-statement/')}>net worth statement</a>, or run your own
        numbers in the <a href={url('/net-worth-calculator/')}>net worth calculator</a>.
      </p>
      <h3>Signature and date</h3>
      <p>
        Signing certifies that the numbers are true and complete to the best of your knowledge. Sign
        and date only after you have reviewed every line. Lenders may check the figures against
        account statements.
      </p>
    </Prose>
  </Sheet>

  <Sheet aria-labelledby="use-title">
    <div class="sec-head stack" style="--stack-gap: 1.25rem">
      <h2 id="use-title">Use this example for your own statement</h2>
      <p class="lead">
        Download the printable blank, fill it by hand, or start from the editable template with
        automatic totals.
      </p>
    </div>
    <div class="grid grid-3 use-grid">
      <div class="card stack" style="--stack-gap: 0.75rem">
        <h3>Printable blank PFS</h3>
        <p class="muted">
          A one-page PDF with the template’s asset and liability categories, totals, net worth and
          signature and date lines.
        </p>
        <Button href={BLANK_PDF} variant="secondary" download>Download the blank (PDF)</Button>
      </div>
      <div class="card stack" style="--stack-gap: 0.75rem">
        <h3>Filled example</h3>
        <p class="muted">The completed statement above with fictional data, as a printable PDF.</p>
        <Button href={EXAMPLE_PDF} variant="secondary" download>Download the example (PDF)</Button>
      </div>
      <div class="card stack" style="--stack-gap: 0.75rem">
        <h3>Editable template</h3>
        <p class="muted">
          The free WorthSheet template for Google Sheets and Excel adds automatic totals and net
          worth.
        </p>
        <Button href="/download/" variant="primary">Get the free template</Button>
      </div>
    </div>
    <div class="stack related" style="--stack-gap: 0.5rem">
      <h3>Related guides</h3>
      <ul>
        <li>
          <a href={url('/how-to-fill-out-a-personal-financial-statement/')}>How to fill out a personal financial statement</a>
        </li>
        <li>
          <a href={url('/what-is-a-personal-financial-statement/')}>What is a personal financial statement?</a>
        </li>
        <li><a href={url('/net-worth-calculator/')}>Net worth calculator</a></li>
        <li><a href={url('/sba-form-413/')}>SBA Form 413 guide and Excel worksheet</a></li>
      </ul>
    </div>
  </Sheet>

  <Sheet aria-labelledby="faq-title">
    <div class="faq-wrap">
      <h2 id="faq-title">Personal financial statement example: FAQ</h2>
      <Faq items={faq} />
    </div>
  </Sheet>

  <CtaBand>
    <CtaTiles slot="art" />
  </CtaBand>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 0.5rem;
  }

  .statement {
    margin-top: clamp(24px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(20px, 3.5vw, 40px);
  }

  .statement-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 32px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--ink);
  }

  .statement-of {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6em;
    font-size: 1.125rem;
  }

  .label {
    color: var(--muted);
  }

  .tag {
    margin-left: auto;
    padding: 0.25em 0.9em;
    border-radius: 999px;
    border: 1px solid #a8730a;
    background: var(--tint-yellow);
    color: #6b4a05;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cols {
    display: grid;
    gap: 20px;
    align-items: start;
  }

  @media (min-width: 860px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .statement caption {
    padding: 12px 16px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .statement thead th {
    position: static;
  }

  tr.group th,
  tr.group td {
    background: var(--beige-soft);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  tr.item th {
    padding-left: 28px;
    font-weight: 400;
  }

  .statement tfoot th,
  .statement tfoot td {
    font-size: 1.0625rem;
  }

  .networth {
    max-width: 480px;
    margin-left: auto;
  }

  .networth tfoot th,
  .networth tfoot td {
    background: var(--ink);
    color: var(--white);
    font-size: 1.25rem;
  }

  .signoff {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 48px;
    padding-top: 8px;
    border-top: 1px solid var(--line-strong);
  }

  .statement-note {
    margin-top: 16px;
  }

  .use-grid {
    margin-top: clamp(24px, 4vw, 40px);
  }

  .use-grid h3 {
    font-size: 1.25rem;
  }

  .related {
    margin-top: clamp(32px, 5vw, 56px);
  }

  .related ul {
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .related a {
    text-decoration-color: var(--line-strong);
  }

  .faq-wrap {
    display: grid;
    gap: 32px;
    max-width: 820px;
  }
</style>
