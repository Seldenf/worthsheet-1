---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Prose from '../components/Prose.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import CalculatorTile from '../components/illustrations/CalculatorTile.astro';
import CtaTiles from '../components/illustrations/CtaTiles.astro';
import CalcLayout from '../components/calculators/CalcLayout.astro';
import MoneyInput from '../components/calculators/MoneyInput.astro';
import ResultCard from '../components/calculators/ResultCard.astro';
import RelatedLinks from '../components/calculators/RelatedLinks.astro';
import { faqLd, webAppLd } from '../lib/seo';
import { formatUSD } from '../lib/finance';
import { url } from '../lib/url';
import {
	MORTGAGE_DEFAULTS,
	computeMortgage,
	defaultMortgage as d,
	mortgageBar,
	mortgageOutputs,
	scheduleBodyHtml,
	scheduleFootHtml,
} from '../components/calculators/mortgageModel';

const path = '/mortgage-calculator/';
const title = 'Mortgage Calculator with Amortization Schedule | WorthSheet';
const description =
	'Free mortgage calculator: enter price, down payment, rate and term to see your monthly principal and interest, total interest, total cost and amortization.';

const faq = [
	{
		q: 'How is a monthly mortgage payment calculated?',
		a: 'The calculator uses the standard fixed-rate formula: loan amount × monthly rate ÷ (1 − (1 + monthly rate)^−number of payments), where the loan amount is price minus down payment.',
	},
	{
		q: 'Does this calculator include property taxes and insurance?',
		a: 'No. It shows principal and interest only. For a fuller monthly budget, including taxes and insurance, use the How Much House Can I Afford calculator.',
	},
	{
		q: 'What is an amortization schedule?',
		a: 'A table showing how each payment is split between interest and principal and how the balance falls over the loan term; this page summarizes it by year.',
	},
	{
		q: 'How much interest will I pay over the life of the loan?',
		a: 'The calculator shows total interest and total cost for your inputs; shorter terms and lower rates reduce total interest.',
	},
	{
		q: 'Is this a loan offer?',
		a: 'No. Results are estimates for educational purposes only and not a loan offer or financial advice.',
	},
];

const out = mortgageOutputs(d);
const bar = mortgageBar(d);
const firstYear = d.rows[0];

// Worked example values, derived from the same model the calculator uses.
const monthlyRate = MORTGAGE_DEFAULTS.rate / 100 / 12;
const discount = Math.pow(1 + monthlyRate, -d.payments);
const short = computeMortgage(d.price, d.down, MORTGAGE_DEFAULTS.rate, 15);

const related = [
	{ href: '/how-much-house-can-i-afford/', title: 'How much house can I afford?', text: 'Work backward from your income to a price, with taxes and insurance included.' },
	{ href: '/debt-to-income-ratio-calculator/', title: 'Debt-to-income calculator', text: 'See your front-end and back-end DTI against the 28/36 benchmarks.' },
	{ href: '/mortgage-readiness-assessment/', title: 'Mortgage readiness assessment', text: 'Score your credit, income, loan-to-value, DTI and net worth.' },
	{ href: '/glossary/amortization/', title: 'Amortization', text: 'What an amortization schedule is and why early payments are mostly interest.' },
	{ href: '/glossary/down-payment/', title: 'Down payment', text: 'How the up-front cash changes the loan amount and the payment.' },
	{ href: '/glossary/apr/', title: 'APR vs. interest rate', text: 'Why the annual percentage rate can differ from the rate you enter here.' },
];
---

<Base
	title={title}
	description={description}
	path={path}
	breadcrumbs={[{ name: 'Mortgage calculator', path }]}
	jsonLd={[
		webAppLd({ name: 'Mortgage calculator with amortization schedule', description, path, category: 'Mortgage calculator' }),
		faqLd(faq),
	]}
>
	<CalcLayout
		eyebrow="Free calculator"
		title="Mortgage calculator"
		accent="with amortization schedule"
		lead="Enter the home price, your down payment, the interest rate and the loan term. You get the monthly principal and interest, the total interest, the total cost and a year-by-year amortization schedule."
		seed={21}
		formId="mortgage-form"
		inputsTitle="Your loan"
		resultsTone="cream"
	>
		<CalculatorTile slot="art" />

		<MoneyInput id="price" label="Home price ($)" value={MORTGAGE_DEFAULTS.price} hint="The purchase price of the home." required />
		<MoneyInput id="down" label="Down payment ($)" value={MORTGAGE_DEFAULTS.down} hint="Leave blank for no down payment." />
		<MoneyInput id="rate" label="Interest rate (%)" value={MORTGAGE_DEFAULTS.rate} prefix="" suffix="%" hint="Annual rate, for example 5 or 6.75." required />
		<MoneyInput id="years" label="Amortization period (years)" value={MORTGAGE_DEFAULTS.years} prefix="" suffix="years" inputmode="numeric" hint="Years to pay off the loan, for example 10, 15, 20, 25 or 30." required />

		<div slot="results" data-results class="stack" style="--stack-gap: 16px">
			<ResultCard primary label="Monthly principal & interest" out="payment" value={out.payment} hint="Taxes, insurance and PMI are not included." />
			<div class="out-grid">
				<ResultCard label="Loan amount" out="loan" value={out.loan} hint="Home price minus down payment" />
				<ResultCard label="Total interest" out="interest" value={out.interest} hint="Over the full term" />
				<ResultCard label="Total cost" out="total" value={out.total} hint="Down payment plus every monthly payment" />
				<ResultCard label="Paid off in" out="payoff" value={out.payoff} hint="At the scheduled payment" />
			</div>
			<div class="pay card">
				<p class="split-title">Where your payments go</p>
				<div class="bar" role="img" data-bar aria-label={out.barLabel}>
					<span class="bar-principal" data-bar-principal style={`width:${bar.principal}%`}></span>
					<span class="bar-interest" data-bar-interest style={`width:${bar.interest}%`}></span>
				</div>
				<ul class="legend" role="list">
					<li><span class="swatch swatch-principal" aria-hidden="true"></span><span data-out="principalLegend">{out.principalLegend}</span></li>
					<li><span class="swatch swatch-interest" aria-hidden="true"></span><span data-out="interestLegend">{out.interestLegend}</span></li>
				</ul>
			</div>
		</div>

		<div slot="below" class="schedule-wrap" data-results>
			<details class="schedule card">
				<summary>
					<span>Show the yearly amortization schedule</span>
					<svg viewBox="0 0 12 8" width="14" height="10" aria-hidden="true"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</summary>
				<div class="table-wrap">
					<table>
						<caption>Principal and interest paid each year, and the balance left at year end</caption>
						<thead>
							<tr>
								<th scope="col">Year</th>
								<th scope="col" class="num">Principal paid</th>
								<th scope="col" class="num">Interest paid</th>
								<th scope="col" class="num">Ending balance</th>
							</tr>
						</thead>
						<tbody data-schedule-body set:html={scheduleBodyHtml(d.rows)}></tbody>
						<tfoot data-schedule-foot set:html={scheduleFootHtml(d.rows)}></tfoot>
					</table>
				</div>
			</details>
		</div>
	</CalcLayout>

	<Sheet id="how" aria-labelledby="how-title">
		<div class="split cols">
			<div class="col">
			<Eyebrow tone="blue">How it works</Eyebrow>
			<Prose>
				<h2 id="how-title">How the mortgage payment is calculated</h2>
				<p>
					This calculator uses the standard formula for a fixed-rate, fully amortizing loan with monthly payments. In plain words: take the loan amount (price minus down payment), multiply it by the monthly interest rate, and divide by one minus the discount factor <code>(1 + monthly rate)</code> raised to the power of minus the number of payments.
				</p>
				<ol>
					<li><strong>Loan amount</strong> = home price − down payment.</li>
					<li><strong>Monthly rate</strong> = annual rate ÷ 12.</li>
					<li><strong>Number of payments</strong> = years × 12.</li>
					<li><strong>Payment</strong> = loan × monthly rate ÷ (1 − (1 + monthly rate)<sup>−payments</sup>).</li>
					<li><strong>Total of payments</strong> = payment × number of payments; <strong>total interest</strong> = total of payments − loan; <strong>total cost</strong> = down payment + total of payments.</li>
				</ol>
				<p>
					The yearly schedule applies the same payment month by month: each month the interest is the remaining balance times the monthly rate, and whatever is left of the payment reduces the balance. The final payment absorbs rounding so the balance ends at exactly $0.
				</p>
			</Prose>
			</div>
			<div class="col">
			<Eyebrow tone="green">In numbers</Eyebrow>
			<Prose>
				<h2 id="example">Worked example</h2>
				<p>
					A {formatUSD(d.price)} home with {formatUSD(d.down)} down, a {MORTGAGE_DEFAULTS.rate}% rate and a {MORTGAGE_DEFAULTS.years}-year term:
				</p>
				<ul>
					<li>Loan amount: {formatUSD(d.price)} − {formatUSD(d.down)} = <strong>{formatUSD(d.loan)}</strong>.</li>
					<li>Monthly rate: {MORTGAGE_DEFAULTS.rate}% ÷ 12 = {(monthlyRate * 100).toFixed(4)}% ({monthlyRate.toFixed(6)}); payments: {MORTGAGE_DEFAULTS.years} × 12 = {d.payments}.</li>
					<li>Discount factor: (1 + {monthlyRate.toFixed(6)})<sup>−{d.payments}</sup> = {discount.toFixed(4)}, so 1 − {discount.toFixed(4)} = {(1 - discount).toFixed(4)}.</li>
					<li>Payment: {formatUSD(d.loan)} × {monthlyRate.toFixed(6)} ÷ {(1 - discount).toFixed(4)} = {formatUSD(d.loan * monthlyRate)} ÷ {(1 - discount).toFixed(4)} ≈ <strong>{formatUSD(d.payment, true)}</strong> a month.</li>
					<li>Total of payments: {formatUSD(d.payment, true)} × {d.payments} ≈ {formatUSD(d.totalPayments, true)} (using the unrounded payment); total interest = {formatUSD(d.totalPayments, true)} − {formatUSD(d.loan)} = <strong>{formatUSD(d.totalInterest, true)}</strong>; total cost with the down payment = <strong>{formatUSD(d.totalCost, true)}</strong>.</li>
					<li>Year 1: about {formatUSD(firstYear.interestPaid)} of the {formatUSD(d.payment * 12)} you pay goes to interest and {formatUSD(firstYear.principalPaid)} reduces the balance.</li>
				</ul>
				<p>
					A shorter term changes the trade-off. The same {formatUSD(d.loan)} at {MORTGAGE_DEFAULTS.rate}% over 15 years costs {formatUSD(short.payment, true)} a month but only {formatUSD(short.totalInterest)} in total interest, compared with {formatUSD(d.totalInterest)} over {MORTGAGE_DEFAULTS.years} years.
				</p>
			</Prose>
			</div>
		</div>
	</Sheet>

	<Sheet id="scope" tone="green" aria-labelledby="scope-title">
		<div class="split cols">
			<div class="col">
			<Eyebrow tone="yellow">Good to know</Eyebrow>
			<Prose>
				<h2 id="scope-title">What this estimate leaves out</h2>
				<p>
					The result is principal and interest only. A real monthly housing payment usually adds property taxes and homeowners insurance (often collected in an <a href={url('/glossary/escrow/')}>escrow</a> account), plus homeowners association dues where they apply. On a conventional loan with less than 20% down, <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-private-mortgage-insurance-en-122/" rel="noopener">private mortgage insurance (PMI)</a> is also added to the payment, and the lender's APR includes certain fees on top of the interest rate.
				</p>
				<p>
					To see a price range that includes taxes, insurance and HOA dues, try the <a href={url('/how-much-house-can-i-afford/')}>how much house can I afford</a> calculator. Lenders also look at your debt-to-income ratio: check yours with the <a href={url('/debt-to-income-ratio-calculator/')}>DTI calculator</a>.
				</p>
			</Prose>
			</div>
			<div class="col">
			<Eyebrow tone="navy">Next step</Eyebrow>
			<Prose>
				<h2>Get your finances lender-ready</h2>
				<p>
					Before you apply, a lender will want a clear picture of what you own and owe. The free WorthSheet template adds up your assets, liabilities and net worth in Google Sheets or Excel, and its Homebuyer Readiness tab is the same self-check across five areas as our <a href={url('/mortgage-readiness-assessment/')}>mortgage readiness assessment</a>.
				</p>
				<p>
					For program rules, see the CFPB's <a href="https://www.consumerfinance.gov/owning-a-home/" rel="noopener">Buying a House</a> guide.
				</p>
			</Prose>
			</div>
		</div>
	</Sheet>

	<Sheet id="faq" aria-labelledby="faq-title">
		<div class="split faq-cols">
			<div class="stack" style="--stack-gap: 1.25rem">
				<Eyebrow tone="blue">FAQ</Eyebrow>
				<h2 id="faq-title">Mortgage calculator FAQ</h2>
				<p class="lead">Answers about what this calculator does and does not include.</p>
			</div>
			<Faq items={faq} />
		</div>
	</Sheet>

	<Sheet id="related" aria-labelledby="related-title">
		<div class="sec-head stack" style="--stack-gap: 1.25rem">
			<Eyebrow tone="green">Keep exploring</Eyebrow>
			<h2 id="related-title">Related tools and guides</h2>
		</div>
		<RelatedLinks items={related} />
	</Sheet>

	<CtaBand>
		<CtaTiles slot="art" />
	</CtaBand>
</Base>

<script>
	import {
		bindCalculator,
		createUseTracker,
		readInputs,
		setOutAll,
		showErrors,
		showResults,
	} from '../components/calculators/calc';
	import { MORTGAGE_KEYS, evaluateMortgage, mortgageBar, mortgageOutputs, scheduleBodyHtml, scheduleFootHtml } from '../components/calculators/mortgageModel';

	const trackUse = createUseTracker('mortgage');

	function update(interacted: boolean) {
		const outcome = evaluateMortgage(readInputs(MORTGAGE_KEYS));
		if (!outcome.ok) {
			showErrors(MORTGAGE_KEYS, outcome.errors);
			showResults(false);
			return;
		}
		showErrors(MORTGAGE_KEYS, {});
		showResults(true);

		const r = outcome.result;
		const outs = mortgageOutputs(r);
		setOutAll(outs);
		const bar = mortgageBar(r);
		document.querySelector<HTMLElement>('[data-bar]')?.setAttribute('aria-label', outs.barLabel);
		const p = document.querySelector<HTMLElement>('[data-bar-principal]');
		const i = document.querySelector<HTMLElement>('[data-bar-interest]');
		if (p) p.style.width = `${bar.principal}%`;
		if (i) i.style.width = `${bar.interest}%`;
		const body = document.querySelector('[data-schedule-body]');
		const foot = document.querySelector('[data-schedule-foot]');
		if (body) body.innerHTML = scheduleBodyHtml(r.rows);
		if (foot) foot.innerHTML = scheduleFootHtml(r.rows);
		if (interacted) trackUse();
	}

	bindCalculator('mortgage-form', update);
</script>

<style>
	.out-grid {
		display: grid;
		gap: 12px;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	@media (max-width: 479px) {
		.out-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.pay {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 16px 18px;
	}

	.split-title {
		font-size: 0.875rem;
		font-weight: 560;
		color: var(--ink);
	}

	.bar {
		display: flex;
		height: 18px;
		border-radius: 999px;
		overflow: hidden;
		background: var(--beige);
	}

	.bar-principal {
		background: var(--green);
	}

	.bar-interest {
		background: var(--yellow);
	}

	.legend {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px 20px;
		font-size: 0.875rem;
	}

	.legend li {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.swatch {
		width: 12px;
		height: 12px;
		border-radius: 4px;
	}

	.swatch-principal {
		background: var(--green);
	}

	.swatch-interest {
		background: var(--yellow);
	}

	.schedule-wrap {
		margin-top: clamp(16px, 2.4vw, 28px);
	}

	.schedule {
		padding: 0;
		overflow: hidden;
	}

	.schedule > summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 44px;
		padding: 18px 22px;
		cursor: pointer;
		list-style: none;
		font-weight: 560;
		letter-spacing: -0.015em;
	}

	.schedule > summary::-webkit-details-marker {
		display: none;
	}

	.schedule[open] > summary svg {
		transform: rotate(180deg);
	}

	.schedule .table-wrap {
		border: 0;
		border-top: 1px solid var(--line);
		border-radius: 0;
		max-height: 520px;
	}

	/* Two prose columns, top aligned; the eyebrow chip sits right above the heading. */
	.cols,
	.faq-cols {
		align-items: start;
	}

	.col {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		min-width: 0;
	}

	.col :global(.prose > h2:first-child) {
		margin-top: 0;
	}
</style>
