---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import BankFinder from '../../components/BankFinder.astro';
import BankMap from '../../components/illustrations/BankMap.astro';
import CtaTiles from '../../components/illustrations/CtaTiles.astro';
import { faqLd } from '../../lib/seo';
import { url } from '../../lib/url';
import { FDIC_META, STATES, fmt, getSummary } from '../../data/banks';

const path = '/banks/';
const title = 'Find FDIC-Insured Banks by ZIP Code & State | WorthSheet';
const description =
  "Search FDIC-insured banks by ZIP code or browse banks in every state. Data comes from the FDIC's BankFind database. List the bank names on your PFS accurately.";

const faq = [
  {
    q: 'How do I find FDIC-insured banks near me?',
    a: "Enter your ZIP code to search the FDIC's BankFind database, or browse your state's page.",
  },
  {
    q: 'What does FDIC insurance cover?',
    a: 'FDIC deposit insurance covers deposits up to $250,000 per depositor, per insured bank, for each account ownership category; see FDIC.gov for the details.',
  },
  {
    q: 'How do I check that a bank is FDIC-insured?',
    a: 'Look it up in FDIC BankFind (banks.data.fdic.gov); the result shows whether it is an active insured institution.',
  },
  {
    q: 'Why list my bank accounts on a personal financial statement?',
    a: 'Lenders expect each checking, savings and money market balance by institution, and the template has a line for the bank name.',
  },
  {
    q: 'Where does this data come from?',
    a: 'The FDIC BankFind Suite API; counts are refreshed when the site is rebuilt.',
  },
];

const states = STATES.map((s) => ({ ...s, stats: getSummary(s.code) }));
const totalBranches = states.reduce((sum, s) => sum + s.stats.branches, 0);
const dataDate = new Date(`${FDIC_META.dataDate}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={title}
  description={description}
  path={path}
  breadcrumbs={[{ name: 'Banks', path }]}
  jsonLd={[faqLd(faq)]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <Eyebrow>Bank finder</Eyebrow>
        <h1>Find FDIC-insured banks by ZIP code or state</h1>
        <p class="lead">
          An FDIC-insured bank is a bank whose deposits are protected by the Federal Deposit Insurance
          Corporation, up to $250,000 per depositor, per insured bank, for each account ownership category.
          Enter a ZIP code to see the full-service bank offices there, or pick a state below.
        </p>
      </div>
      <div class="hero-art">
        <BankMap class="float" />
      </div>
    </div>
  </section>

  <Section id="finder" tone="surface" aria-labelledby="finder-title">
    <div class="finder-wrap">
      <div class="finder-copy stack">
        <h2 id="finder-title">Search FDIC-insured banks by ZIP code</h2>
        <p class="muted">
          The search runs in your browser against the FDIC's public BankFind API and lists every
          full-service office (brick-and-mortar or retail) in the ZIP code you enter. Nothing is loaded from the
          FDIC until you press the button.
        </p>
      </div>
      <div class="card finder-card">
        <BankFinder />
      </div>
    </div>
  </Section>

  <Section aria-labelledby="pfs-title">
    <div class="split">
      <div>
        <Eyebrow>For your financial statement</Eyebrow>
        <h2 id="pfs-title">Why bank names matter on a personal financial statement</h2>
      </div>
      <div class="stack">
        <p>
          A personal financial statement lists what you own and owe, and lenders expect each
          account to be identified by institution: the checking, savings and money market balances under the bank
          that holds them, and each loan under the bank that issued it. The WorthSheet template has an
          "Insert bank name" line for every account for exactly this reason.
        </p>
        <p>
          Spelling the institution the way it appears on your statements makes the figures easy for an
          underwriter to verify. Use the finder to confirm the legal name of a bank and which offices it runs near
          you, then enter your balances in the template or total them in the
          <a href={url('/net-worth-calculator/')}>net worth calculator</a>. Cash and balances you can
          reach quickly count as <a href={url('/glossary/liquid-assets/')}>liquid assets</a>.
        </p>
        <p class="muted">
          New to the format? Read
          <a href={url('/what-is-a-personal-financial-statement/')}>what a personal financial statement is</a>
          and how to fill one out, then grab the free template.
        </p>
        <div class="actions">
          <Button href="/download/" variant="primary">Get the free template</Button>
          <Button href="/what-is-a-personal-financial-statement/" variant="secondary">What is a PFS?</Button>
        </div>
      </div>
    </div>
  </Section>

  <Section id="states" tone="surface" aria-labelledby="states-title">
    <div class="stack" style="--stack-gap: 12px">
      <h2 id="states-title">Banks by state</h2>
      <p class="lead">
        {fmt(FDIC_META.activeInstitutions51)} active FDIC-insured banks are headquartered in the 50 states and
        the District of Columbia, and FDIC data lists {fmt(totalBranches)} full-service branch offices
        across them. Choose a state for its largest banks, community banks and state regulator.
      </p>
    </div>
    <ul class="state-grid" aria-label="Banks by state">
      {
        states.map((s) => (
          <li>
            <a class="card state-card" href={url(`/banks/${s.slug}/`)}>
              <span class="state-name">{s.name}</span>
              <span class="state-stats num">
                {fmt(s.stats.banks)} {s.stats.banks === 1 ? 'bank' : 'banks'}
                <span aria-hidden="true"> · </span>
                <span class="sr-only">, </span>
                {fmt(s.stats.branches)} branches
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="disclaimer source">
      Source: FDIC BankFind Suite, data as of {dataDate}. Bank counts are institutions headquartered in the
      state; branches are full-service offices in the state, whoever owns them. U.S. territories are not
      included. Listings are public data, not recommendations or rankings.
    </p>
  </Section>

  <Section aria-labelledby="faq-title">
    <div class="split">
      <div>
        <Eyebrow>FAQ</Eyebrow>
        <h2 id="faq-title">Questions about FDIC-insured banks</h2>
      </div>
      <Faq items={faq} />
    </div>
  </Section>

  <CtaBand>
    <CtaTiles slot="art" />
  </CtaBand>
</Base>

<style>
  .hero {
    padding-block: clamp(32px, 6vw, 80px) clamp(40px, 6vw, 80px);
  }

  .hero-grid {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .hero-art {
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
  }

  .finder-wrap,
  .split {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
  }

  @media (min-width: 900px) {
    .finder-wrap {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }

    .split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }

  .split h2 {
    margin-top: 12px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .state-grid {
    list-style: none;
    margin: clamp(24px, 4vw, 40px) 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .state-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    height: 100%;
    box-shadow: none;
  }

  .state-name {
    font-weight: 560;
    letter-spacing: -0.015em;
  }

  .state-stats {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .source {
    margin-top: 24px;
    max-width: 56em;
  }
</style>
