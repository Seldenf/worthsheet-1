---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Prose from '../components/Prose.astro';
import CalculatorTile from '../components/illustrations/CalculatorTile.astro';
import CtaTiles from '../components/illustrations/CtaTiles.astro';
import { faqLd, webAppLd } from '../lib/seo';
import { url } from '../lib/url';

const path = '/net-worth-calculator/';
const title = 'Net Worth Calculator (Assets & Liabilities) | WorthSheet';
const description =
  'Free net worth calculator: enter your assets and liabilities by category and see your net worth instantly. Same categories as the WorthSheet PFS template.';

interface Group {
  id: string;
  label: string;
  /** Account type examples from the template's "Account Types Checklist". */
  examples: string[];
}

const assetGroups: Group[] = [
  { id: 'checking', label: 'Checking accounts', examples: ['Checking account'] },
  { id: 'savings', label: 'Savings accounts', examples: ['Savings account'] },
  {
    id: 'retirement',
    label: 'Retirement accounts',
    examples: ['401(k)', '403(b)', 'IRA (SEP, Traditional, Roth)', 'Pension'],
  },
  {
    id: 'investment',
    label: 'Investment accounts',
    examples: [
      'Brokerage or mutual fund account',
      'CDs',
      'Money market',
      'Government bonds',
      'Crypto',
      'Company restricted stock',
    ],
  },
  {
    id: 'real-estate',
    label: 'Real estate',
    examples: ['Primary residence', 'Non-primary residence', 'Investment property'],
  },
  { id: 'vehicles', label: 'Auto, boat, RV', examples: ['Personal vehicle', 'Boat', 'RV'] },
  { id: 'business', label: 'Private business interest', examples: ['Name of business'] },
  {
    id: 'other-assets',
    label: 'Other assets',
    examples: ['HSA', '529 plan', 'Annuity', 'Whole life (cash surrender value)', 'Arts & collectibles'],
  },
];

const liabilityGroups: Group[] = [
  { id: 'credit-cards', label: 'Credit cards', examples: ['Credit card'] },
  { id: 'home-loans', label: 'Home loans (incl. HELOC)', examples: ['Mortgage', 'HELOC'] },
  { id: 'student-loans', label: 'Student loans', examples: ['Subsidized', 'Non-subsidized'] },
  { id: 'vehicle-loans', label: 'Auto, boat, RV loans', examples: ['Auto loan', 'Boat loan', 'RV loan'] },
  {
    id: 'notes-payable',
    label: 'Notes payable',
    examples: ['Personal loan', 'Business loan (personal guarantee)', 'Other property loan'],
  },
  {
    id: 'other-obligations',
    label: 'Other obligations',
    examples: ['Personal bankruptcy obligations', 'Alimony and/or child support'],
  },
];

const faq = [
  {
    q: 'What is net worth?',
    a: 'Net worth is everything you own (assets) minus everything you owe (liabilities).',
  },
  {
    q: 'What counts as an asset in a net worth calculator?',
    a: 'Cash and bank accounts, retirement and investment accounts, real estate, vehicles, business interests and other valuables, each at current value.',
  },
  {
    q: 'Should I include my home?',
    a: "Yes. Enter the home's market value as an asset and the mortgage or HELOC balance as a liability.",
  },
  {
    q: 'Is a negative net worth bad?',
    a: 'Not necessarily. Student loans and a new mortgage can make net worth negative early on; what matters is the direction over time.',
  },
  {
    q: 'How does my net worth compare with others?',
    a: "The Federal Reserve's 2025 Survey of Consumer Finances reports median family net worth of $215,900 and mean of $1.24 million.",
  },
  {
    q: 'Is my data saved or sent anywhere?',
    a: 'No. The totals are calculated in your browser, nothing you type is uploaded or stored, and clearing or reloading the page erases it. If you accept analytics cookies, only the fact that the calculator was used is recorded, never your numbers.',
  },
];

const related = [
  {
    href: '/how-to-calculate-net-worth/',
    title: 'How to calculate your net worth',
    text: 'The formula, four steps and a worked example.',
  },
  {
    href: '/glossary/net-worth/',
    title: 'What is net worth?',
    text: 'A plain-English definition with examples.',
  },
  {
    href: '/personal-financial-statement-example/',
    title: 'Personal financial statement example',
    text: 'See a completed statement and download a blank PDF.',
  },
  {
    href: '/mortgage-readiness-assessment/',
    title: 'Mortgage readiness assessment',
    text: 'Net worth is criterion five of the five we score.',
  },
  {
    href: '/debt-to-income-ratio-calculator/',
    title: 'Debt-to-income ratio calculator',
    text: 'Compare your monthly debt payments with your income.',
  },
  {
    href: '/glossary/liabilities/',
    title: 'What are liabilities?',
    text: 'Which debts and obligations to count.',
  },
];
---

<Base
  title={title}
  description={description}
  path={path}
  breadcrumbs={[{ name: 'Net worth calculator', path }]}
  jsonLd={[
    webAppLd({
      name: 'Net Worth Calculator',
      description,
      path,
      category: 'Net worth calculator',
    }),
    faqLd(faq),
  ]}
>
  <Sheet grid seed={24} id="hero" aria-labelledby="hero-title" class="no-print">
    <div class="split">
      <div class="stack split-copy" style="--stack-gap: 1.25rem">
        <Eyebrow tone="green">Free calculator</Eyebrow>
        <h1 id="hero-title">Net worth <span class="accent">calculator</span></h1>
        <p class="lead">
          Net worth is everything you own (your assets) minus everything you owe (your liabilities). Enter your
          accounts by category below and watch your total assets, total liabilities and net worth update as you type.
        </p>
        <ul class="list-check">
          <li>Same asset and liability groups as the PFS tab of the free template</li>
          <li>Add as many accounts as you need to each group</li>
          <li>Runs in your browser: nothing you enter leaves your device</li>
        </ul>
        <div class="hero-actions">
          <Button href="#calculator" variant="primary" size="lg">Calculate my net worth</Button>
          <Button href="/download/" variant="secondary" size="lg">Get the free template</Button>
        </div>
      </div>
      <div class="hero-art">
        <CalculatorTile class="float" />
      </div>
    </div>
  </Sheet>

  <Sheet id="calculator" tone="white" aria-labelledby="calc-title">
    <div data-nw class="nw">
      <div class="nw-head">
        <div>
          <h2 id="calc-title">Enter your assets and liabilities</h2>
          <p class="muted">
            Use the most recent balance or current market value for each account. Leave a row blank if it does not
            apply; the name is optional and only helps you keep track.
          </p>
        </div>
        <div class="nw-actions no-print">
          <button type="button" class="btn btn-secondary btn-sm" data-print>Print</button>
          <button type="button" class="btn btn-ghost btn-sm" data-reset>Clear all</button>
        </div>
      </div>

      <p class="print-only nw-print-title">
        Net worth statement, as of <span data-print-date></span>
      </p>

      <p class="field-error nw-status" data-status aria-live="polite"></p>

      <div class="nw-cols">
        {
          [
            { kind: 'assets', heading: 'Your assets', hint: 'What you own', groups: assetGroups },
            { kind: 'liabilities', heading: 'Your liabilities', hint: 'What you owe', groups: liabilityGroups },
          ].map((col) => (
            <div class="nw-col" data-kind={col.kind}>
              <h3 class="nw-col-title">
                {col.heading} <span class="muted">({col.hint})</span>
              </h3>
              {col.groups.map((g) => (
                <section
                  class="nw-group card"
                  data-group={g.id}
                  data-label={g.label}
                  data-examples={g.examples.join('|')}
                  aria-labelledby={`nw-${g.id}-title`}
                >
                  <h4 id={`nw-${g.id}-title`}>{g.label}</h4>
                  <p class="field-hint nw-examples">Examples: {g.examples.join(', ')}</p>
                  <div class="nw-rows">
                    <div class="nw-row is-empty">
                      <div class="nw-name">
                        <label class="sr-only" for={`nw-${g.id}-1-name`}>
                          {g.label} row 1: account name
                        </label>
                        <input
                          type="text"
                          id={`nw-${g.id}-1-name`}
                          placeholder={g.examples[0]}
                          autocomplete="off"
                          maxlength="80"
                        />
                      </div>
                      <div class="input-group nw-amount">
                        <label class="sr-only" for={`nw-${g.id}-1-amount`}>
                          {g.label} row 1: amount in dollars
                        </label>
                        <span class="input-affix" aria-hidden="true">
                          $
                        </span>
                        <input
                          type="text"
                          id={`nw-${g.id}-1-amount`}
                          inputmode="decimal"
                          placeholder="0"
                          autocomplete="off"
                        />
                      </div>
                      <button type="button" class="nw-remove no-print" data-remove hidden aria-label={`Remove ${g.label} row 1`}>
                        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                          <path d="M2 2l8 8M10 2l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                      </button>
                    </div>
                  </div>
                  <div class="nw-group-foot">
                    <button type="button" class="btn btn-ghost btn-sm no-print" data-add>
                      + Add row
                    </button>
                    <p class="nw-subtotal">
                      Subtotal <span class="num" data-subtotal>$0</span>
                    </p>
                  </div>
                </section>
              ))}
            </div>
          ))
        }
      </div>
      <div class="nw-summary" aria-live="polite" aria-atomic="true">
        <div class="nw-sum">
          <span class="nw-sum-label">Total assets</span>
          <span class="nw-sum-value num" data-total="assets">$0</span>
        </div>
        <div class="nw-sum">
          <span class="nw-sum-label">Total liabilities</span>
          <span class="nw-sum-value num" data-total="liabilities">$0</span>
        </div>
        <div class="nw-sum nw-sum-main">
          <span class="nw-sum-label">Net worth</span>
          <span class="nw-sum-value num" data-total="net">$0</span>
        </div>
      </div>

      <noscript>
        <p class="muted">The totals need JavaScript. Without it you can still use the free template to total your accounts.</p>
      </noscript>

      <p class="disclaimer">
        Estimates for educational purposes only. Not a loan offer or financial advice. Everything you enter stays in
        your browser and is not saved or sent anywhere.
      </p>
    </div>
  </Sheet>

  <Sheet id="how" tone="white" aria-labelledby="how-title" class="no-print">
    <div class="split">
      <div class="sec-head stack split-copy" style="--stack-gap: 1rem">
        <Eyebrow tone="green">How it works</Eyebrow>
        <h2 id="how-title">How this <span class="accent">net worth calculator</span> works</h2>
      </div>
      <Prose>
        <p>
          The calculator adds every amount you enter under <strong>assets</strong>, adds every amount under
          <strong>liabilities</strong>, and subtracts the second total from the first:
          <strong>net worth = total assets − total liabilities</strong>. A positive result means you own more than you
          owe; a negative result means the opposite.
        </p>
        <p>
          The groups match the Personal Financial Statement (PFS) tab of the free WorthSheet template: checking,
          savings, retirement, investment, real estate, auto/boat/RV, private business interest and other assets, and
          credit cards, home loans including HELOC, student loans, auto/boat/RV loans, notes payable and other
          obligations. The examples under each group come from the template's account types checklist.
        </p>
        <h3>Value each item realistically</h3>
        <ul>
          <li>Real estate and vehicles: current market value, not what you paid.</li>
          <li>Retirement and investment accounts: the balance on the date you are measuring.</li>
          <li>
            Life insurance: cash surrender value only, as on <a href={url('/glossary/sba-form-413/')}>SBA Form 413</a>.
          </li>
          <li>Business interests and collectibles: a conservative value you could document.</li>
          <li>Liabilities: the full balance you owe today, not the monthly payment.</li>
        </ul>
        <p>
          Net worth is a snapshot on one date. For the step-by-step method and a worked example, read
          <a href={url('/how-to-calculate-net-worth/')}>how to calculate your net worth</a>.
        </p>
      </Prose>
    </div>
  </Sheet>

  <Sheet id="meaning" tone="blue" aria-labelledby="meaning-title" class="no-print">
    <div class="split">
      <div class="sec-head stack split-copy" style="--stack-gap: 1rem">
        <Eyebrow tone="blue">Your result</Eyebrow>
        <h2 id="meaning-title">What your <span class="accent accent-blue">net worth tells you</span></h2>
      </div>
      <Prose>
        <p>
          Net worth shows the value left after your debts are paid. Lenders and advisors look at it alongside income
          and credit; the Consumer Financial Protection Bureau lists savings and total assets among the factors mortgage
          lenders weigh (see
          <a href="https://www.consumerfinance.gov/ask-cfpb/does-my-credit-score-affect-my-ability-to-get-a-mortgage-loan-or-the-mortgage-rate-i-pay-en-319/" rel="noopener">CFPB: does my credit score affect my ability to get a mortgage</a>).
        </p>
        <p>
          For context, the Federal Reserve's 2025 Survey of Consumer Finances reports median family net worth of
          $215,900 and mean family net worth of $1.24 million
          (<a href="https://www.federalreserve.gov/newsevents/pressreleases/other20261009a.htm" rel="noopener">Federal Reserve press release, Oct. 9, 2026</a>).
          Medians are benchmarks, not goals; your age, goals and income matter more than a national figure.
        </p>
        <p>
          A negative net worth is common early in life, when student loans or a new mortgage outweigh savings. What
          matters is the direction over time. Many lenders also care about liquid assets, which are the cash-like
          part of your net worth (see <a href={url('/glossary/liquid-assets/')}>liquid assets</a>).
        </p>
      </Prose>
    </div>
  </Sheet>

  <Sheet id="next" tone="green" aria-labelledby="next-title" class="no-print">
    <div class="next">
      <div class="stack" style="--stack-gap: 1rem">
        <Eyebrow tone="green">Next step</Eyebrow>
        <h2 id="next-title">Turn this number into a <span class="accent">bank-ready statement</span></h2>
        <p class="lead">
          A personal financial statement lists every asset and liability behind your net worth on a specific date. The
          free template does the totals for you, includes an account types checklist and prints cleanly for your lender
          or advisor.
        </p>
      </div>
      <div class="next-actions">
        <Button href="/download/" variant="primary" size="lg">Get the free template</Button>
        <Button href="/personal-financial-statement-example/" variant="secondary" size="lg">See a PFS example</Button>
      </div>
    </div>
  </Sheet>

  <Sheet id="faq" tone="white" aria-labelledby="faq-title" class="no-print">
    <div class="split">
      <div class="sec-head stack split-copy" style="--stack-gap: 1rem">
        <Eyebrow tone="yellow">FAQ</Eyebrow>
        <h2 id="faq-title">Net worth calculator questions</h2>
      </div>
      <Faq items={faq} />
    </div>
  </Sheet>

  <Sheet id="related" tone="white" aria-labelledby="related-title" class="no-print">
    <div class="sec-head stack" style="--stack-gap: 1rem">
      <Eyebrow tone="blue">Keep going</Eyebrow>
      <h2 id="related-title">Related tools and guides</h2>
    </div>
    <ul class="grid grid-3 related">
      {
        related.map((r) => (
          <li>
            <a class="card related-card" href={url(r.href)}>
              <h3>{r.title}</h3>
              <span class="related-arrow" aria-hidden="true">↗</span>
              <p class="muted">{r.text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Sheet>

  <div class="no-print">
    <CtaBand>
      <CtaTiles slot="art" />
    </CtaBand>
  </div>
</Base>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-art {
    max-width: 480px;
    margin-inline: auto;
    width: 100%;
  }

  /* ---------- Calculator ---------- */
  .nw {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .nw-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-end;
  }

  .nw-head h2 {
    margin: 0 0 8px;
  }

  .nw-head p {
    margin: 0;
    max-width: 62ch;
  }

  .nw-actions {
    display: flex;
    gap: 8px;
  }

  /* Summary card, styled like the home hero's Summary panel: coloured squares, navy bold net worth. */
  .nw-summary {
    position: sticky;
    bottom: 16px;
    top: auto;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px -12px rgba(12, 38, 53, 0.25);
  }

  @media (max-width: 519px) {
    .nw-sum {
      gap: 2px;
      padding: 10px 12px;
    }
  }

  .nw-sum {
    --sq: var(--green);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px clamp(12px, 2vw, 24px);
    background: var(--white);
    min-width: 0;
  }

  .nw-sum:nth-child(2) {
    --sq: var(--yellow);
  }

  .nw-sum-main {
    --sq: var(--blue);
    background: var(--tint-blue);
  }

  .nw-sum-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--muted);
    font-weight: 540;
  }

  .nw-sum-label::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--sq);
  }

  .nw-sum-value {
    font-size: clamp(1.125rem, 3.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .nw-sum-main .nw-sum-value {
    font-weight: 700;
  }

  .nw-sum-value.is-negative {
    color: var(--danger);
  }

  .nw-status {
    margin: 0;
    min-height: 0;
  }

  .nw-status:empty {
    display: none;
  }

  .nw-cols {
    display: grid;
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
  }

  @media (min-width: 980px) {
    .nw-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .nw-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nw-col-title {
    margin: 0;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
  }

  .nw-col-title .muted {
    font-size: 0.9em;
    font-weight: 400;
  }

  .nw-group {
    padding: clamp(16px, 2.4vw, 24px);
  }

  .nw-group h4 {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .nw-examples {
    margin: 4px 0 12px;
  }

  .nw-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nw-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    grid-template-areas:
      'name remove'
      'amount remove';
    gap: 8px;
    align-items: center;
  }

  .nw-name {
    grid-area: name;
  }

  .nw-amount {
    grid-area: amount;
  }

  .nw-remove {
    grid-area: remove;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--white);
    color: var(--muted);
    cursor: pointer;
  }

  .nw-remove[hidden] {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .nw-remove:hover {
      color: var(--ink);
      border-color: var(--ink);
    }
  }

  @media (min-width: 520px) {
    .nw-row {
      grid-template-columns: minmax(0, 1fr) minmax(120px, 0.6fr) 44px;
      grid-template-areas: 'name amount remove';
    }
  }

  .nw-group-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .nw-subtotal {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .nw-subtotal .num {
    color: var(--ink);
    font-weight: 600;
  }

  .print-only {
    display: none;
  }

  /* ---------- Content blocks ---------- */
  .next {
    display: grid;
    gap: 24px;
    align-items: center;
  }

  .next h2 {
    margin: 12px 0;
  }

  .next .lead {
    margin: 0;
  }

  .next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (min-width: 900px) {
    .next {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
    .next-actions {
      justify-content: flex-end;
    }
  }

  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 20px;
  }

  .related-card {
    position: relative;
    display: block;
    height: 100%;
    padding: clamp(22px, 2.6vw, 30px);
  }

  .related-card h3 {
    margin: 0 0 8px;
    padding-right: 24px;
    font-size: 1.1875rem;
    line-height: 1.25;
  }

  .related-card p {
    margin: 0;
    font-size: 0.9688rem;
    line-height: 1.55;
  }

  .related-arrow {
    position: absolute;
    top: 14px;
    right: 16px;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--green);
    opacity: 0;
    pointer-events: none;
  }

  .related-card:focus-visible .related-arrow {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .related-card:hover .related-arrow {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .related-arrow {
      translate: -2px 2px;
      transition:
        opacity 200ms var(--ease-out),
        translate 200ms var(--ease-out);
    }

    .related-card:focus-visible .related-arrow {
      translate: 0 0;
    }

    @media (hover: hover) and (pointer: fine) {
      .related-card:hover .related-arrow {
        translate: 0 0;
      }
    }
  }

  /* ---------- Print ---------- */
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.consent),
    :global(.skip-link) {
      display: none !important;
    }

    .nw-summary {
      position: static;
      box-shadow: none;
    }

    .print-only {
      display: block;
      margin: 0;
      font-weight: 600;
    }

    .nw-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .nw-group {
      break-inside: avoid;
      border: 1px solid #999;
      box-shadow: none;
    }

    .nw-row.is-empty,
    .nw-group.is-empty {
      display: none;
    }

    .nw-examples {
      display: none;
    }

    .nw-row {
      grid-template-columns: minmax(0, 1fr) minmax(90px, 0.5fr);
      grid-template-areas: 'name amount';
    }

    .nw-row input {
      border: 0;
      border-bottom: 1px solid #999;
      border-radius: 0;
      padding-left: 0;
      min-height: 28px;
    }

    .nw-row .input-affix {
      left: 0;
    }

    .nw-row .input-affix ~ input {
      padding-left: 12px;
    }

    /* Print the statement without the sheet card chrome. */
    :global(#calculator.sheet-section) {
      padding: 0;
    }

    :global(#calculator .sheet-frame) {
      width: 100%;
      margin: 0;
    }

    :global(#calculator .sheet),
    :global(#calculator .sheet-card) {
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: none;
    }

    :global(#calculator .sheet-body) {
      padding: 0;
    }
  }
</style>

<script>
  import { track } from '../lib/analytics';
  import { formatUSD, parseAmount } from '../lib/finance';

  const root = document.querySelector<HTMLElement>('[data-nw]');

  if (root) {
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-group]'));
    const totalEls = {
      assets: root.querySelector<HTMLElement>('[data-total="assets"]')!,
      liabilities: root.querySelector<HTMLElement>('[data-total="liabilities"]')!,
      net: root.querySelector<HTMLElement>('[data-total="net"]')!,
    };
    const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
    const printDateEl = root.querySelector<HTMLElement>('[data-print-date]');
    let tracked = false;

    const rowsOf = (group: HTMLElement) => Array.from(group.querySelectorAll<HTMLElement>('.nw-row'));

    /** Keeps ids, label text, placeholders and remove-button visibility consistent after add/remove. */
    function sync(group: HTMLElement) {
      const gid = group.dataset.group!;
      const label = group.dataset.label!;
      const examples = (group.dataset.examples ?? '').split('|');
      const rows = rowsOf(group);
      rows.forEach((row, i) => {
        const n = i + 1;
        const [nameInput, amountInput] = Array.from(row.querySelectorAll<HTMLInputElement>('input'));
        const [nameLabel, amountLabel] = Array.from(row.querySelectorAll<HTMLLabelElement>('label'));
        nameInput.id = `nw-${gid}-${n}-name`;
        amountInput.id = `nw-${gid}-${n}-amount`;
        nameLabel.htmlFor = nameInput.id;
        amountLabel.htmlFor = amountInput.id;
        nameLabel.textContent = `${label} row ${n}: account name`;
        amountLabel.textContent = `${label} row ${n}: amount in dollars`;
        nameInput.placeholder = examples[i % examples.length] ?? '';
        const remove = row.querySelector<HTMLButtonElement>('[data-remove]')!;
        remove.hidden = rows.length === 1;
        remove.setAttribute('aria-label', `Remove ${label} row ${n}`);
      });
    }

    function compute() {
      let assets = 0;
      let liabilities = 0;
      let ignored = 0;

      for (const group of groups) {
        let subtotal = 0;
        let anyFilled = false;
        for (const row of rowsOf(group)) {
          const [nameInput, amountInput] = Array.from(row.querySelectorAll<HTMLInputElement>('input'));
          const raw = amountInput.value.trim();
          const value = raw === '' ? 0 : parseAmount(raw);
          const bad = raw !== '' && (!Number.isFinite(value) || value < 0);
          if (bad) {
            amountInput.setAttribute('aria-invalid', 'true');
            ignored += 1;
          } else {
            amountInput.removeAttribute('aria-invalid');
            subtotal += value;
          }
          const empty = raw === '' && nameInput.value.trim() === '';
          row.classList.toggle('is-empty', empty);
          anyFilled ||= !empty;
        }
        group.classList.toggle('is-empty', !anyFilled);
        group.querySelector<HTMLElement>('[data-subtotal]')!.textContent = formatUSD(subtotal);
        if (group.closest<HTMLElement>('[data-kind]')?.dataset.kind === 'assets') assets += subtotal;
        else liabilities += subtotal;
      }

      const net = assets - liabilities;
      totalEls.assets.textContent = formatUSD(assets);
      totalEls.liabilities.textContent = formatUSD(liabilities);
      totalEls.net.textContent = formatUSD(net);
      totalEls.net.classList.toggle('is-negative', net < 0);
      statusEl.textContent =
        ignored > 0
          ? `${ignored} ${ignored === 1 ? 'amount was' : 'amounts were'} ignored because ${ignored === 1 ? 'it is' : 'they are'} negative or not a number.`
          : '';

      if (!tracked && assets + liabilities > 0) {
        tracked = true;
        track('calculator_use', { calculator: 'net-worth' });
      }
    }

    function addRow(group: HTMLElement) {
      const rows = rowsOf(group);
      const clone = rows[0].cloneNode(true) as HTMLElement;
      for (const input of Array.from(clone.querySelectorAll<HTMLInputElement>('input'))) {
        input.value = '';
        input.removeAttribute('aria-invalid');
      }
      clone.classList.add('is-empty');
      rows[rows.length - 1].after(clone);
      sync(group);
      clone.querySelector<HTMLInputElement>('input')!.focus();
      compute();
    }

    root.addEventListener('input', compute);

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const group = target.closest<HTMLElement>('[data-group]');

      if (target.closest('[data-add]') && group) {
        addRow(group);
      } else if (target.closest('[data-remove]') && group) {
        target.closest('.nw-row')!.remove();
        sync(group);
        compute();
        group.querySelector<HTMLButtonElement>('[data-add]')!.focus();
      } else if (target.closest('[data-print]')) {
        window.print();
      } else if (target.closest('[data-reset]')) {
        for (const g of groups) {
          rowsOf(g)
            .slice(1)
            .forEach((row) => row.remove());
          for (const input of Array.from(g.querySelectorAll<HTMLInputElement>('input'))) input.value = '';
          sync(g);
        }
        compute();
      }
    });

    window.addEventListener('beforeprint', () => {
      if (printDateEl) {
        printDateEl.textContent = new Date().toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
      }
    });

    groups.forEach(sync);
    compute();
  }
</script>
