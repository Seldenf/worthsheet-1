<script>
  import { track } from '../lib/analytics';
  import { formatPercent, formatUSD, monthlyPayment, parseAmount } from '../lib/finance';
  import {
    RATINGS,
    countGoodOrBetter,
    dtiRatio,
    ltvRatio,
    overallLevel,
    rateBackDti,
    rateCreditScore,
    rateDti,
    rateFrontDti,
    rateIncome,
    rateLtv,
    ratePfs,
    ratingLevel,
    type Level,
    type Rating,
  } from '../lib/readiness';

  const root = document.querySelector<HTMLElement>('[data-ra]');

  if (root) {
    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const field = (id: string) => q<HTMLInputElement>(`#ra-${id}`);
    const filled = (id: string) => field(id).value.trim() !== '';
    /** NaN when empty, not a number or negative. */
    const read = (id: string) => {
      if (!filled(id)) return Number.NaN;
      const value = parseAmount(field(id).value);
      return value >= 0 ? value : Number.NaN;
    };
    /** 0 when empty, NaN when filled but invalid. */
    const optional = (id: string) => (filled(id) ? read(id) : 0);

    const setError = (id: string, message: string) => {
      const el = q<HTMLElement>(`[data-error="${id}"]`);
      el.textContent = message;
      el.hidden = message === '';
      if (message) field(id).setAttribute('aria-invalid', 'true');
      else field(id).removeAttribute('aria-invalid');
    };
    const out = (key: string, text: string) => {
      q<HTMLElement>(`[data-out="${key}"]`).textContent = text;
    };
    const AMOUNT_ERROR = 'Enter a dollar amount of 0 or more.';
    const checkAmounts = (ids: string[]) => ids.forEach((id) => setError(id, filled(id) && Number.isNaN(read(id)) ? AMOUNT_ERROR : ''));

    function showRating(key: string, rating: Rating | null) {
      const level = rating === null ? 'none' : String(ratingLevel(rating));
      const text = rating ?? 'Not scored';
      for (const el of Array.from(root!.querySelectorAll<HTMLElement>(`[data-badge="${key}"], [data-sum="${key}"]`))) {
        el.dataset.level = level;
        el.textContent = el.hasAttribute('data-badge') && rating === null && !el.classList.contains('ra-badge-sm') ? 'Not scored yet' : text;
      }
      const tableKeys = key === 'dti' ? [] : [key];
      for (const tableKey of tableKeys) {
        for (const row of Array.from(root!.querySelectorAll<HTMLElement>(`[data-bands="${tableKey}"] [data-band]`))) {
          if (rating !== null && row.dataset.band === rating) row.setAttribute('aria-current', 'true');
          else row.removeAttribute('aria-current');
        }
      }
    }

    /**
     * Updates the ReadinessGauge SVG in place (same geometry as components/illustrations/ReadinessGauge.astro):
     * segment/label emphasis, needle position and centre label.
     */
    function setGauge(level: Level) {
      const group = q<SVGGElement>('[data-gauge] .wsi-gauge-f1');
      group.querySelectorAll(':scope > g[opacity]').forEach((seg, i) => seg.setAttribute('opacity', i === level ? '1' : '0.4'));
      group.querySelectorAll(':scope > g[font-size] > text').forEach((label, i) => label.setAttribute('fill-opacity', i === level ? '1' : '0.6'));
      const cx = 300;
      const cy = 276;
      const angle = 180 - 36 * level - 18;
      const point = (radius: number, deg: number) =>
        `${(cx + radius * Math.cos((deg * Math.PI) / 180)).toFixed(1)} ${(cy - radius * Math.sin((deg * Math.PI) / 180)).toFixed(1)}`;
      group.querySelector(':scope > path')?.setAttribute('d', `M${point(110, angle)}L${point(11, angle + 90)}L${point(11, angle - 90)}z`);
      const label = group.querySelector(':scope > text');
      if (label) label.textContent = RATINGS[level];
    }

    const OVERALL_NOTE: Record<Level, string> = {
      0: 'Several areas need work before you apply. Start with the steps below.',
      1: 'You are partway there. Strengthen the areas rated Poor or Fair first.',
      2: 'Solid footing. A few improvements could widen your options.',
      3: 'Strong across most areas.',
      4: 'Excellent across the areas scored. This is an educational rating, not an approval.',
    };

    let tracked = false;

    function compute() {
      // 1) Credit score
      const score = read('credit');
      const credit = rateCreditScore(score);
      setError('credit', filled('credit') && credit === null ? 'Enter a score between 300 and 850.' : '');

      // 2) Income
      const incomeIds = ['inc1', 'inc2', 'inc-other'];
      checkAmounts(incomeIds);
      const totalIncome = incomeIds.map(optional).reduce((sum, v) => sum + v, 0);
      const income = rateIncome(totalIncome);
      out('income-total', Number.isFinite(totalIncome) && totalIncome > 0 ? formatUSD(totalIncome) : '—');

      // 3) Loan-to-value and payment
      const price = read('price');
      const down = read('down');
      setError('price', filled('price') && !(price > 0) ? 'Enter the purchase price as a dollar amount above 0.' : '');
      setError(
        'down',
        filled('down') && Number.isNaN(down)
          ? AMOUNT_ERROR
          : price > 0 && down > price
            ? "Down payment can't exceed the purchase price."
            : '',
      );
      const ltv = price > 0 && down <= price ? ltvRatio(price, down) : Number.NaN;
      const ltvRating = rateLtv(ltv);
      const loan = Number.isFinite(ltv) ? price - down : Number.NaN;
      const ratePercent = read('rate');
      setError('rate', filled('rate') && !(ratePercent <= 25) ? 'Enter an interest rate between 0% and 25%.' : '');
      const term = Number(q<HTMLSelectElement>('#ra-term').value);
      const principalInterest = Number.isFinite(loan) && ratePercent <= 25 ? monthlyPayment(loan, ratePercent / 100, term) : Number.NaN;
      out('loan', Number.isFinite(loan) ? formatUSD(loan) : '—');
      out('ltv', Number.isFinite(ltv) ? formatPercent(ltv) : '—');
      out('pi', Number.isFinite(principalInterest) ? formatUSD(principalInterest, true) : '—');

      // 4) Debt-to-income (front-end and back-end)
      checkAmounts(['debts', 'tax', 'ins', 'hoa']);
      const housing = principalInterest + optional('tax') + optional('ins') + optional('hoa');
      const monthlyIncome = totalIncome / 12;
      const front = dtiRatio(housing, monthlyIncome);
      const back = dtiRatio(housing + read('debts'), monthlyIncome);
      const frontRating = rateFrontDti(front);
      const backRating = rateBackDti(back);
      const dti = backRating === null ? null : rateDti(frontRating, backRating);
      out('housing', Number.isFinite(housing) ? formatUSD(housing, true) : '—');
      out('front', Number.isFinite(front) ? formatPercent(front) : '—');
      out('back', Number.isFinite(back) ? formatPercent(back) : '—');

      // 5) Personal financial statement
      checkAmounts(['assets', 'liab']);
      let pfs: Rating | null = null;
      let netWorth = '—';
      if (filled('assets') || filled('liab')) {
        const assets = optional('assets');
        const liabilities = optional('liab');
        if (Number.isFinite(assets) && Number.isFinite(liabilities)) {
          pfs = ratePfs(assets > 0 || liabilities > 0);
          netWorth = formatUSD(assets - liabilities);
        }
      } else {
        const choice = q<HTMLSelectElement>('#ra-pfs').value;
        pfs = choice === 'yes' ? ratePfs(true) : choice === 'no' ? ratePfs(false) : null;
      }
      out('networth', netWorth);

      // Ratings, overall gauge, summary
      const ratings: Record<string, Rating | null> = { credit, income, ltv: ltvRating, dti, pfs };
      for (const [key, rating] of Object.entries(ratings)) showRating(key, rating);
      showRating('front', frontRating);
      showRating('back', backRating);

      const list = Object.values(ratings);
      const scored = list.filter((r) => r !== null).length;
      const level = overallLevel(list);
      const good = countGoodOrBetter(list);

      q<HTMLElement>('[data-empty]').hidden = scored > 0;
      q<HTMLElement>('[data-result]').hidden = scored === 0;

      if (level !== null) {
        setGauge(level);
        q<HTMLElement>('[data-headline]').textContent = `${good} of 5 areas rated Good or better`;
        q<HTMLElement>('[data-overall]').textContent = `Overall: ${RATINGS[level]}.`;
        q<HTMLElement>('[data-overall-note]').textContent = OVERALL_NOTE[level];
        q<HTMLElement>('[data-scored]').textContent =
          scored === 5 ? 'Based on all 5 areas.' : `Based on ${scored} of 5 areas so far. Fill in the rest for a complete score.`;
      }

      // Next steps for criteria rated below Good
      let weak = 0;
      for (const [key, rating] of Object.entries(ratings)) {
        const isWeak = rating !== null && ratingLevel(rating) < 2;
        q<HTMLElement>(`[data-step="${key}"]`).hidden = !isWeak;
        if (isWeak) weak += 1;
      }
      q<HTMLElement>('[data-steps-card]').hidden = scored === 0;
      q<HTMLElement>('[data-steps-none]').hidden = weak > 0;

      if (!tracked && scored > 0) {
        tracked = true;
        track('calculator_use', { calculator: 'mortgage-readiness' });
      }
    }

    root.addEventListener('input', compute);
    root.addEventListener('change', compute);
    compute();
  }
</script>
