---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Prose from '../components/Prose.astro';
import ReadinessGauge from '../components/illustrations/ReadinessGauge.astro';
import CtaTiles from '../components/illustrations/CtaTiles.astro';
import { faqLd, webAppLd } from '../lib/seo';
import { url } from '../lib/url';

const path = '/mortgage-readiness-assessment/';
const title = 'Mortgage Readiness Assessment & Score | WorthSheet';
const description =
  'Free mortgage readiness assessment: a self-check across five areas (credit, income, loan-to-value, debt-to-income and having a personal financial statement). Based on our template.';

const faq = [
  {
    q: 'What is a mortgage readiness assessment?',
    a: 'A quick self-check that rates your credit score, income, loan-to-value, debt-to-income and personal financial statement so you can see what to improve before applying.',
  },
  {
    q: 'What does the assessment score?',
    a: 'Five areas: credit score, income and employment, loan-to-value ratio, debt-to-income ratio (front-end and back-end) and whether you have a personal financial statement.',
  },
  {
    q: 'Are the ratings lender approval rules?',
    a: 'No. The bands are WorthSheet’s own and mirror the Homebuyer Readiness tab of our template. They are not lender rules, and each lender and loan program sets its own requirements.',
  },
  {
    q: 'What credit score do I need?',
    a: 'It varies by program; see the readiness checklist for Fannie Mae, FHA and VA starting points.',
  },
  {
    q: 'Does this affect my credit score?',
    a: 'No. It uses numbers you enter and does not check your credit.',
  },
  {
    q: 'How is the overall score calculated?',
    a: 'Each criterion is rated from Poor to Excellent. The gauge shows the average of the criteria you have filled in (for debt-to-income, the weaker of front-end and back-end), and the headline counts how many criteria are rated Good or better.',
  },
  {
    q: 'Is my information saved or sent anywhere?',
    a: 'No. Everything is calculated in your browser and nothing you type is uploaded or stored. If you accept analytics cookies, only the fact that the tool was used is recorded, never your numbers.',
  },
];

interface Band {
  rating: string;
  range: string;
  note?: string;
}

const bands: Record<string, Band[]> = {
  credit: [
    {
      rating: 'Poor',
      range: '300–579',
      note: 'You may find it hard to qualify for credit or be offered credit at higher interest rates. Lenders see a higher risk of default.',
    },
    {
      rating: 'Fair',
      range: '580–669',
      note: 'You may be eligible for credit but often at higher interest rates. Lenders see a moderate risk.',
    },
    {
      rating: 'Good',
      range: '670–739',
      note: 'You are likely to be offered better interest rates. Lenders see a lower risk.',
    },
    {
      rating: 'Very Good',
      range: '740–799',
      note: 'You are typically offered favorable terms. Lenders see a low risk.',
    },
    {
      rating: 'Excellent',
      range: '800–850',
      note: 'A very low risk of default; you are likely to qualify for the most favorable terms and rates.',
    },
  ],
  income: [
    { rating: 'Poor', range: 'Under $40,000' },
    { rating: 'Fair', range: '$40,000 to under $75,000' },
    { rating: 'Good', range: '$75,000 to under $150,000' },
    { rating: 'Very Good', range: '$150,000 to under $300,000' },
    { rating: 'Excellent', range: '$300,000 or more' },
  ],
  ltv: [
    { rating: 'Poor', range: 'Above 92.5%' },
    { rating: 'Fair', range: 'Above 85% up to 92.5%' },
    { rating: 'Good', range: '75% up to 85%' },
    { rating: 'Very Good', range: '60% up to under 75%' },
    { rating: 'Excellent', range: 'Under 60%' },
  ],
  front: [
    { rating: 'Poor', range: 'Above 28% of gross monthly income' },
    { rating: 'Good', range: 'Above 20% up to 28%' },
    { rating: 'Very Good', range: '10% to 20% (including 10% and 20%)' },
    { rating: 'Excellent', range: 'Under 10%' },
  ],
  back: [
    { rating: 'Poor', range: 'Above 36% of gross monthly income' },
    { rating: 'Good', range: 'Above 30% up to 36%' },
    { rating: 'Very Good', range: '20% to 30% (including 20% and 30%)' },
    { rating: 'Excellent', range: 'Under 20%' },
  ],
  pfs: [
    { rating: 'Poor', range: 'You have not created a personal financial statement' },
    { rating: 'Excellent', range: 'You have created a personal financial statement' },
  ],
};

const incomeFields = [
  { id: 'inc1', label: 'Borrower 1 annual income', hint: 'Before taxes' },
  { id: 'inc2', label: 'Borrower 2 annual income', hint: 'Leave blank if there is no co-borrower' },
  { id: 'inc-other', label: 'Other annual income', hint: 'Social Security, pension or other income' },
];

const pitiFields = [
  { id: 'tax', label: 'Monthly property tax' },
  { id: 'ins', label: 'Monthly homeowners insurance' },
  { id: 'hoa', label: 'Monthly HOA dues' },
];

const related = [
  {
    href: '/mortgage-readiness-checklist/',
    title: 'Mortgage readiness checklist',
    text: 'The five areas in plain English, with what to fix first.',
  },
  {
    href: '/how-much-house-can-i-afford/',
    title: 'How much house can I afford?',
    text: 'Work out a price range from income, debts and down payment.',
  },
  {
    href: '/debt-to-income-ratio-calculator/',
    title: 'Debt-to-income ratio calculator',
    text: 'See front-end and back-end DTI against the 28/36 benchmark.',
  },
  {
    href: '/mortgage-calculator/',
    title: 'Mortgage calculator',
    text: 'Monthly payment, total interest and an amortization table.',
  },
  {
    href: '/net-worth-calculator/',
    title: 'Net worth calculator',
    text: 'Total your assets and liabilities for area five.',
  },
  {
    href: '/what-do-banks-look-for-when-reviewing-a-mortgage-application/',
    title: 'What banks look for in a mortgage application',
    text: 'The factors lenders weigh when reviewing your application.',
  },
  {
    href: '/glossary/loan-to-value-ratio/',
    title: 'What is a loan-to-value ratio?',
    text: 'Definition and examples of LTV.',
  },
  {
    href: '/glossary/back-end-dti/',
    title: 'What is back-end DTI?',
    text: 'Total monthly debt payments divided by gross monthly income.',
  },
];

const criteriaTitles = {
  credit: 'Credit score',
  income: 'Income & employment',
  ltv: 'Loan-to-value ratio',
  dti: 'Debt-to-income ratio',
  pfs: 'Personal financial statement',
};
---

<Base
  title={title}
  description={description}
  path={path}
  breadcrumbs={[{ name: 'Mortgage readiness assessment', path }]}
  jsonLd={[
    webAppLd({
      name: 'Mortgage Readiness Assessment',
      description,
      path,
      category: 'Mortgage readiness calculator',
    }),
    faqLd(faq),
  ]}
>
  <Sheet grid seed={25} id="hero" aria-labelledby="hero-title">
    <div class="split">
      <div class="split-copy">
        <Eyebrow tone="green">Free homebuyer self-check</Eyebrow>
        <h1 id="hero-title">Mortgage readiness assessment <span class="accent">(free score calculator)</span></h1>
        <p class="lead">
          The mortgage readiness assessment is a free self-check that rates your credit score, income, loan-to-value
          ratio, debt-to-income ratio and personal financial statement from Poor to Excellent, so you can see what to
          improve before you apply.
        </p>
        <ul class="list-check">
          <li>A self-check across five areas, with the same bands as the Homebuyer Readiness tab of our free template</li>
          <li>Instant ratings and a personalized checklist of next steps</li>
          <li>No credit check: it only uses numbers you type, in your browser</li>
        </ul>
        <div class="hero-actions">
          <Button href="#assessment" variant="primary" size="lg">Start the assessment</Button>
          <Button href="/mortgage-readiness-checklist/" variant="secondary" size="lg">Read the checklist</Button>
        </div>
      </div>
      <div class="hero-art">
        <ReadinessGauge class="float" level={3} />
      </div>
    </div>
  </Sheet>

  <Sheet id="assessment" aria-labelledby="assessment-title">
    <div data-ra class="ra">
      <div class="ra-intro">
        <h2 id="assessment-title">Rate your mortgage readiness</h2>
        <p class="muted">
          Fill in as many of the five areas as you can. Each one is rated as you type, and the score on the right
          updates automatically. Amounts are in U.S. dollars.
        </p>
      </div>

      <noscript>
        <p class="muted">
          The ratings need JavaScript. Without it, use the <a href={url('/download/')}>free template</a>, which has the
          same Homebuyer Readiness tab.
        </p>
      </noscript>

      <div class="ra-layout">
        <div class="ra-criteria">
          <!-- 1. Credit score -->
          <section class="card ra-card" aria-labelledby="c1-title">
            <header class="ra-card-head">
              <h3 id="c1-title"><span class="ra-num">1</span> Credit score</h3>
              <span class="ra-badge" data-badge="credit" data-level="none">Not scored yet</span>
            </header>
            <div class="field">
              <label for="ra-credit">Your credit score (300–850)</label>
              <input
                type="text"
                id="ra-credit"
                inputmode="numeric"
                autocomplete="off"
                placeholder="e.g. 720"
                aria-describedby="ra-credit-hint ra-credit-err"
              />
              <p class="field-hint" id="ra-credit-hint">
                Need your credit reports? Get them free, every week, at
                <a href="https://www.annualcreditreport.com/" rel="noopener" target="_blank">AnnualCreditReport.com</a>,
                the only website authorized by federal law to provide free credit reports. It gives reports, not
                scores; scores are often free from your bank or card issuer.
              </p>
              <p class="field-error" id="ra-credit-err" data-error="credit" hidden></p>
            </div>
            <details class="ra-bands">
              <summary>How credit score is rated</summary>
              <div class="table-wrap">
                <table data-bands="credit">
                  <thead>
                    <tr><th scope="col">Rating</th><th scope="col">Score</th><th scope="col">What it usually means</th></tr>
                  </thead>
                  <tbody>
                    {
                      bands.credit.map((b) => (
                        <tr data-band={b.rating}>
                          <th scope="row">{b.rating}</th>
                          <td>{b.range}</td>
                          <td>{b.note}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </details>
          </section>

          <!-- 2. Income -->
          <section class="card ra-card" aria-labelledby="c2-title">
            <header class="ra-card-head">
              <h3 id="c2-title"><span class="ra-num">2</span> Income &amp; employment</h3>
              <span class="ra-badge" data-badge="income" data-level="none">Not scored yet</span>
            </header>
            <div class="ra-fields">
              {
                incomeFields.map((f) => (
                  <div class="field">
                    <label for={`ra-${f.id}`}>{f.label}</label>
                    <div class="input-group">
                      <span class="input-affix" aria-hidden="true">$</span>
                      <input
                        type="text"
                        id={`ra-${f.id}`}
                        inputmode="decimal"
                        autocomplete="off"
                        placeholder="0"
                        aria-describedby={`ra-${f.id}-hint ra-${f.id}-err`}
                      />
                    </div>
                    <p class="field-hint" id={`ra-${f.id}-hint`}>{f.hint}</p>
                    <p class="field-error" id={`ra-${f.id}-err`} data-error={f.id} hidden />
                  </div>
                ))
              }
            </div>
            <dl class="ra-readout">
              <div><dt>Total annual income</dt><dd class="num" data-out="income-total">—</dd></div>
            </dl>
            <details class="ra-bands">
              <summary>How income is rated</summary>
              <p>
                Lenders look at income mainly through your debt-to-income ratio, and most importantly at whether it is
                stable and documented. These bands use general U.S. household income ranges, and income should also be
                judged against the cost of living where you plan to buy.
              </p>
              <div class="table-wrap">
                <table data-bands="income">
                  <thead>
                    <tr><th scope="col">Rating</th><th scope="col">Total annual income</th></tr>
                  </thead>
                  <tbody>
                    {
                      bands.income.map((b) => (
                        <tr data-band={b.rating}>
                          <th scope="row">{b.rating}</th>
                          <td>{b.range}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </details>
          </section>

          <!-- 3. LTV -->
          <section class="card ra-card" aria-labelledby="c3-title">
            <header class="ra-card-head">
              <h3 id="c3-title"><span class="ra-num">3</span> Loan-to-value ratio</h3>
              <span class="ra-badge" data-badge="ltv" data-level="none">Not scored yet</span>
            </header>
            <div class="ra-fields ra-fields-2">
              <div class="field">
                <label for="ra-price">Purchase price</label>
                <div class="input-group">
                  <span class="input-affix" aria-hidden="true">$</span>
                  <input type="text" id="ra-price" inputmode="decimal" autocomplete="off" placeholder="400,000" aria-describedby="ra-price-hint ra-price-err" />
                </div>
                <p class="field-hint" id="ra-price-hint">The loan itself will be based on the appraised value.</p>
                <p class="field-error" id="ra-price-err" data-error="price" hidden></p>
              </div>
              <div class="field">
                <label for="ra-down">Down payment</label>
                <div class="input-group">
                  <span class="input-affix" aria-hidden="true">$</span>
                  <input type="text" id="ra-down" inputmode="decimal" autocomplete="off" placeholder="40,000" aria-describedby="ra-down-hint ra-down-err" />
                </div>
                <p class="field-hint" id="ra-down-hint">Enter 0 if none.</p>
                <p class="field-error" id="ra-down-err" data-error="down" hidden></p>
              </div>
              <div class="field">
                <label for="ra-rate">Interest rate</label>
                <div class="input-group">
                  <input type="text" id="ra-rate" inputmode="decimal" autocomplete="off" placeholder="6.5" aria-describedby="ra-rate-hint ra-rate-err" />
                  <span class="input-affix input-affix-end" aria-hidden="true">%</span>
                </div>
                <p class="field-hint" id="ra-rate-hint">Annual rate you expect to pay. Needed for the payment in criterion 4.</p>
                <p class="field-error" id="ra-rate-err" data-error="rate" hidden></p>
              </div>
              <div class="field">
                <label for="ra-term">Loan term</label>
                <select id="ra-term">
                  <option value="30" selected>30 years</option>
                  <option value="15">15 years</option>
                </select>
                <p class="field-hint">Fixed rate, fully amortizing.</p>
              </div>
            </div>
            <dl class="ra-readout">
              <div><dt>Mortgage amount</dt><dd class="num" data-out="loan">—</dd></div>
              <div><dt>Loan-to-value</dt><dd class="num" data-out="ltv">—</dd></div>
              <div><dt>Principal &amp; interest per month</dt><dd class="num" data-out="pi">—</dd></div>
            </dl>
            <details class="ra-bands">
              <summary>How loan-to-value is rated</summary>
              <p>
                The LTV ratio is the loan amount relative to the property's appraised value. A lower LTV is generally
                more favorable because it means you have more equity in the home. For a readiness check it is fine to use
                the expected purchase price. See the <a href="#programs">loan program notes</a> below for conventional,
                FHA, VA and USDA loans.
              </p>
              <div class="table-wrap">
                <table data-bands="ltv">
                  <thead>
                    <tr><th scope="col">Rating</th><th scope="col">Loan-to-value</th></tr>
                  </thead>
                  <tbody>
                    {
                      bands.ltv.map((b) => (
                        <tr data-band={b.rating}>
                          <th scope="row">{b.rating}</th>
                          <td>{b.range}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </details>
          </section>

          <!-- 4. DTI -->
          <section class="card ra-card" aria-labelledby="c4-title">
            <header class="ra-card-head">
              <h3 id="c4-title"><span class="ra-num">4</span> Debt-to-income ratio</h3>
              <span class="ra-badge" data-badge="dti" data-level="none">Not scored yet</span>
            </header>
            <p class="muted ra-lede">
              Uses your total income from criterion 2 and the mortgage payment from criterion 3, so fill those in first.
            </p>
            <div class="field">
              <label for="ra-debts">Current monthly debt payments</label>
              <div class="input-group">
                <span class="input-affix" aria-hidden="true">$</span>
                <input type="text" id="ra-debts" inputmode="decimal" autocomplete="off" placeholder="600" aria-describedby="ra-debts-hint ra-debts-err" />
              </div>
              <p class="field-hint" id="ra-debts-hint">
                Car, student loan, credit card minimums and similar monthly payments. Enter 0 if none. Do not include rent
                or the new mortgage.
              </p>
              <p class="field-error" id="ra-debts-err" data-error="debts" hidden></p>
            </div>
            <details class="ra-optional">
              <summary>Optional: include property tax, insurance and HOA (PITI)</summary>
              <p class="muted">
                Lenders count the full housing payment, not just principal and interest. Leave these blank (treated as $0)
                to match the template, which uses principal and interest only.
              </p>
              <div class="ra-fields ra-fields-3">
                {
                  pitiFields.map((f) => (
                    <div class="field">
                      <label for={`ra-${f.id}`}>{f.label}</label>
                      <div class="input-group">
                        <span class="input-affix" aria-hidden="true">$</span>
                        <input type="text" id={`ra-${f.id}`} inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby={`ra-${f.id}-err`} />
                      </div>
                      <p class="field-error" id={`ra-${f.id}-err`} data-error={f.id} hidden></p>
                    </div>
                  ))
                }
              </div>
            </details>
            <dl class="ra-readout">
              <div><dt>Housing payment per month</dt><dd class="num" data-out="housing">—</dd></div>
              <div>
                <dt>Front-end DTI (housing)</dt>
                <dd><span class="num" data-out="front">—</span> <span class="ra-badge ra-badge-sm" data-badge="front" data-level="none">Not scored</span></dd>
              </div>
              <div>
                <dt>Back-end DTI (total)</dt>
                <dd><span class="num" data-out="back">—</span> <span class="ra-badge ra-badge-sm" data-badge="back" data-level="none">Not scored</span></dd>
              </div>
            </dl>
            <details class="ra-bands">
              <summary>How debt-to-income is rated</summary>
              <p>
                <strong>Front-end DTI</strong> (housing DTI) is the proposed monthly housing payment divided by gross
                monthly income; ideally 28% or lower. <strong>Back-end DTI</strong> (total DTI) adds all other monthly debt
                payments such as credit cards, car loans and student loans; ideally 36% or lower. The criterion is rated by
                the weaker of the two.
              </p>
              <div class="table-wrap">
                <table data-bands="front">
                  <caption>Front-end DTI</caption>
                  <thead>
                    <tr><th scope="col">Rating</th><th scope="col">Housing payment as share of gross monthly income</th></tr>
                  </thead>
                  <tbody>
                    {
                      bands.front.map((b) => (
                        <tr data-band={b.rating}>
                          <th scope="row">{b.rating}</th>
                          <td>{b.range}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
              <div class="table-wrap">
                <table data-bands="back">
                  <caption>Back-end DTI</caption>
                  <thead>
                    <tr><th scope="col">Rating</th><th scope="col">Housing plus other debt payments as share of gross monthly income</th></tr>
                  </thead>
                  <tbody>
                    {
                      bands.back.map((b) => (
                        <tr data-band={b.rating}>
                          <th scope="row">{b.rating}</th>
                          <td>{b.range}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
              <p class="muted">
                Exactly 10% front-end or exactly 20% back-end is Very Good, not Excellent, as in the template. The two DTI
                scales have no Fair band.
              </p>
            </details>
          </section>

          <!-- 5. PFS -->
          <section class="card ra-card" aria-labelledby="c5-title">
            <header class="ra-card-head">
              <h3 id="c5-title"><span class="ra-num">5</span> Personal financial statement</h3>
              <span class="ra-badge" data-badge="pfs" data-level="none">Not scored yet</span>
            </header>
            <div class="field">
              <label for="ra-pfs">Have you created a personal financial statement?</label>
              <select id="ra-pfs">
                <option value="" selected>Select one</option>
                <option value="yes">Yes, I have one</option>
                <option value="no">No, not yet</option>
              </select>
              <p class="field-hint">
                A personal financial statement (PFS) summarizes your assets, liabilities and net worth on one date. Don't
                have one? <a href={url('/download/')}>Get the free template</a> or try the
                <a href={url('/net-worth-calculator/')}>net worth calculator</a>.
              </p>
            </div>
            <p class="ra-or"><span>or enter your totals</span></p>
            <div class="ra-fields ra-fields-2">
              <div class="field">
                <label for="ra-assets">Total assets</label>
                <div class="input-group">
                  <span class="input-affix" aria-hidden="true">$</span>
                  <input type="text" id="ra-assets" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="ra-assets-err" />
                </div>
                <p class="field-error" id="ra-assets-err" data-error="assets" hidden></p>
              </div>
              <div class="field">
                <label for="ra-liab">Total liabilities</label>
                <div class="input-group">
                  <span class="input-affix" aria-hidden="true">$</span>
                  <input type="text" id="ra-liab" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="ra-liab-err" />
                </div>
                <p class="field-error" id="ra-liab-err" data-error="liab" hidden></p>
              </div>
            </div>
            <dl class="ra-readout">
              <div><dt>Net worth</dt><dd class="num" data-out="networth">—</dd></div>
            </dl>
            <details class="ra-bands">
              <summary>How the personal financial statement is rated</summary>
              <p>
                A PFS is not part of the standard mortgage application, because lenders collect your assets and liabilities
                on the loan application itself. Some lenders ask for one in special cases, such as self-employment. Entering totals
                counts as having a statement. Update it often.
              </p>
              <div class="table-wrap">
                <table data-bands="pfs">
                  <thead>
                    <tr><th scope="col">Rating</th><th scope="col">Meaning</th></tr>
                  </thead>
                  <tbody>
                    {
                      bands.pfs.map((b) => (
                        <tr data-band={b.rating}>
                          <th scope="row">{b.rating}</th>
                          <td>{b.range}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </details>
          </section>
        </div>

        <aside class="ra-results" aria-labelledby="results-title">
          <div class="card ra-results-card">
            <h3 id="results-title">Your readiness score</h3>
            <div aria-live="polite" aria-atomic="true" class="ra-live">
              <p class="ra-empty muted" data-empty>
                Fill in at least one area and your rating appears here.
              </p>
              <div data-result hidden>
                <div class="ra-gauge" data-gauge>
                  <ReadinessGauge level={0} idPrefix="wsi-gauge-live" />
                </div>
                <p class="ra-headline" data-headline></p>
                <p class="ra-overall"><strong data-overall></strong> <span data-overall-note class="muted"></span></p>
                <p class="muted ra-scored" data-scored></p>
              </div>
            </div>
            <ul class="ra-summary">
              {
                Object.entries(criteriaTitles).map(([key, label]) => (
                  <li>
                    <span>{label}</span>
                    <span class="ra-badge ra-badge-sm" data-sum={key} data-level="none">Not scored</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="card ra-steps" data-steps-card hidden>
            <h3>Your next steps</h3>
            <p class="muted" data-steps-none hidden>
              None of your scored criteria are below Good. Compare lenders, then ask for a pre-approval; see the
              <a href={url('/mortgage-readiness-checklist/')}>mortgage readiness checklist</a> for the paperwork to gather.
            </p>
            <ul class="ra-step-list">
              <li data-step="credit" hidden>
                <strong>Credit score.</strong> Get your free reports, available weekly, at
                <a href="https://www.annualcreditreport.com/" rel="noopener" target="_blank">AnnualCreditReport.com</a>,
                dispute any errors, pay down revolving balances and avoid opening new credit before you apply. Lenders set
                their own score minimums, so ask what applies to the loan you want.
              </li>
              <li data-step="income" hidden>
                <strong>Income &amp; employment.</strong> Add every reliable income source, including a co-borrower's.
                Lenders verify income with documents such as pay stubs, W-2s and tax returns, so keep them organized. See
                what a price range looks like in
                <a href={url('/how-much-house-can-i-afford/')}>How much house can I afford?</a>
              </li>
              <li data-step="ltv" hidden>
                <strong>Loan-to-value.</strong> Save a larger down payment or target a lower price. Conventional lenders
                often prefer 80% LTV or lower, and under 20% down usually means mortgage insurance. Try different
                scenarios in the <a href={url('/mortgage-calculator/')}>mortgage calculator</a>, and review the
                <a href="#programs">loan program notes</a>.
              </li>
              <li data-step="dti" hidden>
                <strong>Debt-to-income.</strong> Pay down monthly debts, aim for a lower price or a larger down payment,
                and model the effect in the
                <a href={url('/debt-to-income-ratio-calculator/')}>debt-to-income ratio calculator</a>.
              </li>
              <li data-step="pfs" hidden>
                <strong>Personal financial statement.</strong> Create one: list your assets and liabilities in the
                <a href={url('/download/')}>free WorthSheet template</a> and keep it updated.
              </li>
            </ul>
            <p class="muted">
              More detail on each criterion:
              <a href={url('/mortgage-readiness-checklist/')}>mortgage readiness checklist</a>.
            </p>
          </div>
        </aside>
      </div>

      <p class="disclaimer">
        Estimates for educational purposes only. Not a loan offer or financial advice. The ratings are WorthSheet's own
        educational bands, not lender approval rules.
      </p>
    </div>
  </Sheet>

  <Sheet id="programs" aria-labelledby="programs-title">
    <div class="split">
      <div class="sec-head">
        <Eyebrow tone="blue">Loan-to-value notes</Eyebrow>
        <h2 id="programs-title">LTV and loan programs</h2>
      </div>
      <Prose>
        <p>
          A general goal is a 20% down payment (80% LTV), but government programs allow lower down payments. Maximum
          LTV depends on the program, your credit and the lender, so confirm the details with a lender.
        </p>
        <ul>
          <li>
            <strong>Conventional mortgages:</strong> lenders often prefer a maximum LTV of 80% or lower. With less than
            20% down you may have to pay private mortgage insurance (<a href={url('/glossary/pmi/')}>PMI</a>).
          </li>
          <li>
            <strong>FHA loans:</strong> the Federal Housing Administration allows higher LTV; FHA loans often have a
            maximum LTV of 96.5%, which means a down payment as low as 3.5%. See
            <a href="https://www.hud.gov/sites/default/files/hudclips/documents/2026-11hsgml.pdf" rel="noopener" target="_blank">HUD Mortgagee Letter 2026-11</a>
            for the current credit score tiers.
          </li>
          <li>
            <strong>VA loans:</strong> available to eligible veterans and service members, and they typically do not
            require a down payment, so LTV can be 100% or higher. VA says
            <a href="https://www.va.gov/housing-assistance/home-loans/" rel="noopener" target="_blank">nearly 90% of VA-backed loans are made with no down payment</a>.
          </li>
          <li>
            <strong>USDA loans:</strong> the U.S. Department of Agriculture focuses on rural and suburban areas, and
            its loans may also allow higher LTV. See the
            <a href="https://www.rd.usda.gov/programs-services/single-family-housing-programs/single-family-housing-guaranteed-loan-program" rel="noopener" target="_blank">USDA Single Family Housing Guaranteed Loan Program</a>.
          </li>
        </ul>
        <p>
          The CFPB's
          <a href="https://www.consumerfinance.gov/consumer-tools/mortgages/ready-to-buy-a-home" rel="noopener" target="_blank">Ready to buy a home?</a>
          tool is another good place to check your budget.
        </p>
      </Prose>
    </div>
  </Sheet>

  <Sheet tone="cream" aria-labelledby="method-title">
    <div class="split">
      <div class="sec-head">
        <Eyebrow tone="yellow">Method</Eyebrow>
        <h2 id="method-title">How the assessment is scored</h2>
      </div>
      <Prose>
        <p>
          This page replicates the <strong>Homebuyer Readiness</strong> tab of the free WorthSheet template. The five
          areas are your credit score, income and employment, loan-to-value ratio, debt-to-income ratio and personal
          financial statement. The bands are WorthSheet's own educational ratings and mirror the template; they are not
          lender rules, and every lender and loan program sets its own requirements.
        </p>
        <ul>
          <li>
            <strong>Mortgage payment:</strong> principal and interest from the price, down payment, rate and term, using
            the standard fixed-rate formula (the same as the spreadsheet's PMT function).
          </li>
          <li>
            <strong>Front-end and back-end DTI:</strong> the template divides the principal-and-interest payment by gross
            monthly income. This page also lets you add monthly property tax, homeowners insurance and HOA dues (blank
            counts as $0), so leaving them empty gives the template's result. Back-end DTI adds your other monthly debt
            payments. A ratio of exactly 10% (front-end) or 20% (back-end) is Very Good, not Excellent.
          </li>
          <li>
            <strong>Credit score bands:</strong> the ranges are contiguous: 670–739 is Good and 740–799 is Very Good,
            so every score from 300 to 850 receives a rating.
          </li>
          <li>
            <strong>Overall score:</strong> the gauge shows the average rating of the criteria you have filled in. For
            debt-to-income it uses the weaker of front-end and back-end.
          </li>
          <li>
            <strong>Personal financial statement:</strong> Excellent if you have created one (or entered asset or
            liability totals), Poor if not, as in the template.
          </li>
        </ul>
        <p>
          Want to see the same logic in a spreadsheet, wired to your full asset and liability list? The free template
          includes it. <a href={url('/download/')}>Get the template</a>.
        </p>
      </Prose>
    </div>
  </Sheet>

  <Sheet aria-labelledby="faq-title">
    <div class="split">
      <div class="sec-head">
        <Eyebrow tone="green">FAQ</Eyebrow>
        <h2 id="faq-title">Mortgage readiness questions</h2>
      </div>
      <Faq items={faq} />
    </div>
  </Sheet>

  <Sheet tone="blue" aria-labelledby="related-title">
    <div class="sec-head">
      <h2 id="related-title">Related tools and guides</h2>
    </div>
    <div class="grid grid-3 related">
      {
        related.map((r) => (
          <a class="card" href={url(r.href)}>
            <h3>{r.title}</h3>
            <p class="muted">{r.text}</p>
          </a>
        ))
      }
    </div>
  </Sheet>

  <CtaBand
    title="Run this with your real numbers in the free template"
    text="The free WorthSheet template has the same Homebuyer Readiness tab next to its Personal Financial Statement tab, so your net worth feeds the score automatically."
  >
    <CtaTiles slot="art" />
  </CtaBand>
</Base>

