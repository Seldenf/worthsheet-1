---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import DocumentStack from '../components/illustrations/DocumentStack.astro';
import { STATS } from '../config';
import { url } from '../lib/url';
import { faqLd } from '../lib/seo';

const faq = [
  {
    q: 'How do I get the template?',
    a: 'Fill in the short form with your name and email. After you submit, the success panel lets you choose: open your own copy in Google Sheets (Google asks you to sign in to make a copy), or download the Excel (.xlsx) version.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes, the template is free. We ask for a name and email so we know who is using it; see the Privacy Policy for how that data is handled.',
  },
  {
    q: 'Can I use it in Excel instead of Google Sheets?',
    a: 'Yes. After you submit the form, the success panel offers “Download for Excel (.xlsx)”.',
  },
  {
    q: 'What tabs does the template include?',
    a: 'Personal Finance Statement (PFS) and Homebuyer Readiness.',
  },
  {
    q: 'Do I have to fill in every category?',
    a: 'No. Fill in the accounts you have and leave the rest at zero; add rows if you have more accounts than the template shows.',
  },
];

const benefits = ['Free PFS template', 'Regular template updates', 'Secure and private'];
---

<Base
  title="Download the Free PFS Template (Sheets & Excel) | WorthSheet"
  description="Get the free WorthSheet personal financial statement template. Enter your name and email, then open your copy in Google Sheets or download the Excel version."
  path="/download/"
  breadcrumbs={[{ name: 'Download', path: '/download/' }]}
  jsonLd={[faqLd(faq)]}
>
  <Sheet grid seed={32} id="hero" aria-labelledby="hero-title">
    <div class="stack hero-copy" style="--stack-gap: 1.25rem">
      <Eyebrow tone="green">Free template</Eyebrow>
      <h1 id="hero-title">Download the free <span class="accent">personal financial statement template</span></h1>
      <p class="lead">
        Your journey to simplified finances starts here. Tell us where to send your copy and
        pick Google Sheets or Excel in seconds.
      </p>
      <ul class="list-check benefits">
        {
          benefits.map((benefit) => (
            <li>{benefit}</li>
          ))
        }
      </ul>
      <p class="muted">
        Over {STATS.downloads.replace('+', '')} downloads. Name and email are used to deliver the
        template; read the <a href={url('/privacy-policy/')}>Privacy Policy</a>.
      </p>
    </div>
    <div class="hero-form">
      <LeadForm id="download" />
    </div>
  </Sheet>

  <Sheet tone="green" aria-labelledby="what-you-get">
    <div class="split">
      <div class="stack split-copy what-copy" style="--stack-gap: 1.25rem">
        <Eyebrow tone="blue">What you get</Eyebrow>
        <h2 id="what-you-get">One spreadsheet, two tabs, ready for a lender</h2>
        <ul class="get-list">
          <li>
            <strong>Two tabs:</strong> Personal Finance Statement (PFS) and Homebuyer Readiness.
          </li>
          <li>
            <strong>{STATS.assetCategories} asset and {STATS.liabilityCategories} liability categories</strong>
            built in, with formulas that total assets, liabilities and net worth for you.
          </li>
          <li>
            <strong>Works in Google Sheets and Excel.</strong> Open your own copy in Google Sheets or
            download the .xlsx file.
          </li>
        </ul>
        <p>
          Want to see it filled in first? Browse the
          <a href={url('/personal-financial-statement-example/')}>personal financial statement example</a>,
          learn how to
          <a href={url('/how-to-fill-out-a-personal-financial-statement/')}>fill one out</a>, or read
          about <a href={url('/sba-form-413/')}>SBA Form 413</a>.
        </p>
      </div>
      <div class="split-art"><DocumentStack /></div>
    </div>
  </Sheet>

  <Sheet aria-labelledby="faq-title">
    <div class="sec-head stack" style="--stack-gap: 1rem">
      <Eyebrow tone="yellow">Questions</Eyebrow>
      <h2 id="faq-title">Template download FAQ</h2>
    </div>
    <Faq items={faq} />
  </Sheet>
</Base>

<style>
  .hero-copy {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .benefits {
    width: max-content;
    max-width: 100%;
    margin-inline: auto;
    font-weight: 540;
    font-size: 1.0625rem;
    text-align: left;
  }

  .hero-form {
    max-width: 34rem;
    margin: clamp(32px, 5vw, 48px) auto 0;
    text-align: left;
  }

  .hero-copy a,
  .what-copy a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .get-list {
    display: grid;
    gap: 14px;
    padding-left: 1.2em;
  }
</style>
